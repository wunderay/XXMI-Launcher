diff --git a/DirectX11/ModLoading/BackgroundReload.inl b/DirectX11/ModLoading/BackgroundReload.inl
new file mode 100644
index 0000000..f2aae4d
--- /dev/null
+++ b/DirectX11/ModLoading/BackgroundReload.inl
@@ -0,0 +1,345 @@
+// background-reload.patch: UNBUILT AND UNTESTED. Private part of Runtime.cpp,
+// included inside namespace ModLoading after GeneralConfigPipeline.inl.
+//
+// With [ModLoading] background_reload = 1, an explicit F10 press becomes an
+// activation request for the detached general pipeline: the live generation
+// stays published, a complete candidate is parsed/linked off-thread, its GPU
+// objects are created by a worker (or the bounded per-frame pump) and it is
+// swapped at the PumpRuntime frame boundary. Every unsupported state falls
+// back to the legacy synchronous ReloadConfig on the next frame.
+namespace {
+constexpr size_t IncrementalReleasePerFrame = 16;
+constexpr std::chrono::milliseconds BackgroundReloadTimeout(10000);
+
+struct BackgroundReloadControl {
+	std::mutex mutex;
+	bool enabled = false;
+	bool requested = false; // F10 accepted; consumed by the next owner pump
+	bool active = false;    // candidates with id >= minimumCandidate may publish
+	uint64_t minimumCandidate = 0;
+	std::chrono::steady_clock::time_point requestedAt, deadline;
+	std::atomic<bool> keyPressed{false}, forceLegacy{false};
+};
+BackgroundReloadControl& BackgroundControl()
+{
+	static auto* control = new BackgroundReloadControl; // No static destructor under the loader lock.
+	return *control;
+}
+
+void DisableBackgroundReload()
+{
+	auto& control = BackgroundControl();
+	std::lock_guard<std::mutex> lock(control.mutex);
+	control.enabled = control.requested = control.active = false;
+}
+
+void ConfigureBackgroundReload(const RuntimeState& state)
+{
+	const bool requested = GetIniBool(L"ModLoading", L"background_reload", false, nullptr);
+	const bool usable = requested && state.mode != PreparationMode::Off &&
+		state.generalEnabled && state.transactionalActivation;
+	if (requested && !usable)
+		LogOverlayW(LOG_INFO, L"ModLoading background_reload requires general_fast_refresh and transactional_activation; F10 uses the full reload\n");
+	auto& control = BackgroundControl();
+	std::lock_guard<std::mutex> lock(control.mutex);
+	control.enabled = usable;
+	control.requested = control.active = false;
+}
+
+bool BackgroundReloadClaims(uint64_t candidateId)
+{
+	auto& control = BackgroundControl();
+	std::lock_guard<std::mutex> lock(control.mutex);
+	return control.active && candidateId >= control.minimumCandidate;
+}
+
+void BackgroundReloadFallback(uint64_t candidateId, const std::string& reason)
+{
+	auto& control = BackgroundControl();
+	{
+		std::lock_guard<std::mutex> lock(control.mutex);
+		if (!control.active || candidateId < control.minimumCandidate)
+			return;
+		control.active = false;
+	}
+	control.forceLegacy.store(true);
+	LogOverlayW(LOG_INFO, L"> Background reload unavailable (%S); running full reload\n", reason.c_str());
+	// Consumed by the next RunFrameActions; ForceLegacyReload makes it synchronous.
+	G->gReloadConfigPending = true;
+}
+
+void BackgroundReloadPublished(uint64_t candidateId)
+{
+	auto& control = BackgroundControl();
+	std::chrono::steady_clock::time_point requestedAt;
+	{
+		std::lock_guard<std::mutex> lock(control.mutex);
+		if (!control.active || candidateId < control.minimumCandidate)
+			return;
+		control.active = false;
+		requestedAt = control.requestedAt;
+	}
+	const std::chrono::duration<float> elapsed = std::chrono::steady_clock::now() - requestedAt;
+	LogOverlayW(LOG_INFO, L"> Reloaded config in background in %.3fs\n", elapsed.count());
+}
+
+// Owner thread, inside PumpRuntimeImpl with the planner lock held.
+void PumpBackgroundReload(const std::shared_ptr<RuntimeState>& state, DeviceEpoch epoch)
+{
+	auto& control = BackgroundControl();
+	const auto now = std::chrono::steady_clock::now();
+	bool schedule = false, timedOut = false;
+	uint64_t minimum = 0;
+	{
+		std::lock_guard<std::mutex> lock(control.mutex);
+		if (control.requested) {
+			control.requested = false;
+			control.active = true;
+			control.deadline = now + BackgroundReloadTimeout;
+			const auto& pending = Services().pendingGeneral;
+			// An already valid candidate was verified against the current watched
+			// sources; PumpGeneralConfiguration rechecks that proof every frame.
+			if (pending && pending->valid) {
+				control.minimumCandidate = pending->id;
+			} else {
+				control.minimumCandidate = Services().nextGeneration.load() + 1;
+				schedule = true;
+			}
+		} else if (control.active && now > control.deadline) {
+			timedOut = true;
+			minimum = control.minimumCandidate;
+		}
+	}
+	if (schedule && state->monitor) {
+		ReconcileRequest request;
+		request.token = state->monitor->CurrentToken();
+		request.fullReconcile = true; // forceFull: re-read every source like F10
+		ScheduleGeneralBuild(state, request, epoch);
+	}
+	if (timedOut)
+		BackgroundReloadFallback(minimum, "no complete candidate within the timeout");
+}
+
+bool BackgroundWorkerCreation(PreparationPlanner& planner, ID3D11Device* device,
+	const GpuPumpLimits& limits, GpuPumpResult& result)
+{
+	if (!device || (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED) ||
+		!planner.WorkerCreationAvailable())
+		return false;
+	// Each worker creation holds the same creation-mode lock as legacy
+	// resource creation, for one driver call at a time. The render thread can
+	// wait for at most that call; this is a measured risk, not a guarantee.
+	result = planner.PumpWorker(limits, [](const std::function<void()>& create) {
+		LockResourceCreationMode();
+		struct Unlock { ~Unlock() { UnlockResourceCreationMode(); } } unlock;
+		create();
+	});
+	return true;
+}
+
+// Incremental release of retired generations. Fixed slots: no allocation on
+// the render thread. A full table keeps the original one-shot destructor path.
+struct IncrementalRelease {
+	std::shared_ptr<ConfigGenerationPin> graph;
+	ID3D11Device* device = nullptr; // Identity only; never dereferenced here.
+	std::thread::id owner;
+	bool started = false;
+	decltype(ConfigurationState::resources)::iterator resource;
+	decltype(ConfigurationState::shaders)::iterator shader;
+};
+std::mutex& IncrementalReleaseMutex()
+{
+	static auto* mutex = new std::mutex;
+	return *mutex;
+}
+std::array<IncrementalRelease, 4>& IncrementalReleaseSlots()
+{
+	static auto* slots = new std::array<IncrementalRelease, 4>;
+	return *slots;
+}
+
+void QueueIncrementalRelease(std::shared_ptr<ConfigGenerationPin>& graph, ID3D11Device* device, std::thread::id owner)
+{
+	if (!graph || !*graph)
+		return;
+	{
+		auto& control = BackgroundControl();
+		std::lock_guard<std::mutex> lock(control.mutex);
+		if (!control.enabled)
+			return;
+	}
+	std::lock_guard<std::mutex> lock(IncrementalReleaseMutex());
+	for (auto& slot : IncrementalReleaseSlots()) {
+		if (slot.graph)
+			continue;
+		slot.graph = std::move(graph);
+		slot.device = device;
+		slot.owner = owner;
+		slot.started = false;
+		return;
+	}
+}
+
+void ReleaseResourceChildren(CustomResource& resource)
+{
+	if (resource.view) { resource.view->Release(); resource.view = nullptr; }
+	if (resource.resource) { resource.resource->Release(); resource.resource = nullptr; }
+	resource.preparation_pin.reset();
+	resource.substantiated = false;
+}
+
+void ReleaseShaderChildren(CustomShader& shader)
+{
+#define RELEASE_CHILD(Member) if (shader.Member) { shader.Member->Release(); shader.Member = nullptr; }
+	RELEASE_CHILD(vs) RELEASE_CHILD(hs) RELEASE_CHILD(ds)
+	RELEASE_CHILD(gs) RELEASE_CHILD(ps) RELEASE_CHILD(cs)
+	RELEASE_CHILD(blend_state) RELEASE_CHILD(depth_stencil_state)
+	RELEASE_CHILD(rs_state) RELEASE_CHILD(sampler_state)
+#undef RELEASE_CHILD
+	shader.preparation_pin.reset();
+	shader.substantiated = false;
+}
+
+// Set while this thread's PumpIncrementalRelease holds IncrementalReleaseMutex(). A COM
+// Release() inside the pump can reenter a drain on the same thread, and try_lock on a
+// std::mutex the caller already owns is undefined behaviour, so reentry is detected here.
+thread_local bool pumpHoldsReleaseLock = false;
+
+std::atomic<bool>& IncrementalDrainRequested()
+{
+	static std::atomic<bool> requested{false};
+	return requested;
+}
+
+// Moves every queued graph out of the slots; caller holds IncrementalReleaseMutex().
+void TakeAllIncrementalReleases(std::array<std::shared_ptr<ConfigGenerationPin>, 4>& drained)
+{
+	size_t index = 0;
+	for (auto& slot : IncrementalReleaseSlots()) {
+		if (!slot.graph)
+			continue;
+		drained[index++].swap(slot.graph);
+		slot = IncrementalRelease();
+	}
+}
+
+// Owner thread, every Present. Releases at most IncrementalReleasePerFrame
+// resource/shader entries; the remaining CPU-only teardown keeps Disposal().
+void PumpIncrementalRelease(ID3D11Device* device)
+{
+	std::shared_ptr<ConfigGenerationPin> finished;
+	std::array<std::shared_ptr<ConfigGenerationPin>, 4> drained;
+	{
+		if (pumpHoldsReleaseLock)
+			return; // Reentered from a Release() below; the outer pump continues.
+		std::unique_lock<std::mutex> lock(IncrementalReleaseMutex(), std::try_to_lock);
+		if (!lock.owns_lock())
+			return;
+		pumpHoldsReleaseLock = true;
+		struct ClearFlag { ~ClearFlag() { pumpHoldsReleaseLock = false; } } clearFlag;
+		// A drain that could not take the lock (see DrainIncrementalRelease) is done here.
+		if (IncrementalDrainRequested().exchange(false))
+			TakeAllIncrementalReleases(drained);
+		size_t budget = IncrementalReleasePerFrame;
+		for (auto& slot : IncrementalReleaseSlots()) {
+			if (!slot.graph || !budget)
+				continue;
+			// Checked before the owner thread: a replacement owner/device must still reach this
+			// cleanup, or the slot would pin the retired graph indefinitely.
+			if (slot.device && slot.device != device) {
+				// Device recreated: no pacing benefit; keep the original release.
+				finished.swap(slot.graph);
+				slot = IncrementalRelease();
+				break;
+			}
+			if (slot.owner != std::this_thread::get_id())
+				continue;
+			auto& graph = **slot.graph;
+			if (!slot.started) {
+				slot.resource = graph.resources.begin();
+				slot.shader = graph.shaders.begin();
+				slot.started = true;
+			}
+			for (; budget && slot.resource != graph.resources.end(); ++slot.resource, --budget)
+				ReleaseResourceChildren(slot.resource->second);
+			for (; budget && slot.shader != graph.shaders.end(); ++slot.shader, --budget)
+				ReleaseShaderChildren(slot.shader->second);
+			if (slot.resource == graph.resources.end() && slot.shader == graph.shaders.end()) {
+				finished.swap(slot.graph);
+				slot = IncrementalRelease();
+				break;
+			}
+		}
+	}
+	finished.reset(); // Outside the lock; the outer pin's deleter is asynchronous.
+	for (auto& graph : drained)
+		graph.reset();
+}
+
+// Any thread. Hands every queued graph back to the normal
+// Disposal() release, like the device-recreated case above. Called when the runtime
+// device is retired and when a legacy reload disables background reload, so slots never
+// wait for a Present that may not come and all four are free again afterwards. At process
+// exit the (intentionally leaked) slots are not drained; process teardown releases them.
+// Never blocks: a COM Release() inside PumpIncrementalRelease (which holds the mutex) can
+// reenter RetireRuntimeDevice on the same thread. On that thread the mutex is not touched
+// (see pumpHoldsReleaseLock); if it is busy on another thread, the drain is left to the next
+// pump, which takes every slot before releasing anything else.
+void DrainIncrementalRelease()
+{
+	std::array<std::shared_ptr<ConfigGenerationPin>, 4> drained;
+	{
+		if (pumpHoldsReleaseLock) {
+			IncrementalDrainRequested().store(true);
+			return;
+		}
+		std::unique_lock<std::mutex> lock(IncrementalReleaseMutex(), std::try_to_lock);
+		if (!lock.owns_lock()) {
+			IncrementalDrainRequested().store(true);
+			return;
+		}
+		IncrementalDrainRequested().store(false);
+		TakeAllIncrementalReleases(drained);
+	}
+	for (auto& graph : drained)
+		graph.reset(); // Outside the lock; the outer pin's deleter is asynchronous.
+}
+} // namespace
+
+void NoteReloadKeyPressed()
+{
+	BackgroundControl().keyPressed.store(true);
+}
+
+void ForceLegacyReload()
+{
+	BackgroundControl().forceLegacy.store(true);
+}
+
+bool TryBeginBackgroundReload(ID3D11Device* realDevice)
+{
+	try {
+		auto& control = BackgroundControl();
+		// Always consume both edges so a stale press never diverts a later reload.
+		const bool keyPressed = control.keyPressed.exchange(false);
+		const bool forced = control.forceLegacy.exchange(false);
+		if (!keyPressed || forced || G->gWipeUserConfig || !realDevice ||
+			(realDevice->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED))
+			return false;
+		auto state = Current();
+		if (!state || !state->enabled.load() || !state->generalEnabled || state->generalAdmissionBlocked ||
+			!state->semanticBuilder || !state->config || !state->monitor || !state->gpuEnabled || !state->generalGpuBytes)
+			return false;
+		{
+			std::lock_guard<std::mutex> lock(control.mutex);
+			if (!control.enabled)
+				return false;
+			control.requested = true;
+			control.requestedAt = std::chrono::steady_clock::now();
+		}
+		LogOverlayW(LOG_INFO, L"> Background reload requested; current mods stay active\n");
+		return true;
+	} catch (...) {
+		return false;
+	}
+}
