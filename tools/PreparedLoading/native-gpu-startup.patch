+bool PreparationPlanner::UnderMemoryPressure() const {
+	if (!OnOwner()) return false;
+	const auto sample = QueryBudget();
+	return sample.available && (sample.currentUsage >= sample.budget ||
+		safetyHeadroom_ > sample.budget - sample.currentUsage);
+}
+void PreparationPlanner::EvictUnused() {
