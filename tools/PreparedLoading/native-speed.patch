+bool CpuAssetCache::ReserveUnused(size_t bytes, Generation minimum) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	// Retired generations cannot satisfy a current lookup. Reclaim them once
+	// unpinned, while still accounting for old snapshots held by live callers.
+	for (auto it = entries_.begin(); it != entries_.end();)
+		if (it->first.second < minimum && Unpinned(it->second.asset)) {
+			resident_ -= it->second.asset->ByteSize();
+			it = entries_.erase(it);
+		} else ++it;
+	if (bytes > capacity_ || resident_ > capacity_ - bytes || reserved_ > capacity_ - bytes - resident_) return false;
+	reserved_ += bytes;
+	return true;
