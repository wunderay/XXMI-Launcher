+// Keep DDS pixels, format, dimensions and mip levels unchanged. Separate
+// ordinary file IO from the driver upload; neither is measured by WIC decode.
+static HRESULT LoadDDSWithTrace(ID3D11Device* device, const std::wstring& filename,
+    unsigned bindFlags, unsigned miscFlags, bool forceSRGB, ID3D11Resource** resource, uint64_t objectId)
+{
+    std::unique_ptr<uint8_t[]> bytes;
+    DWORD size = 0;
+    {
+        ModLoading::ScopedLoadTrace read(ModLoading::LoadStage::FileRead, objectId);
+        HANDLE file = CreateFileW(filename.c_str(), GENERIC_READ, FILE_SHARE_READ,
+            nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE) { const HRESULT hr = HRESULT_FROM_WIN32(GetLastError()); read.SetResult(hr); return hr; }
+        struct CloseFile { HANDLE value; ~CloseFile() { CloseHandle(value); } } close{file};
+        LARGE_INTEGER length = {};
+        if (!GetFileSizeEx(file, &length)) { const HRESULT hr = HRESULT_FROM_WIN32(GetLastError()); read.SetResult(hr); return hr; }
+        if (length.QuadPart < 128 || length.QuadPart > MAXDWORD) { read.SetResult(E_FAIL); return E_FAIL; }
+        size = static_cast<DWORD>(length.QuadPart);
+        bytes.reset(new (std::nothrow) uint8_t[size]);
+        if (!bytes) { read.SetResult(E_OUTOFMEMORY); return E_OUTOFMEMORY; }
+        DWORD got = 0;
+        if (!ReadFile(file, bytes.get(), size, &got, nullptr)) { const HRESULT hr = HRESULT_FROM_WIN32(GetLastError()); read.SetResult(hr); return hr; }
+        read.SetBytes(got);
+        if (got != size) { read.SetResult(E_FAIL); return E_FAIL; }
+        read.SetResult(S_OK);
+    }
+    ModLoading::ScopedLoadTrace create(ModLoading::LoadStage::GpuCreation, objectId);
+    const HRESULT hr = DirectX::CreateDDSTextureFromMemoryEx(device, bytes.get(), size, 0,
+        D3D11_USAGE_DEFAULT, bindFlags, 0, miscFlags, forceSRGB, resource, nullptr, nullptr);
+    create.SetResult(hr); create.SetBytes(size); return hr;
+}
