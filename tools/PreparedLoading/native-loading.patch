+static bool TryCompileVerifiedLegacyShader(const wchar_t* source, char type,
+    UINT flags, const D3D_SHADER_MACRO* macros, ID3DBlob** bytecode, uint64_t objectId)
+{
+    try {
+        static ModLoading::ResourceRefreshCpuBudget budget(64 * 1024 * 1024);
+        static std::unique_ptr<ModLoading::ShaderDiskCache> cache([] {
+            HMODULE module = nullptr;
+            wchar_t path[32768] = {};
+            if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                reinterpret_cast<LPCWSTR>(&TryCompileVerifiedLegacyShader), &module))
+                return static_cast<ModLoading::ShaderDiskCache*>(nullptr);
+            const DWORD size = GetModuleFileNameW(module, path, 32768);
+            FreeLibrary(module);
+            if (!size || size >= 32768) return static_cast<ModLoading::ShaderDiskCache*>(nullptr);
+            std::wstring directory(path, size);
+            const auto slash = directory.find_last_of(L"\\/");
+            if (slash == std::wstring::npos) return static_cast<ModLoading::ShaderDiskCache*>(nullptr);
+            directory.resize(slash);
+            return new ModLoading::ShaderDiskCache(directory + L"\\.xxmi-shader-cache", 64 * 1024 * 1024, 512);
+        }());
+        if (!cache) return false;
+        wchar_t cwd[32768] = {};
+        const DWORD cwdSize = GetCurrentDirectoryW(32768, cwd);
+        if (!cwdSize || cwdSize >= 32768) return false;
+        ModLoading::ShaderCompileRequest request;
+        request.sourcePath = source; request.workingDirectory.assign(cwd, cwdSize);
+        char target[8] = {}, sourceName[MAX_PATH] = {};
+        _snprintf_s(target, sizeof(target), _TRUNCATE, "%cs_5_0", type);
+        const size_t sourceLength = wcstombs(sourceName, source, MAX_PATH);
+        if (sourceLength == size_t(-1) || sourceLength >= MAX_PATH) return false;
+        request.sourceName = sourceName; request.target = target; request.flags = flags;
+        request.recursiveIncludes = G->recursive_include;
+        for (auto macro = macros; macro && macro->Name; ++macro)
+            request.defines.emplace_back(macro->Name, macro->Definition ? macro->Definition : "");
+        ModLoading::ScopedLoadTrace trace(ModLoading::LoadStage::ShaderPreparation, objectId);
+        ModLoading::PreparedShaderBytecode prepared;
+        std::string error;
+        if (!ModLoading::PrepareD3DShader(request, budget, cache.get(), prepared, error)) return false;
+        const HRESULT result = D3DCreateBlob(prepared.bytecode.size(), bytecode);
+        trace.SetResult(result); trace.SetBytes(prepared.bytecode.size());
+        if (FAILED(result)) return false;
+        memcpy((*bytecode)->GetBufferPointer(), prepared.bytecode.data(), prepared.bytecode.size());
+        if (prepared.cacheHit)
+            ModLoading::LoadTrace::Get().RecordInstant(ModLoading::LoadStage::ShaderCacheHit, objectId, prepared.bytecode.size(), 0);
+        return true;
+    } catch (...) { return false; } // Original compiler remains the compatibility fallback.
+}
