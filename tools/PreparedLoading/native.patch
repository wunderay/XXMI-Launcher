index 0000000000000000000000000000000000000000..6fdcfa0c12efa7713f4c07c6a0ad510a80533277
--- /dev/null
+++ b/tests/d3d11_fixture/oracle.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+namespace fixture {
+constexpr unsigned width = 64, height = 64;
+using Pixel = std::array<uint8_t, 4>;
+// Exact UNORM-friendly values. Quadrants distinguish UV/axis/orientation errors.
+inline Pixel texel(unsigned outfit, unsigned x, unsigned y) {
+    if (outfit > 2 || x > 1 || y > 1) throw std::invalid_argument("texel range");
+    const unsigned q = y * 2 + x;
+    const Pixel palettes[3][4] = {
+        {{240,0,0,255},{0,240,0,255},{0,0,240,255},{240,240,240,255}},
+        {{240,240,0,255},{0,240,240,255},{240,0,240,255},{80,160,240,255}},
+        {{80,0,160,255},{160,80,0,255},{0,160,80,255},{160,160,160,255}}
+    };
+    return palettes[outfit][q];
+}
+inline Pixel expected(unsigned outfit, bool dim, unsigned x, unsigned y) {
+    if (x >= width || y >= height) throw std::invalid_argument("pixel range");
+    Pixel p = texel(outfit, x / 32, y / 32);
+    if (dim) for (unsigned c = 0; c < 3; ++c) p[c] /= 2;
+    return p;
+}
+struct Comparison { size_t badPixels = 0; unsigned maxError = 0; };
+inline Comparison compare(const uint8_t* bytes, size_t size, size_t pitch,
+                          unsigned outfit, bool dim) {
+    if (!bytes || pitch < width * 4 || pitch > SIZE_MAX / height || size < pitch * height)
+        throw std::invalid_argument("invalid readback layout");
+    Comparison result;
+    for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+        auto p = expected(outfit, dim, x, y);
+        bool bad = false;
+        for (unsigned c = 0; c < 4; ++c) {
+            int delta = int(bytes[y * pitch + x * 4 + c]) - int(p[c]);
+            unsigned error = unsigned(delta < 0 ? -delta : delta);
+            if (error > result.maxError) result.maxError = error;
+            bad |= error > 1; // D3D UNORM rounding tolerance; alpha included.
+        }
+        result.badPixels += bad;
+    }
+    return result;
+}
+}
