diff --git a/DirectX11/ModLoading/AssetCatalog.cpp b/DirectX11/ModLoading/AssetCatalog.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d81195420000653b77443b4dfe36dc078908b0f4
--- /dev/null
+++ b/DirectX11/ModLoading/AssetCatalog.cpp
@@ -0,0 +1,42 @@
+#include "AssetCatalog.h"
+#include <set>
+namespace ModLoading {
+uint64_t AssetCatalog::Register(const std::wstring &path, Generation generation,
+								const std::vector<uint64_t> &dependencies) {
+	if (path.empty() || path.size() > 32767 || dependencies.size() > 64)
+		return 0;
+	std::lock_guard<std::mutex> lock(mutex_);
+	std::set<uint64_t> known;
+	for (const auto &r : records_)
+		known.insert(r.second.id);
+	for (uint64_t d : dependencies)
+		if (!known.count(d))
+			return 0;
+	auto it = records_.find(path);
+	if (it == records_.end()) {
+		if (records_.size() >= maximum_)
+			return 0;
+		AssetRecord r;
+		r.id = ++next_;
+		r.path = path;
+		r.generation = generation;
+		r.dependencies = dependencies;
+		return records_.emplace(path, std::move(r)).first->second.id;
+	}
+	it->second.generation = generation;
+	it->second.dependencies = dependencies;
+	return it->second.id;
+}
+std::vector<AssetRecord> AssetCatalog::Records() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	std::vector<AssetRecord> r;
+	r.reserve(records_.size());
+	for (const auto &p : records_)
+		r.push_back(p.second);
+	return r;
+}
+void AssetCatalog::Clear() {
+	std::lock_guard<std::mutex> lock(mutex_);
+	records_.clear();
+}
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/AssetCatalog.h b/DirectX11/ModLoading/AssetCatalog.h
new file mode 100644
index 0000000000000000000000000000000000000000..acf7cb7aa75d9346ee6f70ea0c6e4473888d68b0
--- /dev/null
+++ b/DirectX11/ModLoading/AssetCatalog.h
@@ -0,0 +1,29 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <map>
+#include <mutex>
+namespace ModLoading {
+struct AssetRecord {
+	uint64_t id = 0;
+	std::wstring path;
+	Generation generation = 0;
+	std::vector<uint64_t> dependencies;
+};
+
+class AssetCatalog {
+public:
+	explicit AssetCatalog(size_t maximum = 65536) : maximum_(maximum) {}
+
+	// IDs are stable within a catalog; all dependencies must already be registered.
+	uint64_t Register(const std::wstring& path, Generation generation,
+		const std::vector<uint64_t>& dependencies = {});
+	std::vector<AssetRecord> Records() const;
+	void Clear();
+
+private:
+	mutable std::mutex mutex_;
+	size_t maximum_;
+	uint64_t next_ = 0;
+	std::map<std::wstring, AssetRecord> records_;
+};
+}
