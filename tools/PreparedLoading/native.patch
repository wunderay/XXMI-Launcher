+// A slot is reserved when an object is allocated, so its final deleter never
+// allocates or joins a watcher on a rendering thread. Capacity is bounded.
+class RuntimeDisposal {
+	struct Slot {
+		void* object = nullptr;
+		void (*destroy)(void*) = nullptr;
+		bool occupied = false, ready = false;
+	};
+	std::array<Slot, 32> slots_;
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	std::thread worker_;
+public:
+	RuntimeDisposal() : worker_([this] {
+		for (;;) {
+			size_t index = 0;
+			Slot work;
+			{
+				std::unique_lock<std::mutex> lock(mutex_);
+				wake_.wait(lock, [&] {
+					for (const auto& slot : slots_)
+						if (slot.ready)
+							return true;
+					return false;
+				});
+				for (; index < slots_.size(); ++index)
+					if (slots_[index].ready)
+						break;
+				work = slots_[index];
+				slots_[index].ready = false;
+			}
+			work.destroy(work.object);
+			{
+				std::lock_guard<std::mutex> lock(mutex_);
+				slots_[index] = {};
+			}
+		}
+	})
+	{}
+	template<class T> std::shared_ptr<T> Make() {
+		size_t index = 0;
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			for (; index < slots_.size(); ++index)
+				if (!slots_[index].occupied)
+					break;
+			if (index == slots_.size())
+				throw std::bad_alloc();
+			slots_[index].occupied = true;
+		}
+		T* object = nullptr;
+		try {
+			object = new T;
+		} catch (...) {
+			std::lock_guard<std::mutex> lock(mutex_);
+			slots_[index] = {};
+			throw;
+		}
+		return std::shared_ptr<T>(object, [this, index](T* pointer) {
+			{
+				std::lock_guard<std::mutex> lock(mutex_);
+				slots_[index].object = pointer;
+				slots_[index].destroy = [](void* p) { delete static_cast<T*>(p); };
+				slots_[index].ready = true;
+			}
+			wake_.notify_one();
+		});
+	}
+};
+RuntimeDisposal& Disposal()
+{
+	static RuntimeDisposal* disposal = [] {
+		static int anchor;
+		HMODULE module = nullptr;
+		if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+			reinterpret_cast<LPCWSTR>(&anchor), &module)) throw std::bad_alloc();
+		return new RuntimeDisposal;
+	}();
+	return *disposal;
