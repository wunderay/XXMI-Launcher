+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <vector>
+namespace ModLoading {
+// Same explicit PNG sRGB intent used by the legacy file probe, evaluated from
+// immutable source bytes. Every chunk length is bounded before pointer access.
+inline bool HasPngSRGBChunk(const std::vector<uint8_t>& bytes) {
+    static const uint8_t signature[] = {137,80,78,71,13,10,26,10};
+    if (bytes.size() < sizeof(signature) ||
+        std::memcmp(bytes.data(), signature, sizeof(signature))) return false;
+    for (size_t at = 8; bytes.size() - at >= 12;) {
+        const uint64_t count = (uint64_t(bytes[at]) << 24) |
+            (uint64_t(bytes[at + 1]) << 16) | (uint64_t(bytes[at + 2]) << 8) | bytes[at + 3];
+        if (count > bytes.size() - at - 12) return false;
+        if (!std::memcmp(bytes.data() + at + 4, "sRGB", 4)) return true;
+        if (!std::memcmp(bytes.data() + at + 4, "IEND", 4)) return false;
+        at += static_cast<size_t>(count) + 12;
+    }
+    return false;
+}
+// Conservative target-view reuse: only a full, typed, non-array Texture2D
+// view is admitted. Zero format inherits the typed resource format; UINT_MAX
+// mip count means every available mip, as in the legacy descriptor builder.
+inline bool FullTexture2DViewMatches(uint32_t resourceFormat, uint32_t resourceMips,
+    uint32_t requestedFormat, uint32_t requestedFirst, uint32_t requestedMips,
+    uint32_t preparedFormat, uint32_t preparedFirst, uint32_t preparedMips) {
+    if (!resourceFormat || !resourceMips || requestedFirst || preparedFirst) return false;
+    if (!requestedFormat) requestedFormat = resourceFormat;
+    if (!preparedFormat) preparedFormat = resourceFormat;
+    if (requestedMips == UINT32_MAX) requestedMips = resourceMips;
+    if (preparedMips == UINT32_MAX) preparedMips = resourceMips;
+    return requestedFormat == preparedFormat && requestedMips == resourceMips &&
+        preparedMips == resourceMips;
+}
+
+}
