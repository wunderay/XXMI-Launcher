@@ -0,0 +1,440 @@
+// Standalone Windows regression host. WARP is this fixture's real rendering
+// device, never a device used to prepare resources for another game device.
+#include "PreparationPlanner.h"
+#include "SnapshotIO.h"
+#include <d3dcompiler.h>
+#include <objbase.h>
+#include <wrl/client.h>
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <thread>
+using namespace ModLoading;
+using Microsoft::WRL::ComPtr;
+namespace {
+struct Apartment {
+    Apartment() { assert(SUCCEEDED(CoInitializeEx(nullptr, COINIT_MULTITHREADED))); }
+    ~Apartment() { CoUninitialize(); }
+};
+SourceSnapshot Snapshot(const std::vector<uint8_t>& bytes) {
+    SourceSnapshot snapshot;
+    snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(bytes);
+    snapshot.digest = HashBytes(bytes.data(), bytes.size());
+    return snapshot;
+}
+ComPtr<ID3D11Device> Device(UINT flags, ComPtr<ID3D11DeviceContext>& context) {
+    ComPtr<ID3D11Device> device;
+    const HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, flags,
+        nullptr, 0, D3D11_SDK_VERSION, device.GetAddressOf(), nullptr, context.GetAddressOf());
+    assert(SUCCEEDED(hr)); return device;
+}
+SharedShaderBytecode CompileStage(const char* source, const char* profile) {
+    ComPtr<ID3DBlob> bytecode, errors;
+    const HRESULT hr = D3DCompile(source, std::strlen(source), nullptr, nullptr, nullptr,
+        "main", profile, 0, 0, bytecode.GetAddressOf(), errors.GetAddressOf());
+    if (FAILED(hr) && errors)
+        std::cerr << profile << ": " << static_cast<const char*>(errors->GetBufferPointer()) << std::endl;
+    assert(SUCCEEDED(hr));
+    const auto* bytes = static_cast<const uint8_t*>(bytecode->GetBufferPointer());
+    auto retained = SharedShaderBytecode::Retain(bytecode.Get(), HashBytes(bytes, bytecode->GetBufferSize()));
+    assert(retained); return retained;
+}
+void Created(PreparationPlanner& planner) {
+    GpuPumpLimits limits; limits.operations = 8; limits.bytes = 16 * 1024 * 1024; limits.milliseconds = 1000;
+    const auto pumped = planner.Pump(true, limits);
+    assert(pumped.created == 1 && !pumped.failed && !pumped.deviceRemoved && !pumped.compatibilitySkipped);
+}
+void TestAggregateRefreshBudget() {
+    ComPtr<ID3D11DeviceContext> context; auto device = Device(0, context);
+    const auto epoch = AllocateDeviceEpoch();
+    const uint64_t estimate = 65552, limit = 9 * estimate;
+    auto aggregate = std::make_shared<LiveGpuAllocationLedger>();
+    auto requestFor = [&](uint8_t value) {
+        GpuPreparationRequest request;
+        request.snapshot = Snapshot(std::vector<uint8_t>(16, value));
+        request.buffer.ByteWidth = 16; request.buffer.Usage = D3D11_USAGE_IMMUTABLE;
+        request.buffer.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+        request.dependencyReadOnly = true; request.estimatedBytes = estimate;
+        request.retainedBudget = aggregate; request.retainedBudgetLimit = limit; return request;
+    };
+    std::vector<std::unique_ptr<PreparationPlanner>> generations;
+    std::vector<std::shared_ptr<PreparedGpuObject>> readers;
+    for (uint8_t generation = 1; generation <= 9; ++generation) {
+        auto planner = std::make_unique<PreparationPlanner>(limit);
+        assert(planner->BeginDevice(device.Get(), epoch));
+        DeviceResourceKey key; assert(planner->Enqueue(requestFor(generation), &key) == GpuQueueResult::Queued);
+        assert(aggregate->Bytes() == generation * estimate); // reservations count before allocation
+        Created(*planner); readers.push_back(planner->TryAcquire(key)); assert(readers.back());
+        generations.push_back(std::move(planner));
+    }
+    assert(aggregate->Bytes() == limit);
+    PreparationPlanner next(limit); assert(next.BeginDevice(device.Get(), epoch));
+    auto candidate = requestFor(10); DeviceResourceKey chargedKey, unchargedKey;
+    assert(next.ComputeKey(candidate, chargedKey));
+    auto uncharged = candidate; uncharged.retainedBudget.reset(); uncharged.retainedBudgetLimit = 0;
+    assert(next.ComputeKey(uncharged, unchargedKey) && (chargedKey < unchargedKey || unchargedKey < chargedKey));
+    assert(next.Enqueue(candidate) == GpuQueueResult::BudgetBlocked && next.Queued() == 0);
+    PreparationPlanner tooSmall(estimate - 1); assert(tooSmall.BeginDevice(device.Get(), epoch));
+    assert(tooSmall.Enqueue(candidate) == GpuQueueResult::BudgetBlocked); tooSmall.RetireDevice();
+    candidate.retainedBudgetLimit = limit - estimate;
+    assert(next.Enqueue(candidate) == GpuQueueResult::BudgetBlocked); // old objects survive a lowered limit
+    // Queued cancellation rolls back its aggregate reservation without creating.
+    auto canceledBudget = std::make_shared<LiveGpuAllocationLedger>();
+    auto canceled = requestFor(20); canceled.retainedBudget = canceledBudget; canceled.retainedBudgetLimit = estimate;
+    PreparationPlanner cancel(limit); assert(cancel.BeginDevice(device.Get(), epoch));
+    assert(cancel.Enqueue(canceled) == GpuQueueResult::Queued && canceledBudget->Bytes() == estimate);
+    cancel.RetireDevice(); assert(canceledBudget->Bytes() == 0);
+    // A deferred command list retains A after all nine generation/cache/reader
+    // owners disappear. This actual COM lifetime must still consume the limit.
+    ComPtr<ID3D11DeviceContext> deferred; assert(SUCCEEDED(device->CreateDeferredContext(0, deferred.GetAddressOf())));
+    D3D11_BUFFER_DESC desc{}; desc.ByteWidth = 16; desc.Usage = D3D11_USAGE_STAGING; desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Buffer> readback; assert(SUCCEEDED(device->CreateBuffer(&desc, nullptr, readback.GetAddressOf())));
+    deferred->CopyResource(readback.Get(), readers.front()->resource);
+    ComPtr<ID3D11CommandList> commands; assert(SUCCEEDED(deferred->FinishCommandList(FALSE, commands.GetAddressOf()))); deferred.Reset();
+    for (auto& generation : generations) generation->RetireDevice();
+    generations.clear(); readers.clear(); context->ClearState(); context->Flush();
+    assert(aggregate->Bytes() == estimate);
+    candidate.retainedBudgetLimit = estimate;
+    assert(next.Enqueue(candidate) == GpuQueueResult::BudgetBlocked && next.Queued() == 0);
+    context->ExecuteCommandList(commands.Get(), FALSE);
+    D3D11_MAPPED_SUBRESOURCE mapped{}; assert(SUCCEEDED(context->Map(readback.Get(), 0, D3D11_MAP_READ, 0, &mapped)));
+    const std::vector<uint8_t> oldBytes(16, 1); assert(std::memcmp(mapped.pData, oldBytes.data(), oldBytes.size()) == 0);
+    context->Unmap(readback.Get(), 0); commands.Reset(); readback.Reset(); context->ClearState(); context->Flush();
+    assert(aggregate->Bytes() == 0);
+    assert(next.Enqueue(candidate) == GpuQueueResult::Queued); Created(next);
+    assert(aggregate->Bytes() == estimate);
+    next.RetireDevice(); context->ClearState(); context->Flush();
+    context.Reset(); device.Reset(); assert(aggregate->Bytes() == 0);
+}
+}
+int main() {
+    Apartment apartment;
+    TestAggregateRefreshBudget();
+    // Unique compiled-blob ownership is bounded across queue/profile/generation
+    // aliases; retaining the same blob twice never charges its payload twice.
+    assert(SharedShaderBytecode::LiveRetainedBytes() == 0);
+    {
+        ComPtr<ID3DBlob> first, second;
+        assert(SUCCEEDED(D3DCreateBlob(32, first.GetAddressOf())) && SUCCEEDED(D3DCreateBlob(16, second.GetAddressOf())));
+        std::memset(first->GetBufferPointer(), 1, 32); std::memset(second->GetBufferPointer(), 2, 16);
+        const auto firstDigest = HashBytes(static_cast<const uint8_t*>(first->GetBufferPointer()), 32);
+        const auto secondDigest = HashBytes(static_cast<const uint8_t*>(second->GetBufferPointer()), 16);
+        auto oldGeneration = SharedShaderBytecode::Retain(first.Get(), firstDigest, 32);
+        auto alias = SharedShaderBytecode::Retain(first.Get(), firstDigest, 32);
+        assert(oldGeneration && alias && SharedShaderBytecode::LiveRetainedBytes() == 32);
+        assert(!SharedShaderBytecode::Retain(second.Get(), secondDigest, 32));
+        first.Reset(); oldGeneration = {}; assert(SharedShaderBytecode::LiveRetainedBytes() == 32);
+        alias = {}; assert(SharedShaderBytecode::LiveRetainedBytes() == 0);
+        auto nextGeneration = SharedShaderBytecode::Retain(second.Get(), secondDigest, 32);
+        assert(nextGeneration && SharedShaderBytecode::LiveRetainedBytes() == 16);
+        assert(!SharedShaderBytecode::Retain(second.Get(), secondDigest, 0));
+        auto changedDigest = secondDigest; changedDigest[0] ^= 1;
+        assert(!SharedShaderBytecode::Retain(second.Get(), changedDigest, 32));
+    }
+    assert(SharedShaderBytecode::LiveRetainedBytes() == 0);
+    ComPtr<ID3D11DeviceContext> context;
+    auto device = Device(D3D11_CREATE_DEVICE_SINGLETHREADED, context);
+    assert(ProcessGpuAllocationLedger().Bytes() == 0);
+    PreparationPlanner planner;
+    const auto epoch = AllocateDeviceEpoch();
+    assert(planner.BeginDevice(device.Get(), epoch) && planner.SingleThreadedDevice());
+    GpuPreparationRequest buffer;
+    buffer.snapshot = Snapshot({0, 1, 2, 3, 4, 5, 6, 7});
+    buffer.buffer.ByteWidth = 16; buffer.buffer.Usage = D3D11_USAGE_IMMUTABLE;
+    buffer.buffer.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    buffer.buffer.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+    buffer.createShaderResourceView = true;
+    buffer.shaderResourceView.Format = DXGI_FORMAT_R32_TYPELESS;
+    buffer.shaderResourceView.ViewDimension = D3D11_SRV_DIMENSION_BUFFEREX;
+    buffer.shaderResourceView.BufferEx.NumElements = 4;
+    buffer.shaderResourceView.BufferEx.Flags = D3D11_BUFFEREX_SRV_FLAG_RAW;
+    buffer.estimatedBytes = 65552; buffer.dependencyReadOnly = true;
+    struct ScratchBudget {
+        uint64_t used = 0, capacity = 0;
+    } scratch;
+    buffer.reserveCpuScratch = [&](uint64_t bytes) -> std::shared_ptr<const void> {
+        if (bytes > scratch.capacity - scratch.used) return {};
+        scratch.used += bytes;
+        return std::shared_ptr<const void>(new uint64_t(bytes), [&](const void* value) {
+            const auto* count = static_cast<const uint64_t*>(value);
+            scratch.used -= *count;
+            delete count;
+        });
+    };
+    DeviceResourceKey bufferKey;
+    auto withoutAdmission = buffer;
+    withoutAdmission.reserveCpuScratch = {};
+    assert(planner.Enqueue(withoutAdmission) == GpuQueueResult::CompatibilityOnly);
+    assert(planner.Enqueue(buffer) == GpuQueueResult::BudgetBlocked && !scratch.used);
+    // Reject a tiny source's huge descriptor before allocating CPU padding.
+    auto oversized = buffer;
+    oversized.buffer.ByteWidth = 256 * 1024 * 1024;
+    oversized.estimatedBytes = uint64_t(oversized.buffer.ByteWidth) + 65536;
+    scratch.capacity = 32 * 1024 * 1024;
+    PreparationPlanner largePlanner(512ull * 1024 * 1024);
+    assert(largePlanner.BeginDevice(device.Get(), epoch));
+    assert(largePlanner.Enqueue(oversized) == GpuQueueResult::BudgetBlocked && !scratch.used);
+    largePlanner.RetireDevice();
+    scratch.capacity = buffer.buffer.ByteWidth + 512;
+    assert(planner.Enqueue(buffer, &bufferKey) == GpuQueueResult::Queued);
+    assert(scratch.used == scratch.capacity);
+    assert(planner.Pump(false).created == 0 && !planner.TryAcquire(bufferKey));
+    GpuQueueResult workerResult = GpuQueueResult::Queued;
+    std::thread worker([&] { workerResult = planner.Enqueue(buffer); assert(planner.Pump(true).created == 0); });
+    worker.join(); assert(workerResult == GpuQueueResult::WrongThread);
+    Created(planner);
+    assert(!scratch.used);
+    assert(ProcessGpuAllocationLedger().Bytes() == buffer.estimatedBytes);
+    auto prepared = planner.TryAcquire(bufferKey);
+    assert(prepared && prepared->resource && prepared->shaderResourceView);
+    ComPtr<ID3D11Device> owner;
+    prepared->resource->GetDevice(owner.GetAddressOf()); assert(owner.Get() == device.Get()); owner.Reset();
+    assert(planner.Enqueue(buffer) == GpuQueueResult::AlreadyReady);
+    auto different = buffer; different.buffer.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    different.createShaderResourceView = false; different.buffer.MiscFlags = 0;
+    DeviceResourceKey differentKey;
+    assert(planner.Enqueue(different, &differentKey) == GpuQueueResult::Queued);
+    assert(scratch.used == scratch.capacity);
+    assert(differentKey < bufferKey || bufferKey < differentKey);
