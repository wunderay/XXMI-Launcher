+
+namespace ModLoading {
+namespace {
+void StopOwnedCapture(LoadTrace& trace, std::uint64_t session)
+{
+	trace.EndCapture(session);
+}
+}
+
+bool StreamLoadTraceCapture(std::ostream& output, std::uint64_t session,
+						   const LoadTraceStreamLimits& limits)
+{
+	auto& trace = LoadTrace::Get();
+	if (!(session & 1) || limits.maximumBytes < 4096 || !limits.intervalMilliseconds ||
+		!limits.maximumMilliseconds || !limits.finalAttempts) {
+		StopOwnedCapture(trace, session);
+		return false;
+	}
+	const auto started = std::chrono::steady_clock::now();
+	std::uint64_t bytes = 0, written = 0, foreign = 0;
+	std::uint32_t finalAttempts = 0;
+	const char* reason = "stopped";
+	bool failed = false;
+	// The single batch and bounded strings keep worker memory independent of
+	// capture duration. No cumulative in-memory CSV is retained.
+	auto write = [&](const std::string& contents, bool footer) {
+		const auto reserve = footer ? 0u : 2048u;
+		if (bytes + contents.size() + reserve > limits.maximumBytes) return false;
+		output.write(contents.data(), static_cast<std::streamsize>(contents.size()));
+		bytes += contents.size();
+		return output.good();
+	};
+	try {
+		std::ostringstream header;
+		LoadTrace::WriteCsvHeader(header);
+		header << "# capture_begin=" << session << ";accounting=capture_v2\n";
+		if (!write(header.str(), false)) { StopOwnedCapture(trace, session); return false; }
+		LoadTraceRecord batch[128];
+		for (;;) {
+			const auto current = trace.CaptureSession();
+			if (current != session && current != session + 1) {
+				failed = true; reason = "capture_replaced"; break;
+			}
+			// At most one ring worth per tick, even with continuous producers.
+			std::size_t budget = LoadTrace::Capacity;
+			while (budget) {
+				const auto count = trace.Drain(batch, (std::min)(std::size_t(128), budget));
+				if (!count) break;
+				budget -= count;
+				std::ostringstream rows;
+				std::uint64_t matching = 0;
+				for (std::size_t i = 0; i < count; ++i) {
+					if (batch[i].captureSession != session) { ++foreign; continue; }
+					LoadTrace::WriteCsvRecord(rows, batch[i]);
+					++matching;
+				}
+				if (!write(rows.str(), false)) { failed = true; reason = "write_or_size_limit"; break; }
+				written += matching;
+			}
+			if (failed) StopOwnedCapture(trace, session);
+			output.flush();
+			if (!output) { failed = true; reason = "write_failure"; StopOwnedCapture(trace, session); }
+			const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+				std::chrono::steady_clock::now() - started).count();
+			if (static_cast<std::uint64_t>(elapsed) >= limits.maximumMilliseconds) {
+				failed = true; reason = "time_limit"; StopOwnedCapture(trace, session);
+			}
+			if (trace.CaptureSession() != session) {
+				const auto stats = trace.GetCaptureStats(session);
+				if (failed || !stats.session || !stats.outstanding || ++finalAttempts >= limits.finalAttempts) break;
+			}
+			std::this_thread::sleep_for(std::chrono::milliseconds(limits.intervalMilliseconds));
+		}
+		// Close the grace window before the final snapshot. Any scope still
+		// pinned at the bounded deadline is incomplete and cannot publish later.
+		StopOwnedCapture(trace, session);
+		const auto stats = trace.GetCaptureStats(session);
+		// A replaced bank, stolen drain, stale scope, pending publication or any
+		// lost write fails closed. Structural end is distinct from losslessness.
+		const bool lossless = !failed && stats.session == session && !stats.outstanding &&
+			!stats.droppedFull && !stats.droppedContention && !stats.stale &&
+			stats.accepted == stats.drained && stats.drained == written;
+		std::ostringstream footer;
+		footer << "# capture_end=" << session << ";structural_complete=1;lossless=" << (lossless ? 1 : 0)
+			   << ";accepted=" << stats.accepted << ";drained=" << stats.drained
+			   << ";written=" << written << ";dropped_full=" << stats.droppedFull
+			   << ";dropped_contention=" << stats.droppedContention << ";stale=" << stats.stale
+			   << ";outstanding=" << stats.outstanding << ";foreign_discarded=" << foreign
+			   << ";accounting_available=" << (stats.session == session ? 1 : 0)
+			   << ";reason=" << reason << '\n';
+		if (!write(footer.str(), true)) return false;
+		output.flush();
+		return lossless && output.good();
+	} catch (...) {
+		StopOwnedCapture(trace, session);
+		return false;
+	}
+}
+
+#ifdef _WIN32
+namespace {
+std::atomic<bool> exporting(false);
+std::atomic_flag configureLock = ATOMIC_FLAG_INIT;
+struct WorkerArguments { HMODULE module; std::uint64_t session; };
+WorkerArguments arguments; // protected until exporting returns false
+
+DWORD WINAPI ExportWorker(void* parameter)
+{
+	const WorkerArguments args = *static_cast<WorkerArguments*>(parameter);
+	bool complete = false;
+	try {
+		wchar_t path[32768];
+		const DWORD length = GetModuleFileNameW(args.module, path, 32768);
+		if (length && length < 32768) {
+			std::wstring filename(path, length);
+			const auto slash = filename.find_last_of(L"\\/");
+			if (slash != std::wstring::npos) {
+				filename.resize(slash + 1);
+				filename += L"mod-load-trace-" + std::to_wstring(GetCurrentProcessId())
+					+ L"-" + std::to_wstring(args.session) + L"-" + std::to_wstring(GetTickCount64()) + L".csv";
+				std::ofstream output(filename.c_str(), std::ios::binary | std::ios::out | std::ios::trunc);
+				if (output) {
+					complete = StreamLoadTraceCapture(output, args.session);
+					output.close();
+					complete = complete && !output.fail();
+				}
+			}
+		}
+	} catch (...) {}
+	StopOwnedCapture(LoadTrace::Get(), args.session);
+	if (!complete) OutputDebugStringW(L"XXMI mod-load trace capture incomplete; inspect capture loss counters.\n");
+	exporting.store(false, std::memory_order_release);
+	FreeLibraryAndExitThread(args.module, 0);
+}
+}
+
+bool ConfigureLoadTrace(bool enabled) noexcept
+{
+	// Configuration calls may overlap, but never wait while holding loader lock.
+	if (configureLock.test_and_set(std::memory_order_acquire)) return false;
+	auto& trace = LoadTrace::Get();
+	bool result = true;
+	if (!enabled) {
+		if (exporting.load(std::memory_order_acquire))
+			trace.RequestEndCapture(arguments.session);
+		else trace.SetEnabled(false);
+	}
+	else if (exporting.load(std::memory_order_acquire)) {
+		// Re-reading the enabled setting during reload is idempotent. A stop
+		// request changes the session token, so finalization cannot restart.
+		result = trace.CaptureSession() == arguments.session;
+	}
+	else {
+		HMODULE module = NULL;
+		if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+				reinterpret_cast<LPCWSTR>(&ExportWorker), &module)) result = false;
+		else {
+			trace.SetEnabled(true);
+			if (!trace.IsEnabled()) { FreeLibrary(module); result = false; }
+			else {
+				arguments = {module, trace.CaptureSession()};
+				exporting.store(true, std::memory_order_release);
+				HANDLE worker = CreateThread(NULL, 0, ExportWorker, &arguments, 0, NULL);
+				if (worker) CloseHandle(worker);
+				else {
+					trace.SetEnabled(false);
+					exporting.store(false, std::memory_order_release);
+					FreeLibrary(module);
+					result = false;
+				}
+			}
+		}
+	}
+	configureLock.clear(std::memory_order_release);
+	return result;
+}
+#else
+bool ConfigureLoadTrace(bool) noexcept { return false; }
+#endif
+}
diff --git a/DirectX11/ModLoading/TraceControl.h b/DirectX11/ModLoading/TraceControl.h
new file mode 100644
index 0000000000000000000000000000000000000000..6ed414aa9a842bb227d46585275a1fa0a9508fe6
--- /dev/null
+++ b/DirectX11/ModLoading/TraceControl.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <iosfwd>
+
+namespace ModLoading {
+// Worker-only streaming entry point. The owner starts an enabled capture before
+// calling, and requests graceful stop with RequestEndCapture(session). Direct
+// SetEnabled(false) stops immediately. No collector DLL ABI is implied.
+// Limits include a reserved footer allowance; failure never reports lossless.
+struct LoadTraceStreamLimits {
+	std::uint64_t maximumBytes = 64 * 1024 * 1024;
+	std::uint64_t maximumMilliseconds = 10 * 60 * 1000;
+	std::uint32_t intervalMilliseconds = 100;
+	std::uint32_t finalAttempts = 10;
+};
+bool StreamLoadTraceCapture(std::ostream& output, std::uint64_t session,
+						   const LoadTraceStreamLimits& limits = LoadTraceStreamLimits());
+
+// Configuration-only. Enable starts a dedicated, module-pinned streaming worker;
+// disable requests finalization. An active/finalizing worker owns its session:
+// repeated enable is idempotent while active; enable during finalization fails.
+// Already pinned scopes get a bounded worker-side grace window. No detach join.
+// False means the request could not start; async file failures disable capture.
+bool ConfigureLoadTrace(bool enabled) noexcept;
+}
diff --git a/DirectX11/ModLoading/WorkingSetPolicy.cpp b/DirectX11/ModLoading/WorkingSetPolicy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1431cbb31a6fd03c8323b84c7eea99d4c2c8637a
--- /dev/null
+++ b/DirectX11/ModLoading/WorkingSetPolicy.cpp
@@ -0,0 +1,180 @@
+#include "WorkingSetPolicy.h"
+#include <algorithm>
+#include <limits>
+namespace ModLoading {
+WorkingSetPolicy::WorkingSetPolicy(WorkingSetLimits limits) : limits_(limits) {
+	// Configuration can lower these ceilings, never remove the memory bound.
+	limits_.assets = std::min<size_t>(limits_.assets, 8192);
+	limits_.dependenciesPerAsset = std::min<size_t>(limits_.dependenciesPerAsset, 64);
+	limits_.idCharacters = std::min<size_t>(limits_.idCharacters, 512);
+	limits_.recentAssets = std::min<size_t>(limits_.recentAssets, 256);
+	limits_.assetsPerDraw = std::min<size_t>(limits_.assetsPerDraw, 32);
+	limits_.pairs = std::min<size_t>(limits_.pairs, 2048);
+	limits_.predictions = std::min<size_t>(limits_.predictions, 64);
+}
+bool WorkingSetPolicy::ValidId(const std::wstring& id) const {
+	return !id.empty() && id.size() <= limits_.idCharacters;
+}
+void WorkingSetPolicy::ResetLearning() {
+	counters_.predictionCancelled += predictions_.size();
+	recent_.clear(); predictions_.clear(); pairs_.clear(); draw_.clear();
+	haveDraw_ = false; sequence_ = 0;
+}
+void WorkingSetPolicy::SetGraph(const std::vector<WorkingSetNode>& nodes) {
+	graph_.clear(); graphComplete_ = true;
+	for (const auto& input : nodes) {
+		if (!ValidId(input.id) || graph_.size() >= limits_.assets || graph_.count(input.id)) {
+			graphComplete_ = false; continue;
+		}
+		Node node; node.compatibility = input.compatibilityOnly;
+		for (const auto& dependency : input.dependencies) {
+			if (!ValidId(dependency) || node.dependencies.size() >= limits_.dependenciesPerAsset) {
+				node.compatibility = true; graphComplete_ = false; continue;
+			}
+			node.dependencies.push_back(dependency);
+		}
+		std::sort(node.dependencies.begin(), node.dependencies.end());
+		node.dependencies.erase(std::unique(node.dependencies.begin(), node.dependencies.end()), node.dependencies.end());
+		graph_.emplace(input.id, std::move(node));
+	}
+	SelectProfile({});
+}
+const WorkingSetSelection& WorkingSetPolicy::SelectProfile(const std::vector<std::wstring>& seeds) {
+	const uint64_t generation = selection_.generation + 1;
+	selection_ = {}; selection_.generation = generation; selection_.graphComplete = graphComplete_;
+	explicitProfile_ = !seeds.empty(); ResetLearning();
+	std::vector<std::wstring> pending;
+	if (seeds.empty()) { for (const auto& node : graph_) pending.push_back(node.first); }
+	else {
+		// Input may be arbitrarily large; retained state and traversal stay bounded.
+		for (const auto& seed : seeds) {
+			if (graph_.count(seed)) {
+				if (selection_.selected.insert(seed).second) pending.push_back(seed);
+			} else if (selection_.unknownSeeds.size() < limits_.assets && ValidId(seed)) {
+				selection_.unknownSeeds.push_back(seed);
+			} else { selection_.graphComplete = false; }
+		}
+	}
+	for (size_t index = 0; index < pending.size(); ++index) {
+		const auto id = pending[index]; selection_.selected.insert(id);
+		for (const auto& dependency : graph_.at(id).dependencies) {
+			if (!graph_.count(dependency)) { selection_.compatibility[id] = "missing dependency"; continue; }
+			if (selection_.selected.insert(dependency).second) pending.push_back(dependency);
+		}
+	}
+	// Resolve only proven acyclic dependency units. Cycles and all ancestors
+	// remain compatibility-only, with no recursion or speculative Ready path.
+	std::map<std::wstring, size_t> remaining;
+	std::map<std::wstring, std::vector<std::wstring>> parents;
+	std::vector<std::wstring> ready;
+	for (const auto& id : selection_.selected) {
+		const auto& node = graph_.at(id);
+		if (node.compatibility) selection_.compatibility[id] = "unproven or compatibility dependency";
+		remaining[id] = node.dependencies.size();
+		for (const auto& dependency : node.dependencies) parents[dependency].push_back(id);
+		if (node.dependencies.empty()) ready.push_back(id);
+	}
+	for (size_t index = 0; index < ready.size(); ++index) {
+		const auto id = ready[index];
+		for (const auto& parent : parents[id]) {
+			if (selection_.compatibility.count(id)) selection_.compatibility[parent] = "compatibility dependency";
+			if (--remaining[parent] == 0) ready.push_back(parent);
+		}
+	}
+	for (const auto& item : remaining) {
+		if (item.second && !selection_.compatibility.count(item.first))
+			selection_.compatibility[item.first] = "cyclic or unresolved dependency";
+	}
+	return selection_;
+}
+void WorkingSetPolicy::SetAdaptiveLearning(bool enabled) {
+	if (adaptive_ != enabled) { adaptive_ = enabled; ResetLearning(); }
+}
+void WorkingSetPolicy::Expire(uint64_t sequence) {
+	for (auto it = predictions_.begin(); it != predictions_.end();) {
+		if (sequence - it->second > limits_.predictionLifetime) {
+			++counters_.predictionMisses; it = predictions_.erase(it);
+		} else ++it;
+	}
+	for (auto it = recent_.begin(); it != recent_.end();) {
+		if (sequence - it->second > limits_.recentLifetime) it = recent_.erase(it); else ++it;
+	}
+}
+void WorkingSetPolicy::Predict(const std::wstring& id) {
+	if (draw_.count(id) || predictions_.count(id) || !limits_.predictions) return;
+	if (predictions_.size() >= limits_.predictions) return;
+	predictions_[id] = sequence_; ++counters_.predictionsIssued;
+}
+void WorkingSetPolicy::Observe(const std::wstring& id, uint64_t drawToken, uint64_t sequence) {
+	if (!graph_.count(id) || (haveDraw_ && sequence < sequence_)) { ++counters_.droppedObservations; return; }
+	sequence_ = sequence; Expire(sequence);
+	if (!haveDraw_ || drawToken != drawToken_) { draw_.clear(); drawToken_ = drawToken; haveDraw_ = true; }
+	if (draw_.count(id)) return;
+	if (draw_.size() >= limits_.assetsPerDraw) { ++counters_.droppedObservations; return; }
+	++counters_.observations;
+	if (adaptive_) {
+		if (predictions_.erase(id)) ++counters_.predictionHits;
+		else ++counters_.uncoveredObservations;
+		for (const auto& peer : draw_) {
+			const PairKey key = id < peer ? PairKey(id, peer) : PairKey(peer, id);
+			auto found = pairs_.find(key);
+			if (found == pairs_.end() && limits_.pairs) {
+				if (pairs_.size() >= limits_.pairs) {
+					auto victim = pairs_.begin();
+					for (auto it = pairs_.begin(); it != pairs_.end(); ++it)
+						if (it->second.last < victim->second.last) victim = it;
+					pairs_.erase(victim); ++counters_.evictedPairs;
+				}
+				found = pairs_.emplace(key, Pair{}).first;
+			}
+			if (found != pairs_.end()) {
+				if (found->second.count != std::numeric_limits<uint32_t>::max()) ++found->second.count;
+				found->second.last = sequence;
+			}
+		}
+	} else {
+		++counters_.learningBypassedObservations;
+	}
+	draw_.insert(id);
+	if (limits_.recentAssets) {
+		if (!recent_.count(id) && recent_.size() >= limits_.recentAssets) {
+			auto victim = recent_.begin();
+			for (auto it = recent_.begin(); it != recent_.end(); ++it)
+				if (it->second < victim->second) victim = it;
+			recent_.erase(victim);
+		}
+		recent_[id] = sequence;
+	}
+	if (adaptive_) {
+		// Ordered map gives deterministic ties; a repeated observed co-use is
+		// required before allocating any bounded speculative scheduling slot.
+		for (const auto& pair : pairs_) {
+			if (pair.second.count < 2) continue;
+			if (pair.first.first == id) Predict(pair.first.second);
+			else if (pair.first.second == id) Predict(pair.first.first);
+		}
+	}
+}
+int WorkingSetPolicy::Priority(const std::wstring& id) const {
+	if (!graph_.count(id)) return 0;
+	if (draw_.count(id)) return 500;
+	if (adaptive_ && predictions_.count(id)) return 400;
+	if (recent_.count(id)) return 300;
+	if (explicitProfile_ && selection_.selected.count(id)) return 200;
+	return 100;
+}
+std::string WorkingSetPolicy::Explain(const std::wstring& id) const {
+	switch (Priority(id)) {
+	case 500: return "observed in current draw";
+	case 400: return "repeated observed co-use";
+	case 300: return "recently observed";
+	case 200: return "explicit profile dependency closure";
+	case 100: return "enabled candidate";
+	default: return "unknown exact ID";
+	}
+}
+WorkingSetCounters WorkingSetPolicy::Counters() const {
+	auto result = counters_; result.recentAssets = recent_.size(); result.drawAssets = draw_.size();
+	result.pairs = pairs_.size(); result.predictions = predictions_.size(); return result;
+}
+}
