+#pragma once
+#include "PreparedTypes.h"
+#include <mutex>
+namespace ModLoading {
+// Dedicated derived-data directory ONLY, outside recursively loaded mod trees.
+// All filesystem work is performed by Load/Store on preparation workers.
+class DiskAssetCache {
+  public:
+	explicit DiskAssetCache(std::wstring directory, size_t budgetBytes = size_t(1024) * 1024 * 1024,
+							size_t maximumEntries = 512);
