+// Parsing and legacy persistence may coexist with detached workers. Windows
+// thread locale mode prevents their existing setlocale calls changing process
+// locale while preserving upstream UTF-8 character handling on this thread.
+class ScopedIniThreadLocale {
+	int previousMode_;
+	std::string previousLocale_;
+public:
+	ScopedIniThreadLocale() : previousMode_(_configthreadlocale(_ENABLE_PER_THREAD_LOCALE)) {
+		const char* locale = setlocale(LC_ALL, nullptr);
+		if (locale) previousLocale_ = locale;
+		setlocale(LC_ALL, "C");
+		setlocale(LC_CTYPE, "en_US.UTF-8");
+	}
+	~ScopedIniThreadLocale() {
+		if (!previousLocale_.empty()) setlocale(LC_ALL, previousLocale_.c_str());
+		_configthreadlocale(previousMode_);
+	}
+};
