+}
+// Test-only entry point: the host copies this DLL into its owned fixture root.
+// It exercises the actual private reader/linker without creating a game device.
+extern "C" __declspec(dllexport) int WINAPI XXMI_TestDetachedConfiguration(const wchar_t* fixtureRoot)
+{
+	ScopedIniThreadLocale localeScope;
+	try {
+	if (!fixtureRoot) return __LINE__;
+	wstring root(fixtureRoot);
+	if (root.empty() || (root.back() != L'\\' && root.back() != L'/')) root += L'\\';
+	wchar_t module[MAX_PATH] = {};
+	if (!GetModuleFileNameW(migoto_handle, module, MAX_PATH)) return __LINE__;
+	wchar_t* slash = wcsrchr(module, L'\\');
+	if (!slash) return __LINE__;
+	slash[1] = 0;
+	if (_wcsicmp(module, root.c_str())) return __LINE__;
+	auto write = [&](const wchar_t* relative, const char* bytes) {
+		FILE* file = nullptr;
+		if (_wfopen_s(&file, (root + relative).c_str(), L"wb") || !file) return false;
+		const size_t length = strlen(bytes);
+		const bool written = fwrite(bytes, 1, length, file) == length;
+		return fclose(file) == 0 && written;
+	};
+	CreateDirectoryW((root + L"Mods").c_str(), nullptr);
+	const char* mainIni =
+		"[Include]\ninclude = BaseMod.ini\ninclude_recursive = Mods\n"
+		"[Constants]\nglobal persist $x = 2\nglobal $y = $x + 1\n";
+	const char* modIni =
+		"namespace = Example\n[ResourceBuffer]\ntype = Buffer\nformat = R32_UINT\ndata = 1 2 3 4\n"
+		"[PoolValues]\npool_size = 2\npool_persist_variables = true\npool_lazy_initialization = false\n"
+		"[CommandListMain]\nhandling = skip\n"
+		"[TextureOverrideMain]\nhash = 12345678\nrun = CommandListMain\nhandling = skip\n"
+		"[ShaderOverrideMain]\nhash = 1234567890abcdef\nrun = CommandListMain\n";
+	if (!write(L"d3dx.ini", mainIni) || !write(L"BaseMod.ini", modIni) ||
+		!write(L"d3dx_user.ini", "[Constants]\n$x = 7\n") ||
+		!write(L"Mods\\A.ini", "[Constants]\nglobal $a = 1\n") ||
+		!write(L"Mods\\B.ini", "[Constants]\nglobal $b = 2\n")) return __LINE__;
+	ModLoading::ConfigSourceManifest seed;
+	seed.verified = true;
+	ModLoading::SourceSnapshot mainSource;
+	std::string error;
+	if (!ModLoading::ReadVerifiedSnapshot(root + L"d3dx.ini", 1024 * 1024, mainSource, error)) return __LINE__;
+	seed.sources.push_back({mainSource, L""});
+	auto budget = std::make_shared<ModLoading::ResourceRefreshCpuBudget>(256ull * 1024 * 1024);
+	ModLoading::ConfigSourceManifest manifest;
+	ModLoading::ResourceRefreshClosure closure;
+	if (!ReadVerifiedCurrentConfigManifest(seed, manifest, closure, error, budget)) return __LINE__;
+	if (manifest.sources.size() != 5 || manifest.sources[1].iniNamespace != L"BaseMod.ini" ||
+		manifest.sources[2].iniNamespace != L"Mods\\A.ini" ||
