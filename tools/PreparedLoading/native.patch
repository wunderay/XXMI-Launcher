new file mode 100644
index 0000000000000000000000000000000000000000..c7fcfa30eb1b26f46314a312945ec284bcf2076c
--- /dev/null
+++ b/tests/mod_loading/README.md
@@ -0,0 +1,24 @@
+# Portable LoadTrace checks
+
+From the repository root:
+
+```sh
+mkdir -p work
+c++ -std=c++14 -O2 -Wall -Wextra -Werror -pthread DirectX11/ModLoading/LoadTrace.cpp tests/mod_loading/load_trace_test.cpp -o work/load_trace_test
+./work/load_trace_test
+```
+
+Checks disabled recording, command-list opt-in filtering, allocation-free
+producers, scoped bytes/results and frame attribution, stale session rejection,
+explicit first-correct-frame markers, bounded overflow, CSV output and failure,
+I/O outside the producer lock, and six concurrent producers with a consumer.
+The concurrent test reconciles every attempted record with accepted events or
+explicit full/contention losses and checks accepted records for coherent fields.
+
+These are portable recorder correctness checks. They do not build the Windows
+DLL, exercise D3D11, validate rendered output, or establish performance results.
+Captures hold at most 8192 records; once full, new events are dropped and counted.
+Command-list tracing defaults off to avoid exhausting short diagnostic captures.
+Counters and queued records persist across enabled sessions; CSV identifies each
+session. Export runs on the caller's worker and consumes records before writing,
+so stream failures can lose drained events. Always check the output stream.
diff --git a/tests/mod_loading/load_trace_test.cpp b/tests/mod_loading/load_trace_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d85006f96bd49a2ca64026373f3f89411fa2b1a4
--- /dev/null
+++ b/tests/mod_loading/load_trace_test.cpp
@@ -0,0 +1,205 @@
+#include "../../DirectX11/ModLoading/LoadTrace.h"
+
+#include <cassert>
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <sstream>
+#include <thread>
+
+// Catch accidental producer heap allocation, including in first enabled use on
+// each producer thread. Consumer/export allocations are intentionally allowed.
+static thread_local bool denyAllocation = false;
+void* operator new(std::size_t size)
+{
+    assert(!denyAllocation);
+    if (void* p = std::malloc(size ? size : 1)) return p;
+    throw std::bad_alloc();
+}
+void* operator new[](std::size_t size) { return ::operator new(size); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+#if __cplusplus >= 201402L
+void operator delete(void* p, std::size_t) noexcept { std::free(p); }
+void operator delete[](void* p, std::size_t) noexcept { std::free(p); }
+#endif
+
+using namespace ModLoading;
+
+namespace ModLoading {
+struct LoadTraceTestAccess {
+    static void Lock(LoadTrace& trace)
+    {
+        const bool alreadyLocked = trace.lock_.test_and_set(std::memory_order_acquire);
+        assert(!alreadyLocked);
+    }
+    static void Unlock(LoadTrace& trace) { trace.lock_.clear(std::memory_order_release); }
+};
+}
+
+static void Empty(LoadTrace& trace)
+{
+    LoadTraceRecord batch[128];
+    while (trace.Drain(batch, 128)) {}
+}
+
+// Simulate worker-side I/O calling back into a producer. A successful callback
+// proves the buffer lock is not held while formatting/writing a drained row.
+class ReentrantBuffer : public std::stringbuf {
+public:
+    bool submitted = false;
+protected:
+    std::streamsize xsputn(const char* data, std::streamsize size) override
+    {
+        if (!submitted && std::string(data, static_cast<std::size_t>(size)) == "discovery") {
+            submitted = true;
+            LoadTrace::Get().RecordInstant(LoadStage::ViewCreation, 987);
+        }
+        return std::stringbuf::xsputn(data, size);
+    }
+};
+
+int main()
+{
+    LoadTrace& trace = LoadTrace::Get();
+    assert(!trace.IsEnabled());
+    denyAllocation = true;
+    trace.RecordInstant(LoadStage::Discovery);
+    { ScopedLoadTrace scope(LoadStage::FileRead); scope.SetBytes(42); }
+    denyAllocation = false;
+    assert(trace.GetStats().accepted == 0);
+
+    trace.SetEnabled(true);
+    const std::uint64_t firstFrame = trace.AdvanceFrame();
+    denyAllocation = true;
+    {
+        ScopedLoadTrace scope(LoadStage::FileRead, 123);
+        scope.SetBytes(456);
+        scope.SetResult(-7);
+        trace.AdvanceFrame();
+    }
+    // A timer alone cannot claim a known-correct rendering result.
+    { ScopedLoadTrace forbidden(LoadStage::FirstCorrectFrame); }
+    trace.RecordInstant(LoadStage::FirstCorrectFrame, 123);
+    denyAllocation = false;
+    LoadTraceRecord records[4];
+    assert(trace.Drain(records, 4) == 2);
+    assert(records[0].kind == LoadTraceKind::Duration);
+    assert(records[0].objectId == 123 && records[0].bytes == 456 && records[0].result == -7);
+    assert(records[0].startFrame == firstFrame && records[0].endFrame == firstFrame + 1);
+    assert(records[0].threadId != 0);
+    assert(records[1].stage == LoadStage::FirstCorrectFrame);
+    assert(records[1].kind == LoadTraceKind::Instant && records[1].result == LoadTrace::UnknownResult);
+    const std::uint64_t firstSession = records[0].captureSession;
+
+    // No command-list timing/markers unless explicitly enabled for diagnosis.
+    { ScopedLoadTrace filtered(LoadStage::CommandList); }
+    trace.RecordInstant(LoadStage::CommandList);
+    assert(trace.Drain(records, 4) == 0);
+    trace.SetCommandListTracing(true);
+    { ScopedLoadTrace enabled(LoadStage::CommandList); enabled.SetResult(9); }
+    assert(trace.Drain(records, 4) == 1);
+    assert(records[0].stage == LoadStage::CommandList && records[0].result == 9);
+    trace.SetCommandListTracing(false);
+
+    // A scope opened in an old session must not contaminate the new session.
+    {
+        ScopedLoadTrace stale(LoadStage::Decode);
+        trace.SetEnabled(false);
+        trace.SetEnabled(true);
+    }
+    assert(trace.Drain(records, 4) == 0);
+    trace.RecordInstant(LoadStage::Activation);
+    assert(trace.Drain(records, 4) == 1 && records[0].captureSession > firstSession);
+
+    const LoadTraceStats beforeFull = trace.GetStats();
+    denyAllocation = true;
+    for (std::size_t i = 0; i < LoadTrace::Capacity + 19; ++i)
+        trace.RecordInstant(LoadStage::Discovery, i);
+    denyAllocation = false;
+    const LoadTraceStats afterFull = trace.GetStats();
+    assert(afterFull.accepted - beforeFull.accepted == LoadTrace::Capacity);
+    assert(afterFull.droppedFull - beforeFull.droppedFull == 19);
+    assert(trace.Drain(nullptr, 100) == 0 && trace.Drain(records, 0) == 0);
+    std::ostringstream csv;
+    assert(trace.ExportCsv(csv) == LoadTrace::Capacity);
+    assert(csv.str().find("stage,kind,capture_session,") != std::string::npos);
+    assert(csv.str().find("dropped_full=19") != std::string::npos);
+    assert(trace.Drain(records, 4) == 0);
+
+    trace.RecordInstant(LoadStage::Discovery);
+    const LoadTraceStats beforeExport = trace.GetStats();
+    ReentrantBuffer reentrantBuffer;
+    std::ostream reentrantStream(&reentrantBuffer);
+    assert(trace.ExportCsv(reentrantStream) == 2);
+    assert(reentrantBuffer.submitted);
+    assert(trace.GetStats().accepted == beforeExport.accepted + 1);
+    assert(trace.GetStats().droppedContention == beforeExport.droppedContention);
+    trace.RecordInstant(LoadStage::FileRead);
+    std::ostringstream failedOutput;
+    failedOutput.setstate(std::ios::badbit);
+    assert(trace.ExportCsv(failedOutput) == 0);
+    assert(trace.Drain(records, 4) == 1);
+
+    // Deterministic contention: an exporter must report an incomplete capture,
+    // rather than treating the occupied producer flag as an empty queue.
+    trace.RecordInstant(LoadStage::Decode, 765);
+    LoadTraceTestAccess::Lock(trace);
+    std::ostringstream contendedOutput;
+    assert(trace.ExportCsv(contendedOutput) == 0);
+    LoadTraceTestAccess::Unlock(trace);
+    assert(contendedOutput.fail());
+    assert(contendedOutput.str().find("export_incomplete=contention_retry_limit") != std::string::npos);
+    assert(trace.Drain(records, 4) == 1 && records[0].objectId == 765);
+
+    // Concurrent producers and consumer: all attempts are either accepted or
+    // explicitly counted as losses, and all accepted records remain coherent.
+    const LoadTraceStats beforeConcurrent = trace.GetStats();
+    const std::size_t producerCount = 6;
+    const std::size_t perProducer = 20000;
+    std::atomic<bool> start(false), finished(false);
+    std::atomic<std::uint64_t> consumed(0);
+    std::thread consumer([&] {
+        LoadTraceRecord batch[113];
+        while (!start.load()) std::this_thread::yield();
+        while (!finished.load()) {
+            const std::size_t count = trace.Drain(batch, 113);
+            for (std::size_t i = 0; i < count; ++i) {
+                assert(batch[i].stage == LoadStage::GpuCreation);
+                assert(batch[i].bytes == batch[i].objectId * 2);
+                assert(batch[i].result == -static_cast<std::int64_t>(batch[i].objectId));
+            }
+            consumed.fetch_add(count);
+        }
+    });
+    std::thread producers[producerCount];
+    for (std::size_t p = 0; p < producerCount; ++p) producers[p] = std::thread([&, p] {
+        while (!start.load()) std::this_thread::yield();
+        denyAllocation = true;
+        for (std::size_t i = 0; i < perProducer; ++i) {
+            const std::uint64_t id = p * perProducer + i;
+            trace.RecordInstant(LoadStage::GpuCreation, id, id * 2, -static_cast<std::int64_t>(id));
+        }
+        denyAllocation = false;
+    });
+    start.store(true);
+    for (auto& producer : producers) producer.join();
+    finished.store(true);
+    consumer.join();
+    LoadTraceRecord finalBatch[128];
+    std::size_t count;
+    while ((count = trace.Drain(finalBatch, 128)) != 0) consumed.fetch_add(count);
+    const LoadTraceStats afterConcurrent = trace.GetStats();
+    assert(afterConcurrent.accepted - beforeConcurrent.accepted == consumed.load());
+    assert(afterConcurrent.accepted - beforeConcurrent.accepted +
+           afterConcurrent.droppedFull - beforeConcurrent.droppedFull +
+           afterConcurrent.droppedContention - beforeConcurrent.droppedContention == producerCount * perProducer);
+    assert(afterConcurrent.exported - beforeConcurrent.exported == consumed.load());
+
+    trace.SetEnabled(false);
+    trace.RecordInstant(LoadStage::Present);
+    Empty(trace);
+    assert(trace.GetStats().accepted == afterConcurrent.accepted);
+    std::cout << "LoadTrace portable tests passed\n";
+}
diff --git a/tests/preparation_changes/README.md b/tests/preparation_changes/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..5631c7fe3e221ca17fbdc00642fcbc41657a30ad
--- /dev/null
+++ b/tests/preparation_changes/README.md
@@ -0,0 +1,66 @@
+Run `python3 tests/preparation_changes/run_tests.py` on a C++14 host.
+
+The injected-notification tests cover coalescing and maximum delay, create,
+modify, rename old/new, delete, overflow, unsupported notifications, exclusion
+boundaries, dependencies outside Mods, cancellation, root replacement, bounded
+roots, periodic reconciliation, stale digest rejection, and worker stop.
+The digest test injects CPU-verified digest results with different bytes and
+unchanged metadata. Actual hashing belongs to the CPU snapshot suite.
+
+The Windows backend uses overlapped ReadDirectoryChangesW for recursive roots
+and nonrecursive parent watches. Failed roots retry once per second. Periodic
+full reconciliation is opt-in (default zero) until a complete configuration
+closure verifier can distinguish unchanged INIs from lost config edits.
+The default bounds are 128 roots and 1024 coalesced events. The backend caps
+live plus retired IO records at 256, including parent watches. Exceeding the
+IO cap falls back to bounded periodic reconciliation. On a driver cancellation
+that does not complete promptly, IO memory stays in a capped process-lifetime
+reserve until its completion event signals, avoiding both an unbounded Stop
+wait and reuse of an outstanding OVERLAPPED buffer. Stop is bounded by the
+25ms polling interval plus its enqueue callback; callbacks must only enqueue
+bounded work, and owner code must serialize Start/Stop and never Stop from
+inside a callback.
+
+Windows SDK build and actual filesystem fixtures remain required: partial
+copies, same-size/same-timestamp rewrites, atomic root rename/replacement,
+notification-buffer overflow, long/UNC paths, permission loss, unsupported
+filesystems, and cancellation under stress. Linux tests exercise the portable
+state machine and injected worker only.
+
+Debounce is a scheduling heuristic, not multi-file transaction proof. Consumers
+must verify the complete dependency closure through stable content snapshots,
+queue INI changes for compatible legacy reload, and fence publication with the
+request token and their own generation commit protocol. No callback activates
+or invokes F10. Automatic activation is a separate explicit option defaulting
+to false. Completion manifests or installer atomic replacement are still
+needed to establish intended multi-file installation completeness.
+
+Windows filesystem fixture (Windows SDK developer command prompt, repo root):
+
+```bat
+cl /nologo /std:c++14 /EHsc /W4 /WX /I DirectX11\ModLoading DirectX11\ModLoading\ChangeReconciler.cpp DirectX11\ModLoading\ChangeMonitor.cpp tests\preparation_changes\change_monitor_windows_test.cpp /Fe:change_monitor_windows_test.exe
+change_monitor_windows_test.exe
+```
+
+Use a CI step timeout of two minutes. The fixture uses an exclusively owned
+Windows temporary directory and removes it after the monitor stops. It exercises
+actual create, same-size modify, rename, delete, excluded cache writes, watched
+root replacement and subsequent reattachment, detachment from the old root,
+and cancellation with no callbacks after Stop returns. Notification waits have
+five-second deadlines and diagnostic operation names; the callback only appends
+to a bounded mutex-protected queue. Periodic reconciliation is disabled so it
+cannot satisfy event expectations accidentally. Tests wait for quiet intervals
+rather than assuming one callback per filesystem operation. This fixture has
+not been executed on the Linux development host; a Windows CI pass is required.
+
+Runtime dependency filtering is optional (`ChangeOptions.filterDependencies`,
+false by default). Its `dependencyFiles` list contains resolved canonical asset
+files. With filtering enabled, unrelated non-INI outputs such as d3d11_log are
+ignored; exact asset paths and any nonexcluded `.ini` change remain relevant.
+Name changes of ancestor directories containing tracked assets also invalidate.
+`excludedSourceFiles` lists exact runtime-owned output paths and takes precedence
+over the INI rule; excluded cache/log directories still use Start's excluded roots.
+Overflow and root replacement always retain conservative full/INI invalidation.
+The portable suite checks these rules, including a temporary-file rename into
+a tracked asset name. The filter does not establish a full configuration closure
+for previously unknown INIs inside newly renamed-in directories.
diff --git a/tests/preparation_changes/change_monitor_windows_test.cpp b/tests/preparation_changes/change_monitor_windows_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c3b6c60d4c5a95b540adc63a2507d6776f4a63c
--- /dev/null
+++ b/tests/preparation_changes/change_monitor_windows_test.cpp
@@ -0,0 +1,156 @@
+// Actual Windows filesystem smoke fixture. No game/process interaction.
+#ifndef _WIN32
+#error This fixture requires Windows and the Windows SDK.
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#include "ChangeMonitor.h"
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <cstring>
+#include <cwchar>
+#include <iostream>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+using namespace ModLoading;
+namespace {
+void Require(bool ok, const char* operation) {
+    if (!ok) {
+        std::cerr << "FAIL: " << operation << " (Win32=" << GetLastError() << ")\n";
+        throw std::runtime_error(operation);
+    }
+}
+void Directory(const std::wstring& path) { Require(CreateDirectoryW(path.c_str(), nullptr) != FALSE, "CreateDirectory"); }
+void Write(const std::wstring& path, const char* bytes) {
+    HANDLE file = CreateFileW(path.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    Require(file != INVALID_HANDLE_VALUE, "CreateFile");
+    DWORD written = 0;
+    const DWORD length = static_cast<DWORD>(strlen(bytes));
+    const bool ok = WriteFile(file, bytes, length, &written, nullptr) && written == length && FlushFileBuffers(file);
+    const DWORD error = GetLastError();
+    CloseHandle(file); SetLastError(error); Require(ok, "WriteFile/FlushFileBuffers");
+}
+void RemoveTree(const std::wstring& path) {
+    WIN32_FIND_DATAW data = {};
+    HANDLE find = FindFirstFileW((path + L"\\*").c_str(), &data);
+    if (find != INVALID_HANDLE_VALUE) {
+        do {
+            if (!wcscmp(data.cFileName, L".") || !wcscmp(data.cFileName, L"..")) continue;
+            const std::wstring child = path + L"\\" + data.cFileName;
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+                if (data.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) RemoveDirectoryW(child.c_str());
+                else RemoveTree(child);
+            } else DeleteFileW(child.c_str());
+        } while (FindNextFileW(find, &data));
+        FindClose(find);
+    }
+    RemoveDirectoryW(path.c_str());
+}
+struct TempTree {
+    std::wstring path;
+    TempTree() {
+        wchar_t directory[MAX_PATH + 1] = {}, name[MAX_PATH + 1] = {};
+        const DWORD length = GetTempPathW(MAX_PATH, directory);
+        Require(length > 0 && length < MAX_PATH, "GetTempPath");
+        Require(GetTempFileNameW(directory, L"xmc", 0, name) != 0, "GetTempFileName");
+        path = name; Require(DeleteFileW(path.c_str()) != FALSE, "Delete temporary placeholder"); Directory(path);
+    }
+    ~TempTree() { RemoveTree(path); }
+};
+struct Queue {
+    std::mutex mutex;
+    std::condition_variable changed;
+    uint64_t count = 0;
+    std::deque<ReconcileRequest> requests;
+    // Callback performs bounded copying only; it owns no live runtime objects.
+    void Push(const ReconcileRequest& request) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (requests.size() == 64) requests.pop_front();
+        requests.push_back(request); ++count; changed.notify_all();
+    }
+    ReconcileRequest Latest() { std::lock_guard<std::mutex> lock(mutex); return requests.back(); }
+    uint64_t Count() { std::lock_guard<std::mutex> lock(mutex); return count; }
+    ReconcileRequest WaitAfter(uint64_t before, const char* action) {
+        std::unique_lock<std::mutex> lock(mutex);
+        if (!changed.wait_for(lock, std::chrono::seconds(5), [&] { return count > before; })) {
+            std::cerr << "Timeout after " << action << ", callbacks=" << count << ", baseline=" << before << '\n';
+            throw std::runtime_error(action);
+        }
+        std::cout << "Observed " << action << ", callbacks=" << count << '\n';
+        return requests.back();
+    }
+    void Quiet() {
+        std::unique_lock<std::mutex> lock(mutex);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        for (;;) {
+            const auto before = count;
+            if (!changed.wait_for(lock, std::chrono::milliseconds(350), [&] { return count != before; })) return;
+            if (std::chrono::steady_clock::now() >= deadline) throw std::runtime_error("notifications failed to settle");
+        }
+    }
+};
+}
+int main() {
+    try {
+        TempTree temp;
+        const std::wstring root = temp.path + L"\\Mods", old = temp.path + L"\\Mods-old";
+        const std::wstring cache = root + L"\\cache", asset = root + L"\\asset.bin";
+        Directory(root); Directory(cache);
+        auto queue = std::make_shared<Queue>();
+        ChangeOptions options; options.debounceMs = 75; options.maximumDelayMs = 300;
+        options.periodicReconcileMs = 0; // Actual notifications must satisfy this fixture.
+        ChangeMonitor monitor(options);
