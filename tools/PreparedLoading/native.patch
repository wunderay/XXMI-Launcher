+static void DescribeBytecode(const char* label, const std::vector<uint8_t>& bytes)
+{
+	const auto printDigest = [](const uint8_t* data, size_t size) {
+		const char* hex = "0123456789abcdef";
+		for (uint8_t value : HashBytes(data, size))
+			std::cerr << hex[value >> 4] << hex[value & 15];
+	};
+	std::cerr << label << " bytes=" << bytes.size() << " sha256=";
+	printDigest(bytes.data(), bytes.size());
+	std::cerr << '\n';
+	if (bytes.size() < 32 || std::memcmp(bytes.data(), "DXBC", 4))
+		return;
+	const auto word = [&](size_t offset) {
+		uint32_t value = 0;
+		std::memcpy(&value, bytes.data() + offset, sizeof(value));
+		return value;
+	};
+	const uint32_t count = word(28);
+	if (count > 64 || count > (bytes.size() - 32) / 4)
+		return;
+	for (uint32_t i = 0; i < count; ++i) {
+		const size_t offset = word(32 + size_t(i) * 4);
+		if (offset > bytes.size() - 8)
+			return;
+		const size_t size = word(offset + 4);
+		if (size > bytes.size() - offset - 8)
+			return;
+		std::cerr << "  " << std::string(reinterpret_cast<const char*>(bytes.data() + offset), 4)
+			<< " bytes=" << size << " sha256=";
+		printDigest(bytes.data() + offset + 8, size);
+		std::cerr << '\n';
+	}
+}
