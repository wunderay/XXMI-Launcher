+#include <functional>
+#include <mutex>
+
+namespace ModLoading {
+struct ConfigGeneration {
+    Generation id = 0;
+    // CPU staging/device ownership stamp, independent of the immutable config
+    // compilation stamp. Updating this metadata never reparses or hashes config.
+    BuildVersions versions;
+    std::shared_ptr<const CompiledConfig> config;
+    // Optional owning handles: never raw pointers into another generation.
+    std::vector<std::shared_ptr<const void>> dependencies;
+};
+using GenerationPin = std::shared_ptr<const ConfigGeneration>;
+enum class PublishResult { Activated, InvalidCandidate, Stale, UnsafeBoundary, DependenciesPending, RetirementPending };
+// This manages detached preparation ownership only. Legacy global config and
+// raw command references are not swapped, and retain their compatibility path.
+class GenerationManager {
+public:
+    explicit GenerationManager(size_t maxRetired = 8) : maxRetired_(maxRetired) {}
+    GenerationPin Pin() const;
+    // Staging retains completed CPU preparation only; CompatibilityOnly is
+    // permitted and no live activation/readiness is inferred. Readers pin the
+    // immutable staged batch while cancellation/replacement drops manager ownership.
+    bool Stage(GenerationPin candidate, BuildVersions current);
+    GenerationPin PreparedPin() const;
+    void CancelPrepared();
+    PublishResult Publish(GenerationPin candidate, BuildVersions current,
+        bool safeBoundary, bool dependenciesReady);
+    // A nonblocking fence query must confirm old GPU work complete. CPU pins
+    // independently delay retirement; no render-thread spinning is permitted.
+    size_t Retire(const std::function<bool(Generation)>& gpuComplete);
+    size_t RetiredCount() const;
+private:
+    mutable std::mutex mutex_;
+    GenerationPin active_;
+    GenerationPin prepared_;
+    std::vector<GenerationPin> retired_;
+    size_t maxRetired_;
+};
+}
diff --git a/DirectX11/ModLoading/IncrementalConfigCache.cpp b/DirectX11/ModLoading/IncrementalConfigCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bf9299f8c3348ab350ceebb5af8b39aea9295899
--- /dev/null
+++ b/DirectX11/ModLoading/IncrementalConfigCache.cpp
@@ -0,0 +1,100 @@
+#include "IncrementalConfigCache.h"
+#include <sstream>
+
+namespace ModLoading {
+namespace {
+std::string Trim(const std::string& s) {
+    const auto begin = s.find_first_not_of(" \t\r");
+    if (begin == std::string::npos) return {};
+    return s.substr(begin, s.find_last_not_of(" \t\r") - begin + 1);
+}
+std::string Lower(std::string s) {
+    for (auto& c : s) if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    return s;
+}
+std::shared_ptr<const ConfigFileIR> Lex(const SourceSnapshot& source) {
+    auto ir = std::make_shared<ConfigFileIR>();
+    ir->digest = source.digest;
+    std::string input(source.bytes->begin(), source.bytes->end());
+    if (input.compare(0, 3, "\xef\xbb\xbf") == 0) input.erase(0, 3);
+    std::istringstream stream(input);
+    std::string raw, section;
+    size_t number = 0;
+    while (std::getline(stream, raw)) {
+        ++number;
+        auto line = Trim(raw);
+        if (line.empty() || line[0] == ';') continue;
+        if (line[0] == '[') {
+            section = Lower(Trim(line.substr(1, line.find(']') == std::string::npos ?
+                std::string::npos : line.find(']') - 1)));
+            continue;
+        }
+        const auto equal = line.find('=');
+        ConfigLineIR item;
+        item.section = section;
+        item.raw = line;
+        item.line = number;
+        if (equal != std::string::npos) {
+            item.key = Lower(Trim(line.substr(0, equal)));
+            item.value = Trim(line.substr(equal + 1));
+        }
+        if (section.compare(0, 7, "include") == 0) {
+            if (item.key == "include" || item.key == "user_config")
+                ir->declaredIncludes.push_back(item.value);
+            else ir->ambiguousDependencies = true;
+        }
+        // Conditions and arbitrary expressions can change dependency reachability.
+        if (section.empty() && item.key == "condition") ir->ambiguousDependencies = true;
+        ir->lines.push_back(std::move(item));
+    }
+    return ir;
+}
+size_t Cost(const SourceSnapshot& source, const ConfigFileIR& ir) {
+    size_t size = source.bytes->size() + sizeof(ConfigFileIR);
+    for (const auto& line : ir.lines)
+        size += sizeof(ConfigLineIR) + line.section.size() + line.key.size() + line.value.size() + line.raw.size();
+    for (const auto& include : ir.declaredIncludes) size += include.size() + sizeof(std::string);
+    return size + source.path.size() * sizeof(wchar_t);
+}
+}
+IncrementalConfigCache::IncrementalConfigCache(size_t maxBytes, size_t maxFiles)
+    : maxBytes_(maxBytes), maxFiles_(maxFiles) {}
+std::shared_ptr<const ConfigFileIR> IncrementalConfigCache::Parse(const SourceSnapshot& source,
+    bool forceFull, bool& reused) {
+    reused = false;
+    if (!source.bytes) return {};
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!forceFull) for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+        // Path and full content are checked, even if a digest collision occurs.
+        if (it->source.path == source.path && it->source.digest == source.digest &&
+            *it->source.bytes == *source.bytes) {
+            auto result = it->ir;
+            entries_.splice(entries_.begin(), entries_, it);
+            reused = true;
+            return result;
+        }
+    }
+    auto result = Lex(source);
+    const auto cost = Cost(source, *result);
+    if (maxFiles_ && cost <= maxBytes_) {
+        for (auto it = entries_.begin(); it != entries_.end();) {
+            if (it->source.path == source.path) { bytes_ -= it->bytes; it = entries_.erase(it); }
+            else ++it;
+        }
+        while (!entries_.empty() && (entries_.size() >= maxFiles_ || bytes_ > maxBytes_ - cost)) {
+            bytes_ -= entries_.back().bytes;
+            entries_.pop_back();
+        }
+        entries_.push_front(Entry{source, result, cost});
+        bytes_ += cost;
+    }
+    return result;
+}
+void IncrementalConfigCache::SetSchema(ConfigSchema schema) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!(schema_ == schema)) { entries_.clear(); bytes_ = 0; schema_ = schema; }
+}
+ConfigSchema IncrementalConfigCache::Schema() const { std::lock_guard<std::mutex> lock(mutex_); return schema_; }
+size_t IncrementalConfigCache::Bytes() const { std::lock_guard<std::mutex> lock(mutex_); return bytes_; }
+size_t IncrementalConfigCache::Entries() const { std::lock_guard<std::mutex> lock(mutex_); return entries_.size(); }
+}
diff --git a/DirectX11/ModLoading/IncrementalConfigCache.h b/DirectX11/ModLoading/IncrementalConfigCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..0209ac8330f5e9330f9754f41ed7334cda777785
--- /dev/null
+++ b/DirectX11/ModLoading/IncrementalConfigCache.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "ConfigCompiler.h"
+#include <list>
+#include <mutex>
+
+namespace ModLoading {
+// Memory-only cache: the IR contains no live/global runtime references. Changing
+// parser/schema/ABI invalidates all entries. The accounted payload bound includes
+// retained source bytes; it is not an aggregate process-allocation limit.
+struct ConfigSchema {
+    uint32_t parser = 1, schema = 1, abi = 1;
+    bool operator==(const ConfigSchema& o) const {
+        return parser == o.parser && schema == o.schema && abi == o.abi;
+    }
+};
+class IncrementalConfigCache {
+public:
+    explicit IncrementalConfigCache(size_t maxBytes = 16 * 1024 * 1024, size_t maxFiles = 256);
+    std::shared_ptr<const ConfigFileIR> Parse(const SourceSnapshot& source, bool forceFull, bool& reused);
+    void SetSchema(ConfigSchema schema);
+    ConfigSchema Schema() const;
+    // Cache-owned accounted payload only. A caller's immutable compiled results
+    // may independently pin evicted source/IR objects; their budget is external.
+    size_t Bytes() const;
+    size_t Entries() const;
+private:
+    struct Entry {
+        SourceSnapshot source;
+        std::shared_ptr<const ConfigFileIR> ir;
+        size_t bytes;
+    };
+    size_t maxBytes_, maxFiles_, bytes_ = 0;
+    ConfigSchema schema_;
+    mutable std::mutex mutex_;
+    std::list<Entry> entries_;
+};
+}
diff --git a/DirectX11/ModLoading/LoadTrace.cpp b/DirectX11/ModLoading/LoadTrace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0617b70bf4227bacb824bd2f1307b19acf77052f
--- /dev/null
+++ b/DirectX11/ModLoading/LoadTrace.cpp
@@ -0,0 +1,221 @@
+#include "LoadTrace.h"
+
+#include <algorithm>
+#include <chrono>
+#include <ostream>
+#include <thread>
+
+namespace ModLoading {
+
+const std::size_t LoadTrace::Capacity;
+const std::int64_t LoadTrace::UnknownResult;
+
+namespace {
+const char* StageName(LoadStage stage) noexcept
+{
+    switch (stage) {
+    case LoadStage::Discovery: return "discovery";
+    case LoadStage::FileRead: return "file_read";
+    case LoadStage::Decode: return "decode";
+    case LoadStage::ShaderPreparation: return "shader_preparation";
+    case LoadStage::GpuCreation: return "gpu_creation";
+    case LoadStage::ViewCreation: return "view_creation";
+    case LoadStage::CommandList: return "command_list";
+    case LoadStage::ConfigReload: return "config_reload";
+    case LoadStage::ReadinessWait: return "readiness_wait";
+    case LoadStage::Activation: return "activation";
+    case LoadStage::FirstCorrectFrame: return "first_correct_frame";
+    case LoadStage::FileLoad: return "file_load_combined";
+    case LoadStage::Present: return "present_cpu";
+    }
+    return "unknown";
+}
+}
+
+LoadTrace::LoadTrace() noexcept
+    : session_(0), frame_(0), commandListTracing_(false), head_(0), count_(0), accepted_(0),
+      droppedFull_(0), droppedContention_(0), exported_(0)
+{
+}
+
+LoadTrace& LoadTrace::Get() noexcept
+{
+    static LoadTrace trace;
+    return trace;
+}
+
+void LoadTrace::SetEnabled(bool enabled) noexcept
+{
+    std::uint64_t previous = session_.load(std::memory_order_relaxed);
+    while (((previous & 1) != 0) != enabled &&
+           !session_.compare_exchange_weak(previous, previous + 1,
+               std::memory_order_relaxed, std::memory_order_relaxed)) {}
+}
+
+bool LoadTrace::IsEnabled() const noexcept
+{
+    return (session_.load(std::memory_order_relaxed) & 1) != 0;
+}
+
+void LoadTrace::SetCommandListTracing(bool enabled) noexcept
+{
+    commandListTracing_.store(enabled, std::memory_order_relaxed);
+}
+
+std::uint64_t LoadTrace::AdvanceFrame() noexcept
+{
+    return frame_.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+std::uint64_t LoadTrace::CurrentFrame() const noexcept
+{
+    return frame_.load(std::memory_order_relaxed);
+}
+
+std::uint64_t LoadTrace::NowNs() noexcept
+{
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+std::uint64_t LoadTrace::ThreadId() noexcept
+{
+    static std::atomic<std::uint64_t> nextId(0);
+    static thread_local const std::uint64_t id = nextId.fetch_add(1, std::memory_order_relaxed) + 1;
+    return id;
+}
+
+void LoadTrace::RecordInstant(LoadStage stage, std::uint64_t objectId,
+                              std::uint64_t bytes, std::int64_t result) noexcept
+{
+    const std::uint64_t session = session_.load(std::memory_order_relaxed);
+    if (!(session & 1)) return;
+    if (stage == LoadStage::CommandList && !commandListTracing_.load(std::memory_order_relaxed)) return;
+    const std::uint64_t frame = CurrentFrame();
+    const LoadTraceRecord record = {stage, LoadTraceKind::Instant, session,
+        NowNs(), 0, frame, frame, ThreadId(), objectId, bytes, result};
+    Submit(record, session);
+}
+
+void LoadTrace::Submit(const LoadTraceRecord& record, std::uint64_t session) noexcept
+{
+    if (session_.load(std::memory_order_relaxed) != session) return;
+    if (lock_.test_and_set(std::memory_order_acquire)) {
+        droppedContention_.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (session_.load(std::memory_order_relaxed) == session) {
+        if (count_ == Capacity) {
+            droppedFull_.fetch_add(1, std::memory_order_relaxed);
+        } else {
+            records_[(head_ + count_) % Capacity] = record;
+            ++count_;
+            accepted_.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    lock_.clear(std::memory_order_release);
+}
+
+LoadTraceStats LoadTrace::GetStats() const noexcept
+{
+    return {accepted_.load(std::memory_order_relaxed),
+        droppedFull_.load(std::memory_order_relaxed),
+        droppedContention_.load(std::memory_order_relaxed),
+        exported_.load(std::memory_order_relaxed)};
+}
+
+std::size_t LoadTrace::Drain(LoadTraceRecord* output, std::size_t maximum) noexcept
+{
+    std::size_t drained = 0;
+    TryDrain(output, maximum, drained);
+    return drained;
+}
+
+LoadTrace::DrainStatus LoadTrace::TryDrain(LoadTraceRecord* output, std::size_t maximum,
+                                          std::size_t& drained) noexcept
+{
+    drained = 0;
+    if (!output || !maximum) return DrainStatus::Empty;
+    if (lock_.test_and_set(std::memory_order_acquire)) return DrainStatus::Busy;
+    const std::size_t count = (std::min)(maximum, count_);
+    for (std::size_t i = 0; i < count; ++i) output[i] = records_[(head_ + i) % Capacity];
+    head_ = (head_ + count) % Capacity;
+    count_ -= count;
+    exported_.fetch_add(count, std::memory_order_relaxed);
+    lock_.clear(std::memory_order_release);
+    drained = count;
+    return count ? DrainStatus::Drained : DrainStatus::Empty;
+}
+
+std::size_t LoadTrace::ExportCsv(std::ostream& output)
+{
+    output << "# load_trace_v1; monotonic_ns; frame_ids_are_attribution_only\n"
+              "# activation_and_first_correct_frame_require_explicit_external_evidence\n"
+              "stage,kind,capture_session,start_ns,duration_ns,start_frame,end_frame,thread_id,object_id,bytes,result\n";
+    // Bounded stack buffer keeps formatting and potentially blocking I/O out of
+    // the producer critical section. Even continuous producers cannot extend
+    // this export beyond the fixed record budget.
+    LoadTraceRecord batch[128];
+    std::size_t total = 0;
+    std::size_t busyAttempts = 0;
+    bool incomplete = false;
+    while (total < Capacity && output) {
+        std::size_t count = 0;
+        const DrainStatus status = TryDrain(batch,
+            (std::min)(std::size_t(128), Capacity - total), count);
+        if (status == DrainStatus::Busy) {
+            if (++busyAttempts == 64) {
+                incomplete = true;
+                break;
+            }
+            std::this_thread::yield();
+            continue;
+        }
+        if (status == DrainStatus::Empty) break;
+        busyAttempts = 0;
+        total += count;
+        for (std::size_t i = 0; i < count; ++i) {
+            const LoadTraceRecord& r = batch[i];
+            output << StageName(r.stage) << ','
+                   << (r.kind == LoadTraceKind::Instant ? "instant" : "duration") << ','
+                   << r.captureSession << ',' << r.startNs << ',' << r.durationNs << ','
+                   << r.startFrame << ',' << r.endFrame << ',' << r.threadId << ','
+                   << r.objectId << ',' << r.bytes << ',';
+            if (r.result != UnknownResult) output << r.result;
+            output << '\n';
+        }
+    }
+    const LoadTraceStats stats = GetStats();
+    output << "# cumulative_accepted=" << stats.accepted
+           << ";dropped_full=" << stats.droppedFull
+           << ";dropped_contention=" << stats.droppedContention
+           << ";drained=" << stats.exported << '\n';
+    if (incomplete) {
+        output << "# export_incomplete=contention_retry_limit;queued_records_retained\n";
+        output.setstate(std::ios::failbit);
+    }
+    return total;
+}
+
+ScopedLoadTrace::ScopedLoadTrace(LoadStage stage, std::uint64_t objectId) noexcept
+    : trace_(&LoadTrace::Get()), session_(trace_->session_.load(std::memory_order_relaxed))
+{
+    if (!(session_ & 1) || stage == LoadStage::FirstCorrectFrame ||
+        (stage == LoadStage::CommandList && !trace_->commandListTracing_.load(std::memory_order_relaxed))) {
+        session_ = 0;
+        return;
+    }
+    const std::uint64_t frame = trace_->CurrentFrame();
+    record_ = {stage, LoadTraceKind::Duration, session_, LoadTrace::NowNs(),
+        0, frame, frame, LoadTrace::ThreadId(), objectId, 0, LoadTrace::UnknownResult};
+}
+
+ScopedLoadTrace::~ScopedLoadTrace() noexcept
+{
+    if (!session_ || trace_->session_.load(std::memory_order_relaxed) != session_) return;
+    record_.durationNs = LoadTrace::NowNs() - record_.startNs;
+    record_.endFrame = trace_->CurrentFrame();
+    trace_->Submit(record_, session_);
+}
+
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/LoadTrace.h b/DirectX11/ModLoading/LoadTrace.h
new file mode 100644
index 0000000000000000000000000000000000000000..0368d6465e423020dd1f688b1309cc0101056065
--- /dev/null
+++ b/DirectX11/ModLoading/LoadTrace.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <iosfwd>
+#include <limits>
+
+namespace ModLoading {
+
+enum class LoadStage : std::uint8_t {
+    Discovery, FileRead, Decode, ShaderPreparation, GpuCreation, ViewCreation,
+    CommandList, ConfigReload, ReadinessWait, Activation, FirstCorrectFrame,
+    FileLoad, Present
+};
+
+enum class LoadTraceKind : std::uint8_t { Instant, Duration };
+
+struct LoadTraceRecord {
+    LoadStage stage;
+    LoadTraceKind kind;
+    std::uint64_t captureSession;
+    std::uint64_t startNs;
+    std::uint64_t durationNs;
+    std::uint64_t startFrame;
+    std::uint64_t endFrame;
+    std::uint64_t threadId;
+    std::uint64_t objectId;
+    std::uint64_t bytes;
+    // UnknownResult means the call site did not supply an outcome. Zero is not
+    // implicitly success: result interpretation belongs to the instrumented API.
+    std::int64_t result;
+};
+
+struct LoadTraceStats {
+    std::uint64_t accepted;
+    std::uint64_t droppedFull;
+    std::uint64_t droppedContention;
+    std::uint64_t exported;
+};
+
+class ScopedLoadTrace;
+
+// Process-lifetime, bounded recorder. No heap allocation, file I/O, waiting or
+// retry loops in producer paths. Disabled recording takes one atomic load.
+// Frame IDs are attribution only, not evidence of visible/correct rendering.
+class LoadTrace {
+public:
+    static const std::size_t Capacity = 8192;
+    static const std::int64_t UnknownResult = (std::numeric_limits<std::int64_t>::min)();
+
+    static LoadTrace& Get() noexcept;
+    void SetEnabled(bool enabled) noexcept;
+    bool IsEnabled() const noexcept;
+    // Per-draw command timers can exhaust a short bounded capture. Default off;
+    // enable explicitly for focused diagnosis. Checked before timestamp/ID work.
+    void SetCommandListTracing(bool enabled) noexcept;
+    std::uint64_t AdvanceFrame() noexcept;
+    std::uint64_t CurrentFrame() const noexcept;
+    void RecordInstant(LoadStage stage, std::uint64_t objectId = 0,
+                       std::uint64_t bytes = 0,
+                       std::int64_t result = UnknownResult) noexcept;
+    LoadTraceStats GetStats() const noexcept;
+
+    // Worker-side consumer APIs. Drain tries once and returns zero on contention;
+    // concurrent consumers are safe. A returned record is removed from memory.
+    std::size_t Drain(LoadTraceRecord* output, std::size_t maximum) noexcept;
+    // Call ONLY on a worker. Writes at most Capacity records per invocation;
+    // formatting and stream I/O occur after releasing the producer lock.
+    // Busy drains receive bounded worker-side retries. Exhaustion writes an
+    // incomplete-export comment and sets failbit; queued records remain queued.
+    // Exported records are consumed even on stream failure; callers must check
+    // stream state. Counters are cumulative, sampled independently, not a
+    // transactional snapshot. Stop producers before a final accounting export.
+    std::size_t ExportCsv(std::ostream& output);
+
+private:
+    friend class ScopedLoadTrace;
+    friend struct LoadTraceTestAccess;
+    enum class DrainStatus { Empty, Busy, Drained };
+    DrainStatus TryDrain(LoadTraceRecord* output, std::size_t maximum,
+                         std::size_t& drained) noexcept;
+    LoadTrace() noexcept;
+    static std::uint64_t NowNs() noexcept;
+    static std::uint64_t ThreadId() noexcept;
+    void Submit(const LoadTraceRecord& record, std::uint64_t session) noexcept;
+
+    // Odd = enabled. Every transition changes the token, so old scopes cannot
+    // leak into a later enable session. Control operations run off the render path.
+    std::atomic<std::uint64_t> session_;
+    std::atomic<std::uint64_t> frame_;
+    std::atomic<bool> commandListTracing_;
+    std::atomic_flag lock_ = ATOMIC_FLAG_INIT;
+    LoadTraceRecord records_[Capacity];
+    std::size_t head_;
+    std::size_t count_;
+    std::atomic<std::uint64_t> accepted_, droppedFull_, droppedContention_, exported_;
+};
+
+// Timing a scope does not assert readiness or a correct rendered result.
+// FirstCorrectFrame is accepted only through an explicit RecordInstant call
+// supplied by external validation; it is never inferred from a Present/scope.
+class ScopedLoadTrace {
+public:
+    explicit ScopedLoadTrace(LoadStage stage, std::uint64_t objectId = 0) noexcept;
+    ~ScopedLoadTrace() noexcept;
+    void SetBytes(std::uint64_t bytes) noexcept { record_.bytes = bytes; }
+    void SetResult(std::int64_t result) noexcept { record_.result = result; }
+    ScopedLoadTrace(const ScopedLoadTrace&) = delete;
+    ScopedLoadTrace& operator=(const ScopedLoadTrace&) = delete;
+private:
+    LoadTrace* trace_;
+    std::uint64_t session_;
+    LoadTraceRecord record_;
+};
+
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/MemoryBudgetController.cpp b/DirectX11/ModLoading/MemoryBudgetController.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6b56ed9f1721a48b4a5935c46afd0e9b047603f4
--- /dev/null
+++ b/DirectX11/ModLoading/MemoryBudgetController.cpp
@@ -0,0 +1,48 @@
+#include "MemoryBudgetController.h"
+#include <algorithm>
+#include <atomic>
+#include <limits>
+namespace ModLoading {
+namespace {
+uint64_t Sub(uint64_t a, uint64_t b) { return a > b ? a - b : 0; }
+}
+struct LiveGpuAllocationLedger::State { std::atomic<uint64_t> bytes{0}; };
+LiveGpuAllocationLedger::Lease::Lease(std::shared_ptr<State> state) : state_(std::move(state)) {}
+LiveGpuAllocationLedger::Lease::~Lease() { state_->bytes.fetch_sub(bytes_, std::memory_order_relaxed); }
+LiveGpuAllocationLedger::LiveGpuAllocationLedger() : state_(std::make_shared<State>()) {}
+uint64_t LiveGpuAllocationLedger::Bytes() const { return state_->bytes.load(std::memory_order_relaxed); }
+std::shared_ptr<const LiveGpuAllocationLedger::Lease> LiveGpuAllocationLedger::Track(uint64_t bytes) {
+    if (!bytes) return {};
+    // Allocate the token before touching accounting, so allocation failure
+    // cannot strand an increment. Until CAS succeeds its destructor subtracts0.
+    std::shared_ptr<Lease> lease(new Lease(state_));
+    auto current = state_->bytes.load(std::memory_order_relaxed);
+    for (;;) {
+        if (bytes > (std::numeric_limits<uint64_t>::max)() - current) return {};
+        if (state_->bytes.compare_exchange_weak(current, current + bytes, std::memory_order_relaxed)) {
+            lease->bytes_ = bytes; return lease;
+        }
+    }
+}
+LiveGpuAllocationLedger& ProcessGpuAllocationLedger() {
+    static LiveGpuAllocationLedger ledger;
+    return ledger;
+}
+MemoryBudgetController::MemoryBudgetController(uint64_t fallbackLimit, uint64_t headroom)
+    : fallback_(fallbackLimit), headroom_(headroom) {}
+void MemoryBudgetController::Update(VideoMemorySample sample) { sample_ = sample; }
+uint64_t MemoryBudgetController::Available() const {
+    const auto free = sample_.available ? Sub(Sub(sample_.budget, sample_.currentUsage), headroom_) : Sub(fallback_, sample_.currentUsage);
+    return Sub(free, queued_);
+}
+bool MemoryBudgetController::Reserve(AdmissionEstimate estimate) {
+    if (estimate.pendingGenerationOverlap > Available() ||
+        estimate.allocation > Available() - estimate.pendingGenerationOverlap ||
+        estimate.pendingGenerationOverlap > (std::numeric_limits<uint64_t>::max)() - queued_ ||
+        estimate.allocation > (std::numeric_limits<uint64_t>::max)() - queued_ - estimate.pendingGenerationOverlap)
+        return false;
+    queued_ += estimate.allocation + estimate.pendingGenerationOverlap;
+    return true;
+}
+void MemoryBudgetController::Complete(uint64_t reservedBytes) { queued_ = Sub(queued_, reservedBytes); }
+}
diff --git a/DirectX11/ModLoading/MemoryBudgetController.h b/DirectX11/ModLoading/MemoryBudgetController.h
new file mode 100644
index 0000000000000000000000000000000000000000..8efa3476846ad59dc38735b97b646a11d5840036
--- /dev/null
+++ b/DirectX11/ModLoading/MemoryBudgetController.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <cstdint>
+#include <memory>
+namespace ModLoading {
+// Estimates follow object lifetime across cache/generation/device resets. This
+// ledger makes no claim about physical residency and performs no D3D calls.
+class LiveGpuAllocationLedger {
+    struct State;
+public:
+    class Lease {
+    public:
+        ~Lease();
+        Lease(const Lease&) = delete;
+        Lease& operator=(const Lease&) = delete;
+    private:
+        friend class LiveGpuAllocationLedger;
+        explicit Lease(std::shared_ptr<State> state);
+        std::shared_ptr<State> state_;
+        uint64_t bytes_ = 0;
+    };
+    LiveGpuAllocationLedger();
+    // Call only after successful creation. Aliases share the returned token;
+    // overflow rejects registration and the caller must discard that object.
+    std::shared_ptr<const Lease> Track(uint64_t bytes);
+    uint64_t Bytes() const;
+private:
+    std::shared_ptr<State> state_;
+};
+LiveGpuAllocationLedger& ProcessGpuAllocationLedger();
+struct VideoMemorySample {
+    bool available = false;
+    uint64_t budget = 0, currentUsage = 0;
+};
+struct AdmissionEstimate {
+    uint64_t allocation = 0;
+    // Already-live old generations are included in CurrentUsage. Only estimates
+    // not yet reflected in that sample belong here; never subtract them twice.
+    uint64_t pendingGenerationOverlap = 0;
+};
+class MemoryBudgetController {
+public:
+    explicit MemoryBudgetController(uint64_t fallbackLimit = 128ull * 1024 * 1024,
+                                    uint64_t headroom = 128ull * 1024 * 1024);
+    void Update(VideoMemorySample sample);
+    bool Reserve(AdmissionEstimate estimate);
+    void Complete(uint64_t reservedBytes);
+    uint64_t Available() const;
+    uint64_t QueuedBytes() const { return queued_; }
+private:
+    VideoMemorySample sample_;
+    uint64_t fallback_, headroom_, queued_ = 0;
+};
+}
