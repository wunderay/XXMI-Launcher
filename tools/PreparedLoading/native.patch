+namespace ModLoading {
+enum class GpuPreparationKind { Buffer, Texture2D, EncodedDDS, EncodedWIC, VertexShader, PixelShader, GeometryShader, HullShader, DomainShader, ComputeShader, ShaderBundle };
+enum class GpuQueueResult { Queued, AlreadyReady, CompatibilityOnly, Full, WrongDevice, WrongThread, BudgetBlocked };
+struct PreparedSubresource {
+    uint64_t offset = 0, bytes = 0;
+    UINT rowPitch = 0, slicePitch = 0;
+};
+// A retained compiled blob is an immutable byte view for the duration of a
+// request. No shader-bytecode payload copy and no raw blob lifetime borrowing.
+class SharedShaderBytecode {
+public:
+    static SharedShaderBytecode Retain(ID3DBlob* blob, const SourceDigest& digest,
+                                       uint64_t maximumRetainedBytes = 64ull * 1024 * 1024);
+    static uint64_t LiveRetainedBytes();
+    const uint8_t* Data() const { return data_; }
+    size_t Size() const { return size_; }
+    const SourceDigest& Digest() const { return digest_; }
+    explicit operator bool() const { return owner_ && data_ && size_; }
+private:
+    std::shared_ptr<ID3DBlob> owner_;
+    const uint8_t* data_ = nullptr;
+    size_t size_ = 0;
+    SourceDigest digest_{};
+};
+struct ShaderBundleInput {
+    // Legacy stage order: VS, HS, DS, GS, PS, CS. Mask bit with no bytecode
+    // means an explicit null override, never an unresolved/failed compilation.
+    std::array<SharedShaderBytecode, 6> stages;
+    uint32_t stageOverrideMask = 0;
+    bool createBlendState = false, createDepthStencilState = false;
+    bool createRasterizerState = false, createSamplerState = false;
+    D3D11_BLEND_DESC blend{};
+    D3D11_DEPTH_STENCIL_DESC depthStencil{};
+    D3D11_RASTERIZER_DESC rasterizer{};
+    D3D11_SAMPLER_DESC sampler{};
+};
+struct PreparedShaderBundle {
+    ID3D11VertexShader* vertex = nullptr;
+    ID3D11HullShader* hull = nullptr;
+    ID3D11DomainShader* domain = nullptr;
+    ID3D11GeometryShader* geometry = nullptr;
+    ID3D11PixelShader* pixel = nullptr;
+    ID3D11ComputeShader* compute = nullptr;
+    ID3D11BlendState* blend = nullptr;
+    ID3D11DepthStencilState* depthStencil = nullptr;
+    ID3D11RasterizerState* rasterizer = nullptr;
+    ID3D11SamplerState* sampler = nullptr;
+    PreparedShaderBundle() = default;
+    ~PreparedShaderBundle();
+    PreparedShaderBundle(const PreparedShaderBundle&) = delete;
+    PreparedShaderBundle& operator=(const PreparedShaderBundle&) = delete;
+};
+struct GpuPreparationRequest {
+    SourceSnapshot snapshot;
+    // Queue ownership keeps CPU cache accounting live until upload finishes.
+    std::shared_ptr<const PreparedAsset> sourceOwner;
+    GpuPreparationKind kind = GpuPreparationKind::Buffer;
+    SharedShaderBytecode shaderBytecode;
+    std::shared_ptr<const ShaderBundleInput> shaderBundle;
+    D3D11_BUFFER_DESC buffer{};
+    D3D11_TEXTURE2D_DESC texture{};
+    bool createShaderResourceView = false;
+    bool createDefaultShaderResourceView = false;
+    D3D11_SHADER_RESOURCE_VIEW_DESC shaderResourceView{};
+    std::vector<PreparedSubresource> subresources;
+    // Exact DirectXTK no-context memory-loader options. No mip autogeneration.
+    UINT loaderBindFlags = D3D11_BIND_SHADER_RESOURCE, loaderMiscFlags = 0;
+    UINT wicLoaderFlags = 0;
+    bool forceSRGB = false;
+    size_t maxTextureSize = 0;
+    // Caller proves all command dependencies have no copy/clear/output/pool or
+    // runtime mutation. Unknown dependencies MUST leave this false.
+    bool dependencyReadOnly = false;
+    // Required conservative GPU allocation estimate, including driver overhead.
+    uint64_t estimatedBytes = 0;
+    uint64_t pendingGenerationOverlap = 0;
+    // Effective stereo/resource creation policy, decoder/conversion/cache
+    // version etc.; opaque stable values, never addresses or structure padding.
+    std::vector<uint32_t> creationOptions;
+};
+struct PreparedGpuObject {
+    ID3D11Resource* resource = nullptr;
+    ID3D11ShaderResourceView* shaderResourceView = nullptr;
+    ID3D11DeviceChild* shader = nullptr;
+    std::shared_ptr<PreparedShaderBundle> bundle;
+    // One estimate per creation, also attached to the actual D3D child so
+    // pipeline/view COM owners retain it after cache/active leases disappear.
+    std::shared_ptr<const LiveGpuAllocationLedger::Lease> allocationEstimate;
+    ~PreparedGpuObject();
+    PreparedGpuObject() = default;
+    PreparedGpuObject(const PreparedGpuObject&) = delete;
+    PreparedGpuObject& operator=(const PreparedGpuObject&) = delete;
+};
+struct GpuPumpLimits {
+    size_t operations = 2;
+    uint64_t bytes = 16ull * 1024 * 1024;
+    double milliseconds = 2.0;
+};
+// Conservative encoded metadata estimate; zero means unsupported/malformed.
+uint64_t EstimateEncodedTextureBytes(const SourceSnapshot& source, GpuPreparationKind kind);
+struct GpuPumpResult { size_t created = 0, failed = 0, compatibilitySkipped = 0; bool deviceRemoved = false; };
+// Render-owner only. DriverConcurrentCreates is diagnostic, never worker-call
+// authorization. No immediate/deferred-context calls occur here.
+class PreparationPlanner {
+public:
+    explicit PreparationPlanner(uint64_t cacheBytes = 256ull * 1024 * 1024, size_t maxQueued = 32,
+                                uint64_t maxRetainedShaderBytecodeBytes = 64ull * 1024 * 1024);
+    ~PreparationPlanner();
+    // Borrowed real rendering device; owner MUST RetireDevice before teardown.
+    // Epoch must come from AllocateDeviceEpoch per real wrapper lifetime.
+    bool BeginDevice(ID3D11Device* device, DeviceEpoch epoch);
+    void RetireDevice();
+    DeviceEpoch Epoch() const { return cache_.Epoch(); }
+    GpuQueueResult Enqueue(const GpuPreparationRequest& request, DeviceResourceKey* key = nullptr);
+    // Computes immutable identity only, with no queue/cache/driver mutation.
+    bool ComputeKey(const GpuPreparationRequest& request, DeviceResourceKey& key) const;
+    uint64_t QueuedShaderBytecodeBytes() const { return queuedShaderBytecodeBytes_; }
+    // Caller holds legacy LockResourceCreationMode across Pump. Creation can
+    // stall inside the driver; adaptive budgets cannot preempt one driver call.
+    // Default strict gate executes zero driver calls outside loading windows.
+    GpuPumpResult Pump(bool knownLoadingWindow, GpuPumpLimits limits = {});
+    std::shared_ptr<PreparedGpuObject> TryAcquire(const DeviceResourceKey& key);
+    bool Protect(const DeviceResourceKey& key);
+    void Unprotect(const DeviceResourceKey& key);
+    size_t Queued() const { return queue_.size(); }
+    bool SingleThreadedDevice() const { return singleThreaded_; }
+    bool DriverConcurrentCreates() const { return concurrentCreates_; }
+    void SetSafetyHeadroom(uint64_t bytes);
+private:
+    struct QueuedRequest { GpuPreparationRequest request; DeviceResourceKey key; };
+    bool OnOwner() const;
+    bool MakeKey(const GpuPreparationRequest& request, DeviceResourceKey& key) const;
+    VideoMemorySample QueryBudget() const;
+    DeviceResourceKey CanonicalKey(const DeviceResourceKey& requestKey, const PreparedGpuObject& object) const;
+    std::shared_ptr<PreparedGpuObject> Create(const GpuPreparationRequest& request, HRESULT& result);
+    ID3D11Device* device_ = nullptr;
+    std::thread::id owner_;
+    DeviceResourceCache cache_;
+    MemoryBudgetController budget_;
+    std::deque<QueuedRequest> queue_;
+    std::map<DeviceResourceKey, DeviceResourceKey> resolvedKeys_;
+    std::set<DeviceResourceKey> failedKeys_;
+    size_t maxQueued_;
+    uint64_t maxShaderBytecodeBytes_, queuedShaderBytecodeBytes_ = 0;
+    uint64_t queuedBytes_ = 0, safetyHeadroom_ = 128ull * 1024 * 1024;
+    bool singleThreaded_ = false, concurrentCreates_ = false, enabled_ = true;
+};
+}
+#endif
diff --git a/DirectX11/ModLoading/PreparationScheduler.cpp b/DirectX11/ModLoading/PreparationScheduler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..07f15e00562d0ca4a8d08b70691fa3557a56a991
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationScheduler.cpp
@@ -0,0 +1,77 @@
+#include "PreparationScheduler.h"
+#include "SnapshotIO.h"
+#include "DiskAssetCache.h"
+#include <algorithm>
+#include <stdexcept>
+#ifdef _WIN32
+#include <objbase.h>
+#endif
+namespace ModLoading {
+namespace {
+size_t Reservation(const PreparationLimits& limits){return limits.maxAssetBytes<=limits.cpuBytes/2 ? limits.maxAssetBytes*2 : limits.maxAssetBytes;}
+}
+PreparationScheduler::PreparationScheduler(const PreparationLimits& limits,SnapshotReader reader):limits_(limits),cache_(limits.cpuBytes),reservation_(Reservation(limits)),reader_(reader ? std::move(reader) : SnapshotReader(ReadVerifiedSnapshot)){
+ if(!limits.Valid())throw std::invalid_argument("invalid preparation limits");
+ // Fixed maximum avoids spawning or retiring workers at configuration reload.
+ try {for(size_t i=0;i<16;++i)workers_.emplace_back(&PreparationScheduler::Worker,this);}catch(...){Stop();throw;}
+}
+PreparationScheduler::~PreparationScheduler(){Stop();}
+bool PreparationScheduler::Enqueue(const std::wstring& path,Generation generation,int priority){
+ if(path.empty()||path.size()>32767)return false;
+ std::lock_guard<std::mutex> lock(mutex_);if(stopping_||!limits_.cpuBytes||generation<minimum_)return false;
+ auto key=std::make_pair(path,generation);
+ if(compatibility_.count(key))return false;
+ if(cache_.Find(path,generation)||pending_.count(key))return true;
+ if(pending_.size()>=limits_.maxQueued||!cache_.Reserve(reservation_))return false;
+ try {pending_.insert(key);queue_.push_back(Job{path,generation,priority,++order_,limits_.maxAssetBytes,reservation_});}catch(...){pending_.erase(key);cache_.ReleaseReservation(reservation_);return false;}
+ wake_.notify_one();return true;
+}
+std::shared_ptr<const PreparedAsset> PreparationScheduler::TryGet(const std::wstring& path,Generation generation){std::lock_guard<std::mutex> lock(mutex_);if(stopping_||!limits_.cpuBytes||generation<minimum_)return {};return cache_.Find(path,generation);}
+std::string PreparationScheduler::CompatibilityReason(const std::wstring& path,Generation generation){std::lock_guard<std::mutex> lock(mutex_);auto it=compatibility_.find({path,generation});return it==compatibility_.end() ? std::string() : it->second;}
+void PreparationScheduler::CancelQueued(){
+ for(const auto& job:queue_){pending_.erase({job.path,job.generation});cache_.ReleaseReservation(job.reservation);}queue_.clear();
+}
+bool PreparationScheduler::Reconfigure(const PreparationLimits& limits,Generation minimum){
+ if(!limits.Valid())return false;
+ {std::lock_guard<std::mutex> lock(mutex_);if(stopping_)return false;
+ minimum_=(std::max)(minimum_,minimum);CancelQueued();compatibility_.clear();limits_=limits;reservation_=Reservation(limits);cache_.SetCapacity(limits.cpuBytes);}
+ wake_.notify_all();return true;
+}
+bool PreparationScheduler::ConfigureDiskCache(const std::wstring& directory,size_t budgetBytes){
+ if(directory.size()>30000||(!directory.empty()&&(!budgetBytes||uint64_t(budgetBytes)>uint64_t(4096)*1024*1024)))return false;
+ std::shared_ptr<DiskAssetCache> candidate;
+ try {if(!directory.empty())candidate=std::make_shared<DiskAssetCache>(directory,budgetBytes);}catch(...){return false;}
+ std::lock_guard<std::mutex> lock(mutex_);if(stopping_)return false;disk_=std::move(candidate);return true;
+}
+void PreparationScheduler::CancelBefore(Generation generation){
+ std::lock_guard<std::mutex> lock(mutex_);minimum_=(std::max)(minimum_,generation);
+ for(auto it=compatibility_.begin();it!=compatibility_.end();)if(it->first.second<minimum_)it=compatibility_.erase(it);else ++it;
+ for(auto it=queue_.begin();it!=queue_.end();)if(it->generation<minimum_){pending_.erase({it->path,it->generation});cache_.ReleaseReservation(it->reservation);it=queue_.erase(it);}else ++it;
+}
+void PreparationScheduler::Stop(){
+ {std::lock_guard<std::mutex> lock(mutex_);stopping_=true;CancelQueued();}
+ wake_.notify_all();for(auto& worker:workers_)if(worker.joinable())worker.join();workers_.clear();
+}
+void PreparationScheduler::Worker(){
+#ifdef _WIN32
+ HRESULT com=CoInitializeEx(nullptr,COINIT_MULTITHREADED);
+#endif
+ for(;;){
+  Job job;std::shared_ptr<DiskAssetCache> disk;
+  {std::unique_lock<std::mutex> lock(mutex_);wake_.wait(lock,[this]{return stopping_||(!queue_.empty()&&active_<limits_.workers&&limits_.cpuBytes);});if(stopping_)break;
+   auto best=std::max_element(queue_.begin(),queue_.end(),[](const Job&a,const Job&b){return a.priority<b.priority||(a.priority==b.priority&&a.order>b.order);});job=std::move(*best);queue_.erase(best);++active_;disk=disk_;}
+  std::shared_ptr<PreparedAsset> asset;
+  try {asset=std::make_shared<PreparedAsset>();std::string error;if(!reader_(job.path,job.maxBytes,asset->snapshot,error)||!asset->snapshot.bytes||asset->snapshot.bytes->size()>job.maxBytes)asset.reset();else {asset->generation=job.generation;if(asset->snapshot.watchable){size_t decodedBudget=job.reservation-asset->snapshot.bytes->size();bool restored=disk&&disk->Load(asset->snapshot,decodedBudget,asset->decoded);if(restored||DecodeSnapshot(asset->snapshot,decodedBudget,asset->decoded,error)){asset->state=PreparationState::DecodedReady;if(!restored&&disk)disk->Store(asset->snapshot,*asset->decoded);}}}}catch(...){asset.reset();}
+  {std::lock_guard<std::mutex> lock(mutex_);pending_.erase({job.path,job.generation});--active_;
+   if(asset&&!asset->snapshot.watchable){
+    if(!stopping_&&job.generation>=minimum_){try {if(compatibility_.size()>=limits_.maxQueued)compatibility_.erase(compatibility_.begin());compatibility_[{job.path,job.generation}]=asset->snapshot.compatibilityReason.empty() ? "source alias dependencies require legacy loading" : asset->snapshot.compatibilityReason;}catch(const std::bad_alloc&) {}}
+    asset.reset();
+   }
+   if(asset&&!stopping_&&limits_.cpuBytes&&job.generation>=minimum_)cache_.Publish(std::move(asset),job.reservation);else cache_.ReleaseReservation(job.reservation);}
+  wake_.notify_all();
+ }
+#ifdef _WIN32
+ if(SUCCEEDED(com))CoUninitialize();
+#endif
+}
+}
diff --git a/DirectX11/ModLoading/PreparationScheduler.h b/DirectX11/ModLoading/PreparationScheduler.h
new file mode 100644
index 0000000000000000000000000000000000000000..b4e7717159dac7e76efda2e48da3b19e64e4e895
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationScheduler.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "CpuAssetCache.h"
+#include <condition_variable>
+#include <functional>
+#include <set>
+#include <thread>
+namespace ModLoading {
+class DiskAssetCache;
+class PreparationScheduler {
+public:
+ using SnapshotReader = std::function<bool(const std::wstring&, size_t, SourceSnapshot&, std::string&)>;
+ explicit PreparationScheduler(const PreparationLimits& limits = PreparationLimits(), SnapshotReader reader = SnapshotReader());
+ ~PreparationScheduler();
+ PreparationScheduler(const PreparationScheduler&)=delete;
+ PreparationScheduler& operator=(const PreparationScheduler&)=delete;
+ // True includes duplicate or already-ready work. False is a bounded admission miss.
+ bool Enqueue(const std::wstring& path, Generation generation, int priority=0);
+ std::shared_ptr<const PreparedAsset> TryGet(const std::wstring& path, Generation generation);
+ // Empty means no recorded compatibility exclusion; performs no file I/O.
+ std::string CompatibilityReason(const std::wstring& path, Generation generation);
+ // Never joins or waits for worker I/O. Existing reservations remain accounted on shrink.
+ bool Reconfigure(const PreparationLimits& limits, Generation minimum);
+ // Configuration only: no filesystem access, waiting or worker retirement. Empty disables.
+ bool ConfigureDiskCache(const std::wstring& directory,size_t budgetBytes=size_t(1024)*1024*1024);
+ void CancelBefore(Generation generation);
+ void Stop();
+ size_t ResidentBytes() const { return cache_.ResidentBytes(); }
+ size_t ReservedBytes() const { return cache_.ReservedBytes(); }
+private:
+ struct Job { std::wstring path; Generation generation; int priority; uint64_t order; size_t maxBytes; size_t reservation; };
+ void Worker();
+ void CancelQueued();
+ PreparationLimits limits_; CpuAssetCache cache_; size_t reservation_; SnapshotReader reader_; size_t active_=0;
+ std::shared_ptr<DiskAssetCache> disk_;
+ std::mutex mutex_; std::condition_variable wake_; std::vector<std::thread> workers_;
+ std::vector<Job> queue_;std::set<std::pair<std::wstring,Generation>> pending_;
+ std::map<std::pair<std::wstring,Generation>,std::string> compatibility_;
+ Generation minimum_=0;uint64_t order_=0;bool stopping_=false;
+};
+}
diff --git a/DirectX11/ModLoading/PreparationStatus.cpp b/DirectX11/ModLoading/PreparationStatus.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e0de9353c1414c3a3b7008e4f8d27b1fae1195c7
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationStatus.cpp
@@ -0,0 +1,177 @@
+#include "PreparationStatus.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#include "SnapshotIO.h"
+#endif
+namespace ModLoading {
+namespace {
+const char* Mode(PreparationMode mode) {
+    switch (mode) { case PreparationMode::Off: return "off"; case PreparationMode::Adaptive: return "adaptive";
+    case PreparationMode::PreparedProfile: return "prepared_profile"; } return nullptr;
+}
+const char* State(PreparationStatusState state) {
+    switch (state) { case PreparationStatusState::Off: return "off"; case PreparationStatusState::Preparing: return "preparing";
+    case PreparationStatusState::Ready: return "ready"; case PreparationStatusState::Compatibility: return "compatibility";
+    case PreparationStatusState::Failed: return "failed"; } return nullptr;
+}
+std::string EscapeReason(const std::string& reason) {
+    static const char* hex = "0123456789abcdef";
+    std::string result; result.reserve(256 * 6);
+    for (size_t i = 0; i < std::min(size_t(256), reason.size()); ++i) {
+        const unsigned char c = static_cast<unsigned char>(reason[i]);
+        if (c == '"' || c == '\\') { result += '\\'; result += static_cast<char>(c); }
+        else if (c < 32) { result += "\\u00"; result += hex[c >> 4]; result += hex[c & 15]; }
+        else result += c < 127 ? static_cast<char>(c) : '?';
+    }
+    return result;
+}
+struct FixedStatus {
+    PreparationMode mode = PreparationMode::Off;
+    PreparationStatusState state = PreparationStatusState::Off;
+    uint64_t total = 0, cpu = 0, gpu = 0, compatibility = 0, ticket = 0;
+    char reason[257] = "initializing";
+    size_t reasonLength = 12;
+};
+struct Publisher {
+    std::mutex mutex;
+    FixedStatus latest;
+#ifdef _WIN32
+    std::wstring source, output;
+#endif
+};
+std::atomic<Publisher*> publisher{nullptr};
+PreparationStatusFence publicationFence;
+#ifdef _WIN32
+std::mutex initialization;
+uint64_t UnixMs() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count());
+}
+bool WriteAtomic(const std::wstring& directory, const std::string& json) {
+    if (json.empty() || json.size() > 8192) return false;
+    if (!CreateDirectoryW(directory.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) return false;
+    const std::wstring target = directory + L"\\status.json";
+    const std::wstring temporary = target + L".tmp" + std::to_wstring(GetCurrentProcessId());
+    HANDLE file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return false;
+    DWORD written = 0;
+    const bool ok = WriteFile(file, json.data(), static_cast<DWORD>(json.size()), &written, nullptr) != FALSE &&
+        written == json.size() && FlushFileBuffers(file) != FALSE;
+    CloseHandle(file);
+    if (ok && MoveFileExW(temporary.c_str(), target.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+    DeleteFileW(temporary.c_str()); return false;
+}
+DWORD WINAPI Writer(void* parameter) {
+    try {
+        auto* service = static_cast<Publisher*>(parameter);
+        SourceSnapshot image; std::string error;
+        if (!ReadVerifiedSnapshot(service->source, size_t(64) * 1024 * 1024, image, error)) return 0;
+        std::string digest; digest.reserve(64); const char* hex = "0123456789abcdef";
+        for (const auto byte : image.digest) { digest += hex[byte >> 4]; digest += hex[byte & 15]; }
+        image = SourceSnapshot(); // DLL bytes are not retained by process-life service.
+        for (;;) {
+            FixedStatus fixed;
+            { std::lock_guard<std::mutex> lock(service->mutex); fixed = service->latest; }
+            PreparationStatus status; status.mode = fixed.mode; status.state = fixed.state;
+            status.totalAssets = fixed.total; status.cpuReady = fixed.cpu; status.gpuReady = fixed.gpu;
+            status.compatibilityAssets = fixed.compatibility; status.reason.assign(fixed.reason, fixed.reasonLength);
+            // Invalidation is nondroppable even if no renderer/update runs again.
+            // A file already being written can lag until the next heartbeat;
+            // this diagnostic snapshot never authorizes resource activation.
+            if (!publicationFence.Accepts(fixed.ticket) && status.mode != PreparationMode::Off) {
+                status.state = PreparationStatusState::Preparing;
+                status.cpuReady = 0; status.gpuReady = 0;
+                status.reason = "preparation status invalidated";
+            }
+            WriteAtomic(service->output, SerializePreparationStatus(status, GetCurrentProcessId(), digest, UnixMs()));
+            Sleep(1000);
+        }
+    } catch (...) { return 0; } // Status failure must never terminate the host.
+}
+bool Initialize(const void* address, const std::wstring* outputOverride) {
+    std::lock_guard<std::mutex> lock(initialization);
+    if (publisher.load(std::memory_order_acquire)) return true;
+    if (!address) return false;
+    HMODULE module = nullptr, containing = nullptr;
+    // The caller-supplied identity must belong to this publisher's actual DLL.
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCWSTR>(address), &module) ||
+        !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCWSTR>(&InitializePreparationStatus), &containing) || module != containing) return false;
+    wchar_t path[32768] = {};
+    const DWORD length = GetModuleFileNameW(module, path, static_cast<DWORD>(sizeof(path) / sizeof(path[0])));
+    if (!length || length >= sizeof(path) / sizeof(path[0])) return false;
+    std::wstring source(path, length);
+    const size_t separator = source.find_last_of(L"\\/");
+    if (separator == std::wstring::npos) return false;
+    if (outputOverride && (outputOverride->empty() || outputOverride->size() > 32000)) return false;
+    std::unique_ptr<Publisher> service(new Publisher);
+    service->source = source;
+    service->output = outputOverride ? *outputOverride : source.substr(0, separator) + L"\\.xxmi-preparation";
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+        reinterpret_cast<LPCWSTR>(&InitializePreparationStatus), &containing)) return false;
+    HANDLE thread = CreateThread(nullptr, 0, Writer, service.get(), 0, nullptr);
+    if (!thread) return false;
+    CloseHandle(thread);
+    publisher.store(service.release(), std::memory_order_release);
+    return true;
+}
+#endif
+}
+std::string SerializePreparationStatus(const PreparationStatus& status, uint32_t pid,
+    const std::string& digest, uint64_t updated) noexcept {
+    try {
+        const char* mode = Mode(status.mode); const char* state = State(status.state);
+        if (!mode || !state || !pid || digest.size() != 64 || !updated) return {};
+        for (const char c : digest) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return {};
+        std::string json = "{\"schema_version\":1,\"process_id\":" + std::to_string(pid) +
+            ",\"dll_sha256\":\"" + digest + "\",\"updated_unix_ms\":" + std::to_string(updated) +
+            ",\"mode\":\"" + mode + "\",\"state\":\"" + state + "\",\"total_assets\":" + std::to_string(status.totalAssets) +
+            ",\"cpu_ready\":" + std::to_string(status.cpuReady) + ",\"gpu_ready\":" + std::to_string(status.gpuReady) +
+            ",\"compatibility_assets\":" + std::to_string(status.compatibilityAssets) +
+            ",\"reason\":\"" + EscapeReason(status.reason) + "\"}\n";
+        return json.size() <= 8192 ? json : std::string();
+    } catch (...) { return {}; }
+}
+bool InitializePreparationStatus(const void* address) noexcept {
+#ifdef _WIN32
+    try { return Initialize(address, nullptr); } catch (...) { return false; }
+#else
+    (void)address; return false;
+#endif
+}
+bool InitializePreparationStatusForTesting(const void* address, const std::wstring& output) noexcept {
+#ifdef _WIN32
+    try { return Initialize(address, &output); } catch (...) { return false; }
+#else
+    (void)address; (void)output; return false;
+#endif
+}
+uint64_t ReservePreparationStatusTicket() noexcept { return publicationFence.Reserve(); }
+void InvalidatePreparationStatus() noexcept { publicationFence.Invalidate(); }
+void UpdatePreparationStatus(const PreparationStatus& status, uint64_t ticket) noexcept {
+    try {
+        auto* service = publisher.load(std::memory_order_acquire);
+        if (!service || !publicationFence.Accepts(ticket) || !service->mutex.try_lock()) return;
+        // Fixed-size stores only under lock; no allocation or source traversal.
+        FixedStatus& fixed = service->latest;
+        if (!publicationFence.Accepts(ticket) || ticket < fixed.ticket) { service->mutex.unlock(); return; }
+        fixed.ticket = ticket;
+        fixed.mode = status.mode; fixed.state = status.state;
+        fixed.total = status.totalAssets; fixed.cpu = status.cpuReady; fixed.gpu = status.gpuReady;
+        fixed.compatibility = status.compatibilityAssets;
+        fixed.reasonLength = std::min(size_t(256), status.reason.size());
+        std::memcpy(fixed.reason, status.reason.data(), fixed.reasonLength);
+        fixed.reason[fixed.reasonLength] = 0;
+        service->mutex.unlock();
+    } catch (...) {}
+}
+}
