index 0000000000000000000000000000000000000000..1ec970156abae13eafd3b57c4e24c319fed8df08
--- /dev/null
+++ b/DirectX11/ModLoading/GenerationManager.cpp
@@ -0,0 +1,55 @@
+#include "GenerationManager.h"
+
+namespace ModLoading {
+GenerationPin GenerationManager::Pin() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return active_;
+}
+bool GenerationManager::Stage(GenerationPin candidate, BuildVersions current) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!candidate || !candidate->id || !candidate->config ||
+		!(candidate->versions == current) ||
+		(prepared_ && candidate->id < prepared_->id)) return false;
+	prepared_ = std::move(candidate);
+	return true;
+}
+GenerationPin GenerationManager::PreparedPin() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return prepared_;
+}
+void GenerationManager::CancelPrepared() {
+	std::lock_guard<std::mutex> lock(mutex_);
+	prepared_.reset();
+}
+PublishResult GenerationManager::Publish(GenerationPin candidate, BuildVersions current,
+	bool safeBoundary, bool dependenciesReady) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!candidate || !candidate->id || !candidate->config ||
+		!candidate->config->manifest.verified ||
+		candidate->config->disposition != ConfigDisposition::AssetOnly)
+		return PublishResult::InvalidCandidate;
+	if (!(candidate->versions == current) || !(candidate->config->versions == current) ||
+		(active_ && candidate->id <= active_->id))
+		return PublishResult::Stale;
+	if (!safeBoundary) return PublishResult::UnsafeBoundary;
+	if (!dependenciesReady) return PublishResult::DependenciesPending;
+	if (active_ && retired_.size() >= maxRetired_) return PublishResult::RetirementPending;
+	if (active_) retired_.push_back(active_);
+	active_ = std::move(candidate);
+	return PublishResult::Activated;
+}
+size_t GenerationManager::Retire(const std::function<bool(Generation)>& gpuComplete) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	size_t count = 0;
+	for (auto it = retired_.begin(); it != retired_.end();) {
+		if (it->use_count() == 1 && gpuComplete && gpuComplete((*it)->id)) {
+			it = retired_.erase(it); ++count;
+		} else ++it;
+	}
+	return count;
+}
+size_t GenerationManager::RetiredCount() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return retired_.size();
+}
+}
diff --git a/DirectX11/ModLoading/GenerationManager.h b/DirectX11/ModLoading/GenerationManager.h
new file mode 100644
index 0000000000000000000000000000000000000000..176a3d1907dd00dd6ee61ebde32a813ebf3b445b
--- /dev/null
+++ b/DirectX11/ModLoading/GenerationManager.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "ConfigCompiler.h"
+#include <functional>
+#include <mutex>
+
+namespace ModLoading {
+struct ConfigGeneration {
+	Generation id = 0;
+	// CPU staging/device ownership stamp, independent of the immutable config
+	// compilation stamp. Updating this metadata never reparses or hashes config.
+	BuildVersions versions;
+	std::shared_ptr<const CompiledConfig> config;
+	// Optional owning handles: never raw pointers into another generation.
+	std::vector<std::shared_ptr<const void>> dependencies;
+};
+using GenerationPin = std::shared_ptr<const ConfigGeneration>;
+enum class PublishResult { Activated, InvalidCandidate, Stale, UnsafeBoundary, DependenciesPending, RetirementPending };
+// This manages detached preparation ownership only. Legacy global config and
+// raw command references are not swapped, and retain their compatibility path.
+class GenerationManager {
+public:
+	explicit GenerationManager(size_t maxRetired = 8) : maxRetired_(maxRetired) {}
+	GenerationPin Pin() const;
+	// Staging retains completed CPU preparation only; CompatibilityOnly is
+	// permitted and no live activation/readiness is inferred. Readers pin the
+	// immutable staged batch while cancellation/replacement drops manager ownership.
+	bool Stage(GenerationPin candidate, BuildVersions current);
+	GenerationPin PreparedPin() const;
+	void CancelPrepared();
+	PublishResult Publish(GenerationPin candidate, BuildVersions current,
+		bool safeBoundary, bool dependenciesReady);
+	// A nonblocking fence query must confirm old GPU work complete. CPU pins
+	// independently delay retirement; no render-thread spinning is permitted.
+	size_t Retire(const std::function<bool(Generation)>& gpuComplete);
+	size_t RetiredCount() const;
+private:
+	mutable std::mutex mutex_;
+	GenerationPin active_;
+	GenerationPin prepared_;
+	std::vector<GenerationPin> retired_;
+	size_t maxRetired_;
+};
+}
diff --git a/DirectX11/ModLoading/IncrementalConfigCache.cpp b/DirectX11/ModLoading/IncrementalConfigCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0d1704b36440b418c6d8d5d945ae5bde497dd590
--- /dev/null
+++ b/DirectX11/ModLoading/IncrementalConfigCache.cpp
@@ -0,0 +1,339 @@
+#include "IncrementalConfigCache.h"
+#include "SnapshotIO.h"
+#include <algorithm>
+#include <map>
+#include <sstream>
+
+namespace ModLoading {
+namespace {
+std::string Trim(const std::string& s) {
+	const auto begin = s.find_first_not_of(" \t");
+	if (begin == std::string::npos) return {};
+	return s.substr(begin, s.find_last_not_of(" \t") - begin + 1);
+}
+std::string Lower(std::string s) {
+	for (auto& c : s) if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+	return s;
+}
+std::shared_ptr<const ConfigFileIR> ParseFile(const SourceSnapshot& source, std::shared_ptr<const void> ownership,
+	std::shared_ptr<const void> budgetIdentity) {
+	auto ir = std::make_shared<ConfigFileIR>();
+	ir->ownership = std::move(ownership);
+	ir->budgetIdentity = std::move(budgetIdentity);
+	ir->digest = source.digest;
+	std::string input(source.bytes->begin(), source.bytes->end());
+	const auto eof = input.find('\x1a');
+	if (eof != std::string::npos) input.resize(eof);
+	std::istringstream stream(input);
+	std::string raw, section;
+	size_t number = 0;
+	while (std::getline(stream, raw)) {
+		ConfigPhysicalLineIR physical;
+		physical.raw = raw;
+		physical.line = ++number;
+		// File streams in the native parser use Windows text mode. Preserve the
+		// original physical bytes separately, but normalize CRLF for replay.
+		if (!stream.eof() && !raw.empty() && raw.back() == '\r') raw.pop_back();
+		if (number == 1 && raw.compare(0, 3, "\xef\xbb\xbf") == 0) raw.erase(0, 3);
+		physical.text = Trim(raw);
+		const auto& line = physical.text;
+		if (line.empty()) physical.kind = ConfigPhysicalLineIR::Kind::Empty;
+		else if (line[0] == ';') physical.kind = ConfigPhysicalLineIR::Kind::Comment;
+		else if (line[0] == '[') {
+			physical.kind = ConfigPhysicalLineIR::Kind::Section;
+			auto last = line.find(']');
+			if (last == std::string::npos) last = line.size();
+			const auto first = line.find_first_not_of(" \t", 1);
+			last = line.find_last_not_of(" \t", last - 1);
+			if (first == std::string::npos || last < first) {
+				ir->ambiguousDependencies = true;
+			} else physical.section = line.substr(first, last - first + 1);
+			section = Lower(physical.section);
+		} else {
+			physical.kind = ConfigPhysicalLineIR::Kind::Statement;
+			const auto equal = line.find('=');
+			physical.hasEquals = equal != std::string::npos;
+			if (physical.hasEquals) {
+				// Match ParseIniKeyValLine and ParseIniPreamble, including their
+				// existing first-'=' behavior. Casing is retained for replay.
+				const auto last = line.find_last_not_of(" \t", equal - 1);
+				physical.key = line.substr(0, last + 1);
+				const auto first = line.find_first_not_of(" \t", equal + 1);
+				if (first != std::string::npos) physical.value = line.substr(first);
+			}
+			ConfigLineIR item;
+			item.section = section;
+			item.raw = line;
+			item.line = number;
+			item.key = Lower(physical.key);
+			item.value = physical.value;
+			if (section.compare(0, 7, "include") == 0) {
+				if (item.key == "include" || item.key == "user_config")
+					ir->declaredIncludes.push_back(item.value);
+				else ir->ambiguousDependencies = true;
+			}
+			if (section.empty() && item.key == "condition") ir->ambiguousDependencies = true;
+			ir->lines.push_back(std::move(item));
+		}
+		ir->physicalLines.push_back(std::move(physical));
+	}
+	return ir;
+}
+size_t Cost(const SourceSnapshot& source, const ConfigFileIR& ir) {
+	size_t size = source.bytes->size() + sizeof(ConfigFileIR) + sizeof(SourceSnapshot) +
+		source.compatibilityReason.size();
+	for (const auto& line : ir.lines)
+		size += sizeof(ConfigLineIR) + line.section.size() + line.key.size() + line.value.size() + line.raw.size();
+	for (const auto& line : ir.physicalLines)
+		size += sizeof(ConfigPhysicalLineIR) + line.raw.size() + line.text.size() +
+			line.section.size() + line.key.size() + line.value.size();
+	for (const auto& include : ir.declaredIncludes) size += include.size() + sizeof(std::string);
+	return size + source.path.size() * sizeof(wchar_t);
+}
+std::wstring NormalizePath(std::wstring path) {
+	for (auto& c : path) {
+		if (c == L'\\') c = L'/';
+		if (c >= L'A' && c <= L'Z') c += L'a' - L'A';
+	}
+	const bool absolute = !path.empty() && path[0] == L'/';
+	std::vector<std::wstring> parts;
+	size_t begin = 0;
+	while (begin <= path.size()) {
+		const auto end = path.find(L'/', begin);
+		const auto part = path.substr(begin, end == std::wstring::npos ? end : end - begin);
+		if (part == L".." && !parts.empty() && parts.back() != L"..") parts.pop_back();
+		else if (!part.empty() && part != L".") parts.push_back(part);
+		if (end == std::wstring::npos) break;
+		begin = end + 1;
+	}
+	std::wstring result = absolute ? L"/" : L"";
+	for (const auto& part : parts) {
+		if (!result.empty() && result.back() != L'/') result += L'/';
+		result += part;
+	}
+	return result;
+}
+std::wstring Directory(std::wstring path) {
+	for (auto& c : path) if (c == L'\\') c = L'/';
+	const auto end = path.find_last_of(L'/');
+	return end == std::wstring::npos ? L"" : path.substr(0, end + 1);
+}
+bool Absolute(const std::wstring& path) {
+	return !path.empty() && (path[0] == L'/' || path[0] == L'\\' ||
+		(path.size() > 1 && path[1] == L':'));
+}
+bool IncludePath(const std::string& value, std::wstring& path) {
+	if (value.empty()) return false;
+	for (unsigned char c : value) {
+		// These paths need native Unicode/glob/condition interpretation. Never
+		// infer a partial dependency closure from them.
+		if (c >= 128 || c < 32 || std::string("*?$%\";").find(c) != std::string::npos) return false;
+		path.push_back(static_cast<wchar_t>(c));
+	}
+	return true;
+}
+bool Graph(const ConfigSourceManifest& sources,
+	const std::vector<std::shared_ptr<const ConfigFileIR>>& files,
+	std::vector<std::vector<size_t>>& dependencies) {
+	dependencies.resize(files.size());
+	std::map<std::wstring, size_t> paths;
+	bool certain = true;
+	for (size_t i = 0; i < files.size(); ++i)
+		if (!paths.emplace(NormalizePath(sources.sources[i].snapshot.path), i).second) certain = false;
+	const auto root = sources.sources.empty() ? L"" : Directory(sources.sources.front().snapshot.path);
+	for (size_t i = 0; i < files.size(); ++i) {
+		const auto& ir = *files[i];
+		if (ir.ambiguousDependencies) certain = false;
+		std::wstring iniNamespace = sources.sources[i].iniNamespace;
+		for (const auto& line : ir.lines) {
+			if (line.section.empty() && line.key == "namespace") {
+				std::wstring name;
+				if (!IncludePath(line.value, name)) certain = false;
+				else iniNamespace = std::move(name);
+			}
+			if (line.section.compare(0, 7, "include") != 0) continue;
+			// Explicit namespace separators in a section header can override
+			// the source's namespace path. Leave those to native replay.
+			if (line.section.find_first_of("/\\") != std::string::npos) { certain = false; continue; }
+			if (line.key != "include" && line.key != "user_config") { certain = false; continue; }
+			std::wstring value;
+			if (!IncludePath(line.value, value)) { certain = false; continue; }
+			std::wstring path;
+			if (line.key == "user_config") path = Absolute(value) ? value : root + value;
+			else {
+				if (Absolute(value)) { certain = false; continue; }
+				path = root + Directory(iniNamespace) + value;
+			}
+			const auto target = paths.find(NormalizePath(path));
+			if (target == paths.end()) { certain = false; continue; }
+			dependencies[i].push_back(target->second);
+		}
+		auto& edges = dependencies[i];
+		std::sort(edges.begin(), edges.end());
+		edges.erase(std::unique(edges.begin(), edges.end()), edges.end());
+	}
+	return certain;
+}
+bool SameLayout(const ConfigSourceManifest& a, const ConfigSourceManifest& b) {
+	if (!a.verified || !b.verified || a.sources.size() != b.sources.size() ||
+		a.recursiveIncludes != b.recursiveIncludes || a.userConfig != b.userConfig) return false;
+	for (size_t i = 0; i < a.sources.size(); ++i)
+		if (a.sources[i].snapshot.path != b.sources[i].snapshot.path ||
+			a.sources[i].iniNamespace != b.sources[i].iniNamespace) return false;
+	return true;
+}
+bool SameBytes(const SourceSnapshot& a, const SourceSnapshot& b) {
+	return a.bytes && b.bytes && a.digest == b.digest && *a.bytes == *b.bytes;
+}
+
+}
+IncrementalConfigCache::IncrementalConfigCache(size_t maxBytes, size_t maxFiles)
+	: maxBytes_(maxBytes), maxFiles_(maxFiles) {}
+std::shared_ptr<const ConfigFileIR> IncrementalConfigCache::Parse(const SourceSnapshot& source,
+	bool forceFull, bool& reused,
+	const std::function<std::shared_ptr<const void>(uint64_t)>& reserve,
+	std::shared_ptr<const void> budgetIdentity) {
+	reused = false;
+	if (!source.bytes || HashBytes(source.bytes->data(), source.bytes->size()) != source.digest) return {};
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!forceFull) for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+		// Path and full content are checked, even if a digest collision occurs.
+		if ((!reserve || (budgetIdentity && it->ir->ownership && it->ir->budgetIdentity == budgetIdentity)) &&
+			it->source.path == source.path && it->source.digest == source.digest &&
+			*it->source.bytes == *source.bytes) {
+			auto result = it->ir;
+			entries_.splice(entries_.begin(), entries_, it);
+			reused = true;
+			return result;
+		}
+	}
+	// Physical and semantic line vectors, their strings, stream conversion,
+	// and the cache entry's path all allocate before semantic linking starts.
+	// Source bytes already have a shared charged owner and are not charged here.
+	std::shared_ptr<const void> ownership;
+	if (reserve) {
+		uint64_t lines = 1, sectionLength = 0;
+		const auto& input = *source.bytes;
+		for (size_t begin = 0; begin < input.size();) {
+			size_t end = begin;
+			while (end < input.size() && input[end] != '\n') ++end;
+			size_t first = begin;
+			if (!begin && end >= 3 && input[0] == 0xef && input[1] == 0xbb && input[2] == 0xbf)
+				first = 3;
+			while (first < end && (input[first] == ' ' || input[first] == '\t')) ++first;
+			if (first < end && input[first] == '[')
+				sectionLength = (std::max)(sectionLength, uint64_t(end - first));
+			if (end < input.size()) ++lines;
+			begin = end + 1;
+		}
+		const uint64_t bytes = 65536 + uint64_t(input.size()) * 32 +
+			lines * (1024 + sectionLength * 4) + uint64_t(source.path.size()) * sizeof(wchar_t) * 4;
+		ownership = reserve(bytes);
+		while (!ownership && !entries_.empty()) {
+			bytes_ -= entries_.back().bytes;
+			entries_.pop_back();
+			ownership = reserve(bytes);
+		}
+		if (!ownership) return {};
+	}
+	auto result = ParseFile(source, std::move(ownership), std::move(budgetIdentity));
+	const auto cost = Cost(source, *result);
+	if (maxFiles_ && cost <= maxBytes_) {
+		for (auto it = entries_.begin(); it != entries_.end();) {
+			if (it->source.path == source.path) { bytes_ -= it->bytes; it = entries_.erase(it); }
+			else ++it;
+		}
+		while (!entries_.empty() && (entries_.size() >= maxFiles_ || bytes_ > maxBytes_ - cost)) {
+			bytes_ -= entries_.back().bytes;
+			entries_.pop_back();
+		}
+		entries_.push_front(Entry{result, source, cost});
+		bytes_ += cost;
+	}
+	return result;
+}
+ConfigDependencyPlan IncrementalConfigCache::Plan(const ConfigSourceManifest& sources,
+	const std::shared_ptr<const CompiledConfig>& baseline, bool forceFull) {
+	ConfigDependencyPlan plan;
+	const auto schema = Schema();
+	if (!sources.verified || sources.sources.empty()) {
+		plan.reason = "Unverified or empty config source manifest";
+		return plan;
+	}
+	// Validate the complete immutable candidate before admitting any entries.
+	for (const auto& source : sources.sources) {
+		const auto& snapshot = source.snapshot;
+		if (!snapshot.bytes || HashBytes(snapshot.bytes->data(), snapshot.bytes->size()) != snapshot.digest) {
+			plan.reason = "Missing or inconsistent config source snapshot";
+			return plan;
+		}
+	}
+	const auto count = sources.sources.size();
+	bool full = forceFull || !baseline || !SameLayout(sources, baseline->manifest) ||
+		baseline->parserVersion != schema.parser || baseline->schemaVersion != schema.schema ||
+		baseline->abiVersion != schema.abi || baseline->files.size() != count ||
+		baseline->dependencies.size() != count;
+	if (!full) {
+		std::vector<std::vector<size_t>> previousDependencies;
+		// An ambiguous old graph cannot establish which old dependents became
+		// unreachable when a conditional/dynamic declaration was removed.
+		if (!Graph(baseline->manifest, baseline->files, previousDependencies)) full = true;
+	}
+	std::vector<bool> parsed(count, false), invalidated(count, full);
+	plan.files.reserve(count);
+	for (size_t i = 0; i < count; ++i) {
+		if (!full && !SameBytes(sources.sources[i].snapshot, baseline->manifest.sources[i].snapshot)) invalidated[i] = true;
+		bool reused = false;
+		auto ir = Parse(sources.sources[i].snapshot, invalidated[i], reused, sources.reserve, sources.budgetIdentity);
+		if (!ir) { plan.reason = "Invalid config snapshot or IR CPU admission exhausted"; return plan; }
+		parsed[i] = !reused;
+		plan.files.push_back(std::move(ir));
+	}
+	if (!Graph(sources, plan.files, plan.dependencies)) full = true;
+	plan.dependents.resize(count);
+	for (size_t source = 0; source < count; ++source)
+		for (auto target : plan.dependencies[source]) plan.dependents[target].push_back(source);
+	if (!full) {
+		// Include both graphs: deleting an edge must invalidate its old parents
+		// just as adding one invalidates its new parents.
+		auto affectedBy = plan.dependents;
+		for (size_t source = 0; source < count; ++source) {
+			for (auto target : baseline->dependencies[source]) {
+				if (target >= count) { full = true; break; }
+				affectedBy[target].push_back(source);
+			}
+			if (full) break;
+		}
+		if (!full) {
+			std::vector<size_t> queue;
+			for (size_t i = 0; i < count; ++i) if (invalidated[i]) queue.push_back(i);
+			for (size_t at = 0; at < queue.size(); ++at)
+				for (auto parent : affectedBy[queue[at]])
+					if (!invalidated[parent]) { invalidated[parent] = true; queue.push_back(parent); }
+		}
+	}
+	for (size_t i = 0; i < count; ++i) {
+		if (full) invalidated[i] = true;
+		if (invalidated[i] && !parsed[i]) {
+			bool reused = false;
+			plan.files[i] = Parse(sources.sources[i].snapshot, true, reused, sources.reserve, sources.budgetIdentity);
+			if (!plan.files[i]) { plan.reason = "Config IR CPU admission exhausted"; return plan; }
+			parsed[i] = true;
+		}
+		if (invalidated[i]) plan.invalidated.push_back(i);
+		if (parsed[i]) ++plan.parsedFiles; else ++plan.reusedFiles;
+	}
+	plan.fullRebuild = full;
+	plan.valid = Schema() == schema;
+	if (!plan.valid) plan.reason = "Config schema changed during incremental compilation";
+	return plan;
+}
+
+void IncrementalConfigCache::SetSchema(ConfigSchema schema) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!(schema_ == schema)) { entries_.clear(); bytes_ = 0; schema_ = schema; }
+}
+ConfigSchema IncrementalConfigCache::Schema() const { std::lock_guard<std::mutex> lock(mutex_); return schema_; }
+size_t IncrementalConfigCache::Bytes() const { std::lock_guard<std::mutex> lock(mutex_); return bytes_; }
+size_t IncrementalConfigCache::Entries() const { std::lock_guard<std::mutex> lock(mutex_); return entries_.size(); }
+}
diff --git a/DirectX11/ModLoading/IncrementalConfigCache.h b/DirectX11/ModLoading/IncrementalConfigCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..c3b173ad43cb0fad5bc8d496f86d3709f7e512e3
--- /dev/null
+++ b/DirectX11/ModLoading/IncrementalConfigCache.h
@@ -0,0 +1,52 @@
+#pragma once
+#include "ConfigCompiler.h"
+#include <list>
+#include <mutex>
+
+namespace ModLoading {
+// Memory-only cache: the IR contains no live/global runtime references. Changing
+// parser/schema/ABI invalidates all entries. The accounted payload bound includes
+// retained source bytes; it is not an aggregate process-allocation limit.
+struct ConfigSchema {
+	uint32_t parser = 2, schema = 2, abi = 2;
+	bool operator==(const ConfigSchema& o) const {
+		return parser == o.parser && schema == o.schema && abi == o.abi;
+	}
+};
+// Source-order graph edges point from an including file to its dependencies.
+// Every entry is immutable and can be replayed by the detached semantic parser.
+struct ConfigDependencyPlan {
+	std::vector<std::shared_ptr<const ConfigFileIR>> files;
+	std::vector<std::vector<size_t>> dependencies, dependents;
+	std::vector<size_t> invalidated;
+	size_t parsedFiles = 0, reusedFiles = 0;
+	bool fullRebuild = true, valid = false;
+	std::string reason;
+};
+class IncrementalConfigCache {
+public:
+	explicit IncrementalConfigCache(size_t maxBytes = 16 * 1024 * 1024, size_t maxFiles = 256);
+	std::shared_ptr<const ConfigFileIR> Parse(const SourceSnapshot& source, bool forceFull, bool& reused,
+		const std::function<std::shared_ptr<const void>(uint64_t)>& reserve = {},
+		std::shared_ptr<const void> budgetIdentity = {});
+	ConfigDependencyPlan Plan(const ConfigSourceManifest& sources,
+		const std::shared_ptr<const CompiledConfig>& baseline, bool forceFull = false);
+	void SetSchema(ConfigSchema schema);
+	ConfigSchema Schema() const;
+	// Cache-owned accounted payload only. A caller's immutable compiled results
+	// may independently pin evicted source/IR objects; their budget is external.
+	size_t Bytes() const;
+	size_t Entries() const;
+private:
+	struct Entry {
+		// The IR reservation also covers this entry's copied source metadata.
+		std::shared_ptr<const ConfigFileIR> ir;
+		SourceSnapshot source;
+		size_t bytes;
+	};
+	size_t maxBytes_, maxFiles_, bytes_ = 0;
+	ConfigSchema schema_;
+	mutable std::mutex mutex_;
+	std::list<Entry> entries_;
+};
+}
diff --git a/DirectX11/ModLoading/LoadTrace.cpp b/DirectX11/ModLoading/LoadTrace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b66ff9c55b3bef3296861b94d1ac415a5de40631
--- /dev/null
+++ b/DirectX11/ModLoading/LoadTrace.cpp
@@ -0,0 +1,348 @@
+#include "LoadTrace.h"
+
+#include <algorithm>
+#include <chrono>
+#include <ostream>
+#include <thread>
+
+namespace ModLoading {
+
+const std::size_t LoadTrace::Capacity;
+const std::int64_t LoadTrace::UnknownResult;
+
+namespace {
+const char* StageName(LoadStage stage) noexcept
+{
+	switch (stage) {
+	case LoadStage::Discovery: return "discovery";
+	case LoadStage::FileRead: return "file_read";
+	case LoadStage::Decode: return "decode";
+	case LoadStage::ShaderPreparation: return "shader_preparation";
+	case LoadStage::GpuCreation: return "gpu_creation";
+	case LoadStage::ViewCreation: return "view_creation";
+	case LoadStage::CommandList: return "command_list";
+	case LoadStage::ConfigReload: return "config_reload";
+	case LoadStage::ReadinessWait: return "readiness_wait";
+	case LoadStage::Activation: return "activation";
+	case LoadStage::FirstCorrectFrame: return "first_correct_frame";
+	case LoadStage::FileLoad: return "file_load_combined";
+	case LoadStage::Present: return "present_cpu";
+	}
+	return "unknown";
+}
+}
+
+LoadTrace::LoadTrace() noexcept
+	: session_(0), frame_(0), commandListTracing_(false), entering_(0),
+	  currentCapture_(nullptr), head_(0), tail_(0), accepted_(0),
+	  droppedFull_(0), droppedContention_(0), exported_(0)
+{
+	for (std::size_t i = 0; i < Capacity; ++i) records_[i].sequence.store(i);
+}
+
+LoadTrace& LoadTrace::Get() noexcept
+{
+	static LoadTrace trace;
+	return trace;
+}
+
+void LoadTrace::SetEnabled(bool enabled) noexcept
+{
+	while (controlLock_.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+	const auto previous = session_.load(std::memory_order_acquire);
+	// Direct control transitions explicitly terminate graceful finalization.
+	if (!enabled || !(previous & 1)) {
+		Capture* current = currentCapture_.load(std::memory_order_acquire);
+		if (current) current->closed.store(true, std::memory_order_release);
+	}
+	if (((previous & 1) != 0) != enabled) {
+		if (!enabled) session_.store(previous + 1, std::memory_order_seq_cst);
+		else {
+			// Old entrants recheck the session before touching a capture bank.
+			// A bank stays reserved by every active scope and queued record.
+			while (entering_.load(std::memory_order_seq_cst)) std::this_thread::yield();
+			for (auto& capture : captures_) {
+				if (capture.references.load(std::memory_order_acquire)) continue;
+				capture.session.store(0, std::memory_order_release);
+				capture.accepted.store(0); capture.drained.store(0);
+				capture.full.store(0); capture.contention.store(0); capture.stale.store(0);
+				capture.finishing.store(false); capture.closed.store(false);
+				capture.session.store(previous + 1, std::memory_order_release);
+				currentCapture_.store(&capture, std::memory_order_release);
+				session_.store(previous + 1, std::memory_order_seq_cst);
+				break;
+			}
+		}
+	}
+	controlLock_.clear(std::memory_order_release);
+}
+
+std::uint64_t LoadTrace::CaptureSession() const noexcept
+{
+	return session_.load(std::memory_order_acquire);
+}
+
+LoadTrace::Capture* LoadTrace::AcquireCapture(std::uint64_t session) noexcept
+{
+	entering_.fetch_add(1, std::memory_order_seq_cst);
+	Capture* capture = nullptr;
+	if (session_.load(std::memory_order_seq_cst) == session) {
+		capture = currentCapture_.load(std::memory_order_acquire);
+		capture->references.fetch_add(1, std::memory_order_acq_rel);
+	}
+	entering_.fetch_sub(1, std::memory_order_seq_cst);
+	return capture;
+}
+
+bool LoadTrace::RequestEndCapture(std::uint64_t expectedSession) noexcept
+{
+	while (controlLock_.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+	const auto current = session_.load(std::memory_order_acquire);
+	Capture* capture = currentCapture_.load(std::memory_order_acquire);
+	const bool matched = (expectedSession & 1) && capture &&
+		capture->session.load(std::memory_order_acquire) == expectedSession &&
+		(current == expectedSession || current == expectedSession + 1);
+	if (matched && current == expectedSession) {
+		capture->finishing.store(true, std::memory_order_release);
+		session_.store(expectedSession + 1, std::memory_order_seq_cst);
+	}
+	controlLock_.clear(std::memory_order_release);
+	return matched;
+}
+
+bool LoadTrace::EndCapture(std::uint64_t expectedSession) noexcept
+{
+	while (controlLock_.test_and_set(std::memory_order_acquire)) std::this_thread::yield();
+	const auto current = session_.load(std::memory_order_acquire);
+	Capture* capture = currentCapture_.load(std::memory_order_acquire);
+	const bool matched = (expectedSession & 1) && capture &&
+		capture->session.load(std::memory_order_acquire) == expectedSession &&
+		(current == expectedSession || current == expectedSession + 1);
+	if (matched) {
+		capture->closed.store(true, std::memory_order_release);
+		if (current == expectedSession) session_.store(expectedSession + 1, std::memory_order_seq_cst);
+	}
+	controlLock_.clear(std::memory_order_release);
+	return matched;
+}
+
+LoadTraceCaptureStats LoadTrace::GetCaptureStats(std::uint64_t session) const noexcept
+{
+	for (const auto& capture : captures_) {
+		if (capture.session.load(std::memory_order_acquire) != session) continue;
+		// Read liveness before counters. Once stopped and quiescent, the
+		// acquire observes all completed submissions/drains. Reading liveness
+		// last could incorrectly pair pre-submission counters with post-drain 0.
+		const auto outstanding = entering_.load(std::memory_order_seq_cst)
+			+ capture.references.load(std::memory_order_acquire);
+		const LoadTraceCaptureStats stats = { session, capture.accepted.load(), capture.drained.load(),
+			capture.full.load(), capture.contention.load(), capture.stale.load(), outstanding };
+		if (capture.session.load(std::memory_order_acquire) == session) return stats;
+	}
+	return {0, 0, 0, 0, 0, 0, 0};
+}
+
+bool LoadTrace::IsEnabled() const noexcept
+{
+	return (session_.load(std::memory_order_relaxed) & 1) != 0;
+}
+
+void LoadTrace::SetCommandListTracing(bool enabled) noexcept
+{
+	commandListTracing_.store(enabled, std::memory_order_relaxed);
+}
+
+std::uint64_t LoadTrace::AdvanceFrame() noexcept
+{
+	return frame_.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+std::uint64_t LoadTrace::CurrentFrame() const noexcept
+{
+	return frame_.load(std::memory_order_relaxed);
+}
+
+std::uint64_t LoadTrace::NowNs() noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+std::uint64_t LoadTrace::ThreadId() noexcept
+{
+	static std::atomic<std::uint64_t> nextId(0);
+	static thread_local const std::uint64_t id = nextId.fetch_add(1, std::memory_order_relaxed) + 1;
+	return id;
+}
+
+void LoadTrace::RecordInstant(LoadStage stage, std::uint64_t objectId,
+							  std::uint64_t bytes, std::int64_t result) noexcept
+{
+	const std::uint64_t session = session_.load(std::memory_order_relaxed);
+	if (!(session & 1)) return;
+	if (stage == LoadStage::CommandList && !commandListTracing_.load(std::memory_order_relaxed)) return;
+	const std::uint64_t frame = CurrentFrame();
+	const LoadTraceRecord record = {stage, LoadTraceKind::Instant, session,
+		NowNs(), 0, frame, frame, ThreadId(), objectId, bytes, result};
+	Capture* capture = AcquireCapture(session);
+	if (!capture) return;
+	Submit(record, session, *capture);
+	capture->references.fetch_sub(1, std::memory_order_release);
+}
+
+void LoadTrace::Submit(const LoadTraceRecord& record, std::uint64_t session, Capture& capture) noexcept
+{
+	if (capture.closed.load(std::memory_order_acquire) ||
+		(session_.load(std::memory_order_acquire) != session &&
+		 !capture.finishing.load(std::memory_order_acquire))) {
+		capture.stale.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	std::uint64_t position = tail_.load(std::memory_order_relaxed);
+	Slot& slot = records_[position % Capacity];
+	if (slot.sequence.load(std::memory_order_acquire) != position) {
+		if (position - head_.load(std::memory_order_acquire) >= Capacity) {
+			droppedFull_.fetch_add(1, std::memory_order_relaxed);
+			capture.full.fetch_add(1, std::memory_order_relaxed);
+		} else {
+			droppedContention_.fetch_add(1, std::memory_order_relaxed);
+			capture.contention.fetch_add(1, std::memory_order_relaxed);
+		}
+		return;
+	}
+	if (!tail_.compare_exchange_strong(position, position + 1, std::memory_order_relaxed)) {
+		droppedContention_.fetch_add(1, std::memory_order_relaxed);
+		capture.contention.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	slot.record = record;
+	slot.capture = &capture;
+	capture.references.fetch_add(1, std::memory_order_relaxed);
+	capture.accepted.fetch_add(1, std::memory_order_relaxed);
+	accepted_.fetch_add(1, std::memory_order_relaxed);
+	slot.sequence.store(position + 1, std::memory_order_release);
+}
+
+LoadTraceStats LoadTrace::GetStats() const noexcept
+{
+	return {accepted_.load(std::memory_order_relaxed),
+		droppedFull_.load(std::memory_order_relaxed),
+		droppedContention_.load(std::memory_order_relaxed),
+		exported_.load(std::memory_order_relaxed)};
+}
+
+std::size_t LoadTrace::Drain(LoadTraceRecord* output, std::size_t maximum) noexcept
+{
+	std::size_t drained = 0;
+	TryDrain(output, maximum, drained);
+	return drained;
+}
+
+LoadTrace::DrainStatus LoadTrace::TryDrain(LoadTraceRecord* output, std::size_t maximum,
+										  std::size_t& drained) noexcept
+{
+	drained = 0;
+	if (!output || !maximum) return DrainStatus::Empty;
+	if (lock_.test_and_set(std::memory_order_acquire)) return DrainStatus::Busy;
+	std::size_t count = 0;
+	std::uint64_t position = head_.load(std::memory_order_relaxed);
+	while (count < maximum) {
+		Slot& slot = records_[position % Capacity];
+		if (slot.sequence.load(std::memory_order_acquire) != position + 1) break;
+		output[count++] = slot.record;
+		slot.capture->drained.fetch_add(1, std::memory_order_relaxed);
+		slot.capture->references.fetch_sub(1, std::memory_order_release);
+		slot.sequence.store(position + Capacity, std::memory_order_release);
+		++position;
+		head_.store(position, std::memory_order_release);
+	}
+	exported_.fetch_add(count, std::memory_order_relaxed);
+	lock_.clear(std::memory_order_release);
+	drained = count;
+	return count ? DrainStatus::Drained : DrainStatus::Empty;
+}
+
+std::size_t LoadTrace::ExportCsv(std::ostream& output)
+{
+	WriteCsvHeader(output);
+	// Bounded stack buffer keeps formatting and potentially blocking I/O out of
+	// the producer critical section. Even continuous producers cannot extend
+	// this export beyond the fixed record budget.
+	LoadTraceRecord batch[128];
+	std::size_t total = 0;
+	std::size_t busyAttempts = 0;
+	bool incomplete = false;
+	while (total < Capacity && output) {
+		std::size_t count = 0;
+		const DrainStatus status = TryDrain(batch,
+			(std::min)(std::size_t(128), Capacity - total), count);
+		if (status == DrainStatus::Busy) {
+			if (++busyAttempts == 64) {
+				incomplete = true;
+				break;
+			}
+			std::this_thread::yield();
+			continue;
+		}
+		if (status == DrainStatus::Empty) break;
+		busyAttempts = 0;
+		total += count;
+		for (std::size_t i = 0; i < count; ++i) {
+			WriteCsvRecord(output, batch[i]);
+		}
+	}
+	const LoadTraceStats stats = GetStats();
+	output << "# cumulative_accepted=" << stats.accepted
+		   << ";dropped_full=" << stats.droppedFull
+		   << ";dropped_contention=" << stats.droppedContention
+		   << ";drained=" << stats.exported << '\n';
+	if (incomplete) {
+		output << "# export_incomplete=contention_retry_limit;queued_records_retained\n";
+		output.setstate(std::ios::failbit);
+	}
+	return total;
+}
+
+void LoadTrace::WriteCsvHeader(std::ostream& output)
+{
+	output << "# load_trace_v1; monotonic_ns; frame_ids_are_attribution_only\n"
+			  "# activation_and_first_correct_frame_require_explicit_external_evidence\n"
+			  "stage,kind,capture_session,start_ns,duration_ns,start_frame,end_frame,thread_id,object_id,bytes,result\n";
+}
+
+void LoadTrace::WriteCsvRecord(std::ostream& output, const LoadTraceRecord& r)
+{
+	output << StageName(r.stage) << ','
+		   << (r.kind == LoadTraceKind::Instant ? "instant" : "duration") << ','
+		   << r.captureSession << ',' << r.startNs << ',' << r.durationNs << ','
+		   << r.startFrame << ',' << r.endFrame << ',' << r.threadId << ','
+		   << r.objectId << ',' << r.bytes << ',';
+	if (r.result != UnknownResult) output << r.result;
+	output << '\n';
+}
+
+ScopedLoadTrace::ScopedLoadTrace(LoadStage stage, std::uint64_t objectId) noexcept
+	: trace_(&LoadTrace::Get()), session_(trace_->session_.load(std::memory_order_relaxed)), capture_(nullptr)
+{
+	if (!(session_ & 1) || stage == LoadStage::FirstCorrectFrame ||
+		(stage == LoadStage::CommandList && !trace_->commandListTracing_.load(std::memory_order_relaxed))) {
+		session_ = 0;
+		return;
+	}
+	capture_ = trace_->AcquireCapture(session_);
+	if (!capture_) { session_ = 0; return; }
+	const std::uint64_t frame = trace_->CurrentFrame();
+	record_ = {stage, LoadTraceKind::Duration, session_, LoadTrace::NowNs(),
+		0, frame, frame, LoadTrace::ThreadId(), objectId, 0, LoadTrace::UnknownResult};
+}
+
+ScopedLoadTrace::~ScopedLoadTrace() noexcept
+{
+	if (!session_) return;
+	record_.durationNs = LoadTrace::NowNs() - record_.startNs;
+	record_.endFrame = trace_->CurrentFrame();
+	trace_->Submit(record_, session_, *capture_);
+	capture_->references.fetch_sub(1, std::memory_order_release);
+}
+
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/LoadTrace.h b/DirectX11/ModLoading/LoadTrace.h
new file mode 100644
index 0000000000000000000000000000000000000000..b321ba3429f640fcf954cc3c876d5a61db8443d3
--- /dev/null
+++ b/DirectX11/ModLoading/LoadTrace.h
@@ -0,0 +1,151 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <iosfwd>
+#include <limits>
+
+namespace ModLoading {
+
+enum class LoadStage : std::uint8_t {
+	Discovery, FileRead, Decode, ShaderPreparation, GpuCreation, ViewCreation,
+	CommandList, ConfigReload, ReadinessWait, Activation, FirstCorrectFrame,
+	FileLoad, Present
+};
+
+enum class LoadTraceKind : std::uint8_t { Instant, Duration };
+
+struct LoadTraceRecord {
+	LoadStage stage;
+	LoadTraceKind kind;
+	std::uint64_t captureSession;
+	std::uint64_t startNs;
+	std::uint64_t durationNs;
+	std::uint64_t startFrame;
+	std::uint64_t endFrame;
+	std::uint64_t threadId;
+	std::uint64_t objectId;
+	std::uint64_t bytes;
+	// UnknownResult means the call site did not supply an outcome. Zero is not
+	// implicitly success: result interpretation belongs to the instrumented API.
+	std::int64_t result;
+};
+
+struct LoadTraceStats {
+	std::uint64_t accepted;
+	std::uint64_t droppedFull;
+	std::uint64_t droppedContention;
+	std::uint64_t exported;
+};
+
+struct LoadTraceCaptureStats {
+	std::uint64_t session, accepted, drained, droppedFull, droppedContention;
+	std::uint64_t stale, outstanding;
+};
+
+class ScopedLoadTrace;
+
+// Process-lifetime, bounded recorder. No heap allocation, file I/O, waiting or
+// retry loops in producer paths. Disabled recording takes one atomic load.
+// Frame IDs are attribution only, not evidence of visible/correct rendering.
+class LoadTrace {
+public:
+	static const std::size_t Capacity = 8192;
+	static const std::int64_t UnknownResult = (std::numeric_limits<std::int64_t>::min)();
+
+	static LoadTrace& Get() noexcept;
+	// Control/worker only. Eight bounded capture banks allow stale scopes to
+	// finish safely across restarts. If all banks remain pinned, enable fails
+	// closed (IsEnabled stays false); lifetime counters are never reset.
+	void SetEnabled(bool enabled) noexcept;
+	// Request closes new admission; already pinned scopes may finish in their
+	// own bank until the worker closes it with EndCapture. Direct SetEnabled
+	// transitions and EndCapture remain immediate, isolating stale scopes.
+	bool RequestEndCapture(std::uint64_t expectedSession) noexcept;
+	bool EndCapture(std::uint64_t expectedSession) noexcept;
+	bool IsEnabled() const noexcept;
+	// Per-draw command timers can exhaust a short bounded capture. Default off;
+	// enable explicitly for focused diagnosis. Checked before timestamp/ID work.
+	void SetCommandListTracing(bool enabled) noexcept;
+	std::uint64_t AdvanceFrame() noexcept;
+	std::uint64_t CurrentFrame() const noexcept;
+	void RecordInstant(LoadStage stage, std::uint64_t objectId = 0,
+					   std::uint64_t bytes = 0,
+					   std::int64_t result = UnknownResult) noexcept;
+	LoadTraceStats GetStats() const noexcept;
+	std::uint64_t CaptureSession() const noexcept;
+	LoadTraceCaptureStats GetCaptureStats(std::uint64_t session) const noexcept;
+	static void WriteCsvHeader(std::ostream& output);
+	static void WriteCsvRecord(std::ostream& output, const LoadTraceRecord& record);
+
+	// Worker-side consumer APIs. Drain tries once and returns zero on contention;
+	// concurrent consumers are safe. A returned record is removed from memory.
+	std::size_t Drain(LoadTraceRecord* output, std::size_t maximum) noexcept;
+	// Call ONLY on a worker. Writes at most Capacity records per invocation;
+	// formatting and stream I/O occur after releasing the consumer lock.
+	// Busy drains receive bounded worker-side retries. Exhaustion writes an
+	// incomplete-export comment and sets failbit; queued records remain queued.
+	// Exported records are consumed even on stream failure; callers must check
+	// stream state. Counters are cumulative, sampled independently, not a
+	// transactional snapshot. Stop producers before a final accounting export.
+	std::size_t ExportCsv(std::ostream& output);
+
+private:
+	friend class ScopedLoadTrace;
+	friend struct LoadTraceTestAccess;
+	enum class DrainStatus { Empty, Busy, Drained };
+	DrainStatus TryDrain(LoadTraceRecord* output, std::size_t maximum,
+						 std::size_t& drained) noexcept;
+	LoadTrace() noexcept;
+	static std::uint64_t NowNs() noexcept;
+	static std::uint64_t ThreadId() noexcept;
+
+	struct Capture {
+		std::atomic<std::uint64_t> session, references, accepted, drained;
+		std::atomic<std::uint64_t> full, contention, stale;
+		std::atomic<bool> finishing, closed;
+		Capture() noexcept : session(0), references(0), accepted(0), drained(0),
+			full(0), contention(0), stale(0), finishing(false), closed(true) {}
+	};
+	Capture* AcquireCapture(std::uint64_t session) noexcept;
+	void Submit(const LoadTraceRecord& record, std::uint64_t session, Capture& capture) noexcept;
+	// Only consumer/control threads touch their respective locks. Producers use
+	// one bounded reservation CAS, then release-publish their independent slot.
+	std::atomic<std::uint64_t> session_;
+	std::atomic<std::uint64_t> frame_;
+	std::atomic<bool> commandListTracing_;
+	std::atomic_flag lock_ = ATOMIC_FLAG_INIT;
+	std::atomic_flag controlLock_ = ATOMIC_FLAG_INIT;
+	std::atomic<std::uint64_t> entering_;
+	std::atomic<Capture*> currentCapture_;
+	Capture captures_[8];
+	struct Slot {
+		std::atomic<std::uint64_t> sequence;
+		LoadTraceRecord record;
+		Capture* capture;
+	};
+	Slot records_[Capacity];
+	std::atomic<std::uint64_t> head_, tail_;
+	std::atomic<std::uint64_t> accepted_, droppedFull_, droppedContention_, exported_;
+};
+
+// Timing a scope does not assert readiness or a correct rendered result.
+// FirstCorrectFrame is accepted only through an explicit RecordInstant call
+// supplied by external validation; it is never inferred from a Present/scope.
+class ScopedLoadTrace {
+public:
+	explicit ScopedLoadTrace(LoadStage stage, std::uint64_t objectId = 0) noexcept;
+	~ScopedLoadTrace() noexcept;
+	void SetBytes(std::uint64_t bytes) noexcept { record_.bytes = bytes; }
+	void SetResult(std::int64_t result) noexcept { record_.result = result; }
+	ScopedLoadTrace(const ScopedLoadTrace&) = delete;
+	ScopedLoadTrace& operator=(const ScopedLoadTrace&) = delete;
+private:
+	LoadTrace* trace_;
+	std::uint64_t session_;
+	LoadTrace::Capture* capture_;
+	LoadTraceRecord record_;
+};
+
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/MemoryBudgetController.cpp b/DirectX11/ModLoading/MemoryBudgetController.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4fe08c84e009b5a0cb0df435ac07c0890f1bfe58
--- /dev/null
+++ b/DirectX11/ModLoading/MemoryBudgetController.cpp
@@ -0,0 +1,64 @@
+#include "MemoryBudgetController.h"
+#include <algorithm>
+#include <atomic>
+#include <limits>
+#include <stdexcept>
+namespace ModLoading {
+namespace {
+uint64_t Sub(uint64_t a, uint64_t b) { return a > b ? a - b : 0; }
+uint64_t NextLedgerIdentity() {
+	static std::atomic<uint64_t> next{1};
+	auto value = next.load(std::memory_order_relaxed);
+	for (;;) {
+		if (value == (std::numeric_limits<uint64_t>::max)()) throw std::overflow_error("allocation ledger identity exhausted");
+		if (next.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) return value;
+	}
+}
+}
+struct LiveGpuAllocationLedger::State {
+	std::atomic<uint64_t> bytes{0};
+	uint64_t identity = NextLedgerIdentity();
+};
+LiveGpuAllocationLedger::Lease::Lease(std::shared_ptr<State> state) : state_(std::move(state)) {}
+LiveGpuAllocationLedger::Lease::~Lease() { state_->bytes.fetch_sub(bytes_, std::memory_order_relaxed); }
+LiveGpuAllocationLedger::LiveGpuAllocationLedger() : state_(std::make_shared<State>()) {}
+uint64_t LiveGpuAllocationLedger::Bytes() const { return state_->bytes.load(std::memory_order_relaxed); }
+uint64_t LiveGpuAllocationLedger::Identity() const { return state_->identity; }
+std::shared_ptr<const LiveGpuAllocationLedger::Lease> LiveGpuAllocationLedger::Track(uint64_t bytes) {
+	return TryTrack(bytes, (std::numeric_limits<uint64_t>::max)());
+}
+std::shared_ptr<const LiveGpuAllocationLedger::Lease> LiveGpuAllocationLedger::TryTrack(uint64_t bytes, uint64_t limit) {
+	if (!bytes || bytes > limit) return {};
+	// Allocate the token before touching accounting, so allocation failure
+	// cannot strand an increment. Until CAS succeeds its destructor subtracts0.
+	std::shared_ptr<Lease> lease(new Lease(state_));
+	auto current = state_->bytes.load(std::memory_order_relaxed);
+	for (;;) {
+		if (current > limit - bytes) return {};
+		if (state_->bytes.compare_exchange_weak(current, current + bytes, std::memory_order_relaxed)) {
+			lease->bytes_ = bytes; return lease;
+		}
+	}
+}
+LiveGpuAllocationLedger& ProcessGpuAllocationLedger() {
+	static LiveGpuAllocationLedger ledger;
+	return ledger;
+}
+MemoryBudgetController::MemoryBudgetController(uint64_t fallbackLimit, uint64_t headroom)
+	: fallback_(fallbackLimit), headroom_(headroom) {}
+void MemoryBudgetController::Update(VideoMemorySample sample) { sample_ = sample; }
+uint64_t MemoryBudgetController::Available() const {
+	const auto free = sample_.available ? Sub(Sub(sample_.budget, sample_.currentUsage), headroom_) : Sub(fallback_, sample_.currentUsage);
+	return Sub(free, queued_);
+}
+bool MemoryBudgetController::Reserve(AdmissionEstimate estimate) {
+	if (estimate.pendingGenerationOverlap > Available() ||
+		estimate.allocation > Available() - estimate.pendingGenerationOverlap ||
+		estimate.pendingGenerationOverlap > (std::numeric_limits<uint64_t>::max)() - queued_ ||
+		estimate.allocation > (std::numeric_limits<uint64_t>::max)() - queued_ - estimate.pendingGenerationOverlap)
+		return false;
+	queued_ += estimate.allocation + estimate.pendingGenerationOverlap;
+	return true;
+}
+void MemoryBudgetController::Complete(uint64_t reservedBytes) { queued_ = Sub(queued_, reservedBytes); }
+}
diff --git a/DirectX11/ModLoading/MemoryBudgetController.h b/DirectX11/ModLoading/MemoryBudgetController.h
new file mode 100644
index 0000000000000000000000000000000000000000..64157107ad1bd7c5cbc635c17c37dd5223232035
--- /dev/null
+++ b/DirectX11/ModLoading/MemoryBudgetController.h
@@ -0,0 +1,57 @@
+#pragma once
+#include <cstdint>
+#include <memory>
+namespace ModLoading {
+// Estimates follow object lifetime across cache/generation/device resets. This
+// ledger makes no claim about physical residency and performs no D3D calls.
+class LiveGpuAllocationLedger {
+	struct State;
+public:
+	class Lease {
+	public:
+		~Lease();
+		Lease(const Lease&) = delete;
+		Lease& operator=(const Lease&) = delete;
+	private:
+		friend class LiveGpuAllocationLedger;
+		explicit Lease(std::shared_ptr<State> state);
+		std::shared_ptr<State> state_;
+		uint64_t bytes_ = 0;
+	};
+	LiveGpuAllocationLedger();
+	// Call only after successful creation. Aliases share the returned token;
+	// overflow rejects registration and the caller must discard that object.
+	std::shared_ptr<const Lease> Track(uint64_t bytes);
+	// Reserve before allocation against a shared limit. Queued/canceled and
+	// live allocations share one token; transfer it instead of charging twice.
+	std::shared_ptr<const Lease> TryTrack(uint64_t bytes, uint64_t limit);
+	uint64_t Bytes() const;
+	uint64_t Identity() const;
+private:
+	std::shared_ptr<State> state_;
+};
+LiveGpuAllocationLedger& ProcessGpuAllocationLedger();
+struct VideoMemorySample {
+	bool available = false;
+	uint64_t budget = 0, currentUsage = 0;
+};
+struct AdmissionEstimate {
+	uint64_t allocation = 0;
+	// Already-live old generations are included in CurrentUsage. Only estimates
+	// not yet reflected in that sample belong here; never subtract them twice.
+	uint64_t pendingGenerationOverlap = 0;
+};
+class MemoryBudgetController {
+public:
+	explicit MemoryBudgetController(uint64_t fallbackLimit = 128ull * 1024 * 1024,
+									uint64_t headroom = 128ull * 1024 * 1024);
+	void Update(VideoMemorySample sample);
+	bool Reserve(AdmissionEstimate estimate);
+	void Complete(uint64_t reservedBytes);
+	uint64_t Available() const;
+	uint64_t QueuedBytes() const { return queued_; }
+private:
+	VideoMemorySample sample_;
+	uint64_t fallback_, headroom_, queued_ = 0;
+};
+}
diff --git a/DirectX11/ModLoading/PreparationPlanner.cpp b/DirectX11/ModLoading/PreparationPlanner.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..38942ecb3adf716d6c6f3fc283b9b3d2099315a1
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationPlanner.cpp
@@ -0,0 +1,713 @@
+#include "PreparationPlanner.h"
+#ifdef _WIN32
+#include <dxgi1_4.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <limits>
+#include <mutex>
+#include "LoadTrace.h"
+#include "DDSTextureLoader.h"
+#include "WICTextureLoader.h"
+namespace ModLoading {
+namespace {
+// This private interface has no reference back to the D3D object/device. The
+// D3D child owns it, so views/context references that outlive our cache also
+// retain the estimate. It models COM object lifetime, not hidden driver memory
+// retirement or physical residency.
+const GUID AllocationEstimateGuid = {0x62fba180, 0x25f4, 0x4cb1, {0x8c, 0xad, 0x35, 0x8e, 0x9d, 0x5c, 0xf0, 0x6a}};
+class AllocationEstimateAttachment final : public IUnknown {
+public:
+	AllocationEstimateAttachment(std::shared_ptr<const LiveGpuAllocationLedger::Lease> lease,
+		std::shared_ptr<const LiveGpuAllocationLedger::Lease> retainedBudget)
+		: lease_(std::move(lease)), retainedBudget_(std::move(retainedBudget)) {}
+	HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** output) override {
+		if (!output) return E_POINTER;
+		*output = nullptr;
+		if (!IsEqualGUID(id, __uuidof(IUnknown))) return E_NOINTERFACE;
+		*output = static_cast<IUnknown*>(this); AddRef(); return S_OK;
+	}
+	ULONG STDMETHODCALLTYPE AddRef() override { return refs_.fetch_add(1, std::memory_order_relaxed) + 1; }
+	ULONG STDMETHODCALLTYPE Release() override {
+		const ULONG remaining = refs_.fetch_sub(1, std::memory_order_acq_rel) - 1;
+		if (!remaining) delete this;
+		return remaining;
+	}
+private:
+	~AllocationEstimateAttachment() = default;
+	std::atomic<ULONG> refs_{1};
+	std::shared_ptr<const LiveGpuAllocationLedger::Lease> lease_;
+	std::shared_ptr<const LiveGpuAllocationLedger::Lease> retainedBudget_;
+};
+struct ShaderBytecodeRegistry {
+	struct Entry {
+		std::weak_ptr<ID3DBlob> owner;
+		SourceDigest digest;
+		size_t bytes;
+	};
+	std::mutex mutex;
+	std::atomic<uint64_t> liveBytes{0};
+	std::map<ID3DBlob*, Entry> owners;
+};
+ShaderBytecodeRegistry& BytecodeRegistry() {
+	// Shared owners can outlive configuration services during DLL teardown.
+	// This CPU-only accounting registry has no loader-lock destructor work.
+	static auto* registry = new ShaderBytecodeRegistry;
+	return *registry;
+}
+void Append(std::vector<uint32_t>& v, std::initializer_list<uint32_t> fields) { v.insert(v.end(), fields); }
+uint32_t FloatBits(float value) { uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); return bits; }
+void AppendDigest(std::vector<uint32_t>& v, const SourceDigest& digest) {
+	for (size_t i = 0; i < digest.size(); i += 4)
+		v.push_back(uint32_t(digest[i]) | uint32_t(digest[i + 1]) << 8 |
+			uint32_t(digest[i + 2]) << 16 | uint32_t(digest[i + 3]) << 24);
+}
+bool AppendBundle(std::vector<uint32_t>& v, const ShaderBundleInput& bundle, uint64_t estimate) {
+	if (bundle.stageOverrideMask & ~63u) return false;
+	Append(v, {bundle.stageOverrideMask, uint32_t(bundle.createBlendState), uint32_t(bundle.createDepthStencilState),
+		uint32_t(bundle.createRasterizerState), uint32_t(bundle.createSamplerState)});
+	uint64_t bytecodeBytes = 0;
+	bool hasOperation = bundle.stageOverrideMask || bundle.createBlendState || bundle.createDepthStencilState ||
+		bundle.createRasterizerState || bundle.createSamplerState;
+	if (!hasOperation) return false;
+	for (size_t stage = 0; stage < bundle.stages.size(); ++stage) {
+		const auto& code = bundle.stages[stage];
+		if (code && !(bundle.stageOverrideMask & (1u << stage))) return false;
+		Append(v, {uint32_t(bool(code)), uint32_t(code.Size()), uint32_t(uint64_t(code.Size()) >> 32)});
+		if (code) {
+			if (code.Size() > estimate - bytecodeBytes) return false;
+			bytecodeBytes += code.Size(); AppendDigest(v, code.Digest());
+		}
+	}
+	if (bundle.createBlendState) {
+		const auto& d = bundle.blend;
+		Append(v, {uint32_t(d.AlphaToCoverageEnable), uint32_t(d.IndependentBlendEnable)});
+		for (const auto& target : d.RenderTarget)
+			Append(v, {uint32_t(target.BlendEnable), uint32_t(target.SrcBlend), uint32_t(target.DestBlend), uint32_t(target.BlendOp),
+				uint32_t(target.SrcBlendAlpha), uint32_t(target.DestBlendAlpha), uint32_t(target.BlendOpAlpha), target.RenderTargetWriteMask});
+	}
+	if (bundle.createDepthStencilState) {
+		const auto& d = bundle.depthStencil;
+		Append(v, {uint32_t(d.DepthEnable), uint32_t(d.DepthWriteMask), uint32_t(d.DepthFunc), uint32_t(d.StencilEnable), d.StencilReadMask, d.StencilWriteMask});
+		for (const auto* face : {&d.FrontFace, &d.BackFace})
+			Append(v, {uint32_t(face->StencilFailOp), uint32_t(face->StencilDepthFailOp), uint32_t(face->StencilPassOp), uint32_t(face->StencilFunc)});
+	}
+	if (bundle.createRasterizerState) {
+		const auto& d = bundle.rasterizer;
+		Append(v, {uint32_t(d.FillMode), uint32_t(d.CullMode), uint32_t(d.FrontCounterClockwise), uint32_t(d.DepthBias),
+			FloatBits(d.DepthBiasClamp), FloatBits(d.SlopeScaledDepthBias), uint32_t(d.DepthClipEnable), uint32_t(d.ScissorEnable),
+			uint32_t(d.MultisampleEnable), uint32_t(d.AntialiasedLineEnable)});
+	}
+	if (bundle.createSamplerState) {
+		const auto& d = bundle.sampler;
+		Append(v, {uint32_t(d.Filter), uint32_t(d.AddressU), uint32_t(d.AddressV), uint32_t(d.AddressW), FloatBits(d.MipLODBias),
+			d.MaxAnisotropy, uint32_t(d.ComparisonFunc), FloatBits(d.BorderColor[0]), FloatBits(d.BorderColor[1]),
+			FloatBits(d.BorderColor[2]), FloatBits(d.BorderColor[3]), FloatBits(d.MinLOD), FloatBits(d.MaxLOD)});
+	}
+	return true;
+}
+uint64_t RetainedShaderBytecodeBytes(const GpuPreparationRequest& request) {
+	if (request.kind == GpuPreparationKind::ShaderBundle) {
+		uint64_t total = 0;
+		if (request.shaderBundle)
+			for (const auto& stage : request.shaderBundle->stages) {
+				if (stage.Size() > (std::numeric_limits<uint64_t>::max)() - total) return (std::numeric_limits<uint64_t>::max)();
+				total += stage.Size();
+			}
+		return total;
+	}
+	if (request.kind >= GpuPreparationKind::VertexShader && request.kind <= GpuPreparationKind::ComputeShader)
+		return request.shaderBytecode ? request.shaderBytecode.Size() : request.snapshot.bytes ? request.snapshot.bytes->size() : 0;
+	return 0;
+}
+bool ReadOnly(UINT bind, UINT cpu, D3D11_USAGE usage, UINT misc) {
+	const UINT allowed = D3D11_BIND_VERTEX_BUFFER | D3D11_BIND_INDEX_BUFFER |
+		D3D11_BIND_CONSTANT_BUFFER | D3D11_BIND_SHADER_RESOURCE;
+	const UINT allowedMisc = D3D11_RESOURCE_MISC_BUFFER_STRUCTURED | D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS |
+		D3D11_RESOURCE_MISC_TEXTURECUBE;
+	return bind && !(bind & ~allowed) && !cpu && !(misc & ~allowedMisc) &&
+		(usage == D3D11_USAGE_DEFAULT || usage == D3D11_USAGE_IMMUTABLE);
+}
+uint64_t CpuScratchBytes(const GpuPreparationRequest& request)
+{
+	if (request.kind == GpuPreparationKind::Buffer && request.snapshot.bytes &&
+		request.buffer.ByteWidth > request.snapshot.bytes->size())
+		return uint64_t(request.buffer.ByteWidth) + 512;
+	if (request.kind == GpuPreparationKind::EncodedWIC) {
+		const uint64_t estimate = EstimateEncodedTextureBytes(request.snapshot, request.kind);
+		const uint64_t codecAllowance = 16ull * 1024 * 1024;
+		if (!estimate || estimate > ((std::numeric_limits<uint64_t>::max)() - codecAllowance) / 2)
+			return (std::numeric_limits<uint64_t>::max)();
+		// Covers expanded pixels, conversion staging and a codec allowance.
+		// Third-party codec internals remain a conservative memory estimate.
+		return estimate * 2 + codecAllowance;
+	}
+	if (request.kind == GpuPreparationKind::EncodedDDS && request.snapshot.bytes) {
+		const auto& bytes = *request.snapshot.bytes;
+		auto read = [&](size_t offset) -> uint32_t {
+			if (offset > bytes.size() || bytes.size() - offset < 4) return 0;
+			return uint32_t(bytes[offset]) | uint32_t(bytes[offset + 1]) << 8 |
+				uint32_t(bytes[offset + 2]) << 16 | uint32_t(bytes[offset + 3]) << 24;
+		};
+		const uint64_t mips = (std::max)(1u, read(28));
+		uint64_t arrays = read(112) & 0x200 ? 6 : 1;
+		if (read(84) == 0x30315844) {
+			arrays = read(140);
+			if (read(136) & 4) arrays *= 6;
+		}
+		if (!arrays || arrays > 12288 || mips > 15)
+			return (std::numeric_limits<uint64_t>::max)();
+		return mips * arrays * sizeof(D3D11_SUBRESOURCE_DATA) * 2 + 65536;
+	}
+	return 0;
+}
+// The explicit decoded path accepts only layouts whose byte extents are known.
+// Other formats remain compatibility-only, rather than trusting driver reads
+// beyond supplied snapshot ranges.
+bool Surface(DXGI_FORMAT format, UINT width, UINT height, uint64_t& row, uint64_t& rows) {
+	uint64_t bpp = 0, block = 0;
+	switch (format) {
+	case DXGI_FORMAT_R8_UNORM: case DXGI_FORMAT_A8_UNORM: bpp = 1; break;
+	case DXGI_FORMAT_R8G8_UNORM: case DXGI_FORMAT_R16_UNORM: case DXGI_FORMAT_R16_FLOAT: bpp = 2; break;
+	case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+	case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+	case DXGI_FORMAT_B8G8R8X8_UNORM: case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+	case DXGI_FORMAT_R16G16_FLOAT: case DXGI_FORMAT_R32_FLOAT: bpp = 4; break;
+	case DXGI_FORMAT_R16G16B16A16_FLOAT: case DXGI_FORMAT_R32G32_FLOAT: bpp = 8; break;
+	case DXGI_FORMAT_R32G32B32A32_FLOAT: bpp = 16; break;
+	case DXGI_FORMAT_BC1_UNORM: case DXGI_FORMAT_BC1_UNORM_SRGB:
+	case DXGI_FORMAT_BC4_UNORM: case DXGI_FORMAT_BC4_SNORM: block = 8; break;
+	case DXGI_FORMAT_BC2_UNORM: case DXGI_FORMAT_BC2_UNORM_SRGB:
+	case DXGI_FORMAT_BC3_UNORM: case DXGI_FORMAT_BC3_UNORM_SRGB:
+	case DXGI_FORMAT_BC5_UNORM: case DXGI_FORMAT_BC5_SNORM:
+	case DXGI_FORMAT_BC6H_UF16: case DXGI_FORMAT_BC6H_SF16:
+	case DXGI_FORMAT_BC7_UNORM: case DXGI_FORMAT_BC7_UNORM_SRGB: block = 16; break;
+	default: return false;
+	}
+	row = block ? ((uint64_t(width) + 3) / 4) * block : uint64_t(width) * bpp;
+	rows = block ? (uint64_t(height) + 3) / 4 : height;
+	return true;
+}
+bool AppendView(std::vector<uint32_t>& v, const D3D11_SHADER_RESOURCE_VIEW_DESC& d) {
+	Append(v, {uint32_t(d.Format), uint32_t(d.ViewDimension)});
+	switch (d.ViewDimension) {
+	case D3D11_SRV_DIMENSION_BUFFER: Append(v, {d.Buffer.FirstElement, d.Buffer.NumElements}); break;
+	case D3D11_SRV_DIMENSION_BUFFEREX: Append(v, {d.BufferEx.FirstElement, d.BufferEx.NumElements, d.BufferEx.Flags}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE1D: Append(v, {d.Texture1D.MostDetailedMip, d.Texture1D.MipLevels}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE1DARRAY: Append(v, {d.Texture1DArray.MostDetailedMip, d.Texture1DArray.MipLevels, d.Texture1DArray.FirstArraySlice, d.Texture1DArray.ArraySize}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE2D: Append(v, {d.Texture2D.MostDetailedMip, d.Texture2D.MipLevels}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE2DARRAY: Append(v, {d.Texture2DArray.MostDetailedMip, d.Texture2DArray.MipLevels, d.Texture2DArray.FirstArraySlice, d.Texture2DArray.ArraySize}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE2DMS: break;
+	case D3D11_SRV_DIMENSION_TEXTURE2DMSARRAY: Append(v, {d.Texture2DMSArray.FirstArraySlice, d.Texture2DMSArray.ArraySize}); break;
+	case D3D11_SRV_DIMENSION_TEXTURE3D: Append(v, {d.Texture3D.MostDetailedMip, d.Texture3D.MipLevels}); break;
+	case D3D11_SRV_DIMENSION_TEXTURECUBE: Append(v, {d.TextureCube.MostDetailedMip, d.TextureCube.MipLevels}); break;
+	case D3D11_SRV_DIMENSION_TEXTURECUBEARRAY: Append(v, {d.TextureCubeArray.MostDetailedMip, d.TextureCubeArray.MipLevels, d.TextureCubeArray.First2DArrayFace, d.TextureCubeArray.NumCubes}); break;
+	default: return false;
+	}
+	return true;
+}
+}
+uint64_t EstimateEncodedTextureBytes(const SourceSnapshot& source, GpuPreparationKind kind) {
+	if (!source.bytes) return 0;
+	const auto& b = *source.bytes;
+	const auto le = [&](size_t p) -> uint32_t {
+		if (p > b.size() || b.size() - p < 4) return 0;
+		return uint32_t(b[p]) | uint32_t(b[p + 1]) << 8 | uint32_t(b[p + 2]) << 16 | uint32_t(b[p + 3]) << 24;
+	};
+	const auto be = [&](size_t p) -> uint32_t {
+		if (p > b.size() || b.size() - p < 4) return 0;
+		return uint32_t(b[p]) << 24 | uint32_t(b[p + 1]) << 16 | uint32_t(b[p + 2]) << 8 | uint32_t(b[p + 3]);
+	};
+	uint64_t width = 0, height = 0, depth = 1, arrays = 1, bytesPerPixel = 4, mipCount = 1;
+	DXGI_FORMAT ddsFormat = DXGI_FORMAT_UNKNOWN;
+	if (kind == GpuPreparationKind::EncodedDDS) {
+		if (b.size() < 128 || le(0) != 0x20534444 || le(4) != 124 || le(76) != 32) return 0;
+		width = le(16); height = le(12); depth = (std::max)(1u, le(24));
+		bytesPerPixel = 16; mipCount = (std::max)(1u, le(28));
+		if (mipCount > 15) return 0;
+		if (le(84) == 0x30315844) {
+			if (b.size() < 148) return 0;
+			arrays = le(140); ddsFormat = static_cast<DXGI_FORMAT>(le(128));
+			if (le(136) & 4) arrays *= 6;
+			if (le(132) == 2) height = 1;
+		} else {
+			if (le(112) & 0x200) arrays = 6;
+			switch (le(84)) {
+			case 0x31545844: ddsFormat = DXGI_FORMAT_BC1_UNORM; break; // DXT1
+			case 0x32545844: case 0x33545844: ddsFormat = DXGI_FORMAT_BC2_UNORM; break;
+			case 0x34545844: case 0x35545844: ddsFormat = DXGI_FORMAT_BC3_UNORM; break;
+			case 0x31495441: case 0x55344342: case 0x53344342: ddsFormat = DXGI_FORMAT_BC4_UNORM; break;
+			case 0x32495441: case 0x55354342: case 0x53354342: ddsFormat = DXGI_FORMAT_BC5_UNORM; break;
+			default:
+				if (!(le(80) & 4) && le(88) && le(88) <= 32) bytesPerPixel = (le(88) + 7) / 8;
+				break;
+			}
+		}
+	} else if (kind == GpuPreparationKind::EncodedWIC) {
+		const uint8_t png[] = {137, 80, 78, 71, 13, 10, 26, 10};
+		if (b.size() >= 33 && std::equal(png, png + 8, b.begin()) && be(8) == 13 && be(12) == 0x49484452) {
+			width = be(16); height = be(20); bytesPerPixel = b[24] > 8 ? 8 : 4;
+		} else if (b.size() >= 54 && b[0] == 'B' && b[1] == 'M' && le(14) >= 40) {
+			width = le(18); const uint32_t rawHeight = le(22);
+			height = rawHeight & 0x80000000u ? uint64_t((~rawHeight) + 1u) : rawHeight;
+		} else return 0;
+	} else return 0;
+	if (!width || !height || !depth || !arrays || width > 16384 || height > 16384 || depth > 2048 || arrays > 12288) return 0;
+	uint64_t total = 0;
+	for (uint64_t mip = 0; mip < mipCount; ++mip) {
+		uint64_t row = 0, rows = 0;
+		const uint64_t w = (std::max)(uint64_t(1), width >> mip);
+		const uint64_t h = (std::max)(uint64_t(1), height >> mip);
+		if (!Surface(ddsFormat, UINT(w), UINT(h), row, rows)) { row = w * bytesPerPixel; rows = h; }
+		uint64_t estimate = row;
+		for (const auto factor : {rows, (std::max)(uint64_t(1), depth >> mip), arrays, uint64_t(2)}) {
+			if (factor > (std::numeric_limits<uint64_t>::max)() / estimate) return 0;
+			estimate *= factor;
+		}
+		if (estimate > (std::numeric_limits<uint64_t>::max)() - total) return 0;
+		total += estimate;
+	}
+	// Driver allocations/metadata are estimates, not exact physical residency.
+	return total <= (std::numeric_limits<uint64_t>::max)() - 65536 ? total + 65536 : 0;
+}
+DeviceResourceKey PreparationPlanner::CanonicalKey(const DeviceResourceKey& requestKey, const PreparedGpuObject& object) const {
+	DeviceResourceKey key = requestKey;
+	if (key.effectiveOptions.size() > 3 && !key.effectiveOptions[3] &&
+		key.effectiveOptions[1] != uint32_t(GpuPreparationKind::EncodedDDS) &&
+		key.effectiveOptions[1] != uint32_t(GpuPreparationKind::EncodedWIC)) return key;
+	auto& v = key.effectiveOptions; Append(v, {0x44455343});
+	if (!object.resource) return key;
+	D3D11_RESOURCE_DIMENSION dimension; object.resource->GetType(&dimension); Append(v, {uint32_t(dimension)});
+	// GetType proves the concrete resource interface; these casts preserve COM ownership.
+	switch (dimension) {
+	case D3D11_RESOURCE_DIMENSION_BUFFER: {
+		D3D11_BUFFER_DESC d{}; static_cast<ID3D11Buffer*>(object.resource)->GetDesc(&d);
+		Append(v, {d.ByteWidth, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags, d.StructureByteStride}); break;
+	}
+	case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+		D3D11_TEXTURE1D_DESC d{}; static_cast<ID3D11Texture1D*>(object.resource)->GetDesc(&d);
+		Append(v, {d.Width, d.MipLevels, d.ArraySize, uint32_t(d.Format), uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+	}
+	case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+		D3D11_TEXTURE2D_DESC d{}; static_cast<ID3D11Texture2D*>(object.resource)->GetDesc(&d);
+		Append(v, {d.Width, d.Height, d.MipLevels, d.ArraySize, uint32_t(d.Format), d.SampleDesc.Count,
+			d.SampleDesc.Quality, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+	}
+	case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+		D3D11_TEXTURE3D_DESC d{}; static_cast<ID3D11Texture3D*>(object.resource)->GetDesc(&d);
+		Append(v, {d.Width, d.Height, d.Depth, d.MipLevels, uint32_t(d.Format), uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+	}
+	default: break;
+	}
+	if (object.shaderResourceView) { D3D11_SHADER_RESOURCE_VIEW_DESC d{}; object.shaderResourceView->GetDesc(&d); AppendView(v, d); }
+	return key;
+}
+uint64_t SharedShaderBytecode::LiveRetainedBytes() { return BytecodeRegistry().liveBytes.load(std::memory_order_relaxed); }
+SharedShaderBytecode SharedShaderBytecode::Retain(ID3DBlob* blob, const SourceDigest& digest, uint64_t maximumRetainedBytes) {
+	SharedShaderBytecode result;
+	if (!maximumRetainedBytes || !blob || !blob->GetBufferPointer() || !blob->GetBufferSize()) return result;
+	auto& registry = BytecodeRegistry();
+	std::lock_guard<std::mutex> lock(registry.mutex);
+	// Weak entries retain neither the blob nor its charge. Clean them before
+	// admission so repeated F10 generations cannot grow the index unboundedly.
+	for (auto it = registry.owners.begin(); it != registry.owners.end();)
+		if (it->second.owner.expired()) it = registry.owners.erase(it); else ++it;
+	const size_t bytes = blob->GetBufferSize();
+	auto existing = registry.owners.find(blob);
+	if (existing != registry.owners.end()) {
+		if (existing->second.bytes != bytes || existing->second.digest != digest) return result;
+		result.owner_ = existing->second.owner.lock();
+		if (!result.owner_) return result;
+	} else {
+		if (registry.owners.size() >= 4096 || bytes > maximumRetainedBytes) return result;
+		auto live = registry.liveBytes.load(std::memory_order_relaxed);
+		do {
+			if (live > maximumRetainedBytes - bytes) return result;
+		} while (!registry.liveBytes.compare_exchange_weak(live, live + bytes, std::memory_order_relaxed));
+		blob->AddRef();
+		// No registry mutex in the deleter: control-block/map allocation may
+		// fail while admission holds that mutex. Final release decrements only
+		// after the compiled blob's own Release returns.
+		auto* accounting = &registry;
+		result.owner_ = std::shared_ptr<ID3DBlob>(blob, [accounting, bytes](ID3DBlob* retained) {
+			retained->Release(); accounting->liveBytes.fetch_sub(bytes, std::memory_order_relaxed);
+		});
+		registry.owners.emplace(blob, ShaderBytecodeRegistry::Entry{result.owner_, digest, bytes});
+	}
+	result.data_ = static_cast<const uint8_t*>(blob->GetBufferPointer()); result.size_ = bytes; result.digest_ = digest;
+	return result;
+}
+PreparedShaderBundle::~PreparedShaderBundle() {
+	for (auto* child : {static_cast<ID3D11DeviceChild*>(vertex), static_cast<ID3D11DeviceChild*>(hull),
+		static_cast<ID3D11DeviceChild*>(domain), static_cast<ID3D11DeviceChild*>(geometry),
+		static_cast<ID3D11DeviceChild*>(pixel), static_cast<ID3D11DeviceChild*>(compute),
+		static_cast<ID3D11DeviceChild*>(blend), static_cast<ID3D11DeviceChild*>(depthStencil),
+		static_cast<ID3D11DeviceChild*>(rasterizer), static_cast<ID3D11DeviceChild*>(sampler)})
+		if (child) child->Release();
+}
+PreparedGpuObject::~PreparedGpuObject() {
+	if (shaderResourceView) shaderResourceView->Release();
+	if (shader) shader->Release();
+	if (resource) resource->Release();
+}
+PreparationPlanner::PreparationPlanner(uint64_t cacheBytes, size_t maxQueued, uint64_t maxRetainedShaderBytecodeBytes)
+	: cache_(cacheBytes), maxQueued_((std::min)(size_t(4096), maxQueued)), maxShaderBytecodeBytes_(maxRetainedShaderBytecodeBytes), enabled_(cacheBytes != 0) {}
+PreparationPlanner::~PreparationPlanner() { RetireDevice(); }
+bool PreparationPlanner::OnOwner() const { return owner_ == std::this_thread::get_id(); }
+bool PreparationPlanner::BeginDevice(ID3D11Device* device, DeviceEpoch epoch) {
+	if (!device || !epoch || (device_ && !OnOwner())) return false;
+	if (device_ == device && cache_.Epoch() == epoch) return true;
+	RetireDevice(); owner_ = std::this_thread::get_id(); device_ = device; cache_.BeginEpoch(epoch);
+	singleThreaded_ = (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED) != 0;
+	D3D11_FEATURE_DATA_THREADING threading{};
+	concurrentCreates_ = SUCCEEDED(device->CheckFeatureSupport(D3D11_FEATURE_THREADING, &threading, sizeof(threading))) && threading.DriverConcurrentCreates;
+	return true;
+}
+void PreparationPlanner::RetireDevice() {
+	queue_.clear(); resolvedKeys_.clear(); failedKeys_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0; budget_ = MemoryBudgetController(128ull * 1024 * 1024, safetyHeadroom_);
+	cache_.BeginEpoch(0); device_ = nullptr; singleThreaded_ = false; concurrentCreates_ = false;
+}
+void PreparationPlanner::SetSafetyHeadroom(uint64_t bytes) {
+	if (device_ && !OnOwner()) return;
+	// Existing queue reservations are preserved by re-reserving their estimates.
+	safetyHeadroom_ = bytes; budget_ = MemoryBudgetController(128ull * 1024 * 1024, bytes);
+	budget_.Update(QueryBudget());
+	for (const auto& entry : queue_)
+		if (!budget_.Reserve({entry.request.estimatedBytes, entry.request.pendingGenerationOverlap})) {
+			queue_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0; budget_ = MemoryBudgetController(128ull * 1024 * 1024, bytes); break;
+		}
+}
+bool PreparationPlanner::MakeKey(const GpuPreparationRequest& r, DeviceResourceKey& key) const {
+	if (!r.dependencyReadOnly || !r.estimatedBytes || (!r.retainedBudget && r.retainedBudgetLimit) ||
+		(r.createShaderResourceView && r.createDefaultShaderResourceView)) return false;
+	const bool bundle = r.kind == GpuPreparationKind::ShaderBundle;
+	const bool shader = r.kind >= GpuPreparationKind::VertexShader && r.kind <= GpuPreparationKind::ComputeShader;
+	if (bundle) {
+		if (!r.shaderBundle || r.shaderBytecode || r.createShaderResourceView || r.createDefaultShaderResourceView || !r.subresources.empty()) return false;
+	} else if (shader && r.shaderBytecode) {
+		if (r.snapshot.bytes || r.shaderBundle) return false;
+	} else if (!r.snapshot.bytes || r.snapshot.bytes->empty() || r.shaderBundle || r.shaderBytecode) return false;
+	key.digest = bundle ? SourceDigest{} : r.shaderBytecode ? r.shaderBytecode.Digest() : r.snapshot.digest;
+	key.epoch = cache_.Epoch();
+	auto& v = key.effectiveOptions;
+	Append(v, {3, uint32_t(r.kind), uint32_t(r.createShaderResourceView), uint32_t(r.createDefaultShaderResourceView), uint32_t(r.creationOptions.size())});
+	v.insert(v.end(), r.creationOptions.begin(), r.creationOptions.end());
+	const uint64_t retainedBudgetIdentity = r.retainedBudget ? r.retainedBudget->Identity() : 0;
+	Append(v, {uint32_t(retainedBudgetIdentity), uint32_t(retainedBudgetIdentity >> 32)});
+	if (bundle) return AppendBundle(v, *r.shaderBundle, r.estimatedBytes);
+	if (r.kind == GpuPreparationKind::Buffer) {
+		const auto& d = r.buffer;
+		if (!d.ByteWidth || !ReadOnly(d.BindFlags, d.CPUAccessFlags, d.Usage, d.MiscFlags) ||
+			(d.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE) || r.estimatedBytes < d.ByteWidth) return false;
+		Append(v, {d.ByteWidth, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags, d.StructureByteStride});
+	} else if (r.kind == GpuPreparationKind::Texture2D) {
+		const auto& d = r.texture;
+		if (!d.Width || !d.Height || !d.ArraySize || !d.MipLevels || d.MipLevels > 15 ||
+			d.Width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION || d.Height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+			d.ArraySize > D3D11_REQ_TEXTURE2D_ARRAY_AXIS_DIMENSION ||
+			d.SampleDesc.Count != 1 || d.SampleDesc.Quality ||
+			d.BindFlags != D3D11_BIND_SHADER_RESOURCE || !ReadOnly(d.BindFlags, d.CPUAccessFlags, d.Usage, d.MiscFlags) ||
+			(d.MiscFlags & ~UINT(D3D11_RESOURCE_MISC_TEXTURECUBE)) ||
+			r.subresources.size() != uint64_t(d.MipLevels) * d.ArraySize) return false;
+		uint64_t total = 0;
+		for (size_t i = 0; i < r.subresources.size(); ++i) {
+			const auto& s = r.subresources[i]; uint64_t row = 0, rows = 0;
+			const UINT mip = UINT(i % d.MipLevels);
+			if (!Surface(d.Format, (std::max)(1u, d.Width >> mip), (std::max)(1u, d.Height >> mip), row, rows) ||
+				s.rowPitch < row || s.bytes < uint64_t(s.rowPitch) * (rows - 1) + row ||
+				s.offset > r.snapshot.bytes->size() || s.bytes > r.snapshot.bytes->size() - s.offset) return false;
+			if (s.bytes > (std::numeric_limits<uint64_t>::max)() - total) return false;
+			total += s.bytes;
+			Append(v, {uint32_t(s.offset), uint32_t(s.offset >> 32), uint32_t(s.bytes), uint32_t(s.bytes >> 32), s.rowPitch, s.slicePitch});
+		}
+		if (r.estimatedBytes < total) return false;
+		Append(v, {d.Width, d.Height, d.MipLevels, d.ArraySize, uint32_t(d.Format), d.SampleDesc.Count,
+			d.SampleDesc.Quality, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags});
+	} else if (r.kind == GpuPreparationKind::EncodedDDS || r.kind == GpuPreparationKind::EncodedWIC) {
+		const uint64_t required = EstimateEncodedTextureBytes(r.snapshot, r.kind);
+		if (!required || r.estimatedBytes < required ||
+			!ReadOnly(r.loaderBindFlags, 0, D3D11_USAGE_DEFAULT, r.loaderMiscFlags) ||
+			r.loaderBindFlags != D3D11_BIND_SHADER_RESOURCE || (r.wicLoaderFlags & ~3u) ||
+			(r.loaderMiscFlags & ~UINT(D3D11_RESOURCE_MISC_TEXTURECUBE)) || !r.subresources.empty()) return false;
+		Append(v, {r.loaderBindFlags, r.loaderMiscFlags, r.wicLoaderFlags, uint32_t(r.forceSRGB),
+			uint32_t(r.maxTextureSize), uint32_t(uint64_t(r.maxTextureSize) >> 32)});
+	} else {
+		const auto codeBytes = r.shaderBytecode ? r.shaderBytecode.Size() : r.snapshot.bytes->size();
+		if (!shader || r.estimatedBytes < codeBytes || r.createShaderResourceView || r.createDefaultShaderResourceView || !r.subresources.empty()) return false;
+	}
+	return !r.createShaderResourceView || AppendView(v, r.shaderResourceView);
+}
+VideoMemorySample PreparationPlanner::QueryBudget() const {
+	VideoMemorySample sample; sample.currentUsage = ProcessGpuAllocationLedger().Bytes();
+	if (!device_) return sample;
+	IDXGIDevice* dxgiDevice = nullptr; IDXGIAdapter* adapter = nullptr; IDXGIAdapter3* adapter3 = nullptr;
+	if (SUCCEEDED(device_->QueryInterface(__uuidof(IDXGIDevice), reinterpret_cast<void**>(&dxgiDevice)))) {
+		if (SUCCEEDED(dxgiDevice->GetAdapter(&adapter)) &&
+			SUCCEEDED(adapter->QueryInterface(__uuidof(IDXGIAdapter3), reinterpret_cast<void**>(&adapter3)))) {
+			DXGI_QUERY_VIDEO_MEMORY_INFO local{}, nonlocal{};
+			if (SUCCEEDED(adapter3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local))) {
+				sample.available = true; sample.budget = local.Budget; sample.currentUsage = local.CurrentUsage;
+				// Never count nonlocal allowance as extra local VRAM. If paging
+				// already exceeds the process' nonlocal budget, stop speculation.
+				if (SUCCEEDED(adapter3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal)) &&
+					nonlocal.CurrentUsage > nonlocal.Budget) sample.budget = 0;
+			}
+		}
+	}
+	if (adapter3) adapter3->Release(); if (adapter) adapter->Release(); if (dxgiDevice) dxgiDevice->Release();
+	return sample;
+}
+bool PreparationPlanner::ComputeKey(const GpuPreparationRequest& request, DeviceResourceKey& key) const {
+	if (!enabled_ || !device_ || !OnOwner() || !cache_.Epoch() || request.estimatedBytes > cache_.CapacityBytes()) return false;
+	DeviceResourceKey candidate;
+	if (!MakeKey(request, candidate)) return false;
+	key = std::move(candidate); return true;
+}
+GpuQueueResult PreparationPlanner::Enqueue(const GpuPreparationRequest& request, DeviceResourceKey* key) {
+	if (!enabled_) return GpuQueueResult::CompatibilityOnly;
+	if (!device_ || !cache_.Epoch()) return GpuQueueResult::WrongDevice;
+	if (!OnOwner()) return GpuQueueResult::WrongThread;
+	DeviceResourceKey candidate;
+	if (request.estimatedBytes > cache_.CapacityBytes())
+		return request.retainedBudget ? GpuQueueResult::BudgetBlocked : GpuQueueResult::CompatibilityOnly;
+	if (!MakeKey(request, candidate)) return GpuQueueResult::CompatibilityOnly;
+	if (key) *key = candidate;
+	if (TryAcquire(candidate)) return GpuQueueResult::AlreadyReady;
+	if (failedKeys_.find(candidate) != failedKeys_.end()) return GpuQueueResult::CompatibilityOnly;
+	for (const auto& pending : queue_)
+		if (!(candidate < pending.key) && !(pending.key < candidate)) return GpuQueueResult::Queued;
+	// Saturation disables new speculative keys for this epoch rather than
+	// evicting failure knowledge and retrying unsupported creations forever.
+	if (failedKeys_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) return GpuQueueResult::CompatibilityOnly;
+	if (queue_.size() >= maxQueued_) return GpuQueueResult::Full;
+	std::shared_ptr<const void> cpuScratchReservation;
+	const uint64_t scratchBytes = CpuScratchBytes(request);
+	if (scratchBytes) {
+		if (!request.reserveCpuScratch) return GpuQueueResult::CompatibilityOnly;
+		cpuScratchReservation = request.reserveCpuScratch(scratchBytes);
+		if (!cpuScratchReservation) return GpuQueueResult::BudgetBlocked;
+	}
+	const auto retainedShaderBytes = RetainedShaderBytecodeBytes(request);
+	if (retainedShaderBytes > maxShaderBytecodeBytes_ - queuedShaderBytecodeBytes_) return GpuQueueResult::BudgetBlocked;
+	if ((request.kind == GpuPreparationKind::EncodedDDS || request.kind == GpuPreparationKind::EncodedWIC || request.createDefaultShaderResourceView) &&
+		resolvedKeys_.size() + queue_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) {
+		for (auto alias = resolvedKeys_.begin(); alias != resolvedKeys_.end();) {
+			if (!cache_.Find(alias->second)) alias = resolvedKeys_.erase(alias); else ++alias;
+		}
+		if (resolvedKeys_.size() + queue_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) return GpuQueueResult::Full;
+	}
+	std::shared_ptr<const LiveGpuAllocationLedger::Lease> retainedReservation;
+	if (request.retainedBudget) {
+		retainedReservation = request.retainedBudget->TryTrack(request.estimatedBytes, request.retainedBudgetLimit);
+		if (!retainedReservation) return GpuQueueResult::BudgetBlocked;
+	}
+	budget_.Update(QueryBudget());
+	if (!budget_.Reserve({request.estimatedBytes, request.pendingGenerationOverlap})) {
+		cache_.EvictInactive(request.estimatedBytes); budget_.Update(QueryBudget());
+		if (!budget_.Reserve({request.estimatedBytes, request.pendingGenerationOverlap})) return GpuQueueResult::BudgetBlocked;
+	}
+	try { queue_.push_back({request, std::move(candidate), std::move(retainedReservation), std::move(cpuScratchReservation)}); }
+	catch (...) { budget_.Complete(request.estimatedBytes + request.pendingGenerationOverlap); throw; }
+	queuedBytes_ += request.estimatedBytes; queuedShaderBytecodeBytes_ += retainedShaderBytes;
+	return GpuQueueResult::Queued;
+}
+std::shared_ptr<PreparedGpuObject> PreparationPlanner::Create(const GpuPreparationRequest& r,
+	const std::shared_ptr<const LiveGpuAllocationLedger::Lease>& retainedReservation,
+	const std::shared_ptr<const void>& cpuScratchReservation, HRESULT& hr) {
+	auto result = std::make_shared<PreparedGpuObject>(); hr = E_INVALIDARG;
+	const auto* bytes = r.shaderBytecode ? r.shaderBytecode.Data() : r.snapshot.bytes ? r.snapshot.bytes->data() : nullptr;
+	const size_t byteCount = r.shaderBytecode ? r.shaderBytecode.Size() : r.snapshot.bytes ? r.snapshot.bytes->size() : 0;
+	ScopedLoadTrace trace(LoadStage::GpuCreation); trace.SetBytes(r.estimatedBytes);
+	switch (r.kind) {
+	case GpuPreparationKind::Buffer: {
+		std::vector<uint8_t> padded;
+		if (r.buffer.ByteWidth > byteCount) {
+			if (!cpuScratchReservation) return nullptr;
+			padded.resize(r.buffer.ByteWidth, 0);
+			std::memcpy(padded.data(), bytes, byteCount);
+		}
+		D3D11_SUBRESOURCE_DATA initial{};
+		initial.pSysMem = padded.empty() ? bytes : padded.data();
+		ID3D11Buffer* buffer = nullptr;
+		hr = device_->CreateBuffer(&r.buffer, &initial, &buffer); result->resource = buffer; break;
+	}
+	case GpuPreparationKind::EncodedDDS:
+		if (!cpuScratchReservation) return nullptr;
+		hr = DirectX::CreateDDSTextureFromMemoryEx(device_, bytes, byteCount, r.maxTextureSize,
+			D3D11_USAGE_DEFAULT, r.loaderBindFlags, 0, r.loaderMiscFlags, r.forceSRGB, &result->resource, nullptr);
+		break;
+	case GpuPreparationKind::EncodedWIC:
+		if (!cpuScratchReservation) return nullptr;
+		hr = DirectX::CreateWICTextureFromMemoryEx(device_, bytes, byteCount, r.maxTextureSize,
+			D3D11_USAGE_DEFAULT, r.loaderBindFlags, 0, r.loaderMiscFlags, r.wicLoaderFlags, &result->resource, nullptr);
+		break;
+	case GpuPreparationKind::Texture2D: {
+		std::vector<D3D11_SUBRESOURCE_DATA> initial(r.subresources.size());
+		for (size_t i = 0; i < initial.size(); ++i) {
+			initial[i].pSysMem = bytes + r.subresources[i].offset;
+			initial[i].SysMemPitch = r.subresources[i].rowPitch; initial[i].SysMemSlicePitch = r.subresources[i].slicePitch;
+		}
+		ID3D11Texture2D* texture = nullptr;
+		hr = device_->CreateTexture2D(&r.texture, initial.data(), &texture); result->resource = texture; break;
+	}
+	case GpuPreparationKind::ShaderBundle: {
+		result->bundle = std::make_shared<PreparedShaderBundle>();
+		const auto& input = *r.shaderBundle; auto& output = *result->bundle; hr = S_OK;
+#define PREPARE_BUNDLE_STAGE(Index, Member, Method) if (SUCCEEDED(hr) && input.stages[Index]) hr = device_->Method(input.stages[Index].Data(), input.stages[Index].Size(), nullptr, &output.Member);
+		PREPARE_BUNDLE_STAGE(0, vertex, CreateVertexShader)
+		PREPARE_BUNDLE_STAGE(1, hull, CreateHullShader)
+		PREPARE_BUNDLE_STAGE(2, domain, CreateDomainShader)
+		PREPARE_BUNDLE_STAGE(3, geometry, CreateGeometryShader)
+		PREPARE_BUNDLE_STAGE(4, pixel, CreatePixelShader)
+		PREPARE_BUNDLE_STAGE(5, compute, CreateComputeShader)
+#undef PREPARE_BUNDLE_STAGE
+		if (SUCCEEDED(hr) && input.createBlendState) hr = device_->CreateBlendState(&input.blend, &output.blend);
+		if (SUCCEEDED(hr) && input.createDepthStencilState) hr = device_->CreateDepthStencilState(&input.depthStencil, &output.depthStencil);
+		if (SUCCEEDED(hr) && input.createRasterizerState) hr = device_->CreateRasterizerState(&input.rasterizer, &output.rasterizer);
+		if (SUCCEEDED(hr) && input.createSamplerState) hr = device_->CreateSamplerState(&input.sampler, &output.sampler);
+		break;
+	}
+#define PREPARE_SHADER(Kind, Type, Method) case GpuPreparationKind::Kind: { Type* shader = nullptr; hr = device_->Method(bytes, byteCount, nullptr, &shader); result->shader = shader; break; }
+	PREPARE_SHADER(VertexShader, ID3D11VertexShader, CreateVertexShader)
+	PREPARE_SHADER(PixelShader, ID3D11PixelShader, CreatePixelShader)
+	PREPARE_SHADER(GeometryShader, ID3D11GeometryShader, CreateGeometryShader)
+	PREPARE_SHADER(HullShader, ID3D11HullShader, CreateHullShader)
+	PREPARE_SHADER(DomainShader, ID3D11DomainShader, CreateDomainShader)
+	PREPARE_SHADER(ComputeShader, ID3D11ComputeShader, CreateComputeShader)
+#undef PREPARE_SHADER
+	}
+	trace.SetResult(hr);
+	if (SUCCEEDED(hr) && (r.createShaderResourceView || r.createDefaultShaderResourceView)) {
+		ScopedLoadTrace viewTrace(LoadStage::ViewCreation);
+		hr = device_->CreateShaderResourceView(result->resource, r.createDefaultShaderResourceView ? nullptr : &r.shaderResourceView, &result->shaderResourceView);
+		viewTrace.SetResult(hr);
+	}
+	if (SUCCEEDED(hr)) {
+		std::array<ID3D11DeviceChild*, 12> children{};
+		children[0] = result->resource; children[1] = result->shader;
+		if (result->bundle) {
+			const auto& b = *result->bundle;
+			children[2] = b.vertex; children[3] = b.hull; children[4] = b.domain; children[5] = b.geometry;
+			children[6] = b.pixel; children[7] = b.compute; children[8] = b.blend;
+			children[9] = b.depthStencil; children[10] = b.rasterizer; children[11] = b.sampler;
+		}
+		// An intentional null-only stage bundle has no GPU allocation to track.
+		const bool hasAllocation = std::any_of(children.begin(), children.end(), [](ID3D11DeviceChild* child) { return child != nullptr; });
+		if (hasAllocation) {
+			result->retainedBudgetEstimate = retainedReservation;
+			result->allocationEstimate = ProcessGpuAllocationLedger().Track(r.estimatedBytes);
+			if (!result->allocationEstimate) hr = E_OUTOFMEMORY;
+			else {
+				auto* attachment = new AllocationEstimateAttachment(result->allocationEstimate, result->retainedBudgetEstimate);
+				for (auto* child : children) {
+					if (child && SUCCEEDED(hr)) hr = child->SetPrivateDataInterface(AllocationEstimateGuid, attachment);
+				}
+				attachment->Release();
+			}
+		}
+	}
+	return SUCCEEDED(hr) ? result : nullptr;
+}
+GpuPumpResult PreparationPlanner::Pump(bool knownLoadingWindow, GpuPumpLimits limits) {
+	GpuPumpResult result;
+	if (!enabled_ || !device_ || !OnOwner() || !knownLoadingWindow || !limits.operations || !limits.bytes || !(limits.milliseconds > 0)) return result;
+	const auto start = std::chrono::steady_clock::now(); uint64_t processedBytes = 0;
+	while (!queue_.empty() && result.created + result.failed + result.compatibilitySkipped < limits.operations) {
+		const auto& next = queue_.front();
+		if (next.request.estimatedBytes > limits.bytes) {
+			budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+			queuedBytes_ -= next.request.estimatedBytes;
+			queuedShaderBytecodeBytes_ -= RetainedShaderBytecodeBytes(next.request);
+			queue_.pop_front(); ++result.compatibilitySkipped;
+			continue;
+		}
+		if (next.request.estimatedBytes > limits.bytes - processedBytes ||
+			std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count() >= limits.milliseconds) break;
+		// Recheck process budget at execution, excluding this request's own
+		// reservation. Queue estimates are not a promise of driver residency.
+		budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+		budget_.Update(QueryBudget());
+		if (!budget_.Reserve({next.request.estimatedBytes, next.request.pendingGenerationOverlap})) {
+			// Pressure invalidates speculative reservations; retain CPU sources
+			// in the CPU cache and let the runtime count a preparation miss.
+			queue_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0;
+			budget_ = MemoryBudgetController(128ull * 1024 * 1024, safetyHeadroom_); break;
+		}
+		// Make space before driver allocation, preserving active leases. A
+		// configured cache cap includes the pending allocation's peak estimate.
+		if (!cache_.MakeRoom(next.request.estimatedBytes)) {
+			budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+			queuedBytes_ -= next.request.estimatedBytes;
+			queuedShaderBytecodeBytes_ -= RetainedShaderBytecodeBytes(next.request);
+			queue_.pop_front(); ++result.compatibilitySkipped;
+			continue;
+		}
+		auto work = std::move(queue_.front()); queue_.pop_front();
+		processedBytes += work.request.estimatedBytes; queuedBytes_ -= work.request.estimatedBytes;
+		struct ReservationCompletion {
+			MemoryBudgetController& budget;
+			uint64_t bytes;
+			uint64_t& retainedShaderBytes;
+			uint64_t requestShaderBytes;
+			~ReservationCompletion() {
+				budget.Complete(bytes);
+				retainedShaderBytes = retainedShaderBytes >= requestShaderBytes ? retainedShaderBytes - requestShaderBytes : 0;
+			}
+		} completion{budget_, work.request.estimatedBytes + work.request.pendingGenerationOverlap,
+			queuedShaderBytecodeBytes_, RetainedShaderBytecodeBytes(work.request)};
+		HRESULT hr = E_FAIL; auto object = Create(work.request, work.retainedReservation, work.cpuScratchReservation, hr);
+		if (object) {
+			const auto canonical = CanonicalKey(work.key, *object);
+			if (cache_.Insert(canonical, std::move(object), work.request.estimatedBytes)) {
+				// Never discard an active alias: it is also the handle needed
+				// to release a policy pin. Admission bounds the alias index.
+				if (canonical < work.key || work.key < canonical) resolvedKeys_[work.key] = canonical;
+				++result.created;
+			} else ++result.failed;
+		} else {
+			++result.failed;
+			if (FAILED(hr) && hr != E_OUTOFMEMORY && hr != E_PENDING &&
+				hr != DXGI_ERROR_DEVICE_REMOVED && hr != DXGI_ERROR_DEVICE_RESET && hr != DXGI_ERROR_DEVICE_HUNG &&
+				hr != DXGI_ERROR_WAS_STILL_DRAWING && failedKeys_.size() < (std::max)(size_t(1), maxQueued_ * 4))
+				failedKeys_.insert(work.key);
+		}
+		if (hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET || FAILED(device_->GetDeviceRemovedReason())) {
+			result.deviceRemoved = true; RetireDevice(); break;
+		}
+	}
+	return result;
+}
+bool PreparationPlanner::Protect(const DeviceResourceKey& key) {
+	if (!device_ || !OnOwner()) return false;
+	const auto resolved = resolvedKeys_.find(key);
+	return cache_.Protect(resolved == resolvedKeys_.end() ? key : resolved->second);
+}
+void PreparationPlanner::Unprotect(const DeviceResourceKey& key) {
+	if (!device_ || !OnOwner()) return;
+	const auto resolved = resolvedKeys_.find(key);
+	cache_.Unprotect(resolved == resolvedKeys_.end() ? key : resolved->second);
+}
+std::shared_ptr<PreparedGpuObject> PreparationPlanner::TryAcquire(const DeviceResourceKey& key) {
+	if (!device_ || !OnOwner()) return {};
+	auto resolved = resolvedKeys_.find(key);
+	auto object = cache_.Find(resolved == resolvedKeys_.end() ? key : resolved->second);
+	if (!object && resolved != resolvedKeys_.end()) resolvedKeys_.erase(resolved);
+	return std::static_pointer_cast<PreparedGpuObject>(object);
+}
+}
+
+namespace ModLoading {
+bool AttachPreparedAllocation(ID3D11DeviceChild* child, uint64_t bytes,
+	std::shared_ptr<const LiveGpuAllocationLedger::Lease> retained) {
+	if (!child || !retained) return false;
+	auto process = ProcessGpuAllocationLedger().Track(bytes);
+	if (!process) return false;
+	auto* attachment = new AllocationEstimateAttachment(std::move(process), std::move(retained));
+	const HRESULT hr = child->SetPrivateDataInterface(AllocationEstimateGuid, attachment);
+	attachment->Release();
+	return SUCCEEDED(hr);
+}
+}
+
+#endif
diff --git a/DirectX11/ModLoading/PreparationPlanner.h b/DirectX11/ModLoading/PreparationPlanner.h
