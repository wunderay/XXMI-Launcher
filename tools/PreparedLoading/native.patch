+			D3D11_SDK_VERSION, &rawDevice, nullptr, &rawContext))) return __LINE__;
+		if (!passThrough(rawDevice, rawContext))
+			return __LINE__;
+		std::shared_ptr<ID3D11Device> device(rawDevice, [](ID3D11Device* p) { p->Release(); });
+		std::shared_ptr<ID3D11DeviceContext> context(rawContext, [](ID3D11DeviceContext* p) { p->Release(); });
+		{
+			ID3D11Device* rawSingleThreaded = nullptr;
+			ID3D11DeviceContext* rawSingleContext = nullptr;
+			if (FAILED(createDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, D3D11_CREATE_DEVICE_SINGLETHREADED,
+				nullptr, 0, D3D11_SDK_VERSION, &rawSingleThreaded, nullptr, &rawSingleContext)))
+				return __LINE__;
+			if (!passThrough(rawSingleThreaded, rawSingleContext))
+				return __LINE__;
+			std::shared_ptr<ID3D11Device> singleThreaded(rawSingleThreaded, [](ID3D11Device* p) { p->Release(); });
+			std::shared_ptr<ID3D11DeviceContext> singleContext(rawSingleContext, [](ID3D11DeviceContext* p) { p->Release(); });
+			if (!(singleThreaded->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED))
+				return __LINE__;
+			const int slot = ReserveGraphRetirement(singleThreaded.get());
+			if (slot < 0)
+				return __LINE__;
+			std::thread foreignEmptyCancel([&] { CancelGraphRetirement(slot); });
+			foreignEmptyCancel.join();
+			{
+				auto& retirement = Services();
+				std::lock_guard<std::mutex> guard(retirement.graphRetirementMutex);
+				if (!retirement.graphRetirement[slot].reserved)
+					return __LINE__;
+			}
+			const auto retirementOwner = std::this_thread::get_id();
+			auto destructionThread = std::make_shared<std::atomic<int>>(0);
+			ConfigGenerationPin retired(new ConfigurationState(), [retirementOwner, destructionThread](ConfigurationState* graph) {
+				destructionThread->store(std::this_thread::get_id() == retirementOwner ? 1 : -1);
+				delete graph;
+			});
+			D3D11_BUFFER_DESC bufferDescriptor{};
+			bufferDescriptor.ByteWidth = 16;
+			bufferDescriptor.Usage = D3D11_USAGE_DEFAULT;
+			bufferDescriptor.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+			ID3D11Buffer* buffer = nullptr;
+			if (FAILED(singleThreaded->CreateBuffer(&bufferDescriptor, nullptr, &buffer)))
+				return __LINE__;
+			retired->resources[L"retirement"].resource = buffer;
+			auto cpuPin = retired;
+			std::weak_ptr<ConfigurationState> retained = retired;
+			const auto beforeSubmit = graphRetirementContextCalls.load();
+			std::thread foreignSubmit([&, previous = std::move(retired)]() mutable {
+				SubmitGraphRetirement(slot, std::move(previous));
+			});
+			foreignSubmit.join();
+			if (retained.expired() || graphRetirementContextCalls.load() != beforeSubmit)
+				return __LINE__;
+			{
+				auto& retirement = Services();
+				std::lock_guard<std::mutex> guard(retirement.graphRetirementMutex);
+				if (retirement.graphRetirement[slot].submitted)
+					return __LINE__;
+				retired = *retirement.graphRetirement[slot].graph;
+			}
+			SubmitGraphRetirement(slot, std::move(retired));
+			const auto contextCalls = graphRetirementContextCalls.load();
+			const auto dataCalls = graphRetirementDataCalls.load();
+			CancelGraphRetirement(slot);
+			PollGraphRetirement(device.get());
+			std::thread foreign([&] {
+				CancelGraphRetirement(slot);
+				PollGraphRetirement(singleThreaded.get());
+			});
+			foreign.join();
+			if (retained.expired() || graphRetirementContextCalls.load() != contextCalls || graphRetirementDataCalls.load() != dataCalls)
+				return __LINE__;
+			{
+				auto& retirement = Services();
+				std::lock_guard<std::mutex> guard(retirement.graphRetirementMutex);
+				if (!retirement.graphRetirement[slot].reserved || !retirement.graphRetirement[slot].submitted)
+					return __LINE__;
+			}
+			singleContext->Flush();
+			PollGraphRetirement(singleThreaded.get());
+			if (retained.expired() || destructionThread->load() != 0 || graphRetirementDataCalls.load() != dataCalls)
+				return __LINE__;
+			// Model the old RuntimeState releasing its final graph pin on its
+			// disposal worker. The slot must still protect every GPU child.
+			std::thread releaseCpuPin([pin = std::move(cpuPin)]() mutable { pin.reset(); });
+			releaseCpuPin.join();
+			if (retained.expired() || destructionThread->load() != 0)
+				return __LINE__;
+			// With only the slot's pin left, wrong-device/foreign polling must
+			// still avoid the driver and preserve owner-thread destruction.
+			PollGraphRetirement(device.get());
+			std::thread foreignFinalPin([&] {
+				CancelGraphRetirement(slot);
+				PollGraphRetirement(singleThreaded.get());
+			});
+			foreignFinalPin.join();
+			if (retained.expired() || graphRetirementContextCalls.load() != contextCalls || graphRetirementDataCalls.load() != dataCalls)
+				return __LINE__;
+			const ULONGLONG retirementDeadline = GetTickCount64() + 5000;
+			while (!retained.expired() && GetTickCount64() < retirementDeadline) {
+				PollGraphRetirement(singleThreaded.get());
+				Sleep(5);
+			}
+			if (!retained.expired() || destructionThread->load() != 1 ||
+				graphRetirementContextCalls.load() <= contextCalls || graphRetirementDataCalls.load() <= dataCalls)
+				return __LINE__;
+		}
+		auto& service = Services();
+		service.generalCpuBudget->SetCapacity(256 * MiB);
+		DetachedConfigServices compilerServices; compilerServices.cpuBudget = service.generalCpuBudget;
+		compilerServices.workingDirectory = root;
+		auto builder = CaptureTestDetachedConfigBuilder(root + L"runtime-user.ini", compilerServices);
+		ConfigSourceManifest manifest;
+		manifest.verified = true;
+		manifest.userConfig = root + L"runtime-user.ini";
+		std::string error; SourceSnapshot source;
+		if (!service.generalCpuBudget->ReadSnapshot(root + L"d3dx.ini", MiB, source, error)) return __LINE__;
+		manifest.sources.push_back({source, L""});
+		if (!service.generalCpuBudget->ReadSnapshot(root + L"runtime-user.ini", MiB, source, error)) return __LINE__;
+		manifest.sources.push_back({source, root + L"runtime-user.ini"});
+		IncrementalConfigCache cache;
+		ConfigCompiler compiler(cache, builder);
+		auto baseline = compiler.Build(manifest, {}, {1, 1, service.legacyConfigEpoch.load()}, true);
+		if (!baseline || !baseline->semanticState || baseline->disposition != ConfigDisposition::Complete)
+			return __LINE__;
+		auto original = PinConfiguration();
+		if (TryPublishConfiguration(baseline->semanticState, original, 262144, true) != ConfigPublishResult::Published)
+			return __LINE__;
+		original.reset();
+		auto state = Disposal().Make<RuntimeState>();
+		state->mode = PreparationMode::PreparedProfile;
+		state->enabled = true;
+		state->generalEnabled = state->transactionalActivation = state->loadingWindow = true;
+		state->legacyConfigEpoch = service.legacyConfigEpoch.load();
+		state->generation = ++service.nextGeneration;
+		state->generalCpuBytes = 256 * MiB;
+		state->generalGpuBytes = 128 * MiB;
+		state->shaderBytes = 32 * MiB;
+		state->config = baseline;
+		state->graph = baseline->semanticState;
+		state->semanticBuilder = builder;
+		state->scheduler = std::make_shared<PreparationScheduler>();
+		ChangeOptions options;
+		options.periodicReconcileMs = 0;
+		state->monitor.reset(new ChangeMonitor(options));
+		if (!state->monitor->Start({root}, {}, [owned = state.get()](const ReconcileRequest& request) {
+				RecordMonitorChange(owned, request);
+			}))
+			return __LINE__;
+		state->sourceToken = state->monitor->CurrentToken();
+		if (!service.generalWorker) service.generalWorker = new GeneralBuildWorker();
+		std::atomic_store(&service.state, state);
+		auto diagnose = [&](const char *phase) {
+			auto candidate = service.pendingGeneral;
+			std::lock_guard<std::mutex> guard(state->generalMutex);
+			fprintf(stderr, "Runtime fixture %s: enabled=%d failed=%d source=%llu current=%llu build-device=%llu pending-result=%d reason=%.512s failure=%.512s\n",
+				phase, int(state->enabled.load()), int(state->failed.load()),
+				static_cast<unsigned long long>(state->sourceToken.load()),
+				static_cast<unsigned long long>(state->monitor->CurrentToken()),
+				static_cast<unsigned long long>(state->generalBuildDeviceEpoch),
+				int(bool(state->generalResult)), state->generalReason.c_str(), state->generalFailure.c_str());
+			if (candidate) {
+				fprintf(stderr, "Runtime fixture candidate: id=%llu valid=%d ready=%zu/%zu ini=%d retirement=%d activation=%d source=%llu next-source=%llu next-current=%llu reason=%.512s\n",
+					static_cast<unsigned long long>(candidate->id), int(candidate->valid),
+					candidate->readyAssets, candidate->assets.size(), int(candidate->iniPrepared),
+					candidate->retirementSlot, int(candidate->activationRequested),
+					static_cast<unsigned long long>(candidate->versions.source),
+					static_cast<unsigned long long>(candidate->nextSourceToken),
+					static_cast<unsigned long long>(candidate->next && candidate->next->monitor ? candidate->next->monitor->CurrentToken() : 0),
+					candidate->reason.c_str());
+				fprintf(stderr, "Runtime fixture activation attempt: stage=%d publication=%d uploaded=%d committed=%d (Published=0 Busy=1 Stale=2 Invalid=3 MigrationBudget=4)\n",
+					candidate->lastStage, candidate->lastPublication, int(candidate->lastUploaded), int(candidate->lastCommit));
+			}
+			fflush(stderr);
+		};
+		{ ConfigReadScope read; ConfigState().variables.at(L"$x").fval = 19; }
+		if (!state->enabled.load() || Current() != state) return __LINE__;
+		if (!write(L"d3dx.ini", changed)) return __LINE__;
+		RequestFullPreparationRescan();
+		if (!state->enabled.load() || Current() != state || PinConfiguration() != state->graph) return __LINE__;
+		const ULONGLONG deadline = GetTickCount64() + 20000;
+		bool activated = false;
+		while (GetTickCount64() < deadline) {
+			PumpRuntime(device.get(), 1, context.get());
+			if (!state->enabled.load() && PinConfiguration() == state->graph) {
+				diagnose("source change disabled active runtime");
+				return __LINE__;
+			}
+			auto candidate = service.pendingGeneral;
+			if (candidate && candidate->valid && candidate->readyAssets == candidate->assets.size() && candidate->iniPrepared && candidate->retirementSlot >= 0)
+				service.refreshActivation.Request();
+			if (PinConfiguration() != state->graph) { activated = true; break; }
+			Sleep(5);
+		}
+		if (!activated) {
+			diagnose("activation failed");
+			return __LINE__;
+		}
+		auto active = PinConfiguration();
+		if (active->variables.at(L"$x").fval != 19 || active->variables.at(L"$y").fval != 22 ||
+			active->iniParams.empty() || active->iniParams[0].x != 19 || !active->ownedIniTexture) return __LINE__;
+		if (state->graph->variables.at(L"$x").fval != 19 || state->graph == active) return __LINE__;
+		auto& resource = active->resources.at(L"resourceprepared");
+		if (!resource.substantiated || !resource.resource || !resource.preparation_pin) return __LINE__;
+		auto prepared = resource.resource;
+		HANDLE denyRead = CreateFileW((root + L"runtime-buffer.bin").c_str(), GENERIC_READ, 0, nullptr, OPEN_EXISTING, 0, nullptr);
+		if (denyRead == INVALID_HANDLE_VALUE) return __LINE__;
+		const auto creations = Profiling::resources_created;
+		{ ConfigReadScope read(active); resource.Substantiate(device.get(), D3D11_BIND_VERTEX_BUFFER, D3D11_RESOURCE_MISC_FLAG(0)); }
+		CloseHandle(denyRead);
+		if (resource.resource != prepared || Profiling::resources_created != creations) return __LINE__;
+		// A semantically invalid replacement must never publish over last-good.
+		if (!write(L"d3dx.ini", "[Constants]\nglobal $broken = invalid expression\n")) return __LINE__;
+		RequestFullPreparationRescan();
+		const ULONGLONG failedDeadline = GetTickCount64() + 20000;
+		bool rejected = false;
+		while (GetTickCount64() < failedDeadline) {
+			PumpRuntime(device.get(), 1, context.get());
+			if (service.pendingGeneral && !service.pendingGeneral->valid) { rejected = true; break; }
+			Sleep(5);
+		}
+		if (!rejected || PinConfiguration() != active || resource.resource != prepared) {
+			diagnose("last-good rejection failed");
+			return __LINE__;
+		}
+		auto current = Current(); current->enabled = false;
+		service.pendingGeneral.reset();
+		context->ClearState(); context->Flush();
+		LogInfo("Runtime fixture passed: actual worker/WARP/full graph/migration/first use/last-good\n");
+		return 0;
+	} catch (...) { return __LINE__; }
+}
+#endif
+
+}
