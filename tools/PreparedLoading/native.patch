+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return refs_.fetch_add(1, std::memory_order_relaxed) + 1; }
+    ULONG STDMETHODCALLTYPE Release() override {
+        const ULONG remaining = refs_.fetch_sub(1, std::memory_order_acq_rel) - 1;
+        if (!remaining) delete this;
+        return remaining;
+    }
+private:
+    ~AllocationEstimateAttachment() = default;
+    std::atomic<ULONG> refs_{1};
+    std::shared_ptr<const LiveGpuAllocationLedger::Lease> lease_;
+};
+struct ShaderBytecodeRegistry {
+    struct Entry {
+        std::weak_ptr<ID3DBlob> owner;
+        SourceDigest digest;
+        size_t bytes;
+    };
+    std::mutex mutex;
+    std::atomic<uint64_t> liveBytes{0};
+    std::map<ID3DBlob*, Entry> owners;
+};
+ShaderBytecodeRegistry& BytecodeRegistry() {
+    // Shared owners can outlive configuration services during DLL teardown.
+    // This CPU-only accounting registry has no loader-lock destructor work.
+    static auto* registry = new ShaderBytecodeRegistry;
+    return *registry;
+}
+void Append(std::vector<uint32_t>& v, std::initializer_list<uint32_t> fields) { v.insert(v.end(), fields); }
+uint32_t FloatBits(float value) { uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); return bits; }
+void AppendDigest(std::vector<uint32_t>& v, const SourceDigest& digest) {
+    for (size_t i = 0; i < digest.size(); i += 4)
+        v.push_back(uint32_t(digest[i]) | uint32_t(digest[i + 1]) << 8 |
+            uint32_t(digest[i + 2]) << 16 | uint32_t(digest[i + 3]) << 24);
+}
+bool AppendBundle(std::vector<uint32_t>& v, const ShaderBundleInput& bundle, uint64_t estimate) {
+    if (bundle.stageOverrideMask & ~63u) return false;
+    Append(v, {bundle.stageOverrideMask, uint32_t(bundle.createBlendState), uint32_t(bundle.createDepthStencilState),
+        uint32_t(bundle.createRasterizerState), uint32_t(bundle.createSamplerState)});
+    uint64_t bytecodeBytes = 0;
+    bool hasOperation = bundle.stageOverrideMask || bundle.createBlendState || bundle.createDepthStencilState ||
+        bundle.createRasterizerState || bundle.createSamplerState;
+    if (!hasOperation) return false;
+    for (size_t stage = 0; stage < bundle.stages.size(); ++stage) {
+        const auto& code = bundle.stages[stage];
+        if (code && !(bundle.stageOverrideMask & (1u << stage))) return false;
+        Append(v, {uint32_t(bool(code)), uint32_t(code.Size()), uint32_t(uint64_t(code.Size()) >> 32)});
+        if (code) {
+            if (code.Size() > estimate - bytecodeBytes) return false;
+            bytecodeBytes += code.Size(); AppendDigest(v, code.Digest());
+        }
+    }
+    if (bundle.createBlendState) {
