new file mode 100644
index 0000000000000000000000000000000000000000..9163c6cfd43352a4fd8ce679c12fc03926ca0bb0
--- /dev/null
+++ b/DirectX11/ModLoading/WorkingSetPolicy.h
@@ -0,0 +1,100 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+namespace ModLoading {
+struct WorkingSetNode {
+	std::wstring id;
+	std::vector<std::wstring> dependencies;
+	bool compatibilityOnly = false;
+};
+struct WorkingSetLimits {
+	size_t assets = 8192;
+	size_t dependenciesPerAsset = 64;
+	size_t idCharacters = 512;
+	size_t recentAssets = 256;
+	size_t assetsPerDraw = 32;
+	size_t pairs = 2048;
+	size_t predictions = 64;
+	uint64_t predictionLifetime = 120;
+	uint64_t recentLifetime = 600;
+};
+struct WorkingSetSelection {
+	uint64_t generation = 0;
+	std::set<std::wstring> selected;
+	std::map<std::wstring, std::string> compatibility;
+	std::vector<std::wstring> unknownSeeds;
+	bool graphComplete = true;
+	bool Complete() const
+	{
+		return graphComplete && compatibility.empty() && unknownSeeds.empty();
+	}
+};
+struct WorkingSetCounters {
+	uint64_t observations = 0;
+	uint64_t predictionsIssued = 0;
+	uint64_t predictionHits = 0;
+	uint64_t predictionMisses = 0;
+	uint64_t uncoveredObservations = 0;
+	uint64_t predictionCancelled = 0;
+	uint64_t droppedObservations = 0;
+	uint64_t evictedPairs = 0;
+	uint64_t learningBypassedObservations = 0;
+	size_t recentAssets = 0;
+	size_t drawAssets = 0;
+	size_t pairs = 0;
+	size_t predictions = 0;
+};
+// Owner-thread only. Exact stable IDs; never interprets folders or names. This
+// policy only orders work: membership/prediction cannot certify GPU readiness.
+class WorkingSetPolicy {
+public:
+	explicit WorkingSetPolicy(WorkingSetLimits limits = {});
+	void SetGraph(const std::vector<WorkingSetNode>& nodes);
+	const WorkingSetSelection& SelectProfile(const std::vector<std::wstring>& seeds);
+	const WorkingSetSelection& Selection() const
+	{
+		return selection_;
+	}
+	uint64_t Generation() const
+	{
+		return selection_.generation;
+	}
+	void SetAdaptiveLearning(bool enabled);
+	void Observe(const std::wstring& id, uint64_t drawToken, uint64_t sequence);
+	int Priority(const std::wstring& id) const;
+	std::string Explain(const std::wstring& id) const;
+	WorkingSetCounters Counters() const;
+private:
+	struct Node {
+		std::vector<std::wstring> dependencies;
+		bool compatibility = false;
+	};
+	struct Pair {
+		uint32_t count = 0;
+		uint64_t last = 0;
+	};
+	using PairKey = std::pair<std::wstring, std::wstring>;
+	void ResetLearning();
+	void Expire(uint64_t sequence);
+	void Predict(const std::wstring& id);
+	bool ValidId(const std::wstring& id) const;
+	WorkingSetLimits limits_;
+	std::map<std::wstring, Node> graph_;
+	WorkingSetSelection selection_;
+	WorkingSetCounters counters_;
+	std::map<std::wstring, uint64_t> recent_, predictions_;
+	std::set<std::wstring> draw_;
+	std::map<PairKey, Pair> pairs_;
+	uint64_t sequence_ = 0;
+	uint64_t drawToken_ = 0;
+	bool haveDraw_ = false;
+	bool adaptive_ = true;
+	bool explicitProfile_ = false;
+	bool graphComplete_ = true;
+};
+}
