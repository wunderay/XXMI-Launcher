@@ -0,0 +1,68 @@
+#pragma once
+#include <memory>
+#include <cstddef>
+#include "QuiescentGenerationRegistry.h"
+
+struct ConfigurationState;
+using ConfigGenerationPin = std::shared_ptr<ConfigurationState>;
+
+// A reader keeps the complete linked object graph alive. Nested calls use the
+// same graph, including the pre/post halves of a draw and recursive commands.
+class ConfigReadScope {
+public:
+	ConfigReadScope();
+	explicit ConfigReadScope(ConfigGenerationPin generation);
+	~ConfigReadScope();
+	ConfigReadScope(const ConfigReadScope&) = delete;
+	ConfigReadScope& operator=(const ConfigReadScope&) = delete;
+	const ConfigGenerationPin& Pin() const
+	{
+		return pin_;
+	}
+private:
+	ConfigGenerationPin pin_;
+	bool outer_ = false;
+	bool counted_ = false;
+};
+
+// Selects registries only. It never replaces G, executes initialization, or
+// changes the process/device configuration. One builder owns a candidate.
+class ConfigBuildScope {
+public:
+	explicit ConfigBuildScope(ConfigGenerationPin candidate);
+	~ConfigBuildScope();
+	ConfigBuildScope(const ConfigBuildScope&) = delete;
+	ConfigBuildScope& operator=(const ConfigBuildScope&) = delete;
+private:
+	ConfigGenerationPin previous_;
+	bool previousDetached_ = false;
+};
+bool IsDetachedConfigBuild();
+ConfigGenerationPin PinConfiguration();
+// Caller retains expected until GPU completion. Publication is only admitted
+// between CPU readers and never mutates the old generation.
+ConfigPublishResult TryPublishConfiguration(const ConfigGenerationPin& candidate,
+	const ConfigGenerationPin& expected, size_t maxVariableCopies, bool reset);
+
+ConfigPublishResult StageConfigurationRuntime(const ConfigGenerationPin& candidate,
+	const ConfigGenerationPin& expected, size_t workBudget, uint64_t& revision);
+ConfigPublishResult PublishStagedConfiguration(const ConfigGenerationPin& candidate,
+	const ConfigGenerationPin& expected, uint64_t revision);
+
+// Legacy reload remains synchronous and may execute arbitrary initialization.
+// It requires exclusive CPU access, builds fresh registries, and preserves the
+// original reload/reset behavior without destroying a pinned previous graph.
+class ConfigLegacyWriteScope {
+public:
+	ConfigLegacyWriteScope();
+	~ConfigLegacyWriteScope();
+	explicit operator bool() const;
+	void BeginCandidate();
+	void Commit();
+	ConfigGenerationPin Previous() const;
+	ConfigLegacyWriteScope(const ConfigLegacyWriteScope&) = delete;
+	ConfigLegacyWriteScope& operator=(const ConfigLegacyWriteScope&) = delete;
+private:
+	struct State;
+	std::unique_ptr<State> state_;
+};
diff --git a/DirectX11/ModLoading/CpuAssetCache.cpp b/DirectX11/ModLoading/CpuAssetCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6715acf52a75c4292fcda64f663cdbc250b3e420
--- /dev/null
+++ b/DirectX11/ModLoading/CpuAssetCache.cpp
@@ -0,0 +1,86 @@
+#include "CpuAssetCache.h"
+#include <limits>
+namespace ModLoading {
+namespace {
+bool Unpinned(const std::shared_ptr<const PreparedAsset> &asset) {
+	return asset.use_count() == 1 && asset->snapshot.bytes.use_count() == 1 &&
+		   (!asset->decoded ||
+			(asset->decoded.use_count() == 1 &&
+			 (!asset->decoded->pixels || asset->decoded->pixels.use_count() == 1)));
+}
+} // namespace
+CpuAssetCache::CpuAssetCache(size_t capacity) : capacity_(capacity) {
+}
+bool CpuAssetCache::MakeRoom(size_t bytes) {
+	if (bytes > capacity_)
+		return false;
+	while (resident_ + reserved_ > capacity_ - bytes) {
+		auto oldest = entries_.end();
+		for (auto it = entries_.begin(); it != entries_.end(); ++it)
+			if (Unpinned(it->second.asset) &&
+				(oldest == entries_.end() || it->second.touched < oldest->second.touched))
+				oldest = it;
+		if (oldest == entries_.end())
+			return false;
+		resident_ -= oldest->second.asset->ByteSize();
+		entries_.erase(oldest);
+	}
+	return true;
+}
+void CpuAssetCache::SetCapacity(size_t capacity) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	capacity_ = capacity;
+	MakeRoom(0);
+}
+bool CpuAssetCache::Reserve(size_t bytes) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!MakeRoom(bytes))
+		return false;
+	reserved_ += bytes;
+	return true;
+}
+void CpuAssetCache::ReleaseReservation(size_t bytes) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (bytes <= reserved_)
+		reserved_ -= bytes;
+}
+bool CpuAssetCache::Publish(std::shared_ptr<const PreparedAsset> asset, size_t reservation) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (reservation > reserved_)
+		return false;
+	reserved_ -= reservation;
+	if (!asset || !asset->snapshot.watchable || !asset->snapshot.bytes ||
+		asset->ByteSize() > reservation)
+		return false;
+	auto key = std::make_pair(asset->snapshot.path, asset->generation);
+	if (entries_.count(key))
+		return true;
+	size_t n = asset->ByteSize();
+	if (!MakeRoom(n))
+		return false;
+	try {
+		entries_.emplace(std::move(key), Entry{std::move(asset), ++clock_});
+	} catch (const std::bad_alloc &) {
+		return false;
+	}
+	resident_ += n;
+	return true;
+}
+std::shared_ptr<const PreparedAsset> CpuAssetCache::Find(const std::wstring &path,
+														 Generation generation) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	auto it = entries_.find({path, generation});
+	if (it == entries_.end())
+		return {};
+	it->second.touched = ++clock_;
+	return it->second.asset;
+}
+size_t CpuAssetCache::ResidentBytes() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return resident_;
+}
+size_t CpuAssetCache::ReservedBytes() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return reserved_;
+}
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/CpuAssetCache.h b/DirectX11/ModLoading/CpuAssetCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..c3974bb12160e1c54f58f39596f071b59d916cb2
--- /dev/null
+++ b/DirectX11/ModLoading/CpuAssetCache.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <map>
+#include <mutex>
+namespace ModLoading {
+class CpuAssetCache {
+public:
+	explicit CpuAssetCache(size_t capacity);
+	void SetCapacity(size_t capacity);
+	bool Reserve(size_t bytes);
+	void ReleaseReservation(size_t bytes);
+	bool Publish(std::shared_ptr<const PreparedAsset> asset, size_t reservation);
+	std::shared_ptr<const PreparedAsset> Find(const std::wstring& path, Generation generation);
+	size_t ResidentBytes() const;
+	size_t ReservedBytes() const;
+
+private:
+	struct Entry {
+		std::shared_ptr<const PreparedAsset> asset;
+		uint64_t touched;
+	};
+ bool MakeRoom(size_t bytes);
+ mutable std::mutex mutex_;
+	std::map<std::pair<std::wstring, Generation>, Entry> entries_;
+	size_t capacity_;
+	size_t resident_ = 0;
+	size_t reserved_ = 0;
+	uint64_t clock_ = 0;
+};
+}
diff --git a/DirectX11/ModLoading/DeviceResourceCache.cpp b/DirectX11/ModLoading/DeviceResourceCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b377abcbf58eb5b543e1ae7e2aed68886c7343b8
--- /dev/null
+++ b/DirectX11/ModLoading/DeviceResourceCache.cpp
@@ -0,0 +1,65 @@
+#include "DeviceResourceCache.h"
+#include <atomic>
+#include <limits>
+#include <stdexcept>
+namespace ModLoading {
+bool DeviceResourceKey::operator<(const DeviceResourceKey& other) const {
+	if (epoch != other.epoch) return epoch < other.epoch;
+	if (digest != other.digest) return digest < other.digest;
+	return effectiveOptions < other.effectiveOptions;
+}
+DeviceEpoch AllocateDeviceEpoch() {
+	static std::atomic<DeviceEpoch> next{1};
+	auto value = next.load();
+	for (;;) {
+		if (value == (std::numeric_limits<DeviceEpoch>::max)())
+			throw std::overflow_error("device epoch exhausted");
+		if (next.compare_exchange_weak(value, value + 1)) return value;
+	}
+}
+DeviceResourceCache::DeviceResourceCache(uint64_t maximumBytes) : maximum_(maximumBytes) {}
+void DeviceResourceCache::BeginEpoch(DeviceEpoch epoch) {
+	entries_.clear(); bytes_ = 0; clock_ = 0; epoch_ = epoch;
+}
+bool DeviceResourceCache::Insert(const DeviceResourceKey& key, std::shared_ptr<void> object, uint64_t bytes) {
+	if (!epoch_ || key.epoch != epoch_ || !object || bytes > maximum_) return false;
+	if (entries_.find(key) != entries_.end()) return true;
+	if (!MakeRoom(bytes)) return false;
+	entries_.emplace(key, Entry{std::move(object), bytes, ++clock_, 0}); bytes_ += bytes;
+	return true;
+}
+bool DeviceResourceCache::MakeRoom(uint64_t bytes) {
+	if (bytes > maximum_) return false;
+	if (bytes > maximum_ - bytes_) EvictInactive(bytes - (maximum_ - bytes_));
+	return bytes <= maximum_ - bytes_;
+}
+std::shared_ptr<void> DeviceResourceCache::Find(const DeviceResourceKey& key) {
+	if (!epoch_ || key.epoch != epoch_) return {};
+	auto it = entries_.find(key);
+	if (it == entries_.end()) return {};
+	it->second.use = ++clock_; return it->second.object;
+}
+bool DeviceResourceCache::Protect(const DeviceResourceKey& key) {
+	auto it = entries_.find(key);
+	if (key.epoch != epoch_ || it == entries_.end()) return false;
+	++it->second.active; return true;
+}
+void DeviceResourceCache::Unprotect(const DeviceResourceKey& key) {
+	auto it = entries_.find(key);
+	if (it != entries_.end() && it->second.active) --it->second.active;
+}
+uint64_t DeviceResourceCache::EvictInactive(uint64_t requestedBytes) {
+	uint64_t released = 0;
+	while (released < requestedBytes) {
+		auto oldest = entries_.end();
+		for (auto it = entries_.begin(); it != entries_.end(); ++it)
+			// A lease outside the cache also protects the object. This is cache
+			// ownership protection, never an assertion of OS residency.
+			if (!it->second.active && it->second.object.use_count() == 1 &&
+				(oldest == entries_.end() || it->second.use < oldest->second.use)) oldest = it;
+		if (oldest == entries_.end()) break;
+		released += oldest->second.bytes; bytes_ -= oldest->second.bytes; entries_.erase(oldest);
+	}
+	return released;
+}
+}
diff --git a/DirectX11/ModLoading/DeviceResourceCache.h b/DirectX11/ModLoading/DeviceResourceCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..a4896f9b98e1c969ceadff991a92e1e6de316392
--- /dev/null
+++ b/DirectX11/ModLoading/DeviceResourceCache.h
@@ -0,0 +1,55 @@
+#pragma once
+#include "PreparedTypes.h"
