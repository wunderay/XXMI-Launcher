+namespace {
+struct DetachedCompilePolicy {
+	wstring userConfig;
+	int recursiveInclude = 0;
+	bool cacheShaders = false, allowBufferResize = true;
+	bool signatureComments = false, undecipherableData = false, patchOffsets = false;
+	UINT hunting = 0;
+	bool initializationReady = true;
+	IniSections processSections;
+	std::vector<std::shared_ptr<InputAction>> systemActions;
+};
+bool IsDetachedSemanticSection(const wstring& name)
+{
+	return IsCommandListSection(name.c_str()) ||
+		!_wcsnicmp(name.c_str(), L"Resource", 8) ||
+		!_wcsnicmp(name.c_str(), L"Pool", 4) ||
+		!_wcsnicmp(name.c_str(), L"Preset", 6) ||
+		!_wcsnicmp(name.c_str(), L"Key", 3) ||
+		!_wcsnicmp(name.c_str(), L"Include", 7);
+}
+IniSections ProcessSections(const IniSections& sections)
+{
+	IniSections result;
+	for (const auto& entry : sections)
+		if (!IsDetachedSemanticSection(entry.first)) result.emplace(entry);
+	return result;
+}
+bool SameProcessSections(const IniSections& a, const IniSections& b)
+{
+	if (a.size() != b.size()) return false;
+	for (const auto& entry : a) {
+		auto it = b.find(entry.first);
+		if (it == b.end() || entry.second.kv_map != it->second.kv_map)
+			return false;
+	}
+	return true;
+}
+// Native parsing consumes the cache's parsed physical events. Helpers are shared
+// with the legacy reader, preserving namespace, first duplicate and global
+// override rules while skipping UTF-8 line scanning and key/section splitting.
+void ReplayConfigFile(const ModLoading::ConfigFileIR& file,
+	const wstring& sourceNamespace, size_t sourceIndex)
+{
+	std::wstring_convert<std::codecvt_utf8<wchar_t>> convert;
+	wstring iniNamespace = sourceNamespace, iniPath = sourceNamespace, section;
+	IniSection* entry = nullptr;
+	int warnDuplicates = 1;
+	bool warnNoEquals = true, preamble = true;
+	for (const auto& physical : file.physicalLines) {
+		if (detached_ini_failed) return;
+		using Kind = ModLoading::ConfigPhysicalLineIR::Kind;
+		if (physical.kind == Kind::Empty || physical.kind == Kind::Comment) continue;
+		if (physical.text.size() > 65536) { detached_ini_failed = true; return; }
+		// Deeply nested or extremely large expressions remain on the compatible
+		// loader path, avoiding unbounded recursive parse/evaluation on a worker.
+		size_t depth = 0, operators = 0;
+		for (char c : physical.value) {
+			if (c == '(' || c == '[') { if (++depth > 128) { detached_ini_failed = true; return; } }
+			else if ((c == ')' || c == ']') && depth) --depth;
+			if (c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|')
+				if (++operators > 2048) { detached_ini_failed = true; return; }
+		}
+		wstring line = convert.from_bytes(physical.text);
+		if (physical.kind == Kind::Section) {
+			preamble = false;
+			wstring parsedSection = convert.from_bytes(physical.section);
+			if (parsedSection.empty()) { detached_ini_failed = true; return; }
+			ParseIniSectionLine(&line, &section, &warnDuplicates, &warnNoEquals,
+				&entry, &iniNamespace, &iniPath, &parsedSection);
+		} else if (preamble) {
+			if (!ParseIniPreamble(&line, &iniNamespace)) return;
+		} else {
+			wstring key = convert.from_bytes(physical.key);
+			wstring value = convert.from_bytes(physical.value);
+			ParseIniKeyValLine(&line, &section, warnDuplicates, warnNoEquals,
+				entry, &iniNamespace, sourceIndex, physical.line,
+				&key, &value, physical.hasEquals);
+		}
+	}
+}
+bool ReplayDetachedInitializers(ConfigurationState& candidate)
+{
+	const auto* plan = static_cast<const DetachedInitializationPlan*>(candidate.initializerOwnership.get());
+	if (!plan) return false;
+	for (const auto& initializer : plan->declarations) {
+		if (initializer.target->flags & VariableFlags::PERSIST) continue;
+		float value = 0;
+		if (!initializer.expression.evaluatable->static_evaluate(&value, nullptr, true)) return false;
+		initializer.target->fval = value;
+	}
+	for (const auto& command : candidate.constants_command_list.commands) {
+		float value = 0;
+		if (auto variable = dynamic_cast<VariableAssignment*>(command.get())) {
+			if (variable->var->flags & VariableFlags::PERSIST) continue;
+			if (!variable->expression.static_evaluate(&value, nullptr, true)) return false;
+			variable->var->fval = value;
+		} else if (auto parameter = dynamic_cast<ParamOverride*>(command.get())) {
+			if (!parameter->expression.static_evaluate(&value, nullptr, true)) return false;
+			candidate.iniParams[parameter->param_idx].*parameter->param_component = value;
+		} else return false;
+	}
+	candidate.constants_run = true;
+	return true;
+}
+bool InitializeDetachedConstants(ConfigurationState& candidate,
+	const std::shared_ptr<DetachedInitializationPlan>& plan)
+{
+	// Only pure static assignments are admitted. Keep their sealed expressions
+	// for a bounded replay after commit-time persistence migration.
+	if (!candidate.post_constants_command_list.commands.empty()) return false;
+	if (candidate.iniParamsReserved < 0 || candidate.iniParamsReserved > D3D11_REQ_TEXTURE1D_U_DIMENSION)
+		return false;
+	if (!ReserveDetachedGraph(65536 + uint64_t(candidate.iniParamsReserved) * sizeof(DirectX::XMFLOAT4) * 2))
+		return false;
+	candidate.iniParams.resize(candidate.iniParamsReserved, DirectX::XMFLOAT4(0, 0, 0, 0));
+	for (const auto& command : candidate.constants_command_list.commands) {
+		float value = 0;
+		if (auto variable = dynamic_cast<VariableAssignment*>(command.get())) {
+			if (!variable->var || !variable->expression.static_evaluate(&value, nullptr, true)) return false;
+			variable->var->fval = value;
+		} else if (auto parameter = dynamic_cast<ParamOverride*>(command.get())) {
+			if (parameter->param_idx < 0 || parameter->param_idx >= candidate.iniParamsReserved ||
+				!parameter->param_component || !parameter->expression.static_evaluate(&value, nullptr, true)) return false;
+			candidate.iniParams[parameter->param_idx].*parameter->param_component = value;
+		} else return false;
+	}
+	candidate.initializerOwnership = plan;
+	candidate.replayInitializers = ReplayDetachedInitializers;
+	candidate.initializerCommandCount = plan->work + size_t(candidate.iniParamsReserved) * 4;
+	candidate.constants_run = true;
+	return true;
+}
+}
+
+bool ReadVerifiedCurrentConfigManifest(const ModLoading::ConfigSourceManifest& baseline,
+	ModLoading::ConfigSourceManifest& manifest, ModLoading::ResourceRefreshClosure& closure,
+	std::string& error, const std::shared_ptr<ModLoading::ResourceRefreshCpuBudget>& budget)
+{
+	ScopedIniThreadLocale localeScope;
+	manifest = {};
+	closure = {};
+	if (!baseline.verified || baseline.sources.empty()) {
+		error = "No verified main configuration source";
+		return false;
+	}
+	// The authoritative include walker is reused under detached registries and
+	// capture storage, so include order/exclusions/namespaces remain upstream's.
+	// It discovers current recursive membership, including new and removed mods.
+	ConfigSourceCapture capture;
+	capture.budget = budget;
+	if (!capture.ReserveMetadata(65536)) { error = "Configuration discovery CPU budget exhausted"; return false; }
+	auto candidate = std::make_shared<ConfigurationState>();
+	ConfigBuildScope generationScope(candidate);
+	IniSections sections;
+	capture.enabled = true;
+	capture.sources.verified = true;
+	capture.closure.verified = true;
+	struct DiscoveryScope {
+		IniSections* oldSections;
+		ConfigSourceCapture* oldCapture;
+		bool oldFailed;
+		DiscoveryScope(IniSections& sections, ConfigSourceCapture& capture) :
+			oldSections(detached_ini_sections), oldCapture(detached_source_capture),
+			oldFailed(detached_ini_failed) {
+			detached_ini_sections = &sections;
+			detached_source_capture = &capture;
+			detached_ini_failed = false;
+		}
+		~DiscoveryScope() {
+			detached_ini_sections = oldSections;
+			detached_source_capture = oldCapture;
+			detached_ini_failed = oldFailed;
+		}
+	} scope(sections, capture);
+	try {
+		ParseNamespacedIniFile(baseline.sources.front().snapshot.path.c_str(), nullptr);
+		InsertBuiltInIniSections();
+		ParseIncludedIniFiles();
+		ParsePersistentSettings();
+		if (detached_ini_failed || candidate->compileFailed || !capture.sources.verified || !capture.closure.verified) {
+			error = "Current configuration/include discovery was incomplete or exceeded bounds";
+			return false;
+		}
+		// Explicit sources and an absent persistent file need directory membership
+		// evidence too. Record parent directories before the closing source check.
+		std::set<wstring> directories;
+		for (const auto& directory : capture.closure.directories) directories.insert(directory.path);
+		auto addParent = [&](const wstring& path) {
+			const auto slash = path.find_last_of(L"\\/");
+			if (slash == wstring::npos) return false;
+			const auto parent = path.substr(0, slash);
+			if (!directories.insert(parent).second) return true;
+			if (capture.closure.directories.size() >= 4096) return false;
+			ModLoading::ResourceRefreshDirectory directory;
+			std::shared_ptr<const void> enumerationScratch;
+			if (budget) {
+				enumerationScratch = budget->TryReserve(16 * 1024 * 1024);
+				if (!enumerationScratch) { error = "Configuration directory CPU budget exhausted"; return false; }
+			}
+			directory.path = parent;
+			size_t remaining = capture.refreshEntries < 65536 ? 65536 - capture.refreshEntries : 0;
+			const auto before = remaining;
+			if (!ModLoading::ReadResourceRefreshDirectory(parent, directory.entries, error, &remaining, 4096)) return false;
+			uint64_t retained = 65536;
+			for (const auto& name : directory.entries) retained += 32 * (name.size() + 1) * sizeof(wchar_t) + 1024;
+			if (!capture.ReserveMetadata(retained)) { error = "Configuration inventory CPU budget exhausted"; return false; }
+			capture.refreshEntries += before - remaining;
+			capture.closure.directories.push_back(std::move(directory));
+			return true;
+		};
+		for (const auto& source : capture.sources.sources)
+			if (!addParent(source.snapshot.path)) return false;
+		if (!addParent(candidate->user_config)) return false;
+		if (!ModLoading::VerifyResourceRefreshClosure(capture.closure, error)) return false;
+		for (const auto& source : capture.sources.sources) {
+			if (!source.snapshot.watchable) {
+				error = source.snapshot.compatibilityReason.empty() ? "Configuration source is aliased or unwatchable" : source.snapshot.compatibilityReason;
+				return false;
+			}
+			ModLoading::SourceSnapshot current;
+			if (!(budget ? budget->ReadSnapshot(source.snapshot.path, size_t(16) * 1024 * 1024, current, error) :
+				ModLoading::ReadVerifiedSnapshot(source.snapshot.path, size_t(16) * 1024 * 1024, current, error)) ||
+				current.digest != source.snapshot.digest || !current.watchable || !current.bytes || *current.bytes != *source.snapshot.bytes) {
+				error = "Configuration source changed during include discovery";
+				return false;
+			}
+		}
+		capture.sources.userConfig = candidate->user_config;
+		capture.sources.recursiveIncludes.assign(capture.recursiveIncludes.begin(), capture.recursiveIncludes.end());
+		std::sort(capture.sources.recursiveIncludes.begin(), capture.sources.recursiveIncludes.end());
+		if (budget) budget->BindManifestOwnership(capture.sources,
+			std::make_shared<std::vector<std::shared_ptr<const void>>>(std::move(capture.metadataReservations)));
+		manifest = std::move(capture.sources);
+		closure = std::move(capture.closure);
+		error.clear();
+		return true;
+	} catch (const std::exception&) {
+		error = "Current configuration discovery failed";
+		return false;
+	}
+}
+
+static ModLoading::SemanticBuild MakeDetachedConfigBuilder(const DetachedCompilePolicy& policy,
+	DetachedConfigServices services)
+{
+	return [policy, services](const ModLoading::CompiledConfig& compiled,
+		const std::shared_ptr<const ModLoading::CompiledConfig>&) {
+		ScopedIniThreadLocale localeScope;
+		ModLoading::SemanticCompileResult result;
+		if (!policy.initializationReady) {
+			result.reason = "Legacy delayed include initialization has not completed";
+			return result;
+		}
+		if (!compiled.manifest.verified || compiled.files.size() != compiled.manifest.sources.size()) {
+			result.reason = "Incomplete verified configuration manifest";
+			return result;
+		}
+		if (!compiled.manifest.userConfig.empty() && compiled.manifest.userConfig != policy.userConfig) {
+			result.reason = "Persistent config destination changed; compatible forced reload required";
+			return result;
+		}
+		auto graphOwnership = std::make_shared<DetachedGraphOwnership>();
+		if (services.cpuBudget) {
+			graphOwnership->reserve = [budget = services.cpuBudget](uint64_t bytes) {
+				return budget->TryReserve(bytes);
+			};
+		} else {
+			graphOwnership->reserve = compiled.manifest.reserve;
+		}
+		if (graphOwnership->reserve) {
+			uint64_t graphBytes = 1024 * 1024;
+			for (const auto& source : compiled.manifest.sources) {
+				if (!source.snapshot.bytes || source.snapshot.bytes->size() > 16 * 1024 * 1024) {
+					result.reason = "Semantic graph source bound exceeded";
+					return result;
+				}
+				const auto workspaceBytes = DiscoveryWorkspaceBytes(source.snapshot, &source.iniNamespace);
+				if (workspaceBytes > (std::numeric_limits<uint64_t>::max)() - graphBytes) {
+					result.reason = "Semantic graph expansion bound exceeded";
+					return result;
+				}
+				graphBytes += workspaceBytes;
+			}
+			graphOwnership->initialReservation = graphOwnership->reserve(graphBytes);
+			if (!graphOwnership->initialReservation) {
+				result.reason = "Semantic graph CPU admission exhausted";
+				return result;
+			}
+		}
+		auto candidate = std::make_shared<ConfigurationState>();
+		candidate->graphOwnership = graphOwnership;
+		struct GraphScope {
+			DetachedGraphOwnership* previous;
+			explicit GraphScope(DetachedGraphOwnership* ownership) : previous(detached_graph_ownership) {
+				detached_graph_ownership = ownership;
+			}
+			~GraphScope() {
+				detached_graph_ownership = previous;
+			}
+		} graphScope(graphOwnership.get());
+		candidate->user_config = policy.userConfig;
+		candidate->recursive_include = policy.recursiveInclude;
+		candidate->CACHE_SHADERS = policy.cacheShaders;
+		candidate->allow_buffer_resize = policy.allowBufferResize;
+		candidate->assemble_signature_comments = policy.signatureComments;
+		candidate->disassemble_undecipherable_custom_data = policy.undecipherableData;
+		candidate->patch_cb_offsets = policy.patchOffsets;
+		candidate->hunting = policy.hunting;
+		candidate->inputActions = policy.systemActions;
+		candidate->shaderCpuBudget = services.cpuBudget;
+		candidate->shaderDiskCache = services.shaderCache;
+		candidate->shaderWorkingDirectory = services.workingDirectory;
+		candidate->shaderCacheDirectory = services.cacheDirectory;
+		ConfigBuildScope generationScope(candidate);
+		IniSections workspace;
+		ConfigSourceCapture capture;
+		capture.recursiveIncludes.insert(compiled.manifest.recursiveIncludes.begin(), compiled.manifest.recursiveIncludes.end());
+		struct SourceScope {
+			ConfigSourceCapture* previous;
+			explicit SourceScope(ConfigSourceCapture& value) : previous(detached_source_capture) { detached_source_capture = &value; }
+			~SourceScope() { detached_source_capture = previous; }
+		} sourceScope(capture);
+		struct ParseScope {
+			IniSections* previous;
+			bool previousFailed;
+			explicit ParseScope(IniSections& sections) : previous(detached_ini_sections),
+				previousFailed(detached_ini_failed) { detached_ini_sections = &sections; detached_ini_failed = false; }
+			~ParseScope() { detached_ini_sections = previous; detached_ini_failed = previousFailed; }
+		} parseScope(workspace);
+		try {
+			for (size_t i = 0; i < compiled.files.size(); ++i) {
+				ReplayConfigFile(*compiled.files[i], compiled.manifest.sources[i].iniNamespace, i);
+				// Upstream inserts built-ins after the main file and before includes.
+				if (!i) InsertBuiltInIniSections();
+			}
+			if (detached_ini_failed || candidate->compileFailed) {
+				result.reason = "Configuration parse diagnostics; last-good generation retained";
+				return result;
+			}
+			if (!SameProcessSections(policy.processSections, ProcessSections(workspace))) {
+				result.reason = "Process/device/global settings changed; compatible forced reload required";
+				return result;
+			}
+			auto initialization = std::make_shared<DetachedInitializationPlan>();
+			auto constants = workspace.find(L"Constants");
+			if (constants != workspace.end())
+				for (const auto& line : constants->second.kv_vec) initialization->work += line.raw_line.size() + 1;
+			struct InitializationScope {
+				DetachedInitializationPlan* previous;
+				explicit InitializationScope(DetachedInitializationPlan* plan) : previous(detached_initialization) { detached_initialization = plan; }
+				~InitializationScope() { detached_initialization = previous; }
+			} initializationScope(initialization.get());
+			wchar_t modulePath[MAX_PATH] = {};
+			if (!GetModuleFileNameW(migoto_handle, modulePath, MAX_PATH)) {
+				result.reason = "Module path unavailable";
+				return result;
+			}
+			auto moduleSlash = wcsrchr(modulePath, L'\\');
+			const size_t moduleDirectoryLength = moduleSlash ? size_t(moduleSlash - modulePath) + 1 : MAX_PATH;
+			for (const auto& section : workspace) {
+				if (_wcsnicmp(section.first.c_str(), L"Resource", 8) &&
+					_wcsnicmp(section.first.c_str(), L"Pool", 4) &&
+					_wcsnicmp(section.first.c_str(), L"CustomShader", 12)) continue;
+				wstring namespacePath;
+				get_namespaced_section_path(section.first.c_str(), &namespacePath);
+				for (const auto* key : { L"filename", L"vs", L"hs", L"ds", L"gs", L"ps", L"cs" }) {
+					auto value = section.second.kv_map.find(key);
+					if (value != section.second.kv_map.end() && moduleDirectoryLength + namespacePath.size() + value->second.size() >= MAX_PATH) {
+						result.reason = "Resource/shader path exceeds upstream fixed path bound";
+						return result;
+					}
+				}
+			}
+			LinkIniConfiguration();
+			if (detached_ini_failed || candidate->compileFailed) {
+				result.reason = "Configuration semantic/link diagnostics; last-good generation retained";
+				return result;
+			}
+			if (!InitializeDetachedConstants(*candidate, initialization)) {
+				result.reason = "Initialization has runtime/device side effects; compatible forced reload required";
+				return result;
+			}
+		} catch (const std::exception&) {
+			result.reason = "Detached configuration decoding/allocation/linking failed";
+			return result;
+		}
+		result.state = std::move(candidate);
+		result.complete = true;
+		result.reason = "Complete production semantic graph linked and initialized in detached registries";
+		return result;
+	};
+}
+
+ModLoading::SemanticBuild CaptureDetachedConfigBuilder(DetachedConfigServices services)
+{
+	// This factory is called at the serialized legacy/configuration boundary;
+	// only its immutable capture is accessed later by the worker.
+	DetachedCompilePolicy policy;
+	policy.userConfig = G->user_config;
+	policy.recursiveInclude = G->recursive_include;
+	policy.cacheShaders = G->CACHE_SHADERS;
+	policy.allowBufferResize = G->allow_buffer_resize;
+	policy.signatureComments = G->assemble_signature_comments;
+	policy.undecipherableData = G->disassemble_undecipherable_custom_data;
+	policy.patchOffsets = G->patch_cb_offsets;
+	policy.hunting = G->hunting;
+	policy.initializationReady = G->gConfigInitialized || !G->gSkipEarlyIncludesLoad;
+	policy.processSections = ProcessSections(ini_sections);
+	policy.systemActions = CaptureSystemInputActions();
+	return MakeDetachedConfigBuilder(policy, std::move(services));
+}
