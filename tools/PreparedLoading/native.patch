+			AddNumber(key,r.patchAbi);
+			AddNumber(key,r.flags);
+			AddNumber(key,r.effectFlags);
+			AddNumber(key,uint64_t(r.recursiveIncludes));
+			key.insert(key.end(),r.compilerIdentity.begin(),r.compilerIdentity.end());
+			key.insert(key.end(),r.patchIdentity.begin(),r.patchIdentity.end());
+			AddString(key,r.entryPoint);
+			AddString(key,r.target);
+			AddString(key,r.sourceName);
+			AddPath(key,r.workingDirectory);
+			AddNumber(key,r.defines.size());
+			for(const auto& d:r.defines){
+				AddString(key,d.first);
+				AddString(key,d.second);
+			}
+			AddNumber(key,p.dependencies.size());
+			for(const auto& d:p.dependencies){
+				AddPath(key,d.path);
+				key.insert(key.end(),d.digest.begin(),d.digest.end());
+				AddNumber(key,d.bytes->size());
+			}
+			AddNumber(key,p.includes.size());
+			for(const auto& e:p.includes){
+				AddNumber(key,e.parent);
+				AddNumber(key,e.child);
+				AddNumber(key,e.system);
+				AddString(key,e.name);
+			}
