index 0000000000000000000000000000000000000000..2e112c1ad5b1a27ab98c297e6bd88789d6c2d56c
--- /dev/null
+++ b/tests/d3d11_fixture/main.cpp
@@ -0,0 +1,242 @@
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <dxgi.h>
+#include <wrl/client.h>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <string>
+#include <vector>
+#include <cstdio>
+#include <cstring>
+#include "oracle.h"
+
+using Microsoft::WRL::ComPtr;
+namespace fs = std::filesystem;
+using namespace fixture;
+
+static void check(HRESULT hr, const char* operation) {
+    if (FAILED(hr)) {
+        char code[16]; sprintf_s(code, "0x%08lx", static_cast<unsigned long>(hr));
+        throw std::runtime_error(std::string(operation) + ": " + code);
+    }
+}
+static double now() {
+    LARGE_INTEGER counter, frequency;
+    QueryPerformanceCounter(&counter); QueryPerformanceFrequency(&frequency);
+    return double(counter.QuadPart) * 1000.0 / double(frequency.QuadPart);
+}
+struct Reports {
+    fs::path directory;
+    std::ofstream stages, frames, metadata;
+    unsigned epoch = 0;
+    explicit Reports(const fs::path& path) : directory(path) {
+        // A fresh output directory makes stale/partial runs unambiguous.
+        if (!fs::create_directory(path)) throw std::runtime_error("output directory must not exist; parent must exist");
+        stages.open(path / "stages.csv"); frames.open(path / "frames.csv"); metadata.open(path / "metadata.txt");
+        if (!stages || !frames || !metadata) throw std::runtime_error("cannot create reports");
+        stages << "epoch,stage,host_cpu_wall_ms,objects_created\n";
+        frames << "epoch,scenario,iteration,outfit,dim,lod,submit_cpu_wall_ms,readback_wait_cpu_wall_ms,verify_cpu_wall_ms,bad_pixels,max_channel_error,objects_created\n";
+        stages << std::fixed << std::setprecision(6); frames << std::fixed << std::setprecision(6);
+    }
+    void stage(const char* name, double start, unsigned count) {
+        stages << epoch << ',' << name << ',' << now()-start << ',' << count << '\n';
+    }
+};
+
+static ComPtr<ID3DBlob> compile(const char* source, const char* entry, const char* target) {
+    ComPtr<ID3DBlob> code, errors;
+    HRESULT hr = D3DCompile(source, strlen(source), "embedded_fixture.hlsl", nullptr, nullptr,
+        entry, target, D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+        &code, &errors);
+    if (FAILED(hr) && errors) std::cerr.write(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize());
+    check(hr, "D3DCompile"); return code;
+}
+
+struct Host {
+    Reports& reports;
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> context;
+    ComPtr<ID3D11VertexShader> vs;
+    ComPtr<ID3D11PixelShader> ps;
+    ComPtr<ID3D11InputLayout> layout;
+    ComPtr<ID3D11Buffer> vertices[2], indices[2], tint;
+    ComPtr<ID3D11Texture2D> textures[3], target, staging;
+    ComPtr<ID3D11ShaderResourceView> views[3];
+    ComPtr<ID3D11RenderTargetView> rtv;
+    ComPtr<ID3D11RasterizerState> raster;
+    unsigned objects = 0;
+
+    Host(Reports& r, bool warp) : reports(r) {
+        const double start = now();
+        D3D_FEATURE_LEVEL level;
+        const D3D_FEATURE_LEVEL requested[] = {D3D_FEATURE_LEVEL_11_0};
+        check(D3D11CreateDevice(nullptr, warp ? D3D_DRIVER_TYPE_WARP : D3D_DRIVER_TYPE_HARDWARE,
+            nullptr, 0, requested, 1, D3D11_SDK_VERSION, &device, &level, &context), "D3D11CreateDevice");
+        reports.stage("device_create", start, 1);
+        ComPtr<IDXGIDevice> dxgi; ComPtr<IDXGIAdapter> adapter;
+        check(device.As(&dxgi), "Query IDXGIDevice"); check(dxgi->GetAdapter(&adapter), "GetAdapter");
+        DXGI_ADAPTER_DESC desc{}; check(adapter->GetDesc(&desc), "GetDesc");
+        LARGE_INTEGER driver{};
+        HRESULT driverResult = adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &driver);
+        char name[512]{};
+        WideCharToMultiByte(CP_UTF8,0,desc.Description,-1,name,sizeof(name),nullptr,nullptr);
+        reports.metadata << "epoch=" << reports.epoch << " adapter=" << name
+            << " vendor=" << desc.VendorId << " device=" << desc.DeviceId
+            << " dedicated_video_bytes=" << desc.DedicatedVideoMemory
+            << " feature_level=" << unsigned(level) << " creation_flags=0 driver_type=" << (warp?"WARP":"hardware")
+            << " driver_version_query_hr=" << driverResult << " driver_version_raw=" << driver.QuadPart << '\n';
+        prepare();
+    }
+    ~Host() { context->ClearState(); context->Flush(); }
+
+    void prepare() {
+        static constexpr char source[] = R"(
+cbuffer Tint : register(b0) { float4 tint; };
+Texture2D<float4> image : register(t0);
+float4 VS(float2 position : POSITION) : SV_Position { return float4(position,0,1); }
+float4 PS(float4 position : SV_Position) : SV_Target {
+    return image.Load(int3(uint2(position.xy) / 32, 0)) * tint;
+})";
+        double start = now();
+        auto vcode = compile(source,"VS","vs_5_0"), pcode = compile(source,"PS","ps_5_0");
+        reports.stage("shader_compile",start,0);
+        start = now();
+        check(device->CreateVertexShader(vcode->GetBufferPointer(),vcode->GetBufferSize(),nullptr,&vs),"CreateVertexShader"); ++objects;
+        check(device->CreatePixelShader(pcode->GetBufferPointer(),pcode->GetBufferSize(),nullptr,&ps),"CreatePixelShader"); ++objects;
+        D3D11_INPUT_ELEMENT_DESC element{"POSITION",0,DXGI_FORMAT_R32G32_FLOAT,0,0,D3D11_INPUT_PER_VERTEX_DATA,0};
+        check(device->CreateInputLayout(&element,1,vcode->GetBufferPointer(),vcode->GetBufferSize(),&layout),"CreateInputLayout"); ++objects;
+        reports.stage("shader_and_layout_create",start,3);
+        start = now();
+        // Both cover the full target; two triangles versus one oversized triangle.
+        const float high[] = {-1,-1, -1,1, 1,1, 1,-1};
+        const float low[] = {-1,-1, -1,3, 3,-1};
+        const uint16_t highIndices[] = {0,1,2,0,2,3}, lowIndices[] = {0,1,2};
+        for (unsigned i=0;i<2;++i) {
+            D3D11_BUFFER_DESC b{}; b.Usage=D3D11_USAGE_IMMUTABLE; b.BindFlags=D3D11_BIND_VERTEX_BUFFER;
+            b.ByteWidth=i?sizeof(low):sizeof(high);
+            D3D11_SUBRESOURCE_DATA data{}; data.pSysMem=i?low:high;
+            check(device->CreateBuffer(&b,&data,&vertices[i]),"CreateBuffer vertices"); ++objects;
+            b.BindFlags=D3D11_BIND_INDEX_BUFFER; b.ByteWidth=i?sizeof(lowIndices):sizeof(highIndices);
+            data.pSysMem=i?lowIndices:highIndices;
+            check(device->CreateBuffer(&b,&data,&indices[i]),"CreateBuffer indices"); ++objects;
+        }
+        D3D11_BUFFER_DESC cb{}; cb.ByteWidth=16; cb.Usage=D3D11_USAGE_DEFAULT; cb.BindFlags=D3D11_BIND_CONSTANT_BUFFER;
+        check(device->CreateBuffer(&cb,nullptr,&tint),"CreateBuffer tint"); ++objects;
+        D3D11_TEXTURE2D_DESC td{}; td.Width=width; td.Height=height; td.MipLevels=td.ArraySize=1;
+        td.Format=DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count=1; td.Usage=D3D11_USAGE_DEFAULT; td.BindFlags=D3D11_BIND_RENDER_TARGET;
+        check(device->CreateTexture2D(&td,nullptr,&target),"CreateTexture2D target"); ++objects;
+        td.Usage=D3D11_USAGE_STAGING; td.BindFlags=0; td.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+        check(device->CreateTexture2D(&td,nullptr,&staging),"CreateTexture2D staging"); ++objects;
+        reports.stage("buffer_and_target_create",start,7);
+        start=now();
+        check(device->CreateRenderTargetView(target.Get(),nullptr,&rtv),"CreateRenderTargetView"); ++objects;
+        D3D11_RASTERIZER_DESC rs{}; rs.FillMode=D3D11_FILL_SOLID; rs.CullMode=D3D11_CULL_NONE; rs.DepthClipEnable=TRUE;
+        check(device->CreateRasterizerState(&rs,&raster),"CreateRasterizerState"); ++objects;
+        reports.stage("target_view_and_state_create",start,2);
+        outfit(0); outfit(1);
+    }
+    void outfit(unsigned n) {
+        double start=now();
+        Pixel pixels[4]; for(unsigned y=0;y<2;++y) for(unsigned x=0;x<2;++x) pixels[y*2+x]=texel(n,x,y);
+        D3D11_TEXTURE2D_DESC td{}; td.Width=td.Height=2; td.MipLevels=td.ArraySize=1;
+        td.Format=DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count=1; td.Usage=D3D11_USAGE_IMMUTABLE; td.BindFlags=D3D11_BIND_SHADER_RESOURCE;
+        D3D11_SUBRESOURCE_DATA data{}; data.pSysMem=pixels; data.SysMemPitch=2*sizeof(Pixel);
+        check(device->CreateTexture2D(&td,&data,&textures[n]),"CreateTexture2D outfit"); ++objects;
+        reports.stage("outfit_texture_create",start,1); start=now();
+        check(device->CreateShaderResourceView(textures[n].Get(),nullptr,&views[n]),"CreateShaderResourceView"); ++objects;
+        reports.stage("outfit_view_create",start,1);
+    }
+    void render(const char* scenario, unsigned iteration, unsigned n, bool dim, unsigned lod, bool save) {
+        if (n>2 || lod>1 || !views[n]) throw std::runtime_error("unprepared scenario");
+        unsigned before=objects;
+        double start=now();
+        const float scale=dim?0.5f:1.0f, color[4]={scale,scale,scale,1};
+        context->UpdateSubresource(tint.Get(),0,nullptr,color,0,0);
+        ID3D11RenderTargetView* targetView=rtv.Get(); context->OMSetRenderTargets(1,&targetView,nullptr);
+        const float clear[4]={1,0,1,0}; context->ClearRenderTargetView(rtv.Get(),clear);
+        D3D11_VIEWPORT vp{0,0,float(width),float(height),0,1}; context->RSSetViewports(1,&vp); context->RSSetState(raster.Get());
+        context->IASetInputLayout(layout.Get()); context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        ID3D11Buffer* vb=vertices[lod].Get(); UINT stride=sizeof(float)*2, offset=0;
+        context->IASetVertexBuffers(0,1,&vb,&stride,&offset); context->IASetIndexBuffer(indices[lod].Get(),DXGI_FORMAT_R16_UINT,0);
+        context->VSSetShader(vs.Get(),nullptr,0); context->PSSetShader(ps.Get(),nullptr,0);
+        ID3D11ShaderResourceView* srv=views[n].Get(); context->PSSetShaderResources(0,1,&srv);
+        ID3D11Buffer* cb=tint.Get(); context->PSSetConstantBuffers(0,1,&cb);
+        context->DrawIndexed(lod?3:6,0,0);
+        context->CopyResource(staging.Get(),target.Get());
+        const double submitted=now(), submitMs=submitted-start;
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        check(context->Map(staging.Get(),0,D3D11_MAP_READ,0,&mapped),"Map readback");
+        const double mappedAt=now();
+        // Own the readback before Unmap; no file export is timed as rendering.
+        std::vector<uint8_t> image(width*height*4);
+        for(unsigned y=0;y<height;++y) memcpy(image.data()+y*width*4,static_cast<const uint8_t*>(mapped.pData)+y*mapped.RowPitch,width*4);
+        context->Unmap(staging.Get(),0);
+        const auto result=compare(image.data(),image.size(),width*4,n,dim);
+        const double verified=now();
+        reports.frames << reports.epoch << ',' << scenario << ',' << iteration << ',' << n << ',' << dim << ',' << lod << ','
+            << submitMs << ',' << mappedAt-submitted << ',' << verified-mappedAt << ',' << result.badPixels << ',' << result.maxError << ',' << objects-before << '\n';
+        if (result.badPixels) throw std::runtime_error(std::string("readback mismatch: ")+scenario);
+        if (objects!=before) throw std::runtime_error("resource creation during render");
+        if(save) {
+            auto filename=std::string("epoch")+std::to_string(reports.epoch)+"_"+scenario+".ppm";
+            std::ofstream file(reports.directory/filename,std::ios::binary);
+            file << "P6\n" << width << ' ' << height << "\n255\n";
+            for(size_t i=0;i<image.size();i+=4) file.write(reinterpret_cast<const char*>(image.data()+i),3);
+            if(!file) throw std::runtime_error("PPM export failed");
+        }
+    }
+};
+
+int wmain(int argc, wchar_t** argv) {
+    try {
+        fs::path output; bool warp=false; unsigned repeats=30;
+        for(int i=1;i<argc;++i) {
+            std::wstring arg=argv[i];
+            if(arg==L"--warp") warp=true;
+            else if(arg==L"--output" && i+1<argc) output=argv[++i];
+            else if(arg==L"--repeat" && i+1<argc) {
+                std::wstring value=argv[++i]; size_t used=0;
+                auto count=std::stoul(value,&used);
+                if(used!=value.size() || count<1 || count>1000) throw std::runtime_error("repeat must be 1..1000");
+                repeats=static_cast<unsigned>(count);
+            } else throw std::runtime_error("usage: d3d11_fixture --output NEW_DIRECTORY [--warp] [--repeat 1..1000]");
+        }
+        if(output.empty()) throw std::runtime_error("--output NEW_DIRECTORY is required");
+        Reports reports(output);
+        SYSTEMTIME utc{}; GetSystemTime(&utc);
+        reports.metadata << "fixture_schema=1 baseline_source=a7847eae82aaac32175c9a7d199673d5c9323bcd\n"
+            << "utc=" << utc.wYear << '-' << utc.wMonth << '-' << utc.wDay << 'T' << utc.wHour << ':' << utc.wMinute << ':' << utc.wSecond
+            << "Z pid=" << GetCurrentProcessId() << " repeats=" << repeats << " dimensions=64x64 format=RGBA8_UNORM\n"
+            << "synthetic_offscreen=true present=false injection=false source_file_io=false decoder=false gpu_timestamps=false\n"
+            << "timing=host_QPC_wall_ms readback_wait_includes_GPU_synchronization verification_includes_readback_copy\n";
+        for(unsigned epoch=1;epoch<=2;++epoch) {
+            reports.epoch=epoch;
+            Host host(reports,warp);
+            host.render(epoch==1?"first_use":"device_recreated",0,0,false,0,true);
+            for(unsigned i=0;i<repeats;++i) {
+                host.render("revisit",i,0,false,0,i==0);
+                host.render("outfit_1",i,1,false,0,i==0);
+                host.render("toggle_dim",i,1,true,0,i==0);
+                host.render("lod_low",i,1,true,1,i==0);
+                host.render("lod_high",i,1,true,0,i==0);
+                host.context->ClearState(); // Synthetic no-change rebind, not the importer's F10 path.
+                host.render("unchanged_rebind",i,0,false,0,i==0);
+            }
+            host.outfit(2); // Preparation is recorded separately from the following first draw.
+            host.render("new_generation",0,2,false,0,true);
+            host.render("new_generation_revisit",1,2,false,1,true);
+        }
+        reports.frames.flush(); reports.stages.flush(); reports.metadata.flush();
+        if(!reports.frames || !reports.stages || !reports.metadata) throw std::runtime_error("report write failed");
+        // The success marker is last. Its absence means the run is incomplete/failed.
+        std::ofstream success(output/"PASS.txt");
+        success << "All " << 2*(1+6*repeats+2) << " rendered readbacks matched the CPU oracle (max per-channel tolerance 1).\n"
+                << "Synthetic fixture only; no in-game acceptance or performance claim.\n";
+        success.close(); if(!success) throw std::runtime_error("success marker write failed");
+        std::cout << "PASS: all readbacks verified; see output reports\n";
+        return 0;
+    } catch(const std::exception& e) { std::cerr << "FAIL: " << e.what() << '\n'; return 1; }
+}
