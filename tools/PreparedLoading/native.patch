+#!/usr/bin/env python3
+"""Portable JSON serialization contract; actual publisher needs Windows SDK."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+ROOT = Path(__file__).resolve().parents[2]
+with tempfile.TemporaryDirectory(prefix="xxmi-status-") as build:
+    executable = Path(build) / "status-test"
+    subprocess.run([os.environ.get("CXX", "c++"), "-std=c++14", "-pthread", "-Wall", "-Wextra", "-Werror",
+                    "-I" + str(ROOT / "DirectX11/ModLoading"),
+                    str(ROOT / "DirectX11/ModLoading/PreparationStatus.cpp"),
+                    str(Path(__file__).with_name("status_serialization_test.cpp")), "-o", str(executable)], check=True)
+    result = subprocess.run([str(executable)], check=True, text=True, capture_output=True)
+    rows = [json.loads(line) for line in result.stdout.splitlines()]
+    assert len(rows) == 2
+    for row in rows:
+        assert row["schema_version"] == 1 and row["process_id"] == 123
+        assert row["dll_sha256"] == "a" * 64
+        assert row["mode"] == "adaptive" and row["state"] == "preparing"
+        assert len(row["reason"]) <= 256
+    assert '\"' in rows[0]["reason"] and "\\" in rows[0]["reason"] and "\n" in rows[0]["reason"]
+    assert "\0" in rows[0]["reason"] and "\t" in rows[0]["reason"]
+    assert rows[1]["reason"] == "\0" * 256
+    assert rows[1]["total_assets"] == 2**64 - 1
+print("preparation_status: portable JSON contract passed")
