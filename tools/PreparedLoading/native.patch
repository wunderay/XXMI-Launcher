diff --git a/tests/preparation_generations/README.md b/tests/preparation_generations/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..2026c12f537b787cdcc9a16d4a373586e6bf7792
--- /dev/null
+++ b/tests/preparation_generations/README.md
@@ -0,0 +1,7 @@
+Run `./tests/preparation_generations/run.sh` on a C++14 host. The suite covers ordered content/namespace identity, same-metadata content edits, missing sources, unverified closures, bounded in-memory IR reuse, parser/schema/ABI invalidation, incremental versus clean **lexical IR** equivalence, ambiguous-include full rebuild, rollback, stale source/device/runtime stamps, immutable reader pins and nonblocking GPU retirement gates.
+
+This does not qualify transactional legacy configuration activation. The detached compiler retains actual source bytes and an ordered diagnostic lexical representation; it does not run the legacy expression evaluator, resolve command links, replace global registries, migrate mutable pools, or execute initialization commands. Every semantic configuration change remains `CompatibilityOnly`. `AssetOnly` authorizes preparation ownership only after exact baseline content and complete dependency closure match; it does not itself refresh existing live resources. Legacy F10 still performs its normal persistent save and full initialization/reset behavior even when the file bytes are unchanged.
+
+The IR cache's byte counter bounds its accounted retained payload. Compiled results and reader pins can independently retain evicted IR/source objects, so the counter is not an aggregate process-allocation limit. Staged ownership is CPU preparation only and remains distinct from live publication.
+
+Native integration captures the exact snapshots consumed by the legacy parser (including actual include order, namespaces, and persistent settings). Missing, changing, invalid-UTF-8, or overbudget inputs disable the verified baseline while preserving the upstream fallback. Directory membership and commit-time source currency remain the monitor/runtime owner's responsibility. No cache cost reduction or Windows/D3D11 live activation result is claimed by this portable suite.
diff --git a/tests/preparation_generations/main.cpp b/tests/preparation_generations/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9e170a55783a84856e7660b2ed18053eb9b826f2
--- /dev/null
+++ b/tests/preparation_generations/main.cpp
@@ -0,0 +1,144 @@
+#include "ConfigCompiler.h"
+#include "GenerationManager.h"
+#include "IncrementalConfigCache.h"
+#include "SnapshotIO.h"
+#include <atomic>
+#include <cassert>
+#include <iostream>
+#include <thread>
+using namespace ModLoading;
+namespace {
+ConfigSource Source(const std::wstring& path, const std::string& text, const std::wstring& space = L"") {
+    ConfigSource result;
+    result.snapshot.path = path;
+    result.snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(text.begin(), text.end());
+    result.snapshot.digest = HashBytes(result.snapshot.bytes->data(), result.snapshot.bytes->size());
+    result.iniNamespace = space;
+    return result;
+}
+void EqualIR(const CompiledConfig& a, const CompiledConfig& b) {
+    assert(a.identity == b.identity && a.files.size() == b.files.size());
+    assert(a.disposition == b.disposition);
+    for (size_t i = 0; i < a.files.size(); ++i) {
+        const auto& x = *a.files[i]; const auto& y = *b.files[i];
+        assert(x.digest == y.digest && x.declaredIncludes == y.declaredIncludes);
+        assert(x.lines.size() == y.lines.size());
+        for (size_t j = 0; j < x.lines.size(); ++j) {
+            const auto& p = x.lines[j]; const auto& q = y.lines[j];
+            assert(p.section == q.section && p.key == q.key && p.value == q.value && p.raw == q.raw && p.line == q.line);
+        }
+    }
+}
+GenerationPin Candidate(Generation id, const std::shared_ptr<const CompiledConfig>& config,
+    std::shared_ptr<const void> dependency = {}) {
+    auto generation = std::make_shared<ConfigGeneration>(); generation->id = id; generation->config = config;
+    generation->versions = config->versions;
+    if (dependency) generation->dependencies.push_back(std::move(dependency));
+    return generation;
+}
+}
+int main() {
+    IncrementalConfigCache cache(65536, 8);
+    ConfigCompiler compiler(cache);
+    ConfigSourceManifest sources;
+    sources.verified = true;
+    sources.sources = {Source(L"d3dx.ini", ";comment\r\n[Include]\r\ninclude = mod.ini\r\n[Present]\r\nrun = A\r\nrun = B\r\n"),
+        Source(L"mod.ini", "namespace = Example\n[ResourceThing]\nfilename = a.dds\nfilename = b.dds\n", L"mod.ini")};
+    const BuildVersions versions{11, 22, 33};
+    auto baseline = compiler.Build(sources, {}, versions, true);
+    assert(baseline->disposition == ConfigDisposition::CompatibilityOnly);
+    auto unchanged = compiler.Build(sources, baseline, versions, true);
+    assert(unchanged->disposition == ConfigDisposition::AssetOnly && unchanged->reusedFiles == 2);
+    assert(unchanged->files[0]->lines.size() == 3 && unchanged->files[0]->lines[2].value == "B");
+    assert(unchanged->files[1]->lines[2].value == "b.dds");
+    auto clean = compiler.Build(sources, baseline, versions, true, true);
+    EqualIR(*unchanged, *clean);
+    assert(clean->parsedFiles == 2 && clean->reusedFiles == 0);
+    // Same identity metadata, different content: the digest/byte proof wins.
+    auto changed = sources;
+    changed.sources[1] = Source(L"mod.ini", "namespace = Example\n[ResourceThing]\nfilename = c.dds\nfilename = b.dds\n", L"mod.ini");
+    auto incremental = compiler.Build(changed, baseline, versions, true);
+    assert(incremental->disposition == ConfigDisposition::CompatibilityOnly && incremental->parsedFiles == 1 && incremental->reusedFiles == 1);
+    EqualIR(*incremental, *compiler.Build(changed, baseline, versions, true, true));
+    auto reordered = sources; std::swap(reordered.sources[0], reordered.sources[1]);
+    assert(compiler.Build(reordered, baseline, versions, true)->disposition == ConfigDisposition::CompatibilityOnly);
+    auto renamed = sources; renamed.sources[1].iniNamespace = L"other";
+    assert(compiler.Build(renamed, baseline, versions, true)->disposition == ConfigDisposition::CompatibilityOnly);
+    assert(compiler.Build(sources, baseline, versions, false)->disposition == ConfigDisposition::CompatibilityOnly);
+    auto unverified = sources; unverified.verified = false;
+    assert(compiler.Build(unverified, baseline, versions, true)->disposition == ConfigDisposition::CompatibilityOnly);
+    auto corrupt = sources; corrupt.sources[1].snapshot.digest[0] ^= 1;
+    assert(compiler.Build(corrupt, baseline, versions, true)->disposition == ConfigDisposition::CompatibilityOnly);
+    auto missing = sources; missing.sources.pop_back();
+    assert(compiler.Build(missing, baseline, versions, true)->disposition == ConfigDisposition::CompatibilityOnly);
+    auto ambiguous = sources;
+    ambiguous.sources[0] = Source(L"d3dx.ini", "[Include]\ninclude_recursive = Mods\n");
+    auto ambiguousBaseline = compiler.Build(ambiguous, {}, versions, true);
+    auto conservative = compiler.Build(ambiguous, ambiguousBaseline, versions, true);
+    assert(conservative->fullRebuild && conservative->reusedFiles == 0 && conservative->parsedFiles == 2);
+    EqualIR(*conservative, *compiler.Build(ambiguous, ambiguousBaseline, versions, true, true));
+    cache.SetSchema(ConfigSchema{2, 3, 4});
+    auto schemaChange = compiler.Build(sources, baseline, versions, true);
+    assert(schemaChange->parsedFiles == 2 && schemaChange->identity != baseline->identity);
+    IncrementalConfigCache tiny(1, 1); bool reused = false;
+    tiny.Parse(sources.sources[0].snapshot, false, reused);
+    assert(!reused && tiny.Entries() == 0 && tiny.Bytes() == 0);
+    IncrementalConfigCache bounded(65536, 1);
+    bounded.Parse(sources.sources[0].snapshot, false, reused);
+    bounded.Parse(sources.sources[1].snapshot, false, reused);
+    assert(bounded.Entries() == 1 && bounded.Bytes() <= 65536);
+
+    GenerationManager manager(1);
+    auto stagedAsset = std::make_shared<int>(7);
+    std::weak_ptr<int> stagedWeak = stagedAsset;
+    assert(manager.Stage(Candidate(1, baseline, stagedAsset), versions));
+    stagedAsset.reset();
+    auto preparedPin = manager.PreparedPin();
+    assert(preparedPin && !manager.Pin()); // staging is never live activation
+    assert(!manager.Stage(Candidate(2, baseline), BuildVersions{10,22,33}));
+    manager.CancelPrepared();
+    assert(!manager.PreparedPin() && !stagedWeak.expired());
+    preparedPin.reset();
+    assert(stagedWeak.expired());
+    // Device-only CPU staging restamps metadata without rebuilding/copying config.
+    auto restamped = std::make_shared<ConfigGeneration>();
+    restamped->id = 2; restamped->versions = BuildVersions{11,23,33}; restamped->config = unchanged;
+    assert(manager.Stage(restamped, BuildVersions{11,23,33}));
+    assert(manager.PreparedPin()->config == unchanged);
+    assert(manager.Publish(restamped, BuildVersions{11,23,33}, true, true) == PublishResult::Stale);
+    manager.CancelPrepared();
+    auto asset = std::make_shared<int>(42); std::weak_ptr<int> weak = asset;
+    assert(manager.Publish(Candidate(1, unchanged, asset), versions, true, true) == PublishResult::Activated);
+    asset.reset();
+    auto pin = manager.Pin();
+    auto next = Candidate(2, unchanged);
+    assert(manager.Publish(next, versions, false, true) == PublishResult::UnsafeBoundary);
+    assert(manager.Publish(next, versions, true, false) == PublishResult::DependenciesPending);
+    for (const auto& stale : {BuildVersions{10,22,33}, BuildVersions{11,21,33}, BuildVersions{11,22,32}})
+        assert(manager.Publish(next, stale, true, true) == PublishResult::Stale);
+    assert(manager.Pin()->id == 1 && !weak.expired());
+    assert(manager.Publish(Candidate(2, incremental), versions, true, true) == PublishResult::InvalidCandidate);
+    assert(manager.Publish(next, versions, true, true) == PublishResult::Activated);
+    assert(manager.Retire([](Generation) { return true; }) == 0); // reader pin
+    pin.reset();
+    assert(manager.Retire([](Generation) { return false; }) == 0); // unfinished GPU fence
+    assert(manager.Publish(Candidate(3, unchanged), versions, true, true) == PublishResult::RetirementPending);
+    assert(manager.Retire([](Generation) { return true; }) == 1 && weak.expired());
+    assert(manager.Publish(Candidate(1, unchanged), versions, true, true) == PublishResult::Stale);
+
+    // Concurrent readers only observe complete immutable generations.
+    GenerationManager concurrent(2048);
+    std::atomic<bool> done{false};
+    std::atomic<size_t> reads{0};
+    std::thread reader([&] {
+        do { auto p = concurrent.Pin(); if (p) { assert(p->config->identity == unchanged->identity); ++reads; } }
+        while (!done.load());
+    });
+    for (Generation i = 1; i <= 1000; ++i)
+        assert(concurrent.Publish(Candidate(i, unchanged), versions, true, true) == PublishResult::Activated);
+    done = true; reader.join();
+    assert(concurrent.Pin()->id == 1000);
+    concurrent.Retire([](Generation) { return true; });
+    assert(concurrent.RetiredCount() == 0);
+    std::cout << "preparation generations: source identity, lexical IR clean equivalence, bounded cache, rollback, stale fences, reader/GPU retirement passed\n";
+}
