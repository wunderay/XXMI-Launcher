+#pragma once
+#include "PreparedTypes.h"
+#include <map>
+#include <memory>
+#include <vector>
+namespace ModLoading {
+// Fields are serialized individually; structure padding and inactive D3D union
+// bytes are never cache identity. Epoch zero is invalid.
+struct DeviceResourceKey {
+    SourceDigest digest{};
+    DeviceEpoch epoch = 0;
+    std::vector<uint32_t> effectiveOptions;
+    bool operator<(const DeviceResourceKey& other) const;
+};
+DeviceEpoch AllocateDeviceEpoch();
+class DeviceResourceCache {
+public:
+    explicit DeviceResourceCache(uint64_t maximumBytes = 256ull * 1024 * 1024);
+    void BeginEpoch(DeviceEpoch epoch);
+    DeviceEpoch Epoch() const { return epoch_; }
+    bool Insert(const DeviceResourceKey& key, std::shared_ptr<void> object, uint64_t bytes);
+    std::shared_ptr<void> Find(const DeviceResourceKey& key);
+    bool Protect(const DeviceResourceKey& key);
+    void Unprotect(const DeviceResourceKey& key);
+    uint64_t EvictInactive(uint64_t requestedBytes);
+    uint64_t Bytes() const { return bytes_; }
+    uint64_t CapacityBytes() const { return maximum_; }
+    bool MakeRoom(uint64_t bytes);
+    size_t Size() const { return entries_.size(); }
+private:
+    struct Entry { std::shared_ptr<void> object; uint64_t bytes, use; size_t active = 0; };
+    std::map<DeviceResourceKey, Entry> entries_;
+    DeviceEpoch epoch_ = 0;
+    uint64_t maximum_, bytes_ = 0, clock_ = 0;
+};
+}
