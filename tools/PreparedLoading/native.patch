+#endif
+			// These two policies exactly preserve the existing MigotoIncludeHandler's
+			// intentional identical LOCAL and SYSTEM search policy.
+			std::wstring candidate;
+			if(!AbsolutePath(ParentPath(s.result.dependencies[s.request.recursiveIncludes==1?parentIndex:0].path)+includeName,candidate)){
+				error="invalid shader include path";
+				return false;
+			}
+			if(!s.Charge(candidate.size()*16+name.size()*4+1024,error))return false;
+			s.result.lookupPaths.push_back(candidate);
+			if(!s.Read(candidate,child,error)){
+				if(s.request.recursiveIncludes==1||error!="source unavailable")return false;
+				if(!WatchableMissingLookup(candidate)){
+					error="shader lookup ancestry is compatibility-only";
+					return false;
+				}
+				std::wstring fallback;
+				if(!AbsolutePath(s.request.workingDirectory+L"/"+includeName,fallback))return false;
+				if(fallback==candidate)return false;
+				if(!s.Charge(fallback.size()*16+1024,error))return false;
+				s.result.lookupPaths.push_back(fallback);
+				if(!s.Read(fallback,child,error))return false;
+			}
+			ShaderIncludeEdge edge;
+			edge.parent=parentIndex;
+			edge.child=child;
+			edge.system=system;
+			edge.name=name;
+			s.result.includes.push_back(std::move(edge));
+		}
+		if(child==0||std::find(s.active.begin(),s.active.end(),child)!=s.active.end()){
+			error="cyclic shader include graph is compatibility-only";
+			return false;
+		}
+		s.active.push_back(child);
+		const auto& source=s.result.dependencies[child];
+		bytes=Data(source);
+		size=source.bytes->size();
+		return true;
+	}
+	bool PrepareShader(const ShaderCompileRequest& request,ResourceRefreshCpuBudget& budget,ShaderDiskCache* disk,const ShaderCompilerCallbacks& compiler,PreparedShaderBytecode& result,std::string& error){
+		error.clear();
+		if(!compiler.discover||!compiler.compile||request.recursiveIncludes < -1||request.recursiveIncludes>1||!request.maxSourceBytes||request.maxSourceBytes>64*1024*1024||!request.maxClosureBytes||request.maxClosureBytes>256*1024*1024||!request.maxBytecodeBytes||request.maxBytecodeBytes>64*1024*1024||!request.maxFiles||request.maxFiles>256||!request.maxEdges||request.maxEdges>1024||request.defines.size()>256||request.entryPoint.size()>4096||request.target.size()>4096||request.sourceName.size()>32768){
+			error="unsupported shader preparation policy";
+			return false;
+		}
+		for(const auto& d:request.defines)if(d.first.size()>4096||d.second.size()>4096||d.first.find('\0')!=std::string::npos||d.second.find('\0')!=std::string::npos){
+			error="unsupported shader define";
+			return false;
+		}
+		try {
+			ShaderCompileRequest r=request;
+			if(!IsAbsolute(r.sourcePath)||!IsAbsolute(r.workingDirectory)||!AbsolutePath(r.sourcePath,r.sourcePath)||!AbsolutePath(r.workingDirectory,r.workingDirectory)){
+				error="shader paths are not captured";
+				return false;
+			}
+			PreparedShaderBytecode candidate;
+			// Account before allocation: bounded graph/path/key metadata plus compiler
+			// input/output scratch allowance. D3D compiler private heap is not observable.
+			auto metadata=std::make_shared<ShaderMetadataOwnership>();
+			metadata->bookkeepingLease=budget.TryReserve(256*1024+r.defines.size()*32768);
+			if(!metadata->bookkeepingLease){
+				error="shader metadata budget exhausted";
+				return false;
+			}
+			candidate.metadataOwnership=metadata;
+			candidate.bytecodeOwnership=budget.TryReserve(r.maxBytecodeBytes);
+			auto compilerScratch=budget.TryReserve(r.maxClosureBytes*2+r.maxBytecodeBytes);
+			if(!candidate.metadataOwnership||!candidate.bytecodeOwnership||!compilerScratch){
+				error="shader preparation CPU budget exhausted";
+				return false;
+			}
+			ShaderIncludeSession::State state{
+				r,budget,candidate,{},0,0,false,metadata
+			};
+			size_t source=0;
+			if(!state.Read(r.sourcePath,source,error))return false;
+			if(candidate.dependencies.front().bytes->empty()){
+				error="empty shader source";
+				return false;
+			}
+			ShaderIncludeSession includes(state);
+			if(!compiler.discover(includes,error)||!state.active.empty()){
+				if(error.empty())error="shader preprocessing failed or left includes open";
+				return false;
+			}
+			candidate.key=ShaderKey(r,candidate);
+			if(disk&&disk->Load(candidate.key,r.maxBytecodeBytes,candidate.bytecode)){
+				candidate.cacheHit=true;
+				result=std::move(candidate);
+				return true;
+			}
+			state.sealed=true;
+			if(!compiler.compile(includes,candidate.bytecode,error)||!state.active.empty()||state.replay!=candidate.includes.size()||candidate.bytecode.empty()||candidate.bytecode.size()>r.maxBytecodeBytes){
+				if(error.empty())error="shader compile did not match verified closure or bytecode bounds";
+				return false;
+			}
+			if(disk)disk->Store(candidate.key,candidate.bytecode);
+			result=std::move(candidate);
+			return true;
+		}
+		catch(const std::exception&){
+			error="shader preparation allocation/encoding failed";
+			return false;
+		}
+	}
+}
+#ifdef _WIN32
+namespace ModLoading {
+	namespace {
+		class VerifiedD3DInclude : public ID3DInclude {
+			public:
+			explicit VerifiedD3DInclude(ShaderIncludeSession& includes,std::string& error):includes_(includes),error_(error){}
+			HRESULT __stdcall Open(D3D_INCLUDE_TYPE kind,LPCSTR name,LPCVOID parent,LPCVOID* bytes,UINT* count) override {
+				if(!name||!bytes||!count||(kind!=D3D_INCLUDE_LOCAL&&kind!=D3D_INCLUDE_SYSTEM))return E_INVALIDARG;
+				size_t size=0;
+				const void* data=nullptr;
+				if(!includes_.Open(kind==D3D_INCLUDE_SYSTEM,name,parent,data,size,error_)||size>UINT_MAX)return E_FAIL;
+				*bytes=data;
+				*count=UINT(size);
+				return S_OK;
+			}
+			HRESULT __stdcall Close(LPCVOID bytes) override {
+				return includes_.Close(bytes)?S_OK:E_FAIL;
+			}
+			private: ShaderIncludeSession& includes_;
+			std::string& error_;
+		};
+		struct CompilerBlob {
+			ID3DBlob* value=nullptr;
+			~CompilerBlob(){
+				if(value)value->Release();
+			}
+		};
+		void CompilerMessages(ID3DBlob* blob,std::string& error){
+			if(blob){
+				size_t n=(std::min)(blob->GetBufferSize(),size_t(16384));
+				error.assign(static_cast<const char*>(blob->GetBufferPointer()),n);
+			}
+		}
+		struct CompilerFunctions {
+			decltype(&D3DCompile) compile=nullptr;
+			decltype(&D3DPreprocess) preprocess=nullptr;
+		};
+		bool LoadedCompilerDigest(ResourceRefreshCpuBudget& budget,SourceDigest& digest,CompilerFunctions& functions,std::string& error){
+			// The SDK import library names this module. Resolve the actual exports so an
+			// address of an executable-side import thunk can never identify the compiler.
+			static std::mutex mutex;
+			static bool ready=false;
+			static SourceDigest cached{};
+			static CompilerFunctions cachedFunctions;
+			std::lock_guard<std::mutex> lock(mutex);
+			if(ready){
+				digest=cached;
+				functions=cachedFunctions;
+				return true;
+			}
+			HMODULE imported=GetModuleHandleW(D3DCOMPILER_DLL_W);
+			if(!imported){
+				error="linked SDK compiler module unavailable";
+				return false;
+			}
+			CompilerFunctions found;
+			found.compile=reinterpret_cast<decltype(found.compile)>(GetProcAddress(imported,"D3DCompile"));
+			found.preprocess=reinterpret_cast<decltype(found.preprocess)>(GetProcAddress(imported,"D3DPreprocess"));
+			HMODULE module=nullptr,preprocessor=nullptr;
+			if(!found.compile||!found.preprocess||!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_PIN,reinterpret_cast<LPCWSTR>(found.compile),&module)||!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_PIN,reinterpret_cast<LPCWSTR>(found.preprocess),&preprocessor)||module!=preprocessor){
+				error="compiler export module identity unavailable";
+				return false;
+			}
+			std::vector<wchar_t> path(32768);
+			DWORD n=GetModuleFileNameW(module,path.data(),DWORD(path.size()));
+			if(!n||n>=path.size()){
+				error="compiler module path unavailable";
+				return false;
+			}
+			auto lease=budget.TryReserve(32*1024*1024+1024);
+			if(!lease){
+				error="compiler identity CPU budget exhausted";
+				return false;
+			}
+			SourceSnapshot source;
+			if(!ReadVerifiedSnapshot(std::wstring(path.data(),n),32*1024*1024,source,error))return false;
+			cached=source.digest;
+			cachedFunctions=found;
+			ready=true;
+			digest=cached;
+			functions=found;
+			return true;
+		}
+	}
+	bool PrepareD3DShader(ShaderCompileRequest request,ResourceRefreshCpuBudget& budget,ShaderDiskCache* disk,PreparedShaderBytecode& result,std::string& error){
+		if(request.sourcePath.empty()||request.sourcePath.size()>32768||request.workingDirectory.size()>32768||request.sourceName.size()>32768||request.defines.size()>256){
+			error="unsupported shader preparation input bounds";
+			return false;
+		}
+		for(const auto& define:request.defines)if(define.first.size()>4096||define.second.size()>4096){
+			error="unsupported shader define bounds";
+			return false;
+		}
+		CompilerFunctions compiler;
+		if(!LoadedCompilerDigest(budget,request.compilerIdentity,compiler,error))return false;
+		std::vector<D3D_SHADER_MACRO> defines;
+		for(const auto& d:request.defines)defines.push_back({
+			d.first.c_str(),d.second.c_str()
+		}
+		);
+		defines.push_back({
+			nullptr,nullptr
+		}
+		);
+		if(request.sourceName.empty()){
+			const bool utf8=GetACP()==CP_UTF8;
+			const DWORD conversionFlags=utf8?WC_ERR_INVALID_CHARS:WC_NO_BEST_FIT_CHARS;
+			int n=WideCharToMultiByte(CP_ACP,conversionFlags,request.sourcePath.c_str(),-1,nullptr,0,nullptr,nullptr);
+			if(n<=0){
+				error="shader source name encoding failed";
+				return false;
+			}
+			std::vector<char> name(size_t(n),0);
+			BOOL substituted=FALSE;
+			if(!WideCharToMultiByte(CP_ACP,conversionFlags,request.sourcePath.c_str(),-1,name.data(),n,nullptr,utf8?nullptr:&substituted)||substituted){
+				error="shader source name requires unsupported encoding";
+				return false;
+			}
+			request.sourceName=name.data();
+		}
+		ShaderCompilerCallbacks callbacks;
+		callbacks.discover=[&](ShaderIncludeSession& session,std::string& failure){
+			VerifiedD3DInclude includes(session,failure);
+			CompilerBlob output,errors;
+			const auto& source=session.Source();
+			HRESULT hr=compiler.preprocess(Data(source),source.bytes->size(),request.sourceName.c_str(),defines.data(),&includes,&output.value,&errors.value);
+			CompilerMessages(errors.value,failure);
+			if(FAILED(hr)||!output.value)return false;
+			if(output.value->GetBufferSize()>request.maxClosureBytes){
+				failure="preprocessed shader exceeds bounds";
+				return false;
+			}
+			return true;
+		};
+		callbacks.compile=[&](ShaderIncludeSession& session,std::vector<uint8_t>& bytes,std::string& failure){
+			VerifiedD3DInclude includes(session,failure);
+			CompilerBlob output,errors;
+			const auto& source=session.Source();
+			HRESULT hr=compiler.compile(Data(source),source.bytes->size(),request.sourceName.c_str(),defines.data(),&includes,request.entryPoint.c_str(),request.target.c_str(),request.flags,request.effectFlags,&output.value,&errors.value);
+			CompilerMessages(errors.value,failure);
+			if(FAILED(hr)||!output.value)return false;
+			if(!output.value->GetBufferSize()||output.value->GetBufferSize()>request.maxBytecodeBytes){
+				failure="compiled shader exceeds bounds";
+				return false;
+			}
+			const uint8_t* p=static_cast<const uint8_t*>(output.value->GetBufferPointer());
+			bytes.assign(p,p+output.value->GetBufferSize());
+			return true;
+		};
+		return PrepareShader(request,budget,disk,callbacks,result,error);
+	}
+}
+#endif
diff --git a/DirectX11/ModLoading/ShaderSourceCache.h b/DirectX11/ModLoading/ShaderSourceCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..9f80e5cfca2b167efdc240b50bd4696eca123b53
--- /dev/null
+++ b/DirectX11/ModLoading/ShaderSourceCache.h
@@ -0,0 +1,140 @@
+#pragma once
+#include "PreparedTypes.h"
+#include "RefreshCpuBudget.h"
+#include <functional>
+#include <mutex>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <d3dcompiler.h>
+#endif
+namespace ModLoading {
+struct ShaderCompileRequest {
+	std::wstring sourcePath;
+	// Captured at build admission: never consult process CWD during compilation.
+	std::wstring workingDirectory;
+	std::string sourceName;
+	std::string entryPoint = "main";
+	std::string target;
+	std::vector<std::pair<std::string, std::string>> defines;
+	uint32_t flags = 0;
+	uint32_t effectFlags = 0;
+	uint32_t cacheAbi = 1;
+	uint32_t patchAbi = 1;
+	// CustomShader has no source patch stage, so its patch identity is zero.
+	// Any future patch callback must supply its rules/content digest here.
+	SourceDigest compilerIdentity{}, patchIdentity{};
+	// Matches MigotoIncludeHandler: 0 initial directory + captured CWD fallback,
+	// 1 parent directory (both LOCAL/SYSTEM). -1 uses the SDK-qualified
+	// standard-handler policy: initial directory + captured CWD fallback.
+	// Non-ASCII -1 include-name encoding remains compatibility-only; modes
+	// 0/1 retain the legacy Migoto handler's explicit UTF-8 decoding.
+	int recursiveIncludes = 0;
+	size_t maxSourceBytes = 4 * 1024 * 1024;
+	size_t maxClosureBytes = 16 * 1024 * 1024;
+	size_t maxBytecodeBytes = 4 * 1024 * 1024;
+	size_t maxFiles = 256;
+	size_t maxEdges = 1024;
+};
+struct ShaderIncludeEdge {
+	size_t parent = 0;
+	size_t child = 0;
+	bool system = false;
+	std::string name;
+};
+struct PreparedShaderBytecode {
+	// Reverse destruction releases every accounted buffer before its leases.
+	// Keep these declarations before all storage covered by either token.
+	std::shared_ptr<const void> metadataOwnership, bytecodeOwnership;
+	SourceDigest key{};
+	std::vector<SourceSnapshot> dependencies;
+	std::vector<ShaderIncludeEdge> includes;
+	// Includes failed earlier search candidates: their future creation changes
+	// resolution. The activation closure must watch these as well as sources.
+	std::vector<std::wstring> lookupPaths;
+	std::vector<uint8_t> bytecode;
+	bool cacheHit = false;
+	PreparedShaderBytecode() = default;
+	PreparedShaderBytecode(const PreparedShaderBytecode&) = delete;
+	PreparedShaderBytecode& operator=(const PreparedShaderBytecode&) = delete;
+	PreparedShaderBytecode(PreparedShaderBytecode&&) noexcept = default;
+	PreparedShaderBytecode& operator=(PreparedShaderBytecode&& other) noexcept {
+		if (this != &other) {
+			// Default member assignment would release old leases before old
+			// vector allocations. Retire that complete owner as one unit.
+			PreparedShaderBytecode retired;
+			Swap(retired);
+			Swap(other);
+		}
+		return *this;
+	}
+private:
+	void Swap(PreparedShaderBytecode& other) noexcept {
+		metadataOwnership.swap(other.metadataOwnership);
+		bytecodeOwnership.swap(other.bytecodeOwnership);
+		key.swap(other.key);
+		dependencies.swap(other.dependencies);
+		includes.swap(other.includes);
+		lookupPaths.swap(other.lookupPaths);
+		bytecode.swap(other.bytecode);
+		const bool previous = cacheHit;
+		cacheHit = other.cacheHit;
+		other.cacheHit = previous;
+	}
+};
+// Worker-only proof for absent preferred source paths before legacy fallback.
+// Existing ancestors must have a watchable lexical identity; the activation
+// closure must watch the nearest existing parent and retain expected absence.
+bool IsWatchableMissingSource(const std::wstring& path, std::string& error);
+class ShaderIncludeSession {
+public:
+	// The compiler returns the exact pointer from Open in Close. Parent is the
+	// original source pointer, an open include pointer, or null for root.
+	bool Open(bool system, const std::string& name, const void* parent,
+		const void*& bytes, size_t& size, std::string& error);
+	bool Close(const void* bytes);
+	// Discovery Open can grow the dependency vector and invalidate this
+	// reference. Pin Source().bytes before retaining input across Open calls.
+	const SourceSnapshot& Source() const;
+private:
+	friend bool PrepareShader(const ShaderCompileRequest&, ResourceRefreshCpuBudget&,
+		class ShaderDiskCache*, const struct ShaderCompilerCallbacks&,
+		PreparedShaderBytecode&, std::string&);
+	struct State;
+	explicit ShaderIncludeSession(State& state) : state_(state) {}
+	State& state_;
+};
+struct ShaderCompilerCallbacks {
+	// Discover actual preprocessor opens, including macro/conditional includes.
+	std::function<bool(ShaderIncludeSession&, std::string&)> discover;
+	// Replays the sealed closure, never opens filesystem paths. The caller's
+	// bytecode cap is admitted BEFORE either compiler callback runs.
+	std::function<bool(ShaderIncludeSession&, std::vector<uint8_t>&, std::string&)> compile;
+};
+// Portable bytecode only. Device objects remain in the existing device-epoch
+// cache. Directory must be dedicated derived data outside all mod/watch trees.
+class ShaderDiskCache {
+public:
+	explicit ShaderDiskCache(std::wstring directory, size_t budgetBytes = 256 * 1024 * 1024,
+							size_t maximumEntries = 512);
+	bool Load(const SourceDigest&, size_t maximum, std::vector<uint8_t>&);
+	bool Store(const SourceDigest&, const std::vector<uint8_t>&);
+	static std::wstring EntryName(const SourceDigest&);
+private:
+	bool Directory();
+	bool MakeRoom(uint64_t);
+	std::wstring directory_;
+	size_t budget_, maximum_;
+	std::mutex mutex_;
+};
+// Worker-only: no GPU creation, Present, timestamp cache, or quality changes.
+bool PrepareShader(const ShaderCompileRequest&, ResourceRefreshCpuBudget&,
+	ShaderDiskCache*, const ShaderCompilerCallbacks&, PreparedShaderBytecode&, std::string&);
+#ifdef _WIN32
+// Compiler identity is the verified digest of the loaded D3DCompile DLL.
+// D3DPreprocess discovers dependencies; D3DCompile consumes immutable originals.
+bool PrepareD3DShader(ShaderCompileRequest, ResourceRefreshCpuBudget&, ShaderDiskCache*,
+	PreparedShaderBytecode&, std::string&);
+#endif
+}
