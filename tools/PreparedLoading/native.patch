@@ -0,0 +1,996 @@
+// Resource creation mode uses global NVAPI state; keep every preparation call
+// on the Present owner under the same lock as the compatibility resource path.
+#include "../lock.h"
+#include "Runtime.h"
+#include "RuntimePolicy.h"
+#include "../CommandList.h"
+#include "../IniHandler.h"
+#include "../globals.h"
+#include "PreparationScheduler.h"
+#include "SnapshotIO.h"
+#include "PreparationPlanner.h"
+#include "ChangeMonitor.h"
+#include "ConfigCompiler.h"
+#include "IncrementalConfigCache.h"
+#include "GenerationManager.h"
+#include "PreparationStatus.h"
+#include "LoadTrace.h"
