@@ -0,0 +1,9 @@
+Run `./tests/preparation_ownership/run.sh` with an installed C++17 compiler.
+
+The test exercises `QuiescentGenerationRegistry`, the same CPU publication gate
+used by native `ConfigReadScope`, `TryPublishConfiguration`, and the legacy
+reload's exclusive lease. It checks concurrent readers, the suspended pre/post
+frame lease, bounded migration rejection, stale expected generations, retained
+object lifetime, and replacement under a legacy lease with one owning reader.
+No graphics driver or game is needed. Native parser/command execution and GPU
+retirement require the Windows build and D3D fixture separately.
diff --git a/tests/preparation_ownership/main.cpp b/tests/preparation_ownership/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..72870bf441c2e197ce0c6c99e25a3b1dacc81a6f
--- /dev/null
+++ b/tests/preparation_ownership/main.cpp
@@ -0,0 +1,78 @@
+#include "QuiescentGenerationRegistry.h"
+#include <atomic>
+#include <cassert>
+#include <thread>
+#include <iostream>
+struct Graph { int value; explicit Graph(int n) : value(n) {} };
+int main() {
+    auto old = std::make_shared<Graph>(1), next = std::make_shared<Graph>(2);
+    QuiescentGenerationRegistry<Graph> registry(old);
+    auto commit = [] { return ConfigPublishResult::Published; };
+    auto reader = registry.Acquire();
+    assert(registry.TryPublish(next, old, commit) == ConfigPublishResult::Busy);
+    auto exclusive = registry.TryBeginLegacy(1);
+    assert(exclusive.owns_lock()); exclusive.unlock();
+    std::atomic<bool> acquired{false}, release{false};
+    std::thread concurrent([&] {
+        auto pinned = registry.Acquire();
+        acquired.store(true);
+        while (!release.load()) std::this_thread::yield();
+        assert(pinned->value == 1);
+        registry.Release();
+    });
+    while (!acquired.load()) std::this_thread::yield();
+    assert(!registry.TryBeginLegacy(1).owns_lock());
+    assert(registry.TryPublish(next, old, commit) == ConfigPublishResult::Busy);
+    release.store(true); concurrent.join();
+    // A suspended frame's post command remains a counted reader.
+    assert(registry.TryPublish(next, old, commit) == ConfigPublishResult::Busy);
+    registry.Release();
+    assert(registry.TryPublish(next, old, [] { return ConfigPublishResult::MigrationBudget; }) == ConfigPublishResult::MigrationBudget);
+    assert(registry.Snapshot() == old && next->value == 2);
+    assert(registry.TryPublish(next, old, [&] { next->value = old->value; return ConfigPublishResult::Published; }) == ConfigPublishResult::Published);
+    assert(next->value == 1);
+    assert(registry.TryPublish(std::make_shared<Graph>(3), old, commit) == ConfigPublishResult::Stale);
+    std::weak_ptr<Graph> lifetime = old;
+    old.reset(); assert(!lifetime.expired());
+    reader.reset(); assert(lifetime.expired());
+    // Exclusive legacy replacement permits its own single outer frame reader.
+    auto frame = registry.Acquire();
+    auto legacy = registry.TryBeginLegacy(1); assert(legacy.owns_lock());
+    auto replacement = std::make_shared<Graph>(4);
+    registry.SetActiveUnderLock(replacement); legacy.unlock();
+    assert(frame == next && registry.Snapshot() == replacement);
+    registry.Release();
+    // Runtime migration precedes GPU upload. A reader during that upload must
+    // invalidate the staged values even if it finishes before publication.
+    uint64_t revision = 0;
+    auto staged = std::make_shared<Graph>(5);
+    assert(registry.TryStage(replacement, [&] { staged->value = replacement->value; return ConfigPublishResult::Published; }, revision) == ConfigPublishResult::Published);
+    auto intervening = registry.Acquire();
+    intervening->value = 9;
+    assert(registry.TryPublishStaged(staged, replacement, revision) == ConfigPublishResult::Busy);
+    registry.Release();
+    assert(registry.TryPublishStaged(staged, replacement, revision) == ConfigPublishResult::Stale);
+    assert(registry.Snapshot() == replacement && staged->value == 4);
+    assert(registry.TryStage(replacement, [&] { staged->value = replacement->value; return ConfigPublishResult::Published; }, revision) == ConfigPublishResult::Published);
+    assert(registry.TryPublishStaged(staged, replacement, revision) == ConfigPublishResult::Published);
+    assert(registry.Snapshot()->value == 9);
+    // Present must not wait for a legacy writer that can itself be waiting on
+    // the renderer's global lock. Snapshot remains safe during that writer.
+    std::atomic<bool> legacyHeld{false}, releaseLegacy{false};
+    std::thread writer([&] {
+        auto locked = registry.TryBeginLegacy(0);
+        assert(locked.owns_lock());
+        legacyHeld.store(true);
+        while (!releaseLegacy.load()) std::this_thread::yield();
+    });
+    while (!legacyHeld.load()) std::this_thread::yield();
+    auto current = registry.Snapshot();
+    auto replacementAfterLegacy = std::make_shared<Graph>(10);
+    assert(current == staged);
+    assert(registry.TryStage(current, commit, revision) == ConfigPublishResult::Busy);
+    assert(registry.TryPublish(replacementAfterLegacy, current, commit) == ConfigPublishResult::Busy);
+    assert(registry.TryPublishStaged(replacementAfterLegacy, current, revision) == ConfigPublishResult::Busy);
+    releaseLegacy.store(true);
+    writer.join();
+    std::cout << "configuration ownership publication/lifetime tests passed\n";
+}
