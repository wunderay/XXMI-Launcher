@@ -0,0 +1,35 @@
+#include "RuntimePolicy.h"
+#include <cassert>
+#include <iostream>
+using namespace ModLoading;
+int main() {
+    const std::vector<uint8_t> signature{137,80,78,71,13,10,26,10};
+    auto png = signature;
+    png.insert(png.end(), {0,0,0,1,'s','R','G','B',0,0,0,0,0});
+    assert(HasPngSRGBChunk(png));
+    auto truncated = png; truncated.pop_back();
+    assert(!HasPngSRGBChunk(truncated));
+    auto oversized = png; oversized[8] = 255;
+    assert(!HasPngSRGBChunk(oversized));
+    auto ended = signature;
+    ended.insert(ended.end(), {0,0,0,0,'I','E','N','D',0,0,0,0});
+    ended.insert(ended.end(), png.begin() + 8, png.end());
+    assert(!HasPngSRGBChunk(ended));
+    auto unknown = signature;
+    unknown.insert(unknown.end(), {0,0,0,2,'t','E','X','t',0,0,0,0,0,0});
+    unknown.insert(unknown.end(), png.begin() + 8, png.end());
+    assert(HasPngSRGBChunk(unknown));
+    assert(!HasPngSRGBChunk({}));
+    assert(!HasPngSRGBChunk(signature));
+    auto invalid = png; invalid[0] = 0;
+    assert(!HasPngSRGBChunk(invalid));
+    assert(FullTexture2DViewMatches(28, 1, 0, 0, UINT32_MAX, 28, 0, 1));
+    assert(FullTexture2DViewMatches(29, 5, 29, 0, 5, 29, 0, UINT32_MAX));
+    assert(!FullTexture2DViewMatches(28, 1, 29, 0, 1, 28, 0, 1));
+    assert(!FullTexture2DViewMatches(28, 5, 28, 1, 4, 28, 0, 5));
+    assert(!FullTexture2DViewMatches(28, 5, 28, 0, 4, 28, 0, 5));
+    assert(!FullTexture2DViewMatches(28, 5, 28, 0, 5, 28, 1, 4));
+    assert(!FullTexture2DViewMatches(0, 1, 0, 0, 1, 0, 0, 1));
+    assert(!FullTexture2DViewMatches(28, 0, 28, 0, UINT32_MAX, 28, 0, UINT32_MAX));
+    std::cout << "runtime memory and exact SRV policy: 16 cases passed\n";
+}
