@@ -0,0 +1,194 @@
+#include "ChangeMonitor.h"
+#include <atomic>
+#include <chrono>
+#include <thread>
+#include <cstddef>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#include <algorithm>
+#include <cwctype>
+#endif
+
+namespace ModLoading {
+namespace {
+uint64_t Now() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+#ifdef _WIN32
+std::atomic<size_t> watchCount{0};
+struct Watch {
+    HANDLE file = INVALID_HANDLE_VALUE;
+    OVERLAPPED operation = {};
+    alignas(DWORD) unsigned char buffer[32768];
+    std::wstring directory, target;
+    bool parent = false, pending = false;
+    ~Watch() { if (file != INVALID_HANDLE_VALUE) CloseHandle(file); if (operation.hEvent) CloseHandle(operation.hEvent); --watchCount; }
+};
+// Cancellation usually completes immediately. A broken filesystem driver must
+// not cause Stop to block forever or write into freed OVERLAPPED memory. Retain
+// at most 256 closed-handle operations process-wide; refuse new watches while
+// that bounded reserve is exhausted. No completion routines point into the DLL.
+struct Retired { std::mutex mutex; std::vector<std::unique_ptr<Watch>> watches; };
+Retired& RetiredIO() { static auto* state = new Retired; return *state; }
+void Reap() {
+    auto& state = RetiredIO(); std::lock_guard<std::mutex> guard(state.mutex);
+    state.watches.erase(std::remove_if(state.watches.begin(), state.watches.end(),
+        [](const std::unique_ptr<Watch>& watch) { return WaitForSingleObject(watch->operation.hEvent, 0) == WAIT_OBJECT_0; }), state.watches.end());
+}
+void CloseWatch(std::unique_ptr<Watch>& watch) {
+    if (!watch) return;
+    if (watch->pending) {
+        CancelIoEx(watch->file, &watch->operation);
+        CloseHandle(watch->file); watch->file = INVALID_HANDLE_VALUE;
+        if (WaitForSingleObject(watch->operation.hEvent, 0) != WAIT_OBJECT_0) {
+            auto& state = RetiredIO(); std::lock_guard<std::mutex> guard(state.mutex);
+            state.watches.push_back(std::move(watch)); return;
+        }
+    }
+    watch.reset();
+}
+bool Arm(Watch& watch) {
+    ResetEvent(watch.operation.hEvent);
+    watch.pending = ReadDirectoryChangesW(watch.file, watch.buffer, sizeof(watch.buffer), !watch.parent,
+        FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_SIZE |
+        FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_CREATION, nullptr, &watch.operation, nullptr) != FALSE;
+    return watch.pending;
+}
+std::unique_ptr<Watch> Open(const std::wstring& directory, const std::wstring& target, bool parent) {
+    Reap();
+    { auto& retired = RetiredIO(); std::lock_guard<std::mutex> guard(retired.mutex);
+      if (retired.watches.size() >= 256) return nullptr; }
+    if (watchCount.fetch_add(1) >= 256) { --watchCount; return nullptr; }
+    std::unique_ptr<Watch> watch(new Watch);
+    watch->directory = directory; watch->target = target; watch->parent = parent;
+    watch->operation.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    watch->file = CreateFileW(directory.c_str(), FILE_LIST_DIRECTORY,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED, nullptr);
+    if (!watch->operation.hEvent || watch->file == INVALID_HANDLE_VALUE || !Arm(*watch)) return nullptr;
+    return watch;
+}
+bool Same(const std::wstring& left, const std::wstring& right) { return _wcsicmp(left.c_str(), right.c_str()) == 0; }
+struct RootWatch {
+    std::wstring root, parent;
+    std::unique_ptr<Watch> tree, ancestor;
+    bool attemptedTree = false;
+};
+#endif
+}
+struct ChangeMonitor::Impl {
+    explicit Impl(ChangeOptions options) : state(options) {}
+    ChangeReconciler state;
+    std::atomic<bool> stopping{false};
+    std::thread worker;
+    Callback callback;
+    void Run() {
+#ifdef _WIN32
