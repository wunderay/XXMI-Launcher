diff --git a/DirectX11/ModLoading/PreparationScheduler.cpp b/DirectX11/ModLoading/PreparationScheduler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..51e3595b863cc2d67ba076ddfe0221a11a744341
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationScheduler.cpp
@@ -0,0 +1,220 @@
+#include "PreparationScheduler.h"
+#include "SnapshotIO.h"
+#include "DiskAssetCache.h"
+#include <algorithm>
+#include <stdexcept>
+#ifdef _WIN32
+#include <objbase.h>
+#endif
+namespace ModLoading {
+namespace {
+size_t Reservation(const PreparationLimits &limits) {
+	return limits.maxAssetBytes <= limits.cpuBytes / 2 ? limits.maxAssetBytes * 2
+													   : limits.maxAssetBytes;
+}
+} // namespace
+PreparationScheduler::PreparationScheduler(const PreparationLimits &limits, SnapshotReader reader)
+	: limits_(limits), cache_(limits.cpuBytes), reservation_(Reservation(limits)),
+	  reader_(reader ? std::move(reader) : SnapshotReader(ReadVerifiedSnapshot)) {
+	if (!limits.Valid())
+		throw std::invalid_argument("invalid preparation limits");
+	// Fixed maximum avoids spawning or retiring workers at configuration reload.
+	try {
+		for (size_t i = 0; i < 16; ++i)
+			workers_.emplace_back(&PreparationScheduler::Worker, this);
+	} catch (...) {
+		Stop();
+		throw;
+	}
+}
+PreparationScheduler::~PreparationScheduler() {
+	Stop();
+}
+bool PreparationScheduler::Enqueue(const std::wstring &path, Generation generation, int priority) {
+	if (path.empty() || path.size() > 32767)
+		return false;
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (stopping_ || !limits_.cpuBytes || generation < minimum_)
+		return false;
+	auto key = std::make_pair(path, generation);
+	if (compatibility_.count(key))
+		return false;
+	if (cache_.Find(path, generation) || pending_.count(key))
+		return true;
+	if (pending_.size() >= limits_.maxQueued || !cache_.Reserve(reservation_))
+		return false;
+	try {
+		pending_.insert(key);
+		queue_.push_back(
+			Job{path, generation, priority, ++order_, limits_.maxAssetBytes, reservation_});
+	} catch (...) {
+		pending_.erase(key);
+		cache_.ReleaseReservation(reservation_);
+		return false;
+	}
+	wake_.notify_one();
+	return true;
+}
+std::shared_ptr<const PreparedAsset> PreparationScheduler::TryGet(const std::wstring &path,
+																  Generation generation) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (stopping_ || !limits_.cpuBytes || generation < minimum_)
+		return {};
+	return cache_.Find(path, generation);
+}
+std::string PreparationScheduler::CompatibilityReason(const std::wstring &path,
+													  Generation generation) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	auto it = compatibility_.find({path, generation});
+	return it == compatibility_.end() ? std::string() : it->second;
+}
+void PreparationScheduler::CancelQueued() {
+	for (const auto &job : queue_) {
+		pending_.erase({job.path, job.generation});
+		cache_.ReleaseReservation(job.reservation);
+	}
+	queue_.clear();
+}
+bool PreparationScheduler::Reconfigure(const PreparationLimits &limits, Generation minimum) {
+	if (!limits.Valid())
+		return false;
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (stopping_)
+			return false;
+		minimum_ = (std::max)(minimum_, minimum);
+		CancelQueued();
+		compatibility_.clear();
+		limits_ = limits;
+		reservation_ = Reservation(limits);
+		cache_.SetCapacity(limits.cpuBytes);
+	}
+	wake_.notify_all();
+	return true;
+}
+bool PreparationScheduler::ConfigureDiskCache(const std::wstring &directory, size_t budgetBytes) {
+	if (directory.size() > 30000 ||
+		(!directory.empty() &&
+		 (!budgetBytes || uint64_t(budgetBytes) > uint64_t(4096) * 1024 * 1024)))
+		return false;
+	std::shared_ptr<DiskAssetCache> candidate;
+	try {
+		if (!directory.empty())
+			candidate = std::make_shared<DiskAssetCache>(directory, budgetBytes);
+	} catch (...) {
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (stopping_)
+		return false;
+	disk_ = std::move(candidate);
+	return true;
+}
+void PreparationScheduler::CancelBefore(Generation generation) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	minimum_ = (std::max)(minimum_, generation);
+	for (auto it = compatibility_.begin(); it != compatibility_.end();)
+		if (it->first.second < minimum_)
+			it = compatibility_.erase(it);
+		else
+			++it;
+	for (auto it = queue_.begin(); it != queue_.end();)
+		if (it->generation < minimum_) {
+			pending_.erase({it->path, it->generation});
+			cache_.ReleaseReservation(it->reservation);
+			it = queue_.erase(it);
+		} else
+			++it;
+}
+void PreparationScheduler::Stop() {
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		stopping_ = true;
+		CancelQueued();
+	}
+	wake_.notify_all();
+	for (auto &worker : workers_)
+		if (worker.joinable())
+			worker.join();
+	workers_.clear();
+}
+void PreparationScheduler::Worker() {
+#ifdef _WIN32
+	HRESULT com = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+#endif
+	for (;;) {
+		Job job;
+		std::shared_ptr<DiskAssetCache> disk;
+		{
+			std::unique_lock<std::mutex> lock(mutex_);
+			wake_.wait(lock, [this] {
+				return stopping_ ||
+					   (!queue_.empty() && active_ < limits_.workers && limits_.cpuBytes);
+			});
+			if (stopping_)
+				break;
+			auto best =
+				std::max_element(queue_.begin(), queue_.end(), [](const Job &a, const Job &b) {
+					return a.priority < b.priority ||
+						   (a.priority == b.priority && a.order > b.order);
+				});
+			job = std::move(*best);
+			queue_.erase(best);
+			++active_;
+			disk = disk_;
+		}
+		std::shared_ptr<PreparedAsset> asset;
+		try {
+			asset = std::make_shared<PreparedAsset>();
+			std::string error;
+			if (!reader_(job.path, job.maxBytes, asset->snapshot, error) ||
+				!asset->snapshot.bytes || asset->snapshot.bytes->size() > job.maxBytes)
+				asset.reset();
+			else {
+				asset->generation = job.generation;
+				if (asset->snapshot.watchable) {
+					size_t decodedBudget = job.reservation - asset->snapshot.bytes->size();
+					bool restored =
+						disk && disk->Load(asset->snapshot, decodedBudget, asset->decoded);
+					if (restored ||
+						DecodeSnapshot(asset->snapshot, decodedBudget, asset->decoded, error)) {
+						asset->state = PreparationState::DecodedReady;
+						if (!restored && disk)
+							disk->Store(asset->snapshot, *asset->decoded);
+					}
+				}
+			}
+		} catch (...) {
+			asset.reset();
+		}
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			pending_.erase({job.path, job.generation});
+			--active_;
+			if (asset && !asset->snapshot.watchable) {
+				if (!stopping_ && job.generation >= minimum_) {
+					try {
+						if (compatibility_.size() >= limits_.maxQueued)
+							compatibility_.erase(compatibility_.begin());
+						compatibility_[{job.path, job.generation}] =
+							asset->snapshot.compatibilityReason.empty()
+								? "source alias dependencies require legacy loading"
+								: asset->snapshot.compatibilityReason;
+					} catch (const std::bad_alloc &) {
+					}
+				}
+				asset.reset();
+			}
+			if (asset && !stopping_ && limits_.cpuBytes && job.generation >= minimum_)
+				cache_.Publish(std::move(asset), job.reservation);
+			else
+				cache_.ReleaseReservation(job.reservation);
+		}
+		wake_.notify_all();
+	}
+#ifdef _WIN32
+	if (SUCCEEDED(com))
+		CoUninitialize();
+#endif
+}
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/PreparationScheduler.h b/DirectX11/ModLoading/PreparationScheduler.h
new file mode 100644
index 0000000000000000000000000000000000000000..458e2a5df6f91051c2e3ee04377978400726ae3d
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationScheduler.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "CpuAssetCache.h"
+#include <condition_variable>
+#include <functional>
+#include <set>
+#include <thread>
+namespace ModLoading {
+class DiskAssetCache;
+class PreparationScheduler {
+  public:
+	using SnapshotReader =
+		std::function<bool(const std::wstring &, size_t, SourceSnapshot &, std::string &)>;
+	explicit PreparationScheduler(const PreparationLimits &limits = PreparationLimits(),
+								  SnapshotReader reader = SnapshotReader());
+	~PreparationScheduler();
+	PreparationScheduler(const PreparationScheduler &) = delete;
+	PreparationScheduler &operator=(const PreparationScheduler &) = delete;
+	// True includes duplicate or already-ready work. False is a bounded admission miss.
+	bool Enqueue(const std::wstring &path, Generation generation, int priority = 0);
+	std::shared_ptr<const PreparedAsset> TryGet(const std::wstring &path, Generation generation);
+	// Empty means no recorded compatibility exclusion; performs no file I/O.
+	std::string CompatibilityReason(const std::wstring &path, Generation generation);
+	// Never joins or waits for worker I/O. Existing reservations remain accounted on shrink.
+	bool Reconfigure(const PreparationLimits &limits, Generation minimum);
+	// Configuration only: no filesystem access, waiting or worker retirement. Empty disables.
+	bool ConfigureDiskCache(const std::wstring &directory,
+							size_t budgetBytes = size_t(1024) * 1024 * 1024);
+	void CancelBefore(Generation generation);
+	void Stop();
+	size_t ResidentBytes() const {
+		return cache_.ResidentBytes();
+	}
+	size_t ReservedBytes() const {
+		return cache_.ReservedBytes();
+	}
+
+  private:
+	struct Job {
+		std::wstring path;
+		Generation generation;
+		int priority;
+		uint64_t order;
+		size_t maxBytes;
+		size_t reservation;
+	};
+	void Worker();
+	void CancelQueued();
+	PreparationLimits limits_;
+	CpuAssetCache cache_;
+	size_t reservation_;
+	SnapshotReader reader_;
+	size_t active_ = 0;
+	std::shared_ptr<DiskAssetCache> disk_;
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	std::vector<std::thread> workers_;
+	std::vector<Job> queue_;
+	std::set<std::pair<std::wstring, Generation>> pending_;
+	std::map<std::pair<std::wstring, Generation>, std::string> compatibility_;
+	Generation minimum_ = 0;
+	uint64_t order_ = 0;
+	bool stopping_ = false;
+};
+} // namespace ModLoading
diff --git a/DirectX11/ModLoading/PreparationStatus.cpp b/DirectX11/ModLoading/PreparationStatus.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6e559f24b549dcb7086749db5ffd2b49020fd31f
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationStatus.cpp
@@ -0,0 +1,177 @@
+#include "PreparationStatus.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#include "SnapshotIO.h"
+#endif
+namespace ModLoading {
+namespace {
+const char* Mode(PreparationMode mode) {
+	switch (mode) { case PreparationMode::Off: return "off"; case PreparationMode::Adaptive: return "adaptive";
+	case PreparationMode::PreparedProfile: return "prepared_profile"; } return nullptr;
+}
+const char* State(PreparationStatusState state) {
+	switch (state) { case PreparationStatusState::Off: return "off"; case PreparationStatusState::Preparing: return "preparing";
+	case PreparationStatusState::Ready: return "ready"; case PreparationStatusState::Compatibility: return "compatibility";
+	case PreparationStatusState::Failed: return "failed"; } return nullptr;
+}
+std::string EscapeReason(const std::string& reason) {
+	static const char* hex = "0123456789abcdef";
+	std::string result; result.reserve(256 * 6);
+	for (size_t i = 0; i < std::min(size_t(256), reason.size()); ++i) {
+		const unsigned char c = static_cast<unsigned char>(reason[i]);
+		if (c == '"' || c == '\\') { result += '\\'; result += static_cast<char>(c); }
+		else if (c < 32) { result += "\\u00"; result += hex[c >> 4]; result += hex[c & 15]; }
+		else result += c < 127 ? static_cast<char>(c) : '?';
+	}
+	return result;
+}
+struct FixedStatus {
+	PreparationMode mode = PreparationMode::Off;
+	PreparationStatusState state = PreparationStatusState::Off;
+	uint64_t total = 0, cpu = 0, gpu = 0, compatibility = 0, ticket = 0;
+	char reason[257] = "initializing";
+	size_t reasonLength = 12;
+};
+struct Publisher {
+	std::mutex mutex;
+	FixedStatus latest;
+#ifdef _WIN32
+	std::wstring source, output;
+#endif
+};
+std::atomic<Publisher*> publisher{nullptr};
+PreparationStatusFence publicationFence;
+#ifdef _WIN32
+std::mutex initialization;
+uint64_t UnixMs() {
+	return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::system_clock::now().time_since_epoch()).count());
+}
+bool WriteAtomic(const std::wstring& directory, const std::string& json) {
+	if (json.empty() || json.size() > 8192) return false;
+	if (!CreateDirectoryW(directory.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) return false;
+	const std::wstring target = directory + L"\\status.json";
+	const std::wstring temporary = target + L".tmp" + std::to_wstring(GetCurrentProcessId());
+	HANDLE file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (file == INVALID_HANDLE_VALUE) return false;
+	DWORD written = 0;
+	const bool ok = WriteFile(file, json.data(), static_cast<DWORD>(json.size()), &written, nullptr) != FALSE &&
+		written == json.size() && FlushFileBuffers(file) != FALSE;
+	CloseHandle(file);
+	if (ok && MoveFileExW(temporary.c_str(), target.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+	DeleteFileW(temporary.c_str()); return false;
+}
+DWORD WINAPI Writer(void* parameter) {
+	try {
+		auto* service = static_cast<Publisher*>(parameter);
+		SourceSnapshot image; std::string error;
+		if (!ReadVerifiedSnapshot(service->source, size_t(64) * 1024 * 1024, image, error)) return 0;
+		std::string digest; digest.reserve(64); const char* hex = "0123456789abcdef";
+		for (const auto byte : image.digest) { digest += hex[byte >> 4]; digest += hex[byte & 15]; }
+		image = SourceSnapshot(); // DLL bytes are not retained by process-life service.
+		for (;;) {
+			FixedStatus fixed;
+			{ std::lock_guard<std::mutex> lock(service->mutex); fixed = service->latest; }
+			PreparationStatus status; status.mode = fixed.mode; status.state = fixed.state;
+			status.totalAssets = fixed.total; status.cpuReady = fixed.cpu; status.gpuReady = fixed.gpu;
+			status.compatibilityAssets = fixed.compatibility; status.reason.assign(fixed.reason, fixed.reasonLength);
+			// Invalidation is nondroppable even if no renderer/update runs again.
+			// A file already being written can lag until the next heartbeat;
+			// this diagnostic snapshot never authorizes resource activation.
+			if (!publicationFence.Accepts(fixed.ticket) && status.mode != PreparationMode::Off) {
+				status.state = PreparationStatusState::Preparing;
+				status.cpuReady = 0; status.gpuReady = 0;
+				status.reason = "preparation status invalidated";
+			}
+			WriteAtomic(service->output, SerializePreparationStatus(status, GetCurrentProcessId(), digest, UnixMs()));
+			Sleep(1000);
+		}
+	} catch (...) { return 0; } // Status failure must never terminate the host.
+}
+bool Initialize(const void* address, const std::wstring* outputOverride) {
+	std::lock_guard<std::mutex> lock(initialization);
+	if (publisher.load(std::memory_order_acquire)) return true;
+	if (!address) return false;
+	HMODULE module = nullptr, containing = nullptr;
+	// The caller-supplied identity must belong to this publisher's actual DLL.
+	if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		reinterpret_cast<LPCWSTR>(address), &module) ||
+		!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		reinterpret_cast<LPCWSTR>(&InitializePreparationStatus), &containing) || module != containing) return false;
+	wchar_t path[32768] = {};
+	const DWORD length = GetModuleFileNameW(module, path, static_cast<DWORD>(sizeof(path) / sizeof(path[0])));
+	if (!length || length >= sizeof(path) / sizeof(path[0])) return false;
+	std::wstring source(path, length);
+	const size_t separator = source.find_last_of(L"\\/");
+	if (separator == std::wstring::npos) return false;
+	if (outputOverride && (outputOverride->empty() || outputOverride->size() > 32000)) return false;
+	std::unique_ptr<Publisher> service(new Publisher);
+	service->source = source;
+	service->output = outputOverride ? *outputOverride : source.substr(0, separator) + L"\\.xxmi-preparation";
+	if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+		reinterpret_cast<LPCWSTR>(&InitializePreparationStatus), &containing)) return false;
+	HANDLE thread = CreateThread(nullptr, 0, Writer, service.get(), 0, nullptr);
+	if (!thread) return false;
+	CloseHandle(thread);
+	publisher.store(service.release(), std::memory_order_release);
+	return true;
+}
+#endif
+}
+std::string SerializePreparationStatus(const PreparationStatus& status, uint32_t pid,
+	const std::string& digest, uint64_t updated) noexcept {
+	try {
+		const char* mode = Mode(status.mode); const char* state = State(status.state);
+		if (!mode || !state || !pid || digest.size() != 64 || !updated) return {};
+		for (const char c : digest) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return {};
+		std::string json = "{\"schema_version\":1,\"process_id\":" + std::to_string(pid) +
+			",\"dll_sha256\":\"" + digest + "\",\"updated_unix_ms\":" + std::to_string(updated) +
+			",\"mode\":\"" + mode + "\",\"state\":\"" + state + "\",\"total_assets\":" + std::to_string(status.totalAssets) +
+			",\"cpu_ready\":" + std::to_string(status.cpuReady) + ",\"gpu_ready\":" + std::to_string(status.gpuReady) +
+			",\"compatibility_assets\":" + std::to_string(status.compatibilityAssets) +
+			",\"reason\":\"" + EscapeReason(status.reason) + "\"}\n";
+		return json.size() <= 8192 ? json : std::string();
+	} catch (...) { return {}; }
+}
+bool InitializePreparationStatus(const void* address) noexcept {
+#ifdef _WIN32
+	try { return Initialize(address, nullptr); } catch (...) { return false; }
+#else
+	(void)address; return false;
+#endif
+}
+bool InitializePreparationStatusForTesting(const void* address, const std::wstring& output) noexcept {
+#ifdef _WIN32
+	try { return Initialize(address, &output); } catch (...) { return false; }
+#else
+	(void)address; (void)output; return false;
+#endif
+}
+uint64_t ReservePreparationStatusTicket() noexcept { return publicationFence.Reserve(); }
+void InvalidatePreparationStatus() noexcept { publicationFence.Invalidate(); }
+void UpdatePreparationStatus(const PreparationStatus& status, uint64_t ticket) noexcept {
+	try {
+		auto* service = publisher.load(std::memory_order_acquire);
+		if (!service || !publicationFence.Accepts(ticket) || !service->mutex.try_lock()) return;
+		// Fixed-size stores only under lock; no allocation or source traversal.
+		FixedStatus& fixed = service->latest;
+		if (!publicationFence.Accepts(ticket) || ticket < fixed.ticket) { service->mutex.unlock(); return; }
+		fixed.ticket = ticket;
+		fixed.mode = status.mode; fixed.state = status.state;
+		fixed.total = status.totalAssets; fixed.cpu = status.cpuReady; fixed.gpu = status.gpuReady;
+		fixed.compatibility = status.compatibilityAssets;
+		fixed.reasonLength = std::min(size_t(256), status.reason.size());
+		std::memcpy(fixed.reason, status.reason.data(), fixed.reasonLength);
+		fixed.reason[fixed.reasonLength] = 0;
+		service->mutex.unlock();
+	} catch (...) {}
+}
+}
diff --git a/DirectX11/ModLoading/PreparationStatus.h b/DirectX11/ModLoading/PreparationStatus.h
new file mode 100644
index 0000000000000000000000000000000000000000..c415e699caea1db526017b0ad8ad88c5f8518027
--- /dev/null
+++ b/DirectX11/ModLoading/PreparationStatus.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <string>
+#include <atomic>
+
+namespace ModLoading {
+enum class PreparationStatusState { Off, Preparing, Ready, Compatibility, Failed };
+struct PreparationStatus {
+	PreparationMode mode = PreparationMode::Off;
+	PreparationStatusState state = PreparationStatusState::Off;
+	uint64_t totalAssets = 0, cpuReady = 0, gpuReady = 0, compatibilityAssets = 0;
+	std::string reason;
+};
+// Opt-in loading boundary only, never DllMain. Pins the containing module and
+// starts one process-lifetime writer. Hashing and file I/O run on that worker.
+bool InitializePreparationStatus(const void* moduleAddress) noexcept;
+// Pure lock-free version fence, also used by portable ordering tests. Tickets
+// must be reserved before any source/currentness/count/readiness computation.
+class PreparationStatusFence {
+public:
+	uint64_t Reserve() noexcept { return sequence_.fetch_add(1, std::memory_order_acq_rel) + 1; }
+	void Invalidate() noexcept {
+		const uint64_t next = Reserve();
+		uint64_t floor = floor_.load(std::memory_order_relaxed);
+		while (floor < next && !floor_.compare_exchange_weak(floor, next,
+			std::memory_order_release, std::memory_order_relaxed)) {}
+	}
+	bool Accepts(uint64_t ticket) const noexcept {
+		return ticket && ticket >= floor_.load(std::memory_order_acquire) &&
+			ticket <= sequence_.load(std::memory_order_acquire);
+	}
+private:
+	std::atomic<uint64_t> sequence_{0}, floor_{0};
+};
+// Global process-lifetime fence, never reset across configuration reloads.
+uint64_t ReservePreparationStatusTicket() noexcept;
+void InvalidatePreparationStatus() noexcept;
+// Latest immutable snapshot only: bounded copy, nonblocking try_lock, no I/O.
+// A contended update may be dropped; Runtime must provide authoritative state.
+void UpdatePreparationStatus(const PreparationStatus& status, uint64_t ticket) noexcept;
+// Portable protocol serializer. Invalid enum/hash input returns empty; reason
+// is bounded to 256 bytes and non-ASCII bytes are replaced with '?'. No paths.
+std::string SerializePreparationStatus(const PreparationStatus& status, uint32_t processId,
+	const std::string& dllSha256, uint64_t updatedUnixMs) noexcept;
+// Actual Windows fixture injection: directory must be an owned temporary path.
+// Same singleton/hash/pinning/writer behavior as production; never call in game.
+bool InitializePreparationStatusForTesting(const void* moduleAddress,
+	const std::wstring& outputDirectory) noexcept;
+}
diff --git a/DirectX11/ModLoading/PreparedTypes.h b/DirectX11/ModLoading/PreparedTypes.h
new file mode 100644
index 0000000000000000000000000000000000000000..2549a5703ec5a9a64bd213383fa8d6129405c89d
--- /dev/null
+++ b/DirectX11/ModLoading/PreparedTypes.h
@@ -0,0 +1,84 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+namespace ModLoading {
+using Generation = uint64_t;
+using DeviceEpoch = uint64_t;
+using SourceDigest = std::array<uint8_t, 32>;
+enum class PreparationMode { Off, Adaptive, PreparedProfile };
+enum class PreparationState {
+	Discovered,
+	SnapshotVerified,
+	SourceBytesReady,
+	DecodedReady,
+	CPUReady,
+	DeviceReady,
+	ValidatedForActivation,
+	Active,
+	Retiring,
+	Released,
+	Failed,
+	Canceled,
+	CompatibilityOnly
+};
+
+struct FileIdentity {
+	uint64_t volume = 0;
+	uint64_t file = 0;
+	uint64_t size = 0;
+	uint64_t modified = 0;
+	bool operator==(const FileIdentity& o) const
+	{
+		return volume == o.volume && file == o.file && size == o.size && modified == o.modified;
+	}
+};
+
+struct SourceSnapshot {
+	std::wstring path;
+	SourceDigest digest{};
+	FileIdentity identity;
+	// Lexical parent watches cannot observe writes through these aliases.
+	bool watchable = true;
+	std::string compatibilityReason;
+	std::shared_ptr<const std::vector<uint8_t>> bytes;
+};
+// Source format is retained verbatim. This key is NOT a decoded-image identity.
+// Decoded/GPU consumers must additionally key all decoder and descriptor options.
+struct DecodedImage {
+	uint32_t width = 0;
+	uint32_t height = 0;
+	uint32_t rowPitch = 0;
+	uint32_t format = 0; // DXGI numeric format, no D3D dependency
+	bool metadataSRGB = false;
+	uint32_t decoderVersion = 1;
+	std::shared_ptr<const std::vector<uint8_t>> pixels;
+};
+
+struct PreparedAsset {
+	SourceSnapshot snapshot;
+	Generation generation = 0;
+	PreparationState state = PreparationState::SourceBytesReady;
+	std::shared_ptr<const DecodedImage> decoded;
+	size_t ByteSize() const
+	{
+		return (snapshot.bytes ? snapshot.bytes->size() : 0) +
+			(decoded && decoded->pixels ? decoded->pixels->size() : 0);
+	}
+};
+
+struct PreparationLimits {
+	size_t cpuBytes = size_t(512) * 1024 * 1024;
+	size_t maxAssetBytes = size_t(64) * 1024 * 1024;
+	size_t workers = 2;
+	size_t maxQueued = 64;
+	bool Valid() const
+	{
+		return maxAssetBytes && (!cpuBytes || maxAssetBytes <= cpuBytes) &&
+			workers >= 1 && workers <= 16 && maxQueued >= 1 && maxQueued <= 4096;
+	}
+};
+}
diff --git a/DirectX11/ModLoading/QuiescentGenerationRegistry.h b/DirectX11/ModLoading/QuiescentGenerationRegistry.h
new file mode 100644
index 0000000000000000000000000000000000000000..e21e4c185745a28c79bd769c730c53a10eea3a75
--- /dev/null
+++ b/DirectX11/ModLoading/QuiescentGenerationRegistry.h
@@ -0,0 +1,107 @@
+#pragma once
+#include <memory>
+#include <mutex>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+enum class ConfigPublishResult { Published, Busy, Stale, Invalid, MigrationBudget };
+
+// Production CPU publication gate. Pins retain object graphs, while counted
+// readers also prohibit migration/publication across pending pre/post commands.
+// The commit callback runs only after identity and quiescence are established.
+template<class State>
+class QuiescentGenerationRegistry {
+public:
+	using Pin = std::shared_ptr<State>;
+
+	explicit QuiescentGenerationRegistry(Pin initial) : active_(std::move(initial))
+	{}
+
+	Pin Snapshot() const
+	{
+		return std::atomic_load(&active_);
+	}
+
+	Pin Acquire(Pin selected = {})
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		++readers_;
+		return selected ? std::move(selected) : Snapshot();
+	}
+
+	void Release()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		--readers_;
+		++revision_;
+	}
+
+	template<class PrepareCommit>
+	ConfigPublishResult TryPublish(const Pin& candidate, const Pin& expected, PrepareCommit prepare)
+	{
+		std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+		if (!lock.owns_lock())
+			return ConfigPublishResult::Busy;
+		if (!candidate || candidate == expected)
+			return ConfigPublishResult::Invalid;
+		if (Snapshot() != expected)
+			return ConfigPublishResult::Stale;
+		if (readers_)
+			return ConfigPublishResult::Busy;
+		auto result = prepare();
+		if (result != ConfigPublishResult::Published)
+			return result;
+		// expected retains the old graph so destruction cannot call hooks while
+		// this mutex is held. GPU retirement retains a separate owning pin.
+		std::atomic_store(&active_, candidate);
+		return ConfigPublishResult::Published;
+	}
+
+	template<class Prepare>
+	ConfigPublishResult TryStage(const Pin& expected, Prepare prepare, uint64_t& revision)
+	{
+		std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+		if (!lock.owns_lock())
+			return ConfigPublishResult::Busy;
+		if (Snapshot() != expected)
+			return ConfigPublishResult::Stale;
+		if (readers_)
+			return ConfigPublishResult::Busy;
+		auto result = prepare();
+		if (result == ConfigPublishResult::Published)
+			revision = revision_;
+		return result;
+	}
+
+	ConfigPublishResult TryPublishStaged(const Pin& candidate, const Pin& expected, uint64_t revision)
+	{
+		return TryPublish(candidate, expected, [&] {
+			return revision == revision_ ? ConfigPublishResult::Published : ConfigPublishResult::Stale;
+		});
+	}
+
+	std::unique_lock<std::mutex> TryBeginLegacy(size_t ownReaders)
+	{
+		std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+		if (lock.owns_lock() && readers_ != ownReaders)
+			lock.unlock();
+		return lock;
+	}
+
+	// Only while holding the successful legacy exclusive lease.
+	Pin ActiveUnderLock() const
+	{
+		return Snapshot();
+	}
+	void SetActiveUnderLock(Pin candidate)
+	{
+		std::atomic_store(&active_, std::move(candidate));
+	}
+
+private:
+	mutable std::mutex mutex_;
+	Pin active_;
+	size_t readers_ = 0;
+	uint64_t revision_ = 0;
+};
diff --git a/DirectX11/ModLoading/RefreshCpuBudget.cpp b/DirectX11/ModLoading/RefreshCpuBudget.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1153d74bb97145bed3f9b60f25432eb6d9a1161
--- /dev/null
+++ b/DirectX11/ModLoading/RefreshCpuBudget.cpp
@@ -0,0 +1,136 @@
+#include "RefreshCpuBudget.h"
+#include "SnapshotIO.h"
+#include <limits>
+#include <map>
+#include <mutex>
+
+namespace ModLoading {
+struct ResourceRefreshCpuBudget::State {
+	mutable std::mutex mutex;
+	uint64_t used = 0, capacity = 0;
+	std::map<const std::vector<uint8_t>*, std::weak_ptr<OwnedBytes>> owners;
+};
+struct ResourceRefreshCpuBudget::Reservation {
+	std::shared_ptr<State> state;
+	uint64_t bytes = 0;
+	~Reservation() {
+		if (!state) return;
+		std::lock_guard<std::mutex> lock(state->mutex);
+		state->used -= bytes;
+	}
+	void Shrink(uint64_t size) {
+		std::lock_guard<std::mutex> lock(state->mutex);
+		if (size <= bytes) { state->used -= bytes - size; bytes = size; }
+	}
+};
+struct ResourceRefreshCpuBudget::OwnedBytes {
+	// Bytes are destroyed before their reservation is released.
+	std::shared_ptr<Reservation> reservation;
+	std::shared_ptr<const std::vector<uint8_t>> bytes;
+	~OwnedBytes() {
+		const auto state = reservation->state;
+		std::lock_guard<std::mutex> lock(state->mutex);
+		const auto found = state->owners.find(bytes.get());
+		if (found != state->owners.end() && found->second.expired()) state->owners.erase(found);
+	}
+};
+ResourceRefreshCpuBudget::ResourceRefreshCpuBudget(uint64_t capacity) : state_(std::make_shared<State>()) {
+	state_->capacity = capacity;
+}
+void ResourceRefreshCpuBudget::SetCapacity(uint64_t capacity) {
+	std::lock_guard<std::mutex> lock(state_->mutex); state_->capacity = capacity;
+}
+uint64_t ResourceRefreshCpuBudget::Capacity() const {
+	std::lock_guard<std::mutex> lock(state_->mutex); return state_->capacity;
+}
+uint64_t ResourceRefreshCpuBudget::Used() const {
+	std::lock_guard<std::mutex> lock(state_->mutex); return state_->used;
+}
+std::shared_ptr<ResourceRefreshCpuBudget::Reservation> ResourceRefreshCpuBudget::Reserve(uint64_t bytes) {
+	if (!bytes) bytes = 1;
+	auto reservation = std::make_shared<Reservation>();
+	std::lock_guard<std::mutex> lock(state_->mutex);
+	if (state_->used > state_->capacity || bytes > state_->capacity - state_->used) return {};
+	state_->used += bytes;
+	reservation->state = state_; reservation->bytes = bytes;
+	return reservation;
+}
+std::shared_ptr<const void> ResourceRefreshCpuBudget::TryReserve(uint64_t bytes) { return Reserve(bytes); }
+bool ResourceRefreshCpuBudget::OwnSnapshot(SourceSnapshot& snapshot, std::shared_ptr<Reservation> reservation) {
+	if (!snapshot.bytes) return false;
+	std::shared_ptr<OwnedBytes> owner;
+	{
+		std::lock_guard<std::mutex> lock(state_->mutex);
+		for (auto it = state_->owners.begin(); it != state_->owners.end();) {
+			if (it->second.expired()) it = state_->owners.erase(it); else ++it;
+		}
+		const auto found = state_->owners.find(snapshot.bytes.get());
+		if (found != state_->owners.end()) owner = found->second.lock();
+	}
+	if (!owner) {
+		const uint64_t cost = uint64_t(snapshot.bytes->capacity()) + SnapshotOverhead;
+		if (!reservation) reservation = Reserve(cost);
+		if (!reservation || reservation->bytes < cost) return false;
+		reservation->Shrink(cost);
+		auto fresh = std::make_shared<OwnedBytes>();
+		fresh->reservation = std::move(reservation); fresh->bytes = snapshot.bytes;
+		{
+			std::lock_guard<std::mutex> lock(state_->mutex);
+			// Another task may have charged this same baseline vector.
+			owner = state_->owners[snapshot.bytes.get()].lock();
+			if (!owner) { owner = fresh; state_->owners[snapshot.bytes.get()] = owner; }
+		}
+	}
+	snapshot.bytes = std::shared_ptr<const std::vector<uint8_t>>(owner, owner->bytes.get());
+	return true;
+}
+bool ResourceRefreshCpuBudget::ChargeManifest(ConfigSourceManifest& manifest) {
+	const auto metadata = manifest.MetadataBytes();
+	if (!metadata) return false;
+	auto ownership = TryReserve(metadata);
+	if (!ownership) return false;
+	ConfigSourceManifest owned;
+	BindManifestOwnership(owned, std::move(ownership));
+	owned.sources = manifest.sources;
+	owned.verified = manifest.verified;
+	owned.recursiveIncludes = manifest.recursiveIncludes;
+	owned.userConfig = manifest.userConfig;
+	for (auto& source : owned.sources) if (!OwnSnapshot(source.snapshot)) return false;
+	manifest = std::move(owned);
+	return true;
+}
+void ResourceRefreshCpuBudget::BindManifestOwnership(ConfigSourceManifest& manifest,
+	std::shared_ptr<const void> ownership) {
+	manifest.ownership = std::move(ownership);
+	manifest.budgetIdentity = state_;
+	manifest.reserve = [ledger = *this](uint64_t bytes) mutable { return ledger.TryReserve(bytes); };
+}
+bool ResourceRefreshCpuBudget::OwnsManifest(const ConfigSourceManifest& manifest) const {
+	if (!manifest.ownership || manifest.budgetIdentity != state_ || !manifest.reserve) return false;
+	std::lock_guard<std::mutex> lock(state_->mutex);
+	for (const auto& source : manifest.sources) {
+		if (!source.snapshot.bytes) return false;
+		const auto found = state_->owners.find(source.snapshot.bytes.get());
+		// Pointer equality alone is insufficient: an uncharged original vector
+		// may coexist with a separately charged alias owner of the same bytes.
+		if (found == state_->owners.end() || found->second.expired() ||
+			found->second.owner_before(source.snapshot.bytes) ||
+			source.snapshot.bytes.owner_before(found->second)) return false;
+	}
+	return true;
+}
+bool ResourceRefreshCpuBudget::ReadSnapshot(const std::wstring& path, size_t maximumBytes,
+	SourceSnapshot& snapshot, std::string& error) {
+	error = "Filename refresh CPU budget is exhausted; last-good generation retained";
+	if (maximumBytes > std::numeric_limits<uint64_t>::max() - SnapshotOverhead) return false;
+	auto reservation = Reserve(uint64_t(maximumBytes) + SnapshotOverhead);
+	if (!reservation) return false;
+	SourceSnapshot captured;
+	if (!ReadVerifiedSnapshot(path, maximumBytes, captured, error)) return false;
+	if (!OwnSnapshot(captured, std::move(reservation))) {
+		error = "Filename refresh CPU snapshot ownership admission failed"; return false;
+	}
+	snapshot = std::move(captured);
+	return true;
+}
+}
diff --git a/DirectX11/ModLoading/RefreshCpuBudget.h b/DirectX11/ModLoading/RefreshCpuBudget.h
new file mode 100644
index 0000000000000000000000000000000000000000..e846299fd5ebd418094ecd9063e7f4ba189e8388
--- /dev/null
+++ b/DirectX11/ModLoading/RefreshCpuBudget.h
@@ -0,0 +1,33 @@
+#pragma once
+#include "ConfigCompiler.h"
+#include <memory>
+
+namespace ModLoading {
+// One service-owned ledger is shared across config reloads, candidates and
+// retired generations. Lowering capacity stops new admission; existing pins
+// remain valid until released. All snapshot allocation uses pre-admission.
+class ResourceRefreshCpuBudget {
+public:
+	explicit ResourceRefreshCpuBudget(uint64_t capacity);
+	void SetCapacity(uint64_t capacity);
+	uint64_t Capacity() const;
+	uint64_t Used() const;
+	std::shared_ptr<const void> TryReserve(uint64_t bytes);
+	// Transactional ownership conversion. Shared identical vector owners are
+	// charged once; original bytes are never copied. Includes metadata margin.
+	bool ChargeManifest(ConfigSourceManifest& manifest);
+	// Attach copy admission to metadata already covered by the supplied lease.
+	void BindManifestOwnership(ConfigSourceManifest& manifest, std::shared_ptr<const void> ownership);
+	bool OwnsManifest(const ConfigSourceManifest& manifest) const;
+	bool ReadSnapshot(const std::wstring& path, size_t maximumBytes,
+		SourceSnapshot& snapshot, std::string& error);
+	static constexpr uint64_t SnapshotOverhead = 512;
+private:
+	struct State;
+	struct Reservation;
+	struct OwnedBytes;
+	std::shared_ptr<State> state_;
+	std::shared_ptr<Reservation> Reserve(uint64_t bytes);
+	bool OwnSnapshot(SourceSnapshot& snapshot, std::shared_ptr<Reservation> reservation = {});
+};
+}
diff --git a/DirectX11/ModLoading/ResourceRefresh.cpp b/DirectX11/ModLoading/ResourceRefresh.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f0e6821972e8dbbd2ff110ee56079d14e24699b3
--- /dev/null
+++ b/DirectX11/ModLoading/ResourceRefresh.cpp
@@ -0,0 +1,224 @@
+#include "ResourceRefresh.h"
+#include "SnapshotIO.h"
+#include <algorithm>
+
+namespace ModLoading {
+namespace {
+bool ValidSnapshot(const SourceSnapshot& source) {
+	return source.watchable && source.bytes &&
+		HashBytes(source.bytes->data(), source.bytes->size()) == source.digest;
+}
+bool FilenameSpan(const std::vector<uint8_t>& bytes, size_t line, size_t& begin, size_t& end) {
+	if (!line) return false;
+	begin = 0;
+	for (size_t n = 1; n < line; ++n) {
+		while (begin < bytes.size() && bytes[begin] != '\n') ++begin;
+		if (begin == bytes.size()) return false;
+		++begin;
+	}
+	end = begin;
+	while (end < bytes.size() && bytes[end] != '\n') ++end;
+	if (end > begin && bytes[end - 1] == '\r') --end;
+	size_t equal = begin;
+	while (equal < end && bytes[equal] != '=') ++equal;
+	if (equal == end) return false;
+	size_t keyBegin = begin, keyEnd = equal;
+	while (keyBegin < keyEnd && (bytes[keyBegin] == ' ' || bytes[keyBegin] == '\t')) ++keyBegin;
+	while (keyEnd > keyBegin && (bytes[keyEnd - 1] == ' ' || bytes[keyEnd - 1] == '\t')) --keyEnd;
+	const char key[] = "filename";
+	if (keyEnd - keyBegin != sizeof(key) - 1) return false;
+	for (size_t i = 0; i != sizeof(key) - 1; ++i) {
+		auto c = bytes[keyBegin + i];
+		if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+		if (c != static_cast<uint8_t>(key[i])) return false;
+	}
+	begin = equal + 1;
+	while (begin < end && (bytes[begin] == ' ' || bytes[begin] == '\t')) ++begin;
+	while (end > begin && (bytes[end - 1] == ' ' || bytes[end - 1] == '\t')) --end;
+	return begin < end;
+}
+bool Basename(const std::vector<uint8_t>& bytes, size_t begin, size_t end, std::wstring& out) {
+	if (end - begin <= 4 || end - begin > 200) return false;
+	out.clear();
+	for (size_t i = begin; i < end; ++i) {
+		const auto c = bytes[i];
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.')) return false;
+		out.push_back(c);
+	}
+	if (out.find(L"..") != std::wstring::npos || out.front() == L'.') return false;
+	auto extension = out.substr(out.size() - 4);
+	for (auto& c : extension) if (c >= L'A' && c <= L'Z') c += L'a' - L'A';
+	return extension == L".buf";
+}
+}
+ResourceFilenamePatch BuildResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const ConfigSourceManifest& candidate, const std::vector<ResourceFilenameBinding>& bindings,
+	BuildVersions versions, bool dependencyClosureVerified) try {
+	ResourceFilenamePatch result;
+	result.versions = versions;
+	result.reason = "Filename refresh requires a verified unchanged source closure";
+	if (!baseline.verified || !candidate.verified || !dependencyClosureVerified ||
+		baseline.sources.empty() || baseline.sources.size() != candidate.sources.size()) return result;
+	size_t changed = candidate.sources.size();
+	for (size_t i = 0; i < baseline.sources.size(); ++i) {
+		const auto& a = baseline.sources[i];
+		const auto& b = candidate.sources[i];
+		if (a.snapshot.path != b.snapshot.path || a.iniNamespace != b.iniNamespace ||
+			!ValidSnapshot(a.snapshot) || !ValidSnapshot(b.snapshot)) return result;
+		if (*a.snapshot.bytes != *b.snapshot.bytes) {
+			if (changed != candidate.sources.size()) return result;
+			changed = i;
+		}
+	}
+	result.reason = "Only one authoritative existing Resource filename value may change";
+	if (changed == candidate.sources.size()) return result;
+	const auto& before = *baseline.sources[changed].snapshot.bytes;
+	const auto& after = *candidate.sources[changed].snapshot.bytes;
+	// Find the one changed physical line once. Scanning from byte zero for
+	// every resource binding would multiply INI size by resource count.
+	size_t difference = 0, changedLine = 1;
+	while (difference < before.size() && difference < after.size() && before[difference] == after[difference]) {
+		if (before[difference] == '\n') ++changedLine;
+		++difference;
+	}
+	size_t oldBegin, oldEnd, newBegin, newEnd;
+	std::wstring oldValue, newValue;
+	if (!FilenameSpan(before, changedLine, oldBegin, oldEnd) ||
+		!FilenameSpan(after, changedLine, newBegin, newEnd) || oldBegin != newBegin ||
+		!Basename(before, oldBegin, oldEnd, oldValue) ||
+		!Basename(after, newBegin, newEnd, newValue) ||
+		!std::equal(before.begin(), before.begin() + oldBegin, after.begin()) ||
+		before.size() - oldEnd != after.size() - newEnd ||
+		!std::equal(before.begin() + oldEnd, before.end(), after.begin() + newEnd)) return result;
+	size_t matches = 0;
+	for (const auto& binding : bindings) {
+		if (binding.sourceIndex != changed || binding.line != changedLine || binding.resourceId.empty() ||
+			binding.sourcePath != baseline.sources[changed].snapshot.path ||
+			binding.preferredDirectory.empty() ||
+			(binding.preferredDirectory.back() != L'\\' && binding.preferredDirectory.back() != L'/')) continue;
+		// The parser must have used its preferred directory, never the fallback.
+		if (binding.resolvedFilename != binding.preferredDirectory + binding.originalValue) continue;
+		++matches;
+		result.binding = binding;
+		result.replacementValue = newValue;
+		result.replacementPath = binding.preferredDirectory + result.replacementValue;
+	}
+	if (matches != 1) return result;
+	result.valid = true;
+	result.manifest = candidate;
+	result.reason = "Validated single static buffer filename delta; runtime dependency admission required";
+	return result;
+} catch (const std::bad_alloc&) {
+	ResourceFilenamePatch failure;
+	failure.versions = versions;
+	failure.reason = "Filename refresh metadata CPU budget exhausted";
+	return failure;
+}
+ResourceFilenamePatch ReadResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const std::vector<ResourceFilenameBinding>& bindings, BuildVersions versions,
+	bool dependencyClosureVerified, const std::shared_ptr<ResourceRefreshCpuBudget>& budget,
+	std::shared_ptr<const void> metadataOwnership) {
+	ResourceFilenamePatch failure;
+	failure.versions = versions;
+	failure.reason = "Unable to capture a complete stable configuration source closure";
+	if (!budget || !baseline.verified || !dependencyClosureVerified || baseline.sources.empty() ||
+		baseline.sources.size() > 4096) return failure;
+	if (!budget->OwnsManifest(baseline)) {
+		failure.reason = "Filename refresh baseline lacks CPU budget ownership"; return failure;
+	}
+	if (!metadataOwnership) {
+		ResourceRefreshClosure closure; closure.verified = true;
+		metadataOwnership = ReserveResourceRefreshMetadata(*budget, baseline, bindings, closure);
+	}
+	if (!metadataOwnership) {
+		failure.reason = "Filename refresh metadata exceeds the reserved CPU budget"; return failure;
+	}
+	ConfigSourceManifest candidate;
+	candidate.verified = true;
+	budget->BindManifestOwnership(candidate, std::move(metadataOwnership));
+	candidate.sources.reserve(baseline.sources.size());
+	std::string error;
+	for (const auto& original : baseline.sources) {
+		if (!original.snapshot.bytes || original.snapshot.bytes->size() > size_t(16) * 1024 * 1024 - 200)
+			return failure;
+		ConfigSource source;
+		source.iniNamespace = original.iniNamespace;
+		// A supported filename is at most 200 ASCII bytes. Unsupported source
+		// growth is rejected by the stable-handle size check before allocation.
+		if (!budget->ReadSnapshot(original.snapshot.path, original.snapshot.bytes->size() + 200,
+			source.snapshot, error)) { failure.reason = error; return failure; }
+		if (source.snapshot.digest == original.snapshot.digest &&
+			*source.snapshot.bytes == *original.snapshot.bytes)
+			source.snapshot.bytes = original.snapshot.bytes; // share one charged owner
+		candidate.sources.push_back(std::move(source));
+	}
+	auto patch = BuildResourceFilenamePatch(baseline, candidate, bindings, versions, true);
+	if (!patch.valid) return patch;
+	for (const auto& source : candidate.sources) {
+		SourceSnapshot checked;
+		if (!budget->ReadSnapshot(source.snapshot.path, source.snapshot.bytes->size(), checked, error) ||
+			!checked.watchable || checked.digest != source.snapshot.digest || *checked.bytes != *source.snapshot.bytes)
+			{ failure.reason = error.empty() ? "Configuration changed during refresh verification" : error; return failure; }
+	}
+	return patch;
+}
+ResourceRefreshPin ResourceRefreshManager::Pin() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return active_;
+}
+ResourceRefreshPublishResult ResourceRefreshManager::Publish(ResourceRefreshPin candidate,
+	BuildVersions current, uint64_t legacyConfigEpoch, bool dependenciesReady) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!candidate || !candidate->id || !candidate->payload ||
+		!candidate->manifest.verified || candidate->manifest.sources.empty())
+		return ResourceRefreshPublishResult::InvalidCandidate;
+	for (const auto& source : candidate->manifest.sources)
+		if (!source.snapshot.watchable || !source.snapshot.bytes)
+			return ResourceRefreshPublishResult::InvalidCandidate;
+	if (!(candidate->versions == current) || !legacyConfigEpoch ||
+		candidate->legacyConfigEpoch != legacyConfigEpoch ||
+		(active_ && candidate->id <= active_->id)) return ResourceRefreshPublishResult::Stale;
+	if (!dependenciesReady) return ResourceRefreshPublishResult::DependenciesPending;
+	if (active_ && retired_.size() >= maxRetired_) return ResourceRefreshPublishResult::RetirementPending;
+	if (active_) retired_.push_back(active_);
+	active_ = std::move(candidate);
+	return ResourceRefreshPublishResult::Activated;
+}
+void ResourceRefreshManager::Clear() {
+	ResourceRefreshPin active;
+	std::vector<ResourceRefreshPin> retired;
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		active.swap(active_);
+		retired.swap(retired_);
+	}
+	// COM destruction can reenter runtime lifecycle callbacks.
+}
+size_t ResourceRefreshManager::Retire(const std::function<bool(uint64_t)>& gpuComplete) {
+	if (!gpuComplete) return 0;
+	std::vector<uint64_t> ids;
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		for (const auto& pin : retired_) if (pin.use_count() == 1) ids.push_back(pin->id);
+	}
+	std::vector<ResourceRefreshPin> release;
+	size_t count = 0;
+	for (const auto id : ids) {
+		if (!gpuComplete(id)) continue;
+		std::lock_guard<std::mutex> lock(mutex_);
+		for (auto it = retired_.begin(); it != retired_.end(); ++it) {
+			if ((*it)->id == id && it->use_count() == 1) {
+				release.push_back(std::move(*it));
+				retired_.erase(it); ++count;
+				break;
+			}
+		}
+	}
+	return count;
+}
+size_t ResourceRefreshManager::RetiredCount() const {
+	std::lock_guard<std::mutex> lock(mutex_);
+	return retired_.size();
+}
+}
diff --git a/DirectX11/ModLoading/ResourceRefresh.h b/DirectX11/ModLoading/ResourceRefresh.h
new file mode 100644
index 0000000000000000000000000000000000000000..ce1dcd44408c2425340b5ca019d2a2a2a710b259
--- /dev/null
+++ b/DirectX11/ModLoading/ResourceRefresh.h
@@ -0,0 +1,90 @@
+#pragma once
+#include "ConfigCompiler.h"
+#include "RefreshCpuBudget.h"
+#include <functional>
+#include <mutex>
+
+namespace ModLoading {
+// Captured from the actual legacy parser, never inferred from directory scans.
+// The first release supports a simple ASCII .buf basename in the preferred
+// namespace directory; legacy fallback-path changes are deliberately excluded.
+struct ResourceFilenameBinding {
+	size_t sourceIndex = 0, line = 0;
+	std::wstring sourcePath, resourceId, originalValue, resolvedFilename, preferredDirectory;
+};
+struct ResourceFilenamePatch {
+	bool valid = false;
+	std::string reason;
+	ResourceFilenameBinding binding;
+	std::wstring replacementValue, replacementPath;
+	ConfigSourceManifest manifest;
+	BuildVersions versions;
+};
+struct ResourceRefreshDirectory {
+	std::wstring path;
+	// Exact legacy enumeration: D:name for child directories, F:name for INIs.
+	// Non-INI asset filenames are excluded so preparing a new .buf is possible.
+	std::vector<std::wstring> entries;
+};
+struct ResourceRefreshClosure {
+	bool verified = false;
+	std::string reason;
+	std::vector<ResourceRefreshDirectory> directories;
+	// Proved absent optional inputs (e.g. a not-yet-created persistent INI).
+	std::vector<std::wstring> absentPaths;
+};
+bool IsResourceRefreshDirectoryWatchable(const std::wstring& path);
+bool ReadResourceRefreshDirectory(const std::wstring& path,
+	std::vector<std::wstring>& entries, std::string& error, size_t* remainingEntries = nullptr,
+	size_t maximumRetainedEntries = 65536);
+bool VerifyResourceRefreshClosure(const ResourceRefreshClosure& closure, std::string& error);
+// Reserve before copying a worker task. The conservative margin covers state,
+// task, verifier scratch, patch and generation metadata copies; manifest
+// ownership carries it through active/retired reader pins.
+std::shared_ptr<const void> ReserveResourceRefreshMetadata(ResourceRefreshCpuBudget& budget,
+	const ConfigSourceManifest& baseline, const std::vector<ResourceFilenameBinding>& bindings,
+	const ResourceRefreshClosure& closure);
+ResourceFilenamePatch BuildResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const ConfigSourceManifest& candidate, const std::vector<ResourceFilenameBinding>& bindings,
+	BuildVersions versions, bool dependencyClosureVerified);
+// Worker-only I/O helper. Reads precisely the captured source list, validates
+// the delta, then rechecks every source. Caller separately proves directory
+// membership/closure and checks its change ticket before enqueue/publication.
+ResourceFilenamePatch ReadResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const std::vector<ResourceFilenameBinding>& bindings, BuildVersions versions,
+	bool dependencyClosureVerified, const std::shared_ptr<ResourceRefreshCpuBudget>& budget,
+	std::shared_ptr<const void> metadataOwnership = {});
+ResourceFilenamePatch ReadResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const std::vector<ResourceFilenameBinding>& bindings, BuildVersions versions,
+	const ResourceRefreshClosure& closure, const std::shared_ptr<ResourceRefreshCpuBudget>& budget,
+	std::shared_ptr<const void> metadataOwnership = {});
+
+struct ResourceRefreshGeneration {
+	uint64_t id = 0, legacyConfigEpoch = 0;
+	BuildVersions versions;
+	ConfigSourceManifest manifest;
+	// Runtime owns a complete immutable lookup table and prepared resource owners.
+	std::shared_ptr<const void> payload;
+};
+using ResourceRefreshPin = std::shared_ptr<const ResourceRefreshGeneration>;
+enum class ResourceRefreshPublishResult { Activated, InvalidCandidate, Stale,
+	DependenciesPending, RetirementPending };
+// Explicit user action is enforced by the caller. Failed validation, watcher
+// cancellation and failed preparation never clear the last-good active pin.
+class ResourceRefreshManager {
+public:
+	explicit ResourceRefreshManager(size_t maxRetired = 8) : maxRetired_(maxRetired) {}
+	ResourceRefreshPin Pin() const;
+	ResourceRefreshPublishResult Publish(ResourceRefreshPin candidate,
+		BuildVersions current, uint64_t legacyConfigEpoch, bool dependenciesReady);
+	// Reserved for explicit legacy reload/device lifecycle invalidation.
+	void Clear();
+	size_t Retire(const std::function<bool(uint64_t)>& gpuComplete);
+	size_t RetiredCount() const;
+private:
+	mutable std::mutex mutex_;
+	ResourceRefreshPin active_;
+	std::vector<ResourceRefreshPin> retired_;
+	size_t maxRetired_;
+};
+}
diff --git a/DirectX11/ModLoading/ResourceRefreshClosure.cpp b/DirectX11/ModLoading/ResourceRefreshClosure.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6098aa288b4d77767fef88e9982999e844a8f8f8
--- /dev/null
+++ b/DirectX11/ModLoading/ResourceRefreshClosure.cpp
@@ -0,0 +1,210 @@
+#include "ResourceRefresh.h"
+#include <algorithm>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#else
+#include <sys/stat.h>
+#include <dirent.h>
+#include <cerrno>
+#include <codecvt>
+#include <locale>
+#endif
+
+namespace ModLoading {
+namespace {
+bool IniName(const std::wstring& name) {
+	if (name.size() < 4) return false;
+	auto extension = name.substr(name.size() - 4);
+	for (auto& c : extension) if (c >= L'A' && c <= L'Z') c += L'a' - L'A';
+	return extension == L".ini";
+}
+}
+bool IsResourceRefreshDirectoryWatchable(const std::wstring& path) {
+#ifdef _WIN32
+	std::vector<wchar_t> buffer(32768);
+	const DWORD count = GetFullPathNameW(path.c_str(), static_cast<DWORD>(buffer.size()), buffer.data(), nullptr);
+	if (!count || count >= buffer.size()) return false;
+	std::wstring full(buffer.data(), count);
+	while (full.size() > 3 && (full.back() == L'\\' || full.back() == L'/')) full.pop_back();
+	if (full.size() < 3 || full[1] != L':' || full.find(L':', 2) != std::wstring::npos) return false;
+	const DWORD longCount = GetLongPathNameW(full.c_str(), buffer.data(), static_cast<DWORD>(buffer.size()));
+	if (!longCount || longCount >= buffer.size() ||
+		CompareStringOrdinal(full.c_str(), static_cast<int>(full.size()), buffer.data(),
+			static_cast<int>(longCount), TRUE) != CSTR_EQUAL) return false;
+	// Directory notifications may use a distinct 8.3 spelling even when the
+	// watch and loaded source use long names. Exact dependency filters cannot
+	// prove identity until both spellings are tracked, including ancestors.
+	const DWORD shortCount = GetShortPathNameW(full.c_str(), buffer.data(), static_cast<DWORD>(buffer.size()));
+	if (!shortCount || shortCount >= buffer.size() ||
+		CompareStringOrdinal(full.c_str(), static_cast<int>(full.size()), buffer.data(),
+			static_cast<int>(shortCount), TRUE) != CSTR_EQUAL) return false;
+	for (size_t i = 3; i <= full.size(); ++i) {
+		if (i != full.size() && full[i] != L'\\' && full[i] != L'/') continue;
+		const DWORD attributes = GetFileAttributesW(full.substr(0, i).c_str());
+		if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY) ||
+			(attributes & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+	}
+	return true;
+#else
+	try {
+		const auto full = std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path);
+		if (full.empty() || full[0] != '/') return false;
+		for (size_t i = 1; i <= full.size(); ++i) {
+			if (i != full.size() && full[i] != '/') continue;
+			struct stat info{};
+			if (lstat(full.substr(0, i).c_str(), &info) || !S_ISDIR(info.st_mode)) return false;
+		}
+		return true;
+	} catch (...) { return false; }
+#endif
+}
+bool ReadResourceRefreshDirectory(const std::wstring& path,
+	std::vector<std::wstring>& entries, std::string& error, size_t* remainingEntries,
+	size_t maximumRetainedEntries) {
+	entries.clear();
+	error = "Recursive include directory is unavailable, aliased, or exceeds refresh bounds";
+	if (!IsResourceRefreshDirectoryWatchable(path)) return false;
+	bool valid = true;
+	size_t observed = 0;
+	size_t localRemaining = 65536;
+	if (!remainingEntries) remainingEntries = &localRemaining;
+#ifdef _WIN32
+	WIN32_FIND_DATAW data{};
+	const auto pattern = path + L"\\*";
+	HANDLE find = FindFirstFileW(pattern.c_str(), &data);
+	if (find == INVALID_HANDLE_VALUE) return false;
+	struct FindOwner { HANDLE handle; ~FindOwner() { FindClose(handle); } } owner{find};
+	do {
+		const std::wstring name(data.cFileName);
+		if (name == L"." || name == L"..") continue;
+		if (!*remainingEntries || ++observed > 65536 || (data.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) { valid = false; break; }
+		--*remainingEntries;
+		if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || IniName(name)) {
+			if (entries.size() >= maximumRetainedEntries) { valid = false; break; }
+			entries.push_back((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY ? L"D:" : L"F:") + name);
+		}
+	} while (FindNextFileW(find, &data));
+	if (valid && GetLastError() != ERROR_NO_MORE_FILES) valid = false;
+#else
+	try {
+		std::wstring_convert<std::codecvt_utf8<wchar_t>> converter;
+		const auto encoded = converter.to_bytes(path);
+		DIR* directory = opendir(encoded.c_str());
+		if (!directory) return false;
+		std::unique_ptr<DIR, int(*)(DIR*)> owner(directory, closedir);
+		for (;;) {
+			errno = 0;
+			dirent* entry = readdir(directory);
+			if (!entry) { if (errno) valid = false; break; }
+			const std::string name(entry->d_name);
+			if (name == "." || name == "..") continue;
+			struct stat info{};
+			if (!*remainingEntries || ++observed > 65536 || lstat((encoded + "/" + name).c_str(), &info) || S_ISLNK(info.st_mode)) {
+				valid = false; break;
+			}
+			--*remainingEntries;
+			const auto wide = converter.from_bytes(name);
+			if (S_ISDIR(info.st_mode) || IniName(wide)) {
+				if (entries.size() >= maximumRetainedEntries) { valid = false; break; }
+				entries.push_back((S_ISDIR(info.st_mode) ? L"D:" : L"F:") + wide);
+			}
+		}
+	} catch (...) { valid = false; }
+#endif
+	if (!valid || !IsResourceRefreshDirectoryWatchable(path)) { entries.clear(); return false; }
+	std::sort(entries.begin(), entries.end());
+	error.clear();
+	return true;
+}
+bool VerifyResourceRefreshClosure(const ResourceRefreshClosure& closure, std::string& error) {
+	error = closure.reason.empty() ? "Recursive include closure is unverified" : closure.reason;
+	if (!closure.verified || closure.directories.size() > 4096) return false;
+	if (closure.absentPaths.size() > 4096) return false;
+	for (const auto& path : closure.absentPaths) {
+#ifdef _WIN32
+		const DWORD attributes = GetFileAttributesW(path.c_str());
+		const DWORD code = attributes == INVALID_FILE_ATTRIBUTES ? GetLastError() : ERROR_SUCCESS;
+		if (attributes != INVALID_FILE_ATTRIBUTES || (code != ERROR_FILE_NOT_FOUND && code != ERROR_PATH_NOT_FOUND)) {
+			error = "Previously absent configuration input appeared or became unverifiable";
+			return false;
+		}
+#else
+		try {
+			const auto encoded = std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path);
+			struct stat info{};
+			if (!lstat(encoded.c_str(), &info) || (errno != ENOENT && errno != ENOTDIR)) {
+				error = "Previously absent configuration input appeared or became unverifiable";
+				return false;
+			}
+		} catch (...) { return false; }
+#endif
+	}
+	size_t count = 0;
+	size_t remainingEntries = 65536;
+	for (const auto& directory : closure.directories) {
+		count += directory.entries.size();
+		if (count > 65536) { error = "Recursive include closure exceeds refresh bounds"; return false; }
+		std::vector<std::wstring> entries;
+		if (!ReadResourceRefreshDirectory(directory.path, entries, error, &remainingEntries,
+			directory.entries.size())) return false;
+		if (entries != directory.entries) { error = "Recursive include directory membership changed; legacy reload required"; return false; }
+	}
+	error.clear();
+	return true;
+}
+std::shared_ptr<const void> ReserveResourceRefreshMetadata(ResourceRefreshCpuBudget& budget,
+	const ConfigSourceManifest& baseline, const std::vector<ResourceFilenameBinding>& bindings,
+	const ResourceRefreshClosure& closure) {
+	if (baseline.sources.size() > 4096 || bindings.size() > 65536 || closure.directories.size() > 4096 || closure.absentPaths.size() > 4096) return {};
+	// Fixed allowance covers simultaneous path API buffers, stable-reader
+	// scratch, small result objects and one new filename. Dynamic terms cover
+	// up to eight metadata copies plus vector/string capacity growth.
+	uint64_t bytes = 256 * 1024;
+	auto add = [&](uint64_t value) {
+		const auto capacity = budget.Capacity();
+		if (bytes > capacity || value > capacity - bytes) return false;
+		bytes += value; return true;
+	};
+	auto text = [&](const std::wstring& value) {
+		return value.size() <= 32768 && add(16 * (sizeof(std::wstring) + (value.size() + 1) * sizeof(wchar_t)));
+	};
+	for (const auto& path : closure.absentPaths) if (!text(path)) return {};
+	for (const auto& root : baseline.recursiveIncludes) if (!text(root)) return {};
+	if (!text(baseline.userConfig)) return {};
+	for (const auto& source : baseline.sources)
+		if (!add(16 * sizeof(ConfigSource)) || !text(source.snapshot.path) || !text(source.iniNamespace)) return {};
+	for (const auto& binding : bindings)
+		if (!add(16 * sizeof(ResourceFilenameBinding)) || !text(binding.sourcePath) ||
+			!text(binding.resourceId) || !text(binding.originalValue) || !text(binding.resolvedFilename) ||
+			!text(binding.preferredDirectory)) return {};
+	size_t count = 0;
+	for (const auto& directory : closure.directories) {
+		count += directory.entries.size();
+		if (count > 65536 || !text(directory.path) || !add(16 * sizeof(ResourceRefreshDirectory))) return {};
+		for (const auto& entry : directory.entries) {
+			// A changed filename may be longer than its baseline name. Reserve
+			// maximum filesystem-name storage before any worker enumeration.
+			if (entry.size() > 262 || !add(16 * (sizeof(std::wstring) + 263 * sizeof(wchar_t)))) return {};
+		}
+	}
+	return budget.TryReserve(bytes);
+}
+ResourceFilenamePatch ReadResourceFilenamePatch(const ConfigSourceManifest& baseline,
+	const std::vector<ResourceFilenameBinding>& bindings, BuildVersions versions,
+	const ResourceRefreshClosure& closure, const std::shared_ptr<ResourceRefreshCpuBudget>& budget,
+	std::shared_ptr<const void> metadataOwnership) {
+	ResourceFilenamePatch failure;
+	failure.versions = versions;
+	if (!budget) { failure.reason = "Filename refresh CPU budget unavailable"; return failure; }
+	if (!metadataOwnership) metadataOwnership = ReserveResourceRefreshMetadata(*budget, baseline, bindings, closure);
+	if (!metadataOwnership) { failure.reason = "Filename refresh metadata exceeds the reserved CPU budget"; return failure; }
+	if (!VerifyResourceRefreshClosure(closure, failure.reason)) return failure;
+	auto candidate = ReadResourceFilenamePatch(baseline, bindings, versions, true, budget, std::move(metadataOwnership));
+	if (!candidate.valid) return candidate;
+	if (!VerifyResourceRefreshClosure(closure, failure.reason)) return failure;
+	return candidate;
+}
+}
diff --git a/DirectX11/ModLoading/ResourceRefreshOverlay.cpp b/DirectX11/ModLoading/ResourceRefreshOverlay.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fdc9759f73b2846c533b021de9968ec9b62bcc35
--- /dev/null
+++ b/DirectX11/ModLoading/ResourceRefreshOverlay.cpp
@@ -0,0 +1,21 @@
+#include "ResourceRefreshOverlay.h"
+namespace ModLoading {
+void CaptureResourceRefreshDrawPin(ResourceRefreshDrawPin& draw, ResourceRefreshPin generation) {
+	if (draw.captured) return;
+	draw.generation = std::move(generation);
+	draw.captured = true;
+}
+void* ResolveResourceRefreshOverlay(const ResourceRefreshDrawPin& draw, const void* original,
+	const void* deviceIdentity, DeviceEpoch deviceEpoch, uint64_t legacyConfigEpoch) noexcept {
+	auto* fallback = const_cast<void*>(original);
+	if (!draw.captured || !draw.generation || !draw.generation->payload || !deviceEpoch ||
+		draw.generation->legacyConfigEpoch != legacyConfigEpoch ||
+		draw.generation->versions.device != deviceEpoch) return fallback;
+	const auto overlay = std::static_pointer_cast<const ResourceRefreshOverlay>(draw.generation->payload);
+	if (overlay->deviceIdentity != deviceIdentity || overlay->deviceEpoch != deviceEpoch ||
+		overlay->legacyConfigEpoch != legacyConfigEpoch) return fallback;
+	const auto replacement = overlay->replacements.find(original);
+	return replacement == overlay->replacements.end() || !replacement->second ?
+		fallback : replacement->second.get();
+}
+}
diff --git a/DirectX11/ModLoading/ResourceRefreshOverlay.h b/DirectX11/ModLoading/ResourceRefreshOverlay.h
new file mode 100644
index 0000000000000000000000000000000000000000..4cb127af8c62c3855dded4805a97ecc7f34e23b3
--- /dev/null
+++ b/DirectX11/ModLoading/ResourceRefreshOverlay.h
@@ -0,0 +1,33 @@
+#pragma once
+#include "ResourceRefresh.h"
+#include <map>
+#include <atomic>
+
+namespace ModLoading {
+// Complete immutable replacement owners. This payload belongs exclusively to
+// the Runtime's ResourceRefreshManager; arbitrary opaque manager payloads must
+// never be passed to this resolver.
+struct ResourceRefreshOverlay {
+	const void* deviceIdentity = nullptr;
+	DeviceEpoch deviceEpoch = 0;
+	uint64_t legacyConfigEpoch = 0;
+	std::map<const void*, std::shared_ptr<void>> replacements;
+};
+class ResourceRefreshActivationEdge {
+public:
+	void SetReady(uint64_t id) noexcept { ready_.store(id, std::memory_order_release); }
+	void Request() noexcept { requested_.store(ready_.load(std::memory_order_acquire), std::memory_order_release); }
+	uint64_t Consume() noexcept { return requested_.exchange(0, std::memory_order_acq_rel); }
+private:
+	std::atomic<uint64_t> ready_{0}, requested_{0};
+};
+struct ResourceRefreshDrawPin {
+	bool captured = false;
+	ResourceRefreshPin generation;
+};
+void CaptureResourceRefreshDrawPin(ResourceRefreshDrawPin& draw, ResourceRefreshPin generation);
+// No allocation, file I/O, hashing, or mutation. A captured null generation is
+// deliberately retained across every pre/post command and stage of the draw.
+void* ResolveResourceRefreshOverlay(const ResourceRefreshDrawPin& draw, const void* original,
+	const void* deviceIdentity, DeviceEpoch deviceEpoch, uint64_t legacyConfigEpoch) noexcept;
+}
