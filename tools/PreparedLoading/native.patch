+		bool WatchableMissingLookup(const std::wstring& path) {
+#ifdef _WIN32
+			if(path.size()<3||path[1]!=L':'||path.find(L':',2)!=std::wstring::npos)return false;
+			std::vector<wchar_t> buffer(32768);
+			for(size_t i=3;i<=path.size();++i){
+				if(i!=path.size()&&path[i]!=L'\\'&&path[i]!=L'/')continue;
+				auto part=path.substr(0,i);
+				DWORD attributes=GetFileAttributesW(part.c_str());
+				if(attributes==INVALID_FILE_ATTRIBUTES){
