+namespace {
+thread_local int legacyRetirementSlot = -1;
+#ifdef XXMI_MODLOADING_TESTS
+std::atomic<uint64_t> graphRetirementContextCalls{0}, graphRetirementDataCalls{0};
+#endif
+int ReserveGraphRetirement(ID3D11Device* device)
+{
+	auto& service = Services();
+	TryGlobalConfigGuard configGuard(device != nullptr);
+	std::unique_lock<std::recursive_mutex> ownerLock(service.plannerMutex, std::defer_lock);
+	if (device)
+		ownerLock.try_lock();
+	if (device && (!configGuard.acquired || !ownerLock.owns_lock() ||
+		(service.device == device && service.owner != std::thread::id() && service.owner != std::this_thread::get_id())))
+		return -1;
+	const bool singleThreaded = device && (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED);
+	int slot = -1;
+	{
+		std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+		for (size_t i = 0; i < service.graphRetirement.size(); ++i)
+			if (!service.graphRetirement[i].reserved) {
+				slot = int(i);
+				service.graphRetirement[i].reserved = true;
+				break;
+			}
+	}
+	if (slot < 0)
+		return -1;
+	std::shared_ptr<ConfigGenerationPin> deferredGraph;
+	try {
+		// A SINGLETHREADED graph may own GPU children whose final Release
+		// must stay on this owner. The slot retains it until both GPU and
+		// all other CPU owners have finished; ordinary devices dispose async.
+		deferredGraph = singleThreaded ? std::make_shared<ConfigGenerationPin>() : Disposal().Make<ConfigGenerationPin>();
+	} catch (...) {
+		CancelGraphRetirement(slot);
+		return -1;
+	}
+	ID3D11Query* query = nullptr;
+	D3D11_QUERY_DESC desc{D3D11_QUERY_EVENT, 0};
+	if (device && FAILED(device->CreateQuery(&desc, &query))) {
+		std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+		service.graphRetirement[slot].reserved = false;
+		return -1;
+	}
+	std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+	auto& entry = service.graphRetirement[slot];
+	entry.device = device;
+	entry.owner = std::this_thread::get_id();
+	entry.singleThreaded = singleThreaded;
+	entry.graph = std::move(deferredGraph);
+	if (query)
+		entry.query = std::shared_ptr<ID3D11Query>(query, [](ID3D11Query* p) { p->Release(); });
+	return slot;
+}
+void CancelGraphRetirement(int slot)
+{
+	if (slot < 0)
+		return;
+	RuntimeServices::GraphRetirement discarded;
+	{
+		auto& service = Services();
+		std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+		auto& entry = service.graphRetirement[slot];
+		// Only an empty, unsubmitted SINGLETHREADED reservation is cancellable.
+		// Its protecting pin must survive other CPU owners and the GPU fence;
+		// Poll is the sole release path once a retired graph has been attached.
+		if (entry.singleThreaded && (entry.owner != std::this_thread::get_id() ||
+			entry.submitted || (entry.graph && *entry.graph)))
+			return;
+		discarded = std::move(entry);
+		entry = {};
+	}
+}
+bool CompleteGraphRetirement(size_t slot, const std::shared_ptr<ConfigGenerationPin> &graph,
+	const std::shared_ptr<ID3D11Query> &query)
+{
+	RuntimeServices::GraphRetirement discarded;
+	{
+		auto &service = Services();
+		std::lock_guard<std::mutex> guard(service.graphRetirementMutex);
+		auto &entry = service.graphRetirement[slot];
+		// Another poll may have completed and reused this slot while the
+		// caller queried D3D. Only the captured reservation may be released.
+		if (!entry.reserved || !entry.submitted || entry.graph != graph || entry.query != query) return false;
+		if (entry.singleThreaded && (entry.owner != std::this_thread::get_id() ||
+			!entry.graph || !*entry.graph || entry.graph->use_count() != 1))
+			return false;
+		discarded = std::move(entry);
+		entry = {};
+	}
+	return true;
+}
+void SubmitGraphRetirement(int slot, ConfigGenerationPin previous)
+{
+	if (slot < 0)
+		return;
+	std::shared_ptr<ID3D11Query> query;
+	std::shared_ptr<ConfigGenerationPin> graph;
+	ID3D11Device* device = nullptr;
+	std::thread::id owner;
+	{
+		auto& service = Services();
+		std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+		auto& entry = service.graphRetirement[slot];
+		if (!*entry.graph)
+			*entry.graph = std::move(previous);
+		else if (*entry.graph != previous)
+			return;
+		// Do not even copy the wrapper/query onto a foreign thread: an owner
+		// poll could otherwise leave that temporary as their final COM owner.
+		if (entry.query && entry.owner != std::this_thread::get_id())
+			return;
+		query = entry.query;
+		graph = entry.graph;
+		device = entry.device;
+		owner = entry.owner;
+		if (!query && !device) {
+			entry.submitted = true;
+			return;
+		}
+	}
+	// The graph is retained even if submission cannot reach its device owner.
+	// An unsubmitted slot never authorizes retirement without an event proof.
+	if (!query || !device || owner != std::this_thread::get_id())
+		return;
+	TryGlobalConfigGuard configGuard;
+	auto& service = Services();
+	std::unique_lock<std::recursive_mutex> ownerLock(service.plannerMutex, std::try_to_lock);
+	if (!configGuard.acquired || !ownerLock.owns_lock())
+		return;
+	{
+		ID3D11DeviceContext* context = nullptr;
+#ifdef XXMI_MODLOADING_TESTS
+		++graphRetirementContextCalls;
+#endif
+		device->GetImmediateContext(&context);
+		if (context) {
+			context->End(query.get());
+			context->Release();
+		} else return; // Retain fail-closed: no unproved release.
+	}
+	std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+	auto& entry = service.graphRetirement[slot];
+	if (entry.graph == graph && entry.query == query && entry.owner == owner)
+		entry.submitted = true;
+}
+void PollGraphRetirement(ID3D11Device* currentDevice)
+{
+	if (runtimeBusy)
+		return;
+	auto& service = Services();
+	for (size_t i = 0; i < service.graphRetirement.size(); ++i) {
+		std::shared_ptr<ID3D11Query> query;
+		std::shared_ptr<ConfigGenerationPin> graph;
+		bool candidate = false;
+		ID3D11Device* owningDevice = nullptr;
+		{
+			std::lock_guard<std::mutex> lock(service.graphRetirementMutex);
+			const auto& entry = service.graphRetirement[i];
+			candidate = entry.reserved && entry.submitted && entry.graph && *entry.graph && entry.graph->use_count() == 1;
+			if (candidate && entry.query &&
+				(entry.device != currentDevice || entry.owner != std::this_thread::get_id()))
+				candidate = false;
+			if (candidate) {
+				query = entry.query;
+				graph = entry.graph;
+				owningDevice = entry.device;
+			}
+		}
+		if (!candidate)
+			continue;
+		bool complete = !query;
+		if (query && owningDevice) {
+			TryGlobalConfigGuard configGuard;
+			std::unique_lock<std::recursive_mutex> ownerLock(service.plannerMutex, std::try_to_lock);
+			if (!configGuard.acquired || !ownerLock.owns_lock())
+				continue;
+			ID3D11DeviceContext* context = nullptr;
+#ifdef XXMI_MODLOADING_TESTS
+			++graphRetirementContextCalls;
+#endif
+			owningDevice->GetImmediateContext(&context);
+			BOOL done = FALSE;
+			if (context) {
+#ifdef XXMI_MODLOADING_TESTS
+				++graphRetirementDataCalls;
+#endif
+				complete = context->GetData(query.get(), &done, sizeof(done), D3D11_ASYNC_GETDATA_DONOTFLUSH) == S_OK && done;
+				context->Release();
+			}
+			if (FAILED(owningDevice->GetDeviceRemovedReason())) complete = true;
+		}
+		if (complete)
+			CompleteGraphRetirement(i, graph, query);
+	}
+}
+}
+bool AdmitConfigurationRetirement(ID3D11Device* device)
+{
+	if (legacyRetirementSlot >= 0)
+		return true;
+	PollGraphRetirement(device);
+	legacyRetirementSlot = ReserveGraphRetirement(device);
+	return legacyRetirementSlot >= 0;
+}
+void CancelConfigurationRetirement()
+{
+	CancelGraphRetirement(legacyRetirementSlot);
+	legacyRetirementSlot = -1;
+}
+void RetainRetiredConfiguration(ConfigGenerationPin generation) {
+	SubmitGraphRetirement(legacyRetirementSlot, std::move(generation));
+	legacyRetirementSlot = -1;
+}
+void ObservePreparedResource(CustomResource* original, DrawCallInfo* draw) {
+	if (!original || !draw || runtimeBusy) return;
+	auto state = Current(); if (!state || !state->enabled.load()) return;
+	auto& service = Services();
+	std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+	if (!lock.owns_lock() || service.owner != std::this_thread::get_id()) return;
+	std::unique_lock<std::mutex> learningLock(state->generalMutex, std::try_to_lock);
+	if (!learningLock.owns_lock()) return;
+	const auto id = state->resourceIds.find(original);
+	if (id == state->resourceIds.end()) return;
+	if (!draw->preparation_usage_stamp) draw->preparation_usage_stamp = ++state->drawSerial;
+	state->workingSet.Observe(id->second, draw->preparation_usage_stamp, ++state->observationSerial);
+}
