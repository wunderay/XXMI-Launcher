+#!/usr/bin/env python3
+"""Portable reconciler/worker contract check; does not qualify Windows IO."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+with tempfile.TemporaryDirectory(prefix="xxmi-preparation-changes-") as build:
+    executable = Path(build) / "changes-test"
+    subprocess.run([
+        os.environ.get("CXX", "c++"), "-std=c++14", "-pthread", "-Wall", "-Wextra", "-Werror",
+        "-I" + str(ROOT / "DirectX11/ModLoading"),
+        str(ROOT / "DirectX11/ModLoading/ChangeReconciler.cpp"),
+        str(ROOT / "DirectX11/ModLoading/ChangeMonitor.cpp"),
+        str(Path(__file__).with_name("change_reconciler_test.cpp")), "-o", str(executable),
+    ], check=True)
+    subprocess.run([str(executable)], check=True)
+print("preparation_changes: portable state and worker checks passed")
