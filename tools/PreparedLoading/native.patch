diff --git a/tests/preparation_refresh/README.md b/tests/preparation_refresh/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..1c8f97c301f1a1a041e28be13307f0969d594452
--- /dev/null
+++ b/tests/preparation_refresh/README.md
@@ -0,0 +1,41 @@
+# Bounded resource filename refresh
+
+Run `bash tests/preparation_refresh/run.sh` for the portable C++14 policy and
+ownership checks. The tests cover exact whole-manifest comparison, authoritative
+filename locations, unsupported edits, repeated/reverted filename changes,
+version/epoch rejection, failure preserving the last-good generation, bounded
+retirement, and a reader retaining its generation across publication.
+Recursive include checks compare the INI names and child directories actually
+enumerated by the legacy parser with bounded worker scans before and after the
+candidate read. Adding a `.buf` is permitted; adding/removing/renaming an INI or
+directory is rejected. Conditional include preambles and aliased paths remain
+on the compatibility path. Every captured directory must also be watched so a
+change after candidate preparation invalidates its publication ticket.
+
+Refresh CPU ownership uses one service ledger across configuration reloads.
+Baseline, candidate, active and retired snapshot vectors carry shared leases;
+unchanged vectors are charged once. Reads reserve space before opening the
+stable snapshot and limit each source to its preceding size plus 200 bytes,
+the maximum admitted filename length. Final verification reads reserve their
+own scratch space. Conservative metadata reservations precede worker copies and
+remain attached to published manifests. Pressure rejects the replacement and
+keeps the last successful generation. Tests exercise oversized sources,
+verification-read pressure, shared ownership, accumulated retirement pressure
+and retained readers after a quota decrease.
+
+The supported change is one existing static VB/IB resource's simple ASCII `.buf`
+filename value. All other configuration bytes, source order and namespaces must
+remain identical. Runtime admission additionally proves the existing command
+dependency and complete GPU readiness. Parser provenance is captured while
+loading the original configuration; the policy does not reconstruct namespaces
+or key precedence from its diagnostic lexical IR.
+
+`[ModLoading] refresh_key` is an optional, separately assigned action with no
+default binding. It requests publication of the complete candidate ready at the
+time of the action. An action while preparation is incomplete does not authorize
+a later automatic activation. F10 retains the legacy save/reset/initialization
+path. Failed or unsupported candidate edits preserve the last successful refresh.
+
+These portable checks do not prove Windows rendering, parser integration, WARP
+lifetime behavior, game compatibility, or frame-time performance. Full arbitrary
+configuration linking and migration remain outside this bounded feature.
diff --git a/tests/preparation_refresh/main.cpp b/tests/preparation_refresh/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8529b048cf29e4aef6785fca6381ecbe1241da52
--- /dev/null
+++ b/tests/preparation_refresh/main.cpp
@@ -0,0 +1,349 @@
+#include "ResourceRefresh.h"
+#include "SnapshotIO.h"
+#include <cassert>
+#include <iostream>
+#include <thread>
+#include <atomic>
+#include <fstream>
+#include <cstdio>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#endif
+using namespace ModLoading;
+
+#ifdef _WIN32
+static void DirectoryShortAliasTest() {
+    wchar_t temporaryBase[MAX_PATH] = {}, uniqueFile[MAX_PATH] = {};
+    const DWORD count = GetTempPathW(MAX_PATH, temporaryBase);
+    if (!count || count >= MAX_PATH || !GetTempFileNameW(temporaryBase, L"xrf", 0, uniqueFile)) {
+        std::cout << "Directory 8.3 alias regression skipped: temporary path unavailable\n"; return;
+    }
+    DeleteFileW(uniqueFile);
+    const std::wstring directory = std::wstring(uniqueFile) + L"-refresh-long-directory";
+    if (!CreateDirectoryW(directory.c_str(), nullptr)) {
+        std::cout << "Directory 8.3 alias regression skipped: temporary directory unavailable\n"; return;
+    }
+    wchar_t alternate[32768] = {};
+    const DWORD alternateCount = GetShortPathNameW(directory.c_str(), alternate, 32768);
+    if (alternateCount && alternateCount < 32768 &&
+        CompareStringOrdinal(directory.c_str(), static_cast<int>(directory.size()),
+            alternate, static_cast<int>(alternateCount), TRUE) != CSTR_EQUAL) {
+        assert(!IsResourceRefreshDirectoryWatchable(directory));
+        assert(!IsResourceRefreshDirectoryWatchable(alternate));
+        std::cout << "Directory 8.3 alias regression passed\n";
+    } else {
+        std::cout << "Directory 8.3 alias regression skipped: no distinct alternate path\n";
+    }
+    assert(RemoveDirectoryW(directory.c_str()));
+}
+#endif
+
+static ConfigSource Source(const std::string& text, const std::wstring& path = L"/mods/a.ini") {
+    ConfigSource source;
+    source.snapshot.path = path;
+    source.snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(text.begin(), text.end());
+    source.snapshot.digest = HashBytes(source.snapshot.bytes->data(), source.snapshot.bytes->size());
+    source.iniNamespace = L"mods/a.ini";
+    return source;
+}
+static ConfigSourceManifest Manifest(const std::string& text) {
+    ConfigSourceManifest manifest;
+    manifest.verified = true;
+    manifest.sources = {Source(text), Source("[Constants]\nglobal persist $x = 1\n", L"/other.ini")};
+    return manifest;
+}
+static ResourceFilenameBinding Binding() {
+    ResourceFilenameBinding b;
+    b.sourceIndex = 0; b.line = 2; b.sourcePath = L"/mods/a.ini";
+    b.resourceId = L"resource\\mods\\vb"; b.originalValue = L"a.buf";
+    b.preferredDirectory = L"/mods/"; b.resolvedFilename = L"/mods/a.buf";
+    return b;
+}
+static ResourceRefreshPin MakeGeneration(uint64_t id, BuildVersions v, const ConfigSourceManifest& manifest) {
+    auto generation = std::make_shared<ResourceRefreshGeneration>();
+    generation->id = id; generation->versions = v; generation->legacyConfigEpoch = 7;
+    generation->manifest = manifest; generation->payload = std::make_shared<const int>(static_cast<int>(id));
+    return generation;
+}
+static void ManifestOwnershipTests() {
+    auto budget = std::make_shared<ResourceRefreshCpuBudget>(1024 * 1024);
+    auto make = [&] {
+        ConfigSourceManifest manifest;
+        budget->BindManifestOwnership(manifest, budget->TryReserve(65536));
+        ConfigSource source;
+        source.snapshot.bytes = std::shared_ptr<const std::vector<uint8_t>>(
+            new std::vector<uint8_t>(32), [budget](const std::vector<uint8_t>* bytes) {
+                // This source deliberately has no byte reservation: metadata's
+                // own lease must still be live during storage destruction.
+                assert(budget->Used() >= 65536);
+                delete bytes;
+            });
+        manifest.sources.push_back(std::move(source));
+        return manifest;
+    };
+    {
+        auto original = make();
+        const auto used = budget->Used();
+        auto copy = original;
+        assert(budget->Used() == used + original.MetadataBytes());
+        assert(copy.sources.data() != original.sources.data());
+        assert(copy.sources[0].snapshot.bytes == original.sources[0].snapshot.bytes);
+        ConfigSourceManifest assigned;
+        assigned = original;
+        assert(budget->Used() == used + 2 * original.MetadataBytes());
+        budget->SetCapacity(budget->Used());
+        const auto bytes = assigned.sources[0].snapshot.bytes;
+        bool refused = false;
+        try { assigned = original; } catch (const std::bad_alloc&) { refused = true; }
+        assert(refused && assigned.sources[0].snapshot.bytes == bytes);
+        refused = false;
+        try { ConfigSourceManifest rejected(original); } catch (const std::bad_alloc&) { refused = true; }
+        assert(refused);
+    }
+    assert(budget->Used() == 0);
+    budget->SetCapacity(1024 * 1024);
+    // Move assignment must finish destroying the old metadata before its lease
+    // is returned, just as normal destruction does.
+    auto destination = make();
+    destination = ConfigSourceManifest{};
+    assert(budget->Used() == 0);
+}
+static void CpuBudgetTests(const std::string& path) {
+    const BuildVersions versions{1, 2, 3};
+    auto budget = std::make_shared<ResourceRefreshCpuBudget>(1024 * 1024);
+    auto text = [](const std::string& filename) {
+        return "[ResourceVB]\nfilename = " + filename + "\nstride = 12\n;" + std::string(96 * 1024, 'x') + "\n";
+    };
+    auto write = [&](const std::string& filename) {
+        std::ofstream file(path, std::ios::binary | std::ios::trunc);
+        file << text(filename); assert(file.good());
+    };
+    ConfigSourceManifest baseline;
+    baseline.verified = true;
+    baseline.sources.push_back(Source(text("a.buf"), std::wstring(path.begin(), path.end())));
+    auto binding = Binding(); binding.sourcePath = baseline.sources[0].snapshot.path;
+    const std::vector<ResourceFilenameBinding> bindings{binding};
+    assert(!ReadResourceFilenamePatch(baseline, bindings, versions, true, budget).valid);
+    assert(budget->ChargeManifest(baseline));
+    assert(budget->OwnsManifest(baseline));
+    const auto baselineCharge = budget->Used();
+    assert(baselineCharge > baseline.sources[0].snapshot.bytes->size());
+    // A second manifest owns metadata, but aliases the same charged byte vector.
+    {
+        auto duplicate = baseline;
+        assert(budget->ChargeManifest(duplicate));
+        assert(duplicate.sources[0].snapshot.bytes.get() == baseline.sources[0].snapshot.bytes.get());
+        assert(budget->Used() - baselineCharge < baseline.sources[0].snapshot.bytes->size());
+    }
+    assert(budget->Used() == baselineCharge);
+    ResourceRefreshClosure closure; closure.verified = true;
+    auto metadata = ReserveResourceRefreshMetadata(*budget, baseline, bindings, closure);
+    assert(metadata);
+    const auto taskCharge = budget->Used();
+    // Reject an unsupported oversized candidate using stable-handle file size,
+    // before its contents can allocate beyond the old-size + filename bound.
+    {
+        std::ofstream oversized(path, std::ios::binary | std::ios::trunc);
+        oversized.seekp(8 * 1024 * 1024); oversized.put('\n');
+    }
+    auto rejected = ReadResourceFilenamePatch(baseline, bindings, versions, closure, budget, metadata);
+    assert(!rejected.valid && rejected.reason == "source exceeds budget");
+    assert(budget->Used() == taskCharge);
+    write("b.buf");
+    // Admit the candidate's first capture, but leave too little for its final
+    // stable recheck. Failure releases both bytes and retains the baseline.
+    budget->SetCapacity(taskCharge + baseline.sources[0].snapshot.bytes->size() + 4096);
+    rejected = ReadResourceFilenamePatch(baseline, bindings, versions, closure, budget, metadata);
+    assert(!rejected.valid && rejected.reason.find("CPU budget") != std::string::npos);
+    assert(budget->Used() == taskCharge);
+    budget->SetCapacity(1024 * 1024);
+    metadata.reset();
+    assert(budget->Used() == baselineCharge);
+    ResourceRefreshManager manager(8);
+    assert(manager.Publish(MakeGeneration(1, versions, baseline), versions, 7, true) == ResourceRefreshPublishResult::Activated);
+    size_t accepted = 0;
+    bool pressure = false;
+    for (uint64_t id = 2; id < 10; ++id) {
+        const auto lastGood = manager.Pin();
+        write("v" + std::to_string(id) + ".buf");
+        const auto candidate = ReadResourceFilenamePatch(lastGood->manifest, bindings, versions, closure, budget);
+        if (!candidate.valid) {
+            pressure = true;
+            assert(manager.Pin() == lastGood);
+            break;
+        }
+        assert(manager.Publish(MakeGeneration(id, versions, candidate.manifest), versions, 7, true) == ResourceRefreshPublishResult::Activated);
+        ++accepted;
+        assert(budget->Used() <= budget->Capacity());
+    }
+    assert(accepted && pressure && manager.RetiredCount());
+    auto held = manager.Pin();
+    manager.Clear();
+    assert(budget->Used() > baselineCharge);
+    // Changing the configuration budget never invalidates an old reader pin.
+    budget->SetCapacity(1);
+    assert(!budget->TryReserve(1) && held->manifest.sources[0].snapshot.bytes);
+    held.reset();
+    assert(budget->Used() == baselineCharge);
+    baseline = ConfigSourceManifest{};
+    assert(budget->Used() == 0);
+    std::remove(path.c_str());
+}
+int main(int argc, char** argv) {
+    ManifestOwnershipTests();
+#ifdef _WIN32
+    DirectoryShortAliasTest();
+#endif
+    const auto base = Manifest("[ResourceVB]\nfilename = a.buf\nstride = 12\n");
+    const auto next = Manifest("[ResourceVB]\nfilename = longer.buf\nstride = 12\n");
+    const BuildVersions versions{1, 2, 3};
+    const std::vector<ResourceFilenameBinding> bindings{Binding()};
+    auto build = [&](const ConfigSourceManifest& candidate, bool closure = true) {
+        return BuildResourceFilenamePatch(base, candidate, bindings, versions, closure);
+    };
+    auto patch = build(next);
+    assert(patch.valid && patch.replacementPath == L"/mods/longer.buf");
+    assert(patch.versions == versions && patch.manifest.sources.size() == 2);
+    assert(!build(base).valid && !build(next, false).valid);
+    auto bad = next; bad.verified = false; assert(!build(bad).valid);
+    bad = next; bad.sources[0].snapshot.digest[0] ^= 1; assert(!build(bad).valid);
+    bad = next; bad.sources[0].snapshot.watchable = false; assert(!build(bad).valid);
+    auto aliasedBase = base; aliasedBase.sources[0].snapshot.watchable = false;
+    assert(!BuildResourceFilenamePatch(aliasedBase, next, bindings, versions, true).valid);
+    bad = next; bad.sources[0].iniNamespace = L"other"; assert(!build(bad).valid);
+    bad = next; bad.sources[0].snapshot.path = L"/moved.ini"; assert(!build(bad).valid);
+    bad = next; bad.sources.push_back(Source("[ResourceAdded]\n")); assert(!build(bad).valid);
+    bad = next; bad.sources[1] = Source("[Constants]\nglobal persist $x = 2\n", L"/other.ini");
+    assert(!build(bad).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = b.buf\nstride = 24\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename=b.buf\nstride = 12\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = b.buf\nstride = 12\n; new comment\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = ../b.buf\nstride = 12\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = image.dds\nstride = 12\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = b.buf; comment\nstride = 12\n")).valid);
+    assert(!build(Manifest("[ResourceVB]\nfilename = b\n.buf\nstride = 12\n")).valid);
+    auto duplicate = bindings; duplicate.push_back(Binding());
+    assert(!BuildResourceFilenamePatch(base, next, duplicate, versions, true).valid);
+    auto fallback = bindings; fallback[0].resolvedFilename = L"/root/a.buf";
+    assert(!BuildResourceFilenamePatch(base, next, fallback, versions, true).valid);
+    auto wrongLine = bindings; wrongLine[0].line = 3;
+    assert(!BuildResourceFilenamePatch(base, next, wrongLine, versions, true).valid);
+    const auto third = Manifest("[ResourceVB]\nfilename = c.buf\nstride = 12\n");
+    assert(BuildResourceFilenamePatch(next, third, bindings, versions, true).valid);
+    assert(BuildResourceFilenamePatch(third, base, bindings, versions, true).valid);
+    const auto crlf = Manifest("\xef\xbb\xbf[ResourceVB]\r\n\tFILENAME = a.buf \t\r\nstride = 12\r\n");
+    const auto crlfNext = Manifest("\xef\xbb\xbf[ResourceVB]\r\n\tFILENAME = B.BUF \t\r\nstride = 12\r\n");
+    assert(BuildResourceFilenamePatch(crlf, crlfNext, bindings, versions, true).valid);
+
+    ResourceRefreshManager manager(1);
+    using R = ResourceRefreshPublishResult;
+    assert(manager.Publish({}, versions, 7, true) == R::InvalidCandidate);
+    auto first = MakeGeneration(1, versions, base);
+    assert(manager.Publish(first, versions, 7, true) == R::Activated);
+    auto pin = manager.Pin();
+    auto second = MakeGeneration(2, versions, next);
+    assert(manager.Publish(second, versions, 7, false) == R::DependenciesPending);
+    assert(manager.Pin() == first);
+    assert(manager.Publish(second, BuildVersions{2,2,3}, 7, true) == R::Stale);
+    assert(manager.Publish(second, versions, 8, true) == R::Stale);
+    assert(manager.Publish(second, versions, 7, true) == R::Activated);
+    assert(*std::static_pointer_cast<const int>(pin->payload) == 1);
+    assert(*std::static_pointer_cast<const int>(manager.Pin()->payload) == 2);
+    assert(manager.Publish(MakeGeneration(3, versions, third), versions, 7, true) == R::RetirementPending);
+    assert(manager.Retire([](uint64_t) { return true; }) == 0);
+    first.reset(); pin.reset();
+    assert(manager.Retire([](uint64_t) { return false; }) == 0);
+    assert(manager.Retire([&](uint64_t id) { assert(manager.Pin()->id == 2); return id == 1; }) == 1);
+    assert(manager.Publish(second, versions, 7, true) == R::Stale);
+    // Reader owns one immutable complete payload while publication proceeds.
+    std::atomic<bool> captured{false}, published{false};
+    std::thread reader([&] {
+        const auto held = manager.Pin(); captured.store(true);
+        while (!published.load()) std::this_thread::yield();
+        assert(held->id == 2 && *std::static_pointer_cast<const int>(held->payload) == 2);
+    });
+    while (!captured.load()) std::this_thread::yield();
+    assert(manager.Publish(MakeGeneration(3, versions, third), versions, 7, true) == R::Activated);
+    published.store(true); reader.join();
+    auto finalPin = manager.Pin();
+    manager.Clear();
+    assert(!manager.Pin() && finalPin->id == 3);
+    bool destroyed = false;
+    auto reentrant = std::make_shared<ResourceRefreshGeneration>();
+    reentrant->id = 4; reentrant->legacyConfigEpoch = 7; reentrant->versions = versions;
+    reentrant->manifest = base;
+    reentrant->payload = std::shared_ptr<const void>(new int(4), [&](const void* p) {
+        assert(!manager.Pin()); destroyed = true; delete static_cast<const int*>(p);
+    });
+    assert(manager.Publish(reentrant, versions, 7, true) == R::Activated);
+    reentrant.reset(); manager.Clear(); assert(destroyed);
+    if (argc >= 2) {
+        const std::string path = std::string(argv[1]) + ".ini";
+        const std::string other = std::string(argv[1]) + "-other.ini";
+        auto capturedManifest = base;
+        capturedManifest.sources[0].snapshot.path.assign(path.begin(), path.end());
+        capturedManifest.sources[1].snapshot.path.assign(other.begin(), other.end());
+        auto diskBindings = bindings;
+        diskBindings[0].sourcePath = capturedManifest.sources[0].snapshot.path;
+        auto diskBudget = std::make_shared<ResourceRefreshCpuBudget>(1024 * 1024);
+        assert(diskBudget->ChargeManifest(capturedManifest));
+        auto write = [](const std::string& p, const ConfigSource& source) {
+            std::ofstream file(p, std::ios::binary | std::ios::trunc);
+            file.write(reinterpret_cast<const char*>(source.snapshot.bytes->data()), source.snapshot.bytes->size());
+            assert(file.good());
+        };
+        write(path, next.sources[0]); write(other, base.sources[1]);
+        assert(ReadResourceFilenamePatch(capturedManifest, diskBindings, versions, true, diskBudget).valid);
+        assert(!ReadResourceFilenamePatch(capturedManifest, diskBindings, versions, false, diskBudget).valid);
+        write(other, Source("[Constants]\nglobal persist $x = 9\n"));
+        assert(!ReadResourceFilenamePatch(capturedManifest, diskBindings, versions, true, diskBudget).valid);
+        std::remove(path.c_str()); std::remove(other.c_str());
+        assert(!ReadResourceFilenamePatch(capturedManifest, diskBindings, versions, true, diskBudget).valid);
+        CpuBudgetTests(std::string(argv[1]) + "-budget.ini");
+    }
+    if (argc >= 3) {
+        const std::string directory(argv[2]);
+        const std::string kept = directory + "/kept.ini";
+        const std::string added = directory + "/new.ini";
+        const std::string asset = directory + "/new.buf";
+        std::remove(added.c_str()); std::remove(asset.c_str());
+        { std::ofstream file(kept); file << "[ResourceUnused]\n"; }
+        ResourceRefreshClosure closure;
+        closure.verified = true;
+        ResourceRefreshDirectory capturedDirectory;
+        capturedDirectory.path.assign(directory.begin(), directory.end());
+        std::string error;
+        assert(ReadResourceRefreshDirectory(capturedDirectory.path, capturedDirectory.entries, error));
+        assert(capturedDirectory.entries == std::vector<std::wstring>({L"D:nested", L"F:kept.ini"}));
+        closure.directories.push_back(capturedDirectory);
+        assert(VerifyResourceRefreshClosure(closure, error));
+        { std::ofstream file(asset); file << "candidate buffer"; }
+        assert(VerifyResourceRefreshClosure(closure, error));
+        // Absence must be captured at the original persistent-file decision.
+        // A later directory snapshot that already contains the new file must
+        // never legitimize a candidate whose parser omitted that file.
+        ResourceRefreshClosure absent;
+        absent.verified = true;
+        absent.absentPaths.push_back(std::wstring(added.begin(), added.end()));
+        assert(VerifyResourceRefreshClosure(absent, error));
+        { std::ofstream file(added); file << "[ResourceNew]\n"; }
+        ResourceRefreshDirectory afterCreation;
+        afterCreation.path = capturedDirectory.path;
+        assert(ReadResourceRefreshDirectory(afterCreation.path, afterCreation.entries, error));
+        absent.directories.push_back(afterCreation);
+        assert(!VerifyResourceRefreshClosure(absent, error));
+        assert(!VerifyResourceRefreshClosure(closure, error) && !error.empty());
+        std::remove(added.c_str());
+        assert(std::rename((directory + "/nested").c_str(), (directory + "/renamed").c_str()) == 0);
+        assert(!VerifyResourceRefreshClosure(closure, error));
+        assert(std::rename((directory + "/renamed").c_str(), (directory + "/nested").c_str()) == 0);
+        assert(VerifyResourceRefreshClosure(closure, error));
+        closure.verified = false; closure.reason = "Conditional include preambles require legacy reload";
+        assert(!VerifyResourceRefreshClosure(closure, error) && error == closure.reason);
+        std::remove(kept.c_str()); std::remove(asset.c_str());
+    }
+    std::cout << "Resource filename delta, last-good publication, stale tokens and reader ownership passed\n";
+}
