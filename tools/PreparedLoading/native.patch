+        // before proving a later file event comes from the new directory handle.
+        std::this_thread::sleep_for(std::chrono::milliseconds(1300)); queue->Quiet();
+        before = queue->Count(); Write(asset, "NEW!");
+        queue->WaitAfter(before, "create in replacement root"); queue->Quiet();
+        request = queue->Latest(); Require(monitor.IsCurrent(request.token), "replacement token current");
+        before = queue->Count(); Write(old + L"\\retired.bin", "OLD!");
+        std::this_thread::sleep_for(std::chrono::milliseconds(700));
