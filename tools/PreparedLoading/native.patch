diff --git a/DirectX11/ModLoading/GenerationManager.cpp b/DirectX11/ModLoading/GenerationManager.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..16e4800d7417bc429ed2d175454e4a03cfc089ae
--- /dev/null
+++ b/DirectX11/ModLoading/GenerationManager.cpp
@@ -0,0 +1,55 @@
+#include "GenerationManager.h"
+
+namespace ModLoading {
+GenerationPin GenerationManager::Pin() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return active_;
+}
+bool GenerationManager::Stage(GenerationPin candidate, BuildVersions current) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!candidate || !candidate->id || !candidate->config ||
+        !(candidate->versions == current) ||
+        (prepared_ && candidate->id < prepared_->id)) return false;
+    prepared_ = std::move(candidate);
+    return true;
+}
+GenerationPin GenerationManager::PreparedPin() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return prepared_;
+}
+void GenerationManager::CancelPrepared() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    prepared_.reset();
+}
+PublishResult GenerationManager::Publish(GenerationPin candidate, BuildVersions current,
+    bool safeBoundary, bool dependenciesReady) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!candidate || !candidate->id || !candidate->config ||
+        !candidate->config->manifest.verified ||
+        candidate->config->disposition != ConfigDisposition::AssetOnly)
+        return PublishResult::InvalidCandidate;
+    if (!(candidate->versions == current) || !(candidate->config->versions == current) ||
+        (active_ && candidate->id <= active_->id))
+        return PublishResult::Stale;
+    if (!safeBoundary) return PublishResult::UnsafeBoundary;
+    if (!dependenciesReady) return PublishResult::DependenciesPending;
+    if (active_ && retired_.size() >= maxRetired_) return PublishResult::RetirementPending;
+    if (active_) retired_.push_back(active_);
+    active_ = std::move(candidate);
+    return PublishResult::Activated;
+}
+size_t GenerationManager::Retire(const std::function<bool(Generation)>& gpuComplete) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t count = 0;
+    for (auto it = retired_.begin(); it != retired_.end();) {
+        if (it->use_count() == 1 && gpuComplete && gpuComplete((*it)->id)) {
+            it = retired_.erase(it); ++count;
+        } else ++it;
+    }
+    return count;
+}
+size_t GenerationManager::RetiredCount() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return retired_.size();
+}
+}
