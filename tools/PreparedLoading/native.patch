+namespace ModLoading {
+namespace {
+constexpr uint64_t MiB = 1024ull * 1024;
+struct ProfileEntry {
+    bool staticCompatibility = false, compatibility = false, cpuReady = false;
+    Generation generation = 0;
+    DeviceEpoch epoch = 0;
+    std::shared_ptr<const PreparedAsset> source;
+    std::weak_ptr<PreparedGpuObject> pinnedGpu;
+    std::weak_ptr<PreparedGpuObject> observedGpu;
+    DeviceResourceKey key;
+    std::string reason;
+};
+struct RuntimeState {
+    PreparationMode mode = PreparationMode::Off;
+    std::atomic<bool> enabled{false};
+    std::atomic<Generation> generation{0};
+    PreparationLimits cpuLimits;
+    GpuPumpLimits gpuLimits;
+    uint64_t gpuBytes = 256 * MiB, shaderBytes = 0;
+    uint64_t totalAssets = 0, baseCompatibility = 0;
+    std::map<const void*, ProfileEntry> profile;
+    bool loadingWindow = false;
+    std::shared_ptr<PreparationScheduler> scheduler;
+    std::unique_ptr<ChangeMonitor> monitor;
+    std::vector<std::wstring> files;
+    std::vector<CustomResource*> resources;
+    size_t resourceCursor = 0;
+    std::vector<CustomShader*> shaders;
+    size_t shaderCursor = 0;
+    std::mutex pendingMutex;
+    ReconcileRequest pending;
+    bool hasPending = false;
+    std::atomic<uint64_t> sourceToken{0};
+    size_t cursor = 0;
+    std::shared_ptr<const CompiledConfig> config;
+    GenerationManager generations;
+    ~RuntimeState() { if (monitor) monitor->Stop(); }
+};
+// The DLL's process-lifetime services deliberately have no static destructors
+// that join Windows workers while DllMain holds the loader lock.
+struct RuntimeServices {
+    std::shared_ptr<RuntimeState> state;
+    std::atomic<Generation> nextGeneration{0};
+    std::shared_ptr<PreparationScheduler> scheduler;
+    bool modulePinned = false;
+    std::unique_ptr<PreparationPlanner> planner;
+    ID3D11Device* device = nullptr;
+    DeviceEpoch epoch = 0;
+    std::thread::id owner;
+    Generation plannerGeneration = 0;
+    IncrementalConfigCache configCache;
+    std::recursive_mutex plannerMutex;
+    std::atomic<bool> retirementRequested{false};
+    std::map<ID3D11Resource*, std::weak_ptr<PreparedGpuObject>> activeResources;
+    // Strong speculative profile leases share the planner's retirement lock.
+    // Config/profile entries hold weak references, so device teardown drops all
+    // unconsumed GPU owners without touching the raw configuration graph.
+    std::map<const void*, std::shared_ptr<PreparedGpuObject>> profileGpuPins;
+};
+RuntimeServices& Services() { static auto* s = new RuntimeServices; return *s; }
+std::shared_ptr<RuntimeState> Current() { return std::atomic_load(&Services().state); }
+thread_local bool runtimeBusy = false;
+thread_local bool retiringDevice = false;
+struct TryGlobalConfigGuard {
+    bool acquired;
+    TryGlobalConfigGuard() : acquired(TryEnterCriticalSection(&G->mCriticalSection) != FALSE) {}
+    ~TryGlobalConfigGuard() { if (acquired) LeaveCriticalSection(&G->mCriticalSection); }
+};
+struct RuntimeOwnerScope {
+    std::unique_lock<std::recursive_mutex>& lock;
+    explicit RuntimeOwnerScope(std::unique_lock<std::recursive_mutex>& held) : lock(held) { runtimeBusy = true; }
+    ~RuntimeOwnerScope() {
+        runtimeBusy = false;
+        auto& service = Services();
+        if (service.retirementRequested.exchange(false)) {
+            InvalidatePreparationStatus();
+            // Resource destructors may call wrapped device Release recursively.
+            retiringDevice = true;
+            service.activeResources.clear();
+            service.profileGpuPins.clear();
+            auto retired = std::move(service.planner);
+            service.device = nullptr; service.epoch = 0; service.plannerGeneration = 0;
+            retired.reset();
+            retiringDevice = false;
+        }
+        // A foreign Release may request retirement after the final exchange
+        // but before mutex unlock. Requests are stored before try_lock, so
+        // checking again after unlock closes that handoff window.
+        ID3D11Device* const device = service.device;
+        lock.unlock();
+        if (service.retirementRequested.load()) RetireRuntimeDevice(device);
+    }
+};
+int Setting(const wchar_t* key, int fallback, int low, int high) {
+    return (std::max)(low, (std::min)(high, GetIniInt(L"ModLoading", key, fallback, nullptr)));
+}
+std::wstring Canonical(const std::wstring& path) {
+    if (path.empty()) return {};
+    const DWORD length = GetFullPathNameW(path.c_str(), 0, nullptr, nullptr);
+    if (!length || length > 32767) return {};
+    std::vector<wchar_t> full(length);
+    const DWORD written = GetFullPathNameW(path.c_str(), length, full.data(), nullptr);
+    if (!written || written >= length) return {};
+    return std::wstring(full.data(), written);
+}
+std::wstring Parent(const std::wstring& path) {
+    const auto slash = path.find_last_of(L"\\/");
+    return slash == std::wstring::npos ? std::wstring() : path.substr(0, slash + 1);
+}
+bool IsBuffer(const CustomResource& resource) {
+    return resource.override_type == CustomResourceType::BUFFER ||
+        resource.override_type == CustomResourceType::STRUCTURED_BUFFER ||
+        resource.override_type == CustomResourceType::RAW_BUFFER;
+}
+bool IsDDS(const std::wstring& path) {
+    const auto dot = path.find_last_of(L'.');
+    return dot != std::wstring::npos && !_wcsicmp(path.c_str() + dot, L".dds");
+}
+DXGI_FORMAT SRGB(DXGI_FORMAT format) {
+    switch (format) {
+    case DXGI_FORMAT_R8G8B8A8_UNORM: return DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    case DXGI_FORMAT_B8G8R8A8_UNORM: return DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+    case DXGI_FORMAT_B8G8R8X8_UNORM: return DXGI_FORMAT_B8G8R8X8_UNORM_SRGB;
+    default: return format;
+    }
+}
+// This strict subset matches DirectXTK's no-context, no-resize WIC path.
+// Feature-level scaling, format conversion and uncommon decoder output use
+// the exact encoded-memory loader instead.
+bool UseDecoded(const PreparedAsset& asset, ID3D11Device* device,
+    const CustomResource& target, GpuPreparationRequest& request) {
+    if (!asset.decoded || !asset.decoded->pixels || !device) return false;
+    const auto& image = *asset.decoded;
+    if (!image.width || !image.height || image.decoderVersion != 1) return false;
+    UINT maximum = device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_11_0 ? 16384 :
+        device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_10_0 ? 8192 :
+        device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_9_3 ? 4096 : 2048;
+    if (image.width > maximum || image.height > maximum) return false;
+    DXGI_FORMAT format = static_cast<DXGI_FORMAT>(image.format);
+    const auto flags = PreparedWICFlags(*asset.snapshot.bytes,
+        target.override_color_space, G->gForceDetectColorSpace);
+    if ((flags & DirectX::WIC_LOADER_FORCE_SRGB) ||
+        (!(flags & DirectX::WIC_LOADER_IGNORE_SRGB) && image.metadataSRGB))
+        format = SRGB(format);
+    UINT support = 0;
+    if (FAILED(device->CheckFormatSupport(format, &support)) ||
+        !(support & D3D11_FORMAT_SUPPORT_TEXTURE2D)) return false;
+    if (request.loaderMiscFlags || request.loaderBindFlags != D3D11_BIND_SHADER_RESOURCE)
+        return false;
+    request.kind = GpuPreparationKind::Texture2D;
+    request.snapshot.bytes = image.pixels;
+    request.texture.Width = image.width;
+    request.texture.Height = image.height;
+    request.texture.MipLevels = request.texture.ArraySize = 1;
+    request.texture.Format = format;
+    request.texture.SampleDesc.Count = 1;
+    request.texture.Usage = D3D11_USAGE_DEFAULT;
+    request.texture.BindFlags = request.loaderBindFlags;
+    request.subresources.push_back({0, image.pixels->size(), image.rowPitch,
+        static_cast<UINT>(image.pixels->size())});
+    request.estimatedBytes = image.pixels->size() + 64 * 1024;
+    request.creationOptions.insert(request.creationOptions.end(), {image.decoderVersion,
+        image.width, image.height, image.rowPitch, image.format, flags});
+    return true;
+}
+bool RequestFor(CustomResource& resource, const PreparedAsset& asset,
+    ID3D11Device* device, GpuPreparationRequest& request) {
+    if (!resource.PreparationReadOnly() || resource.filename.empty() ||
+        !asset.snapshot.bytes || asset.snapshot.bytes->empty()) return false;
+    request.snapshot = asset.snapshot;
+    request.dependencyReadOnly = true;
+    // No custom NVAPI stereo mode is applied by CustomResource::Substantiate.
+    // Preparation uses exactly that default creation policy under its lock.
+    request.creationOptions = {RuntimeFeatureVersion, 0};
+    if (IsBuffer(resource)) {
+        if (asset.snapshot.bytes->size() > UINT_MAX) return false;
+        auto& desc = request.buffer;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = resource.bind_flags;
+        desc.MiscFlags = resource.misc_flags;
+        desc.ByteWidth = static_cast<UINT>(asset.snapshot.bytes->size());
+        if (resource.override_type == CustomResourceType::STRUCTURED_BUFFER)
+            desc.StructureByteStride = desc.ByteWidth;
+        resource.OverrideBufferDesc(&desc);
+        request.estimatedBytes = uint64_t(desc.ByteWidth) + 64 * 1024;
+        return desc.ByteWidth != 0;
+    }
+    request.loaderBindFlags = resource.override_bind_flags == CustomResourceBindFlags::INVALID ?
+        resource.bind_flags : static_cast<UINT>(resource.override_bind_flags);
+    request.loaderMiscFlags = resource.override_misc_flags == ResourceMiscFlags::INVALID ?
+        resource.misc_flags : static_cast<UINT>(resource.override_misc_flags);
+    request.createDefaultShaderResourceView = resource.preparation_known_srv &&
+        request.loaderBindFlags == D3D11_BIND_SHADER_RESOURCE && !request.loaderMiscFlags;
+    request.forceSRGB = resource.override_color_space == CustomColorSpace::SRGB;
+    request.wicLoaderFlags = PreparedWICFlags(*asset.snapshot.bytes,
+        resource.override_color_space, G->gForceDetectColorSpace);
+    const bool dds = IsDDS(resource.filename);
+    if (!dds && UseDecoded(asset, device, resource, request)) {
+        if (request.createDefaultShaderResourceView) request.estimatedBytes += 64 * 1024;
+        return true;
+    }
+    request.kind = dds ? GpuPreparationKind::EncodedDDS : GpuPreparationKind::EncodedWIC;
+    request.estimatedBytes = EstimateEncodedTextureBytes(asset.snapshot, request.kind);
+    if (!request.estimatedBytes) return false;
+    if (request.createDefaultShaderResourceView) request.estimatedBytes += 64 * 1024;
+    return true;
+}
+std::shared_ptr<const ShaderBundleInput> CaptureShaderBundle(CustomShader& shader, size_t maxBytes, uint64_t shaderBudget) {
+    if (shader.substantiated || shader.preparation_compile_failed ||
+        shader.blend_override < 0 || shader.blend_override > 1 ||
+        shader.depth_stencil_override < 0 || shader.depth_stencil_override > 1 ||
+        shader.rs_override < 0 || shader.rs_override > 1 ||
+        shader.sampler_override < 0 || shader.sampler_override > 1) return {};
+    auto input = std::make_shared<ShaderBundleInput>();
+    const bool overrideStage[] = {shader.vs_override, shader.hs_override, shader.ds_override,
+        shader.gs_override, shader.ps_override, shader.cs_override};
+    ID3DBlob* bytecode[] = {shader.vs_bytecode, shader.hs_bytecode, shader.ds_bytecode,
+        shader.gs_bytecode, shader.ps_bytecode, shader.cs_bytecode};
+    size_t bytes = 0;
+    bool createsObject = false;
+    for (size_t stage = 0; stage < 6; ++stage) {
+        if (overrideStage[stage]) input->stageOverrideMask |= 1u << stage;
+        if (!bytecode[stage]) continue; // A configured null stage is intentional.
+        if (!overrideStage[stage] || bytecode[stage]->GetBufferSize() > maxBytes - bytes) return {};
+        bytes += bytecode[stage]->GetBufferSize();
+        const auto retained = SharedShaderBytecode::LiveRetainedBytes();
+        if (retained > shaderBudget || bytecode[stage]->GetBufferSize() > shaderBudget - retained) return {};
+        const auto digest = HashBytes(static_cast<const uint8_t*>(bytecode[stage]->GetBufferPointer()),
+            bytecode[stage]->GetBufferSize());
+        input->stages[stage] = SharedShaderBytecode::Retain(bytecode[stage], digest, shaderBudget);
+        if (!input->stages[stage]) return {};
+        createsObject = true;
+    }
+    input->createBlendState = shader.blend_override == 1;
+    input->createDepthStencilState = shader.depth_stencil_override == 1;
+    input->createRasterizerState = shader.rs_override == 1;
+    input->createSamplerState = shader.sampler_override == 1;
+    if (input->createBlendState) input->blend = shader.blend_desc;
+    if (input->createDepthStencilState) input->depthStencil = shader.depth_stencil_desc;
+    if (input->createRasterizerState) input->rasterizer = shader.rs_desc;
+    if (input->createSamplerState) input->sampler = shader.sampler_desc;
+    return createsObject || input->createBlendState || input->createDepthStencilState ||
+        input->createRasterizerState || input->createSamplerState ? input : nullptr;
+}
+bool ShaderRequestFor(CustomShader& shader, GpuPreparationRequest& request) {
+    if (!shader.preparation_bundle || shader.substantiated || shader.preparation_compile_failed)
+        return false;
+    request.kind = GpuPreparationKind::ShaderBundle;
+    request.shaderBundle = shader.preparation_bundle;
+    request.dependencyReadOnly = true; // Compiled shaders and fixed states are immutable.
+    request.creationOptions = {RuntimeFeatureVersion, 1, uint32_t(shader.compile_flags)};
+    uint64_t bytes = 0, objects = 0;
+    for (const auto& stage : shader.preparation_bundle->stages) {
+        bytes += stage.Size();
+        if (stage) ++objects;
+    }
+    const auto& input = *shader.preparation_bundle;
+    objects += input.createBlendState + input.createDepthStencilState +
+        input.createRasterizerState + input.createSamplerState;
+    request.estimatedBytes = bytes * 2 + objects * 64 * 1024;
+    return request.estimatedBytes != 0;
+}
+bool KnownPreparationCopy(const ResourceCopyOperation& operation) {
+    const auto& destination = operation.dst;
+    const bool inputSlot = destination.type == ResourceCopyTargetType::SHADER_RESOURCE ||
+        destination.type == ResourceCopyTargetType::VERTEX_BUFFER ||
+        destination.type == ResourceCopyTargetType::INDEX_BUFFER ||
+        destination.type == ResourceCopyTargetType::CONSTANT_BUFFER;
+    if (!inputSlot || destination.slot_expression || destination.range_start || destination.range_end ||
+        destination.custom_resource_pool || destination.pool_dynamic_index_expression ||
+        destination.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+        operation.src.slot_expression || operation.src.range_start || operation.src.range_end ||
+        operation.src.custom_resource_pool || operation.src.pool_dynamic_index_expression ||
+        operation.src.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE) return false;
+    const uint32_t allowedOptions = uint32_t(ResourceCopyOptions::REFERENCE) |
+        uint32_t(ResourceCopyOptions::UNLESS_NULL) | uint32_t(ResourceCopyOptions::SET_VIEWPORT);
+    if (uint32_t(operation.options) & ~allowedOptions) return false;
+    if (operation.src.type == ResourceCopyTargetType::EMPTY) return true;
+    if (operation.src.type != ResourceCopyTargetType::CUSTOM_RESOURCE ||
+        !(operation.options & ResourceCopyOptions::REFERENCE) ||
+        (uint32_t(operation.options) & ~allowedOptions) ||
+        operation.src.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+        destination.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE) return false;
+    // GetCustomResource has a legacy non-const API; this is a static target
+    // lookup only, and pool/dynamic sources are explicitly rejected.
+    auto& source = const_cast<ResourceCopyTarget&>(operation.src);
+    if (source.custom_resource_pool) return false;
+    auto* resource = source.GetCustomResource(nullptr, true);
+    return resource && resource->PreparationReadOnly() && !resource->filename.empty();
+}
+bool KnownPreparationCommand(const CommandListCommand& command) {
+    if (const auto* operation = dynamic_cast<const ResourceCopyOperation*>(&command))
+        return KnownPreparationCopy(*operation);
+    if (const auto* batch = dynamic_cast<const ShaderResourceBindBatch*>(&command)) {
+        for (const auto& operation : batch->operations)
+            if (!operation || !KnownPreparationCopy(*operation)) return false;
+        return true;
+    }
+    if (const auto* shader = dynamic_cast<const RunCustomShaderCommand*>(&command)) return shader->custom_shader != nullptr;
+    if (const auto* draw = dynamic_cast<const DrawCommand*>(&command)) {
+        size_t arguments = 0;
+        switch (draw->type) {
+        case DrawCommandType::DRAW: arguments = 2; break;
+        case DrawCommandType::DRAW_INDEXED: case DrawCommandType::DISPATCH: arguments = 3; break;
+        case DrawCommandType::DRAW_INSTANCED: arguments = 4; break;
+        case DrawCommandType::DRAW_INDEXED_INSTANCED: arguments = 5; break;
+        default: return false;
+        }
+        // Resource/hash expressions can create staging resources while being
+        // evaluated. Only the parser's side-effect-free constant evaluation is
+        // admitted by this initial whole-profile command proof.
+        for (size_t argument = 0; argument < arguments; ++argument) {
+            float value = 0;
+            if (!const_cast<CommandListExpression&>(draw->args[argument]).static_evaluate(&value)) return false;
+        }
+        return true;
+    }
+    return dynamic_cast<const RunExplicitCommandList*>(&command) ||
+        dynamic_cast<const RunLinkedCommandList*>(&command) ||
+        dynamic_cast<const SkipCommand*>(&command) || dynamic_cast<const AbortCommand*>(&command);
+}
+bool KnownPreparationCommandClosure() {
+    if (registered_command_lists.size() > 65536) return false;
+    std::vector<CommandList*> pending(registered_command_lists.begin(), registered_command_lists.end());
+    std::set<CommandList*> visited;
+    size_t commands = 0;
+    while (!pending.empty()) {
+        auto* list = pending.back(); pending.pop_back();
+        if (!list || list->runtime_populated) return false;
+        if (!visited.insert(list).second) continue;
+        if (visited.size() > 65536) return false;
+        for (const auto& command : list->commands) {
+            if (++commands > 65536 || !command || !KnownPreparationCommand(*command)) return false;
+            if (const auto* shader = dynamic_cast<const RunCustomShaderCommand*>(command.get())) {
+                pending.push_back(&shader->custom_shader->command_list);
+                pending.push_back(&shader->custom_shader->post_command_list);
+            } else if (const auto* explicitList = dynamic_cast<const RunExplicitCommandList*>(command.get())) {
+                if (!explicitList->command_list_section) return false;
+                pending.push_back(&explicitList->command_list_section->command_list);
+                pending.push_back(&explicitList->command_list_section->post_command_list);
+            } else if (const auto* linked = dynamic_cast<const RunLinkedCommandList*>(command.get())) {
+                pending.push_back(linked->link);
+            }
+        }
+    }
+    return true;
+}
+
+void PublishProgress(const std::shared_ptr<RuntimeState>& state, DeviceEpoch epoch,
+    const char* forcedReason = nullptr) {
+    PreparationStatus status;
+    const auto statusTicket = ReservePreparationStatusTicket();
+    status.mode = state ? state->mode : PreparationMode::Off;
+    if (!state || state->mode == PreparationMode::Off) {
+        status.state = PreparationStatusState::Off;
+        UpdatePreparationStatus(status, statusTicket); return;
+    }
+    status.totalAssets = state->totalAssets;
+    status.compatibilityAssets = state->baseCompatibility;
+    for (const auto& item : state->profile) {
+        const auto& entry = item.second;
+        if (entry.compatibility) ++status.compatibilityAssets;
+        if (entry.generation != state->generation) continue;
+        if (entry.cpuReady) ++status.cpuReady;
+        auto gpu = entry.pinnedGpu.lock();
+        if (!gpu) gpu = entry.observedGpu.lock();
+        if (entry.cpuReady && gpu && entry.epoch == epoch) ++status.gpuReady;
+    }
+    // Serialize the final source fence and publication with the monitor's
+    // invalidation callback. A snapshot gathered before that callback cannot
+    // clear its newer atomic writer invalidation with a stale Ready update.
+    std::unique_lock<std::mutex> publishLock(state->pendingMutex, std::try_to_lock);
+    if (!publishLock.owns_lock()) return;
+    const bool current = state->enabled.load() && state->monitor &&
+        state->monitor->IsCurrent(state->sourceToken.load());
+    if (forcedReason || Services().retirementRequested.load() || !current || !state->gpuBytes || !state->cpuLimits.cpuBytes) {
+        status.state = PreparationStatusState::Compatibility;
+        status.compatibilityAssets = status.totalAssets;
+        status.gpuReady = 0;
+        if (!current) status.cpuReady = 0;
+        status.reason = forcedReason ? forcedReason : "preparation disabled or source/configuration needs compatible reload";
+    } else if (status.compatibilityAssets) {
+        status.state = PreparationStatusState::Compatibility;
+        status.reason = "profile includes unsupported, mutable, unknown-view, or legacy shader entries";
+        for (const auto& item : state->profile)
+            if (item.second.compatibility && !item.second.reason.empty()) {
+                status.reason = item.second.reason; break;
+            }
+    } else if (state->mode == PreparationMode::PreparedProfile && status.totalAssets &&
+        status.cpuReady == status.totalAssets && status.gpuReady == status.totalAssets) {
+        status.state = PreparationStatusState::Ready;
+        status.reason = "complete current profile pinned; preparation readiness is not activation or visual validation";
+    } else {
+        status.state = PreparationStatusState::Preparing;
+        status.reason = "waiting for verified sources, complete GPU objects, loading window, or available budget";
+    }
+    UpdatePreparationStatus(status, statusTicket);
+}
+void ResetProfileEntry(ProfileEntry& entry, Generation generation, DeviceEpoch epoch) {
+    if (entry.generation == generation && entry.epoch == epoch) return;
+    entry.source.reset(); entry.pinnedGpu.reset(); entry.observedGpu.reset();
+    entry.cpuReady = false; entry.compatibility = entry.staticCompatibility; entry.reason.clear();
+    entry.generation = generation; entry.epoch = epoch; entry.key = DeviceResourceKey();
+}
+bool SameKey(const DeviceResourceKey& a, const DeviceResourceKey& b) {
+    return !(a < b) && !(b < a);
+}
+bool QualifiedResource(CustomResource& resource, const std::shared_ptr<PreparedGpuObject>& prepared) {
+    if (!prepared || !prepared->resource) return false;
+    if (!resource.preparation_known_srv) return true;
+    if (!prepared->shaderResourceView || IsBuffer(resource)) return false;
+    D3D11_RESOURCE_DIMENSION dimension;
+    prepared->resource->GetType(&dimension);
+    if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) return false;
+    D3D11_TEXTURE2D_DESC texture{};
+    static_cast<ID3D11Texture2D*>(prepared->resource)->GetDesc(&texture);
+    D3D11_SHADER_RESOURCE_VIEW_DESC view{};
+    prepared->shaderResourceView->GetDesc(&view);
+    return texture.ArraySize == 1 && texture.SampleDesc.Count == 1 && !texture.SampleDesc.Quality &&
+        !(texture.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE) &&
+        view.ViewDimension == D3D11_SRV_DIMENSION_TEXTURE2D &&
+        FullTexture2DViewMatches(uint32_t(texture.Format), texture.MipLevels,
+            0, 0, UINT32_MAX, uint32_t(view.Format), view.Texture2D.MostDetailedMip, view.Texture2D.MipLevels);
+}
+bool SourcesCurrent(const std::shared_ptr<RuntimeState>& state) {
+    return state && state->enabled.load() && state->scheduler && state->monitor &&
+        state->monitor->IsCurrent(state->sourceToken.load());
+}
+}
+
+unsigned PreparedWICFlags(const std::vector<uint8_t>& bytes,
+    CustomColorSpace colorSpace, bool detectPngSRGB) {
+    if (colorSpace == CustomColorSpace::LINEAR || colorSpace == CustomColorSpace::SRGB)
+        return static_cast<unsigned>(colorSpace);
+    if (!detectPngSRGB) return DirectX::WIC_LOADER_DEFAULT;
+    return HasPngSRGBChunk(bytes) ? DirectX::WIC_LOADER_FORCE_SRGB : DirectX::WIC_LOADER_DEFAULT;
+}
+
+void CancelRuntimeGeneration() {
+    auto state = Current();
+    if (!state) return;
+    state->enabled.store(false);
+    InvalidatePreparationStatus();
+    const auto generation = ++Services().nextGeneration;
+    if (state->scheduler) state->scheduler->CancelBefore(generation);
+    state->generations.CancelPrepared();
+    auto& service = Services();
+    service.retirementRequested.store(true);
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (lock.owns_lock()) {
+        if (service.device) RetireRuntimeDevice(service.device);
+        else service.retirementRequested.store(false);
+    }
+    // Old CPU bytes/GPU objects cannot be acquired after invalidation. Actual
+    // existing resource references retain their normal COM lifetime.
+}
+static void ConfigureRuntimeImpl() {
+    auto state = std::make_shared<RuntimeState>();
+    state->generation = ++Services().nextGeneration;
+    wchar_t mode[64] = {};
+    GetIniString(L"ModLoading", L"mode", L"off", mode, 64);
+    if (!_wcsicmp(mode, L"adaptive")) state->mode = PreparationMode::Adaptive;
+    else if (!_wcsicmp(mode, L"prepared_profile")) state->mode = PreparationMode::PreparedProfile;
+    else if (_wcsicmp(mode, L"off"))
+        LogOverlayW(LOG_WARNING, L"Unknown experimental ModLoading mode '%ls'; disabled\n", mode);
+    if (state->mode != PreparationMode::Off) {
+        const int cpuMB = Setting(L"cpu_cache_mb",512,0,4096);
+        state->cpuLimits.cpuBytes = size_t(cpuMB ? (std::max)(16, cpuMB) : 0) * MiB;
+        state->shaderBytes = (std::min)(uint64_t(state->cpuLimits.cpuBytes / 4), 64 * MiB);
+        state->cpuLimits.cpuBytes -= size_t(state->shaderBytes);
+        state->cpuLimits.maxAssetBytes = size_t(Setting(L"max_asset_mb",64,1,1024)) * size_t(MiB);
+        if (state->cpuLimits.cpuBytes)
+            state->cpuLimits.maxAssetBytes = (std::min)(state->cpuLimits.cpuBytes, state->cpuLimits.maxAssetBytes);
+        state->cpuLimits.workers = Setting(L"worker_threads",2,1,16);
+        state->cpuLimits.maxQueued = Setting(L"max_pending_jobs",64,1,4096);
+        const int gpuMB = Setting(L"gpu_cache_mb",256,0,4096);
+        state->gpuBytes = uint64_t(gpuMB ? (std::max)(16, gpuMB) : 0) * MiB;
+        state->gpuLimits.bytes = uint64_t(Setting(L"upload_budget_mb",16,1,1024)) * MiB;
+        state->gpuLimits.milliseconds = (std::max)(0.1f, (std::min)(50.0f,
+            GetIniFloat(L"ModLoading", L"create_budget_ms", 2.0f, nullptr)));
+        state->loadingWindow = GetIniBool(L"ModLoading", L"preparation_loading_window", false, nullptr);
+        if (GetIniBool(L"ModLoading", L"auto_activate", false, nullptr))
+            LogOverlayW(LOG_WARNING, L"ModLoading auto_activate is unsupported; use explicit compatible reload\n");
+        static int statusModuleAnchor;
+        InitializePreparationStatus(&statusModuleAnchor);
+        state->totalAssets = customResources.size() + customShaders.size();
+        const auto manifest = CaptureLoadedConfigSources();
+        ConfigCompiler compiler(Services().configCache);
+        auto previous = Current();
+        state->config = compiler.Build(manifest, previous ? previous->config : nullptr,
+            {state->generation.load(), 0, state->generation.load()}, false);
+        std::set<std::wstring> files, roots;
+        const auto persistentOutput = Canonical(G->user_config);
+        for (auto& entry : customResources) {
+            if (!entry.second.filename.empty()) {
+                auto canonical = Canonical(entry.second.filename);
+                if (canonical.empty() || (!persistentOutput.empty() &&
+                    !_wcsicmp(canonical.c_str(), persistentOutput.c_str()))) continue;
+                entry.second.filename = std::move(canonical);
+                files.insert(entry.second.filename);
+                state->resources.push_back(&entry.second);
+                if (state->profile.size() < 4096) {
+                    ProfileEntry profile;
+                    profile.staticCompatibility = !entry.second.PreparationReadOnly() ||
+                        (IsBuffer(entry.second) && entry.second.preparation_known_srv);
+                    profile.compatibility = profile.staticCompatibility;
+                    state->profile.emplace(&entry.second, std::move(profile));
+                }
+                auto root = Parent(entry.second.filename);
+                if (!root.empty()) roots.insert(root);
+            }
+        }
+        size_t shaderCount = 0;
+        for (auto& entry : customShaders) {
+            if (++shaderCount > 4096) break;
+            entry.second.preparation_bundle = state->shaderBytes ? CaptureShaderBundle(entry.second,
+                state->cpuLimits.maxAssetBytes, state->shaderBytes) : nullptr;
+            if (entry.second.preparation_bundle) {
+                state->shaders.push_back(&entry.second);
+                if (state->profile.size() < 4096) state->profile.emplace(&entry.second, ProfileEntry());
+            }
+        }
+        for (const auto& source : manifest.sources) {
+            auto root = Parent(Canonical(source.snapshot.path));
+            if (!root.empty()) roots.insert(root);
+        }
+        state->baseCompatibility = state->totalAssets - state->profile.size();
+        // A copied runtime/game resource, staging/readback command, dynamic
+        // view, or unclassified command may create objects outside declarations.
+        // Such a closure is an explicit compatibility entry, never whole-profile
+        // Ready merely because its file-backed subset happens to be prepared.
+        if (!KnownPreparationCommandClosure()) {
+            ++state->totalAssets; ++state->baseCompatibility;
+        }
+        state->files.assign(files.begin(), files.end());
+        auto& service = Services();
+        if (state->cpuLimits.cpuBytes && !service.scheduler) {
+            // Workers can outlive individual config generations. Pin the DLL
+            // before starting them so no background instruction can execute
+            // after module unload; process teardown reclaims the pool.
+            static int moduleAnchor;
+            HMODULE module = nullptr;
+            service.modulePinned = GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                GET_MODULE_HANDLE_EX_FLAG_PIN, reinterpret_cast<LPCWSTR>(&moduleAnchor), &module) != FALSE;
+            if (service.modulePinned)
+                service.scheduler = std::make_shared<PreparationScheduler>(state->cpuLimits);
+        }
+        state->scheduler = service.scheduler;
+        if (state->scheduler && !state->scheduler->Reconfigure(state->cpuLimits, state->generation))
+            state->scheduler.reset();
+        ChangeOptions monitorOptions;
+        monitorOptions.periodicReconcileMs = 0;
+        monitorOptions.filterDependencies = true;
+        monitorOptions.dependencyFiles = state->files;
+        if (!persistentOutput.empty())
+            monitorOptions.excludedSourceFiles.push_back(persistentOutput);
+        state->monitor.reset(new ChangeMonitor(monitorOptions));
+        // The monitor member is stopped/joined by RuntimeState before its
+        // other members are destroyed. The callback must never own RuntimeState:
+        // a final shared_ptr release on this worker would join itself.
+        RuntimeState* const owned = state.get();
+        const bool monitoring = state->monitor->Start({roots.begin(), roots.end()}, {},
+            [owned](const ReconcileRequest& request) {
+                std::lock_guard<std::mutex> lock(owned->pendingMutex);
+                owned->pending = request;
+                owned->hasPending = true;
+                InvalidatePreparationStatus();
+                PreparationStatus status;
+                const auto statusTicket = ReservePreparationStatusTicket();
+                status.mode = owned->mode;
+                status.state = PreparationStatusState::Preparing;
+                status.totalAssets = owned->totalAssets;
+                status.reason = "source notification invalidated the prepared profile";
+                UpdatePreparationStatus(status, statusTicket);
+            });
+        state->enabled.store(monitoring && state->scheduler != nullptr && state->cpuLimits.cpuBytes != 0);
+        if (!monitoring)
+            LogOverlayW(LOG_WARNING, L"ModLoading monitor unavailable; using compatible file loading\n");
+        LogInfo("Experimental ModLoading v%u: %zu sources, CPU %zu MiB, GPU %llu MiB, loading-window=%d\n",
+            RuntimeFeatureVersion, state->files.size(), state->cpuLimits.cpuBytes / size_t(MiB),
+            state->gpuBytes / MiB, state->loadingWindow);
+    }
+    if (state->mode == PreparationMode::Off && Services().scheduler) {
+        PreparationLimits disabled;
+        disabled.cpuBytes = 0;
+        Services().scheduler->Reconfigure(disabled, state->generation);
+    }
+    // Configuration loading is already a legacy loading boundary. Retiring the
+    // previous monitor here never happens in a draw/resource cache lookup.
+    auto previousState = Current();
+    if (previousState) {
+        previousState->enabled.store(false);
+        if (previousState->monitor) previousState->monitor->Stop();
+    }
+    std::atomic_store(&Services().state, state);
+    PublishProgress(state, 0);
+}
+
+std::shared_ptr<const PreparedAsset> TryGetPreparedAsset(const std::wstring& path) {
+    auto state = Current();
+    if (!SourcesCurrent(state)) return {};
+    auto asset = state->scheduler->TryGet(path, state->generation);
+    return SourcesCurrent(state) ? asset : nullptr;
+}
+static void PumpRuntimeImpl(ID3D11Device* device, DeviceEpoch epoch) {
+    auto state = Current();
+    if (!state || !state->enabled.load() || !device || !epoch || runtimeBusy) return;
+    // The same global lock protects legacy config destruction. Never retain
+    // or dereference CustomResource pointers while a concurrent F10 clears them.
+    TryGlobalConfigGuard configGuard;
+    if (!configGuard.acquired || !state->enabled.load()) return;
+    auto& service = Services();
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (!lock.owns_lock() || (service.planner && service.owner != std::this_thread::get_id())) return;
+    RuntimeOwnerScope ownerScope(lock);
+    ReconcileRequest request;
+    bool changed = false;
+    {
+        std::lock_guard<std::mutex> lock(state->pendingMutex);
+        if (state->hasPending) {
+            request = std::move(state->pending); state->hasPending = false; changed = true;
+        }
+    }
+    if (changed && state->monitor->IsCurrent(request.token)) {
+        state->generation = ++Services().nextGeneration;
+        state->scheduler->CancelBefore(state->generation);
+        state->sourceToken.store(request.token);
+        state->cursor = state->resourceCursor = state->shaderCursor = 0;
+        state->generations.CancelPrepared();
+        // INI edits only invalidate preparation; never execute or auto-reload
+        // changed commands. Existing live configuration stays on its old path.
+        if (request.iniChanged) {
+            state->sourceToken.store(0);
+            LogInfo("ModLoading: configuration/closure change requires explicit compatible reload\n");
+        }
+    }
+    if (!SourcesCurrent(state)) { PublishProgress(state, epoch); return; }
+    if (FAILED(device->GetDeviceRemovedReason())) {
+        PublishProgress(state, epoch, "rendering device was removed; compatibility reload/device recreation required");
+        return;
+    }
+    // A single-threaded device offers no safe foreign-thread teardown path
+    // once prepared children retain its COM lifetime. Keep this device class
+    // on the CPU snapshot + legacy GPU path until explicit owner teardown is
+    // available; never create speculative children for it.
+    if (!state->gpuBytes || (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED)) {
+        for (size_t work = 0; work < 8 && !state->files.empty(); ++work)
+            state->scheduler->Enqueue(state->files[state->cursor++ % state->files.size()], state->generation);
+        for (size_t work = 0; work < 8 && !state->resources.empty(); ++work) {
+            auto* resource = state->resources[state->resourceCursor++ % state->resources.size()];
+            const auto tracked = state->profile.find(resource);
+            if (tracked == state->profile.end()) continue;
+            auto& progress = tracked->second;
+            ResetProfileEntry(progress, state->generation, epoch);
+            if (auto asset = state->scheduler->TryGet(resource->filename, state->generation)) {
+                progress.cpuReady = true;
+                if (state->mode == PreparationMode::PreparedProfile) progress.source = asset;
+            }
+        }
+        for (size_t work = 0; work < 2 && !state->shaders.empty(); ++work) {
+            auto* shader = state->shaders[state->shaderCursor++ % state->shaders.size()];
+            const auto tracked = state->profile.find(shader);
+            if (tracked == state->profile.end()) continue;
+            ResetProfileEntry(tracked->second, state->generation, epoch);
+            tracked->second.cpuReady = shader->preparation_bundle != nullptr;
+        }
+        PublishProgress(state, epoch, !state->gpuBytes ? "GPU preparation disabled" :
+            "single-threaded device uses CPU snapshots and legacy GPU creation");
+        return;
+    }
+    if (!service.planner || service.device != device || service.epoch != epoch ||
+        service.plannerGeneration != state->generation) {
+        service.activeResources.clear();
+        service.profileGpuPins.clear();
+        service.planner.reset(new PreparationPlanner(state->gpuBytes, 32, state->shaderBytes));
+        service.device = device; service.epoch = epoch;
+        service.owner = std::this_thread::get_id();
+        service.plannerGeneration = state->generation;
+        if (!service.planner->BeginDevice(device, epoch)) return;
+    }
+    // Bound CPU admission and descriptor work per Present. The queue/cache
+    // enforce their own memory limits; no draw executes just to discover work.
+    for (size_t work = 0; work < 8 && !state->files.empty(); ++work) {
+        const auto& file = state->files[state->cursor++ % state->files.size()];
+        state->scheduler->Enqueue(file, state->generation);
+    }
+    auto batch = std::make_shared<ConfigGeneration>();
+    batch->id = state->generation;
+    batch->versions = {state->generation.load(), epoch, state->generation.load()};
+    batch->config = state->config;
+    for (size_t work = 0; work < 8 && !state->resources.empty(); ++work) {
+        auto& resource = *state->resources[state->resourceCursor++ % state->resources.size()];
+        const auto tracked = state->profile.find(&resource);
+        if (tracked == state->profile.end()) continue;
+        auto& progress = tracked->second;
+        ResetProfileEntry(progress, state->generation, epoch);
+        auto asset = progress.source ? progress.source : state->scheduler->TryGet(resource.filename, state->generation);
+        if (!asset) {
+            const auto reason = state->scheduler->CompatibilityReason(resource.filename, state->generation);
+            if (!reason.empty()) { progress.compatibility = true; progress.reason = reason; }
+            continue;
+        }
+        progress.cpuReady = true;
+        if (state->mode == PreparationMode::PreparedProfile) progress.source = asset;
+        batch->dependencies.push_back(asset);
+        if (progress.staticCompatibility) continue;
+        progress.compatibility = false;
+        GpuPreparationRequest prepared;
+        if (!RequestFor(resource, *asset, device, prepared)) { progress.compatibility = true; continue; }
+        prepared.sourceOwner = asset;
+        DeviceResourceKey key;
+        if (!service.planner->ComputeKey(prepared, key)) {
+            progress.compatibility = true; service.profileGpuPins.erase(&resource);
+            progress.pinnedGpu.reset(); progress.observedGpu.reset(); continue;
+        }
+        auto pin = progress.pinnedGpu.lock();
+        if (pin && !SameKey(progress.key, key)) {
+            service.profileGpuPins.erase(&resource); progress.pinnedGpu.reset(); pin.reset();
+        }
+        if (!pin) {
+            const auto queued = service.planner->Enqueue(prepared, &key);
+            if (queued == GpuQueueResult::CompatibilityOnly) { progress.compatibility = true; continue; }
+        }
+        auto object = pin ? pin : service.planner->TryAcquire(key);
+        if (object && QualifiedResource(resource, object)) {
+            progress.key = key; progress.observedGpu = object;
+            if (state->mode == PreparationMode::PreparedProfile) {
+                service.profileGpuPins[&resource] = object; progress.pinnedGpu = object;
+            }
+        } else if (object) progress.compatibility = true;
+    }
+    for (size_t work = 0; work < 2 && !state->shaders.empty(); ++work) {
+        auto& shader = *state->shaders[state->shaderCursor++ % state->shaders.size()];
+        const auto tracked = state->profile.find(&shader);
+        if (tracked == state->profile.end()) continue;
+        auto& progress = tracked->second;
+        ResetProfileEntry(progress, state->generation, epoch);
+        if (progress.pinnedGpu.lock()) continue;
+        GpuPreparationRequest prepared;
+        if (!ShaderRequestFor(shader, prepared)) {
+            if (!progress.observedGpu.lock()) progress.compatibility = true;
+            continue;
+        }
+        progress.cpuReady = true;
+        DeviceResourceKey key;
+        const auto queued = service.planner->Enqueue(prepared, &key);
+        if (queued == GpuQueueResult::CompatibilityOnly) { progress.compatibility = true; continue; }
+        auto object = service.planner->TryAcquire(key);
+        if (object && object->bundle) {
+            progress.key = key; progress.observedGpu = object;
+            if (state->mode == PreparationMode::PreparedProfile) {
+                service.profileGpuPins[&shader] = object; progress.pinnedGpu = object;
+            }
+        }
+    }
+    if (!SourcesCurrent(state)) return;
+    if (batch->config && !batch->dependencies.empty())
+        state->generations.Stage(batch,
+            {state->generation.load(), epoch, state->generation.load()});
+    if (state->loadingWindow) EnsureCOM();
+    struct CreationModeGuard {
+        CreationModeGuard() { LockResourceCreationMode(); }
+        ~CreationModeGuard() { UnlockResourceCreationMode(); }
+    } creationMode;
+    const auto result = service.planner->Pump(state->loadingWindow, state->gpuLimits);
+    if (result.deviceRemoved) RetireRuntimeDevice(device);
+    PublishProgress(state, epoch, result.deviceRemoved ? "rendering device removed during preparation" : nullptr);
+}
+bool InRuntimePreparation() { return runtimeBusy || retiringDevice; }
+void RetireRuntimeDevice(ID3D11Device* device) {
+    auto& service = Services();
+    if (retiringDevice) return;
+    service.retirementRequested.store(true);
+    InvalidatePreparationStatus();
+    PreparationStatus invalid;
+    const auto invalidTicket = ReservePreparationStatusTicket();
+    if (auto state = Current()) { invalid.mode = state->mode; invalid.totalAssets = state->totalAssets; }
+    invalid.state = invalid.mode == PreparationMode::Off ? PreparationStatusState::Off : PreparationStatusState::Preparing;
+    invalid.reason = "GPU cache retirement requires profile revalidation";
+    UpdatePreparationStatus(invalid, invalidTicket);
+    // Device Release can reenter through resource/cache destruction or run on
+    // another game thread. Defer without blocking/resetting an executing Pump.
+    if (runtimeBusy) return;
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (!lock.owns_lock()) return;
+    // Conservatively drain the current speculative cache for any wrapped
+    // application device release. Keeping one aggregate retirement flag avoids
+    // losing a concurrent current-device request behind a probe-device release.
+    (void)device;
+    if (!service.planner) { service.retirementRequested.store(false); return; }
+    // Runtime never admits speculative resources for SINGLETHREADED devices.
+    // For supported devices COM release is thread-safe, and this lock excludes
+    // all render-owned preparation calls while draining the cache.
+    retiringDevice = true;
+    service.activeResources.clear();
+    service.profileGpuPins.clear();
+    auto retired = std::move(service.planner);
+    service.device = nullptr; service.epoch = 0; service.plannerGeneration = 0;
+    retired.reset();
+    service.retirementRequested.store(false);
+    retiringDevice = false;
+}
+static bool TryUsePreparedResourceImpl(CustomResource& target, ID3D11Device* device) {
+    auto state = Current();
+    auto& service = Services();
+    if (runtimeBusy || service.retirementRequested.load()) return false;
+    TryGlobalConfigGuard configGuard;
+    if (!configGuard.acquired) return false;
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (!lock.owns_lock() || service.owner != std::this_thread::get_id()) return false;
+    RuntimeOwnerScope ownerScope(lock);
+    if (!SourcesCurrent(state) || !service.planner || service.device != device ||
+        service.plannerGeneration != state->generation) return false;
+    const auto tracked = state->profile.find(&target);
+    ProfileEntry* progress = tracked != state->profile.end() ? &tracked->second : nullptr;
+    const bool currentPin = progress && progress->generation == state->generation && progress->epoch == service.epoch;
+    auto asset = currentPin && progress->source ? progress->source :
+        state->scheduler->TryGet(target.filename, state->generation);
+    if (!asset) return false;
+    GpuPreparationRequest request;
+    if (!RequestFor(target, *asset, device, request)) return false;
+    request.sourceOwner = asset;
+    DeviceResourceKey key;
+    if (!service.planner->ComputeKey(request, key)) return false;
+    auto prepared = currentPin && SameKey(progress->key, key) ? progress->pinnedGpu.lock() : nullptr;
+    if (!prepared) {
+        if (service.planner->Enqueue(request, &key) != GpuQueueResult::AlreadyReady || !SourcesCurrent(state)) return false;
+        prepared = service.planner->TryAcquire(key);
+    }
+    if (!prepared || !prepared->resource || !SourcesCurrent(state)) return false;
+    if (prepared->shaderResourceView && service.activeResources.size() < 4096)
+        service.activeResources[prepared->resource] = prepared;
+    prepared->resource->AddRef();
+    target.preparation_pin = prepared;
+    target.resource = prepared->resource;
+    target.device = device;
+    target.is_null = false;
+    if (IsBuffer(target)) {
+        target.buf_size = static_cast<UINT>(asset->snapshot.bytes->size());
+        target.OverrideOutOfBandInfo(&target.format, &target.stride);
+    }
+    // COM references pin active resources independently of cache eviction. Views
+    // remain lazily created by the existing target-specific legacy view code.
+    LoadTrace::Get().RecordInstant(LoadStage::ReadinessWait,
+        reinterpret_cast<uintptr_t>(&target), request.estimatedBytes, 0);
+    return true;
+}
+static bool TryUsePreparedShaderBundleImpl(CustomShader& target, ID3D11Device* device) {
+    auto state = Current();
+    auto& service = Services();
+    if (runtimeBusy || service.retirementRequested.load()) return false;
+    TryGlobalConfigGuard configGuard;
+    if (!configGuard.acquired) return false;
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (!lock.owns_lock() || service.owner != std::this_thread::get_id()) return false;
+    RuntimeOwnerScope ownerScope(lock);
+    if (!SourcesCurrent(state) || !service.planner || service.device != device ||
+        service.plannerGeneration != state->generation || target.vs || target.hs || target.ds ||
+        target.gs || target.ps || target.cs || target.blend_state || target.depth_stencil_state ||
+        target.rs_state || target.sampler_state) return false;
+    GpuPreparationRequest request;
+    if (!ShaderRequestFor(target, request)) return false;
+    DeviceResourceKey key;
+    if (!service.planner->ComputeKey(request, key)) return false;
+    const auto tracked = state->profile.find(&target);
+    const bool currentPin = tracked != state->profile.end() && tracked->second.generation == state->generation &&
+        tracked->second.epoch == service.epoch && SameKey(tracked->second.key, key);
+    auto prepared = currentPin ? tracked->second.pinnedGpu.lock() : nullptr;
+    if (!prepared) {
+        if (service.planner->Enqueue(request, &key) != GpuQueueResult::AlreadyReady) return false;
+        prepared = service.planner->TryAcquire(key);
+    }
+    if (!prepared || !prepared->bundle || !SourcesCurrent(state)) return false;
+    const auto& bundle = *prepared->bundle;
+    const auto& input = *request.shaderBundle;
+    // Every requested object must exist before any target pointer changes.
+    // An intentional null override has an empty input and an empty output.
+    const bool output[] = {bundle.vertex != nullptr, bundle.hull != nullptr,
+        bundle.domain != nullptr, bundle.geometry != nullptr, bundle.pixel != nullptr,
+        bundle.compute != nullptr};
+    for (size_t stage = 0; stage < 6; ++stage)
+        if (bool(input.stages[stage]) != output[stage]) return false;
+    if (input.createBlendState != (bundle.blend != nullptr) ||
+        input.createDepthStencilState != (bundle.depthStencil != nullptr) ||
+        input.createRasterizerState != (bundle.rasterizer != nullptr) ||
+        input.createSamplerState != (bundle.sampler != nullptr)) return false;
+    if (bundle.vertex) bundle.vertex->AddRef();
+    if (bundle.hull) bundle.hull->AddRef();
+    if (bundle.domain) bundle.domain->AddRef();
+    if (bundle.geometry) bundle.geometry->AddRef();
+    if (bundle.pixel) bundle.pixel->AddRef();
+    if (bundle.compute) bundle.compute->AddRef();
+    if (bundle.blend) bundle.blend->AddRef();
+    if (bundle.depthStencil) bundle.depthStencil->AddRef();
+    if (bundle.rasterizer) bundle.rasterizer->AddRef();
+    if (bundle.sampler) bundle.sampler->AddRef();
+    target.vs = bundle.vertex; target.hs = bundle.hull; target.ds = bundle.domain;
+    target.gs = bundle.geometry; target.ps = bundle.pixel; target.cs = bundle.compute;
+    target.blend_state = bundle.blend; target.depth_stencil_state = bundle.depthStencil;
+    target.rs_state = bundle.rasterizer; target.sampler_state = bundle.sampler;
+    target.preparation_pin = prepared;
+    LoadTrace::Get().RecordInstant(LoadStage::ReadinessWait,
+        reinterpret_cast<uintptr_t>(&target), request.estimatedBytes, 0);
+    return true;
+}
+static ID3D11ShaderResourceView* TryGetPreparedShaderResourceViewImpl(ID3D11Resource* resource,
+    ID3D11Device* device, const D3D11_SHADER_RESOURCE_VIEW_DESC* requested) {
+    if (!resource || !requested || requested->ViewDimension != D3D11_SRV_DIMENSION_TEXTURE2D)
+        return nullptr;
+    auto state = Current();
+    auto& service = Services();
+    if (runtimeBusy || service.retirementRequested.load()) return nullptr;
+    TryGlobalConfigGuard configGuard;
+    if (!configGuard.acquired) return nullptr;
+    std::unique_lock<std::recursive_mutex> lock(service.plannerMutex, std::try_to_lock);
+    if (!lock.owns_lock() || service.owner != std::this_thread::get_id()) return nullptr;
+    RuntimeOwnerScope ownerScope(lock);
+    if (!SourcesCurrent(state) || !service.planner || service.device != device ||
+        service.plannerGeneration != state->generation) return nullptr;
+    const auto entry = service.activeResources.find(resource);
+    if (entry == service.activeResources.end()) return nullptr;
+    auto prepared = entry->second.lock();
+    if (!prepared || prepared->resource != resource || !prepared->shaderResourceView) return nullptr;
+    D3D11_RESOURCE_DIMENSION dimension;
+    resource->GetType(&dimension);
+    if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) return nullptr;
+    D3D11_TEXTURE2D_DESC texture{};
+    static_cast<ID3D11Texture2D*>(resource)->GetDesc(&texture);
+    if (texture.ArraySize != 1 || texture.SampleDesc.Count != 1 || texture.SampleDesc.Quality ||
+        (texture.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE)) return nullptr;
+    D3D11_SHADER_RESOURCE_VIEW_DESC actual{};
+    prepared->shaderResourceView->GetDesc(&actual);
+    if (actual.ViewDimension != D3D11_SRV_DIMENSION_TEXTURE2D ||
+        !FullTexture2DViewMatches(uint32_t(texture.Format), texture.MipLevels,
+            uint32_t(requested->Format), requested->Texture2D.MostDetailedMip, requested->Texture2D.MipLevels,
+            uint32_t(actual.Format), actual.Texture2D.MostDetailedMip, actual.Texture2D.MipLevels) ||
+        !SourcesCurrent(state)) return nullptr;
+    prepared->shaderResourceView->AddRef();
+    LoadTrace::Get().RecordInstant(LoadStage::ViewCreation, reinterpret_cast<uintptr_t>(resource), 0, 0);
+    return prepared->shaderResourceView;
+}
+bool TryUsePreparedShaderBundle(CustomShader& target, ID3D11Device* device) {
+    try { return TryUsePreparedShaderBundleImpl(target, device); }
+    catch (...) { return false; }
+}
+ID3D11ShaderResourceView* TryGetPreparedShaderResourceView(ID3D11Resource* resource,
+    ID3D11Device* device, const D3D11_SHADER_RESOURCE_VIEW_DESC* requested) {
+    try { return TryGetPreparedShaderResourceViewImpl(resource, device, requested); }
+    catch (...) { return nullptr; }
+}
+
+void ConfigureRuntime() {
+    try { ConfigureRuntimeImpl(); }
+    catch (...) {
+        CancelRuntimeGeneration();
+        LogInfo("ModLoading configure failed; using compatible loading\n");
+    }
+}
+void PumpRuntime(ID3D11Device* device, DeviceEpoch epoch) {
+    try { PumpRuntimeImpl(device, epoch); }
+    catch (...) {
+        CancelRuntimeGeneration();
+        LogInfo("ModLoading preparation failed; using compatible loading\n");
+    }
+}
+bool TryUsePreparedResource(CustomResource& target, ID3D11Device* device) {
+    try { return TryUsePreparedResourceImpl(target, device); }
+    catch (...) { return false; }
+}
+
+}
