@@ -0,0 +1,34 @@
+#include "oracle.h"
+#include <iostream>
+#include <vector>
+
+int main() {
+    using namespace fixture;
+    auto require = [](bool ok) { if (!ok) throw std::runtime_error("oracle test failed"); };
+    try {
+        require(expected(0,false,0,0) == Pixel{240,0,0,255});
+        require(expected(0,false,63,0) == Pixel{0,240,0,255});
+        require(expected(0,false,0,63) == Pixel{0,0,240,255});
+        require(expected(1,true,63,63) == Pixel{40,80,120,255});
+        constexpr size_t pitch = width * 4 + 32;
+        std::vector<uint8_t> data(pitch * height, 123);
+        for (unsigned outfit = 0; outfit < 3; ++outfit) for (bool dim : {false,true}) {
+            for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+                auto p = expected(outfit,dim,x,y);
+                for (unsigned c = 0; c < 4; ++c) data[y*pitch+x*4+c] = p[c];
+            }
+            require(compare(data.data(),data.size(),pitch,outfit,dim).badPixels == 0);
+            data[0] ^= 127;
+            require(compare(data.data(),data.size(),pitch,outfit,dim).badPixels == 1);
+        }
+        bool rejected = false;
+        try { compare(data.data(),data.size()-1,pitch,0,false); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        require(rejected);
+        rejected = false;
+        try { compare(data.data(),data.size(),SIZE_MAX,0,false); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        require(rejected);
+        std::cout << "PASS: quadrant/color oracle, six variants, corruption, padded rows, bounds\n";
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
