index 0000000000000000000000000000000000000000..2e112c1ad5b1a27ab98c297e6bd88789d6c2d56c
--- /dev/null
+++ b/tests/d3d11_fixture/main.cpp
@@ -0,0 +1,242 @@
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <dxgi.h>
+#include <wrl/client.h>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <string>
+#include <vector>
+#include <cstdio>
+#include <cstring>
+#include "oracle.h"
+
+using Microsoft::WRL::ComPtr;
+namespace fs = std::filesystem;
+using namespace fixture;
+
+static void check(HRESULT hr, const char* operation) {
+    if (FAILED(hr)) {
+        char code[16]; sprintf_s(code, "0x%08lx", static_cast<unsigned long>(hr));
+        throw std::runtime_error(std::string(operation) + ": " + code);
+    }
+}
+static double now() {
+    LARGE_INTEGER counter, frequency;
+    QueryPerformanceCounter(&counter); QueryPerformanceFrequency(&frequency);
+    return double(counter.QuadPart) * 1000.0 / double(frequency.QuadPart);
+}
+struct Reports {
+    fs::path directory;
+    std::ofstream stages, frames, metadata;
+    unsigned epoch = 0;
+    explicit Reports(const fs::path& path) : directory(path) {
+        // A fresh output directory makes stale/partial runs unambiguous.
+        if (!fs::create_directory(path)) throw std::runtime_error("output directory must not exist; parent must exist");
+        stages.open(path / "stages.csv"); frames.open(path / "frames.csv"); metadata.open(path / "metadata.txt");
+        if (!stages || !frames || !metadata) throw std::runtime_error("cannot create reports");
+        stages << "epoch,stage,host_cpu_wall_ms,objects_created\n";
+        frames << "epoch,scenario,iteration,outfit,dim,lod,submit_cpu_wall_ms,readback_wait_cpu_wall_ms,verify_cpu_wall_ms,bad_pixels,max_channel_error,objects_created\n";
+        stages << std::fixed << std::setprecision(6); frames << std::fixed << std::setprecision(6);
+    }
+    void stage(const char* name, double start, unsigned count) {
+        stages << epoch << ',' << name << ',' << now()-start << ',' << count << '\n';
+    }
+};
+
+static ComPtr<ID3DBlob> compile(const char* source, const char* entry, const char* target) {
+    ComPtr<ID3DBlob> code, errors;
+    HRESULT hr = D3DCompile(source, strlen(source), "embedded_fixture.hlsl", nullptr, nullptr,
+        entry, target, D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+        &code, &errors);
+    if (FAILED(hr) && errors) std::cerr.write(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize());
+    check(hr, "D3DCompile"); return code;
+}
+
+struct Host {
+    Reports& reports;
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> context;
+    ComPtr<ID3D11VertexShader> vs;
+    ComPtr<ID3D11PixelShader> ps;
+    ComPtr<ID3D11InputLayout> layout;
+    ComPtr<ID3D11Buffer> vertices[2], indices[2], tint;
+    ComPtr<ID3D11Texture2D> textures[3], target, staging;
+    ComPtr<ID3D11ShaderResourceView> views[3];
+    ComPtr<ID3D11RenderTargetView> rtv;
+    ComPtr<ID3D11RasterizerState> raster;
+    unsigned objects = 0;
+
+    Host(Reports& r, bool warp) : reports(r) {
+        const double start = now();
+        D3D_FEATURE_LEVEL level;
+        const D3D_FEATURE_LEVEL requested[] = {D3D_FEATURE_LEVEL_11_0};
+        check(D3D11CreateDevice(nullptr, warp ? D3D_DRIVER_TYPE_WARP : D3D_DRIVER_TYPE_HARDWARE,
+            nullptr, 0, requested, 1, D3D11_SDK_VERSION, &device, &level, &context), "D3D11CreateDevice");
+        reports.stage("device_create", start, 1);
+        ComPtr<IDXGIDevice> dxgi; ComPtr<IDXGIAdapter> adapter;
+        check(device.As(&dxgi), "Query IDXGIDevice"); check(dxgi->GetAdapter(&adapter), "GetAdapter");
+        DXGI_ADAPTER_DESC desc{}; check(adapter->GetDesc(&desc), "GetDesc");
+        LARGE_INTEGER driver{};
+        HRESULT driverResult = adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &driver);
+        char name[512]{};
+        WideCharToMultiByte(CP_UTF8,0,desc.Description,-1,name,sizeof(name),nullptr,nullptr);
+        reports.metadata << "epoch=" << reports.epoch << " adapter=" << name
+            << " vendor=" << desc.VendorId << " device=" << desc.DeviceId
+            << " dedicated_video_bytes=" << desc.DedicatedVideoMemory
+            << " feature_level=" << unsigned(level) << " creation_flags=0 driver_type=" << (warp?"WARP":"hardware")
+            << " driver_version_query_hr=" << driverResult << " driver_version_raw=" << driver.QuadPart << '\n';
+        prepare();
+    }
+    ~Host() { context->ClearState(); context->Flush(); }
+
+    void prepare() {
+        static constexpr char source[] = R"(
+cbuffer Tint : register(b0) { float4 tint; };
+Texture2D<float4> image : register(t0);
+float4 VS(float2 position : POSITION) : SV_Position { return float4(position,0,1); }
+float4 PS(float4 position : SV_Position) : SV_Target {
+    return image.Load(int3(uint2(position.xy) / 32, 0)) * tint;
+})";
+        double start = now();
+        auto vcode = compile(source,"VS","vs_5_0"), pcode = compile(source,"PS","ps_5_0");
+        reports.stage("shader_compile",start,0);
+        start = now();
+        check(device->CreateVertexShader(vcode->GetBufferPointer(),vcode->GetBufferSize(),nullptr,&vs),"CreateVertexShader"); ++objects;
+        check(device->CreatePixelShader(pcode->GetBufferPointer(),pcode->GetBufferSize(),nullptr,&ps),"CreatePixelShader"); ++objects;
+        D3D11_INPUT_ELEMENT_DESC element{"POSITION",0,DXGI_FORMAT_R32G32_FLOAT,0,0,D3D11_INPUT_PER_VERTEX_DATA,0};
+        check(device->CreateInputLayout(&element,1,vcode->GetBufferPointer(),vcode->GetBufferSize(),&layout),"CreateInputLayout"); ++objects;
+        reports.stage("shader_and_layout_create",start,3);
+        start = now();
+        // Both cover the full target; two triangles versus one oversized triangle.
+        const float high[] = {-1,-1, -1,1, 1,1, 1,-1};
+        const float low[] = {-1,-1, -1,3, 3,-1};
+        const uint16_t highIndices[] = {0,1,2,0,2,3}, lowIndices[] = {0,1,2};
+        for (unsigned i=0;i<2;++i) {
+            D3D11_BUFFER_DESC b{}; b.Usage=D3D11_USAGE_IMMUTABLE; b.BindFlags=D3D11_BIND_VERTEX_BUFFER;
+            b.ByteWidth=i?sizeof(low):sizeof(high);
+            D3D11_SUBRESOURCE_DATA data{}; data.pSysMem=i?low:high;
+            check(device->CreateBuffer(&b,&data,&vertices[i]),"CreateBuffer vertices"); ++objects;
+            b.BindFlags=D3D11_BIND_INDEX_BUFFER; b.ByteWidth=i?sizeof(lowIndices):sizeof(highIndices);
+            data.pSysMem=i?lowIndices:highIndices;
+            check(device->CreateBuffer(&b,&data,&indices[i]),"CreateBuffer indices"); ++objects;
+        }
+        D3D11_BUFFER_DESC cb{}; cb.ByteWidth=16; cb.Usage=D3D11_USAGE_DEFAULT; cb.BindFlags=D3D11_BIND_CONSTANT_BUFFER;
+        check(device->CreateBuffer(&cb,nullptr,&tint),"CreateBuffer tint"); ++objects;
+        D3D11_TEXTURE2D_DESC td{}; td.Width=width; td.Height=height; td.MipLevels=td.ArraySize=1;
+        td.Format=DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count=1; td.Usage=D3D11_USAGE_DEFAULT; td.BindFlags=D3D11_BIND_RENDER_TARGET;
+        check(device->CreateTexture2D(&td,nullptr,&target),"CreateTexture2D target"); ++objects;
+        td.Usage=D3D11_USAGE_STAGING; td.BindFlags=0; td.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+        check(device->CreateTexture2D(&td,nullptr,&staging),"CreateTexture2D staging"); ++objects;
+        reports.stage("buffer_and_target_create",start,7);
+        start=now();
+        check(device->CreateRenderTargetView(target.Get(),nullptr,&rtv),"CreateRenderTargetView"); ++objects;
+        D3D11_RASTERIZER_DESC rs{}; rs.FillMode=D3D11_FILL_SOLID; rs.CullMode=D3D11_CULL_NONE; rs.DepthClipEnable=TRUE;
+        check(device->CreateRasterizerState(&rs,&raster),"CreateRasterizerState"); ++objects;
+        reports.stage("target_view_and_state_create",start,2);
+        outfit(0); outfit(1);
+    }
+    void outfit(unsigned n) {
+        double start=now();
+        Pixel pixels[4]; for(unsigned y=0;y<2;++y) for(unsigned x=0;x<2;++x) pixels[y*2+x]=texel(n,x,y);
+        D3D11_TEXTURE2D_DESC td{}; td.Width=td.Height=2; td.MipLevels=td.ArraySize=1;
+        td.Format=DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count=1; td.Usage=D3D11_USAGE_IMMUTABLE; td.BindFlags=D3D11_BIND_SHADER_RESOURCE;
+        D3D11_SUBRESOURCE_DATA data{}; data.pSysMem=pixels; data.SysMemPitch=2*sizeof(Pixel);
+        check(device->CreateTexture2D(&td,&data,&textures[n]),"CreateTexture2D outfit"); ++objects;
+        reports.stage("outfit_texture_create",start,1); start=now();
+        check(device->CreateShaderResourceView(textures[n].Get(),nullptr,&views[n]),"CreateShaderResourceView"); ++objects;
+        reports.stage("outfit_view_create",start,1);
+    }
+    void render(const char* scenario, unsigned iteration, unsigned n, bool dim, unsigned lod, bool save) {
+        if (n>2 || lod>1 || !views[n]) throw std::runtime_error("unprepared scenario");
+        unsigned before=objects;
+        double start=now();
+        const float scale=dim?0.5f:1.0f, color[4]={scale,scale,scale,1};
+        context->UpdateSubresource(tint.Get(),0,nullptr,color,0,0);
+        ID3D11RenderTargetView* targetView=rtv.Get(); context->OMSetRenderTargets(1,&targetView,nullptr);
+        const float clear[4]={1,0,1,0}; context->ClearRenderTargetView(rtv.Get(),clear);
+        D3D11_VIEWPORT vp{0,0,float(width),float(height),0,1}; context->RSSetViewports(1,&vp); context->RSSetState(raster.Get());
+        context->IASetInputLayout(layout.Get()); context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        ID3D11Buffer* vb=vertices[lod].Get(); UINT stride=sizeof(float)*2, offset=0;
+        context->IASetVertexBuffers(0,1,&vb,&stride,&offset); context->IASetIndexBuffer(indices[lod].Get(),DXGI_FORMAT_R16_UINT,0);
+        context->VSSetShader(vs.Get(),nullptr,0); context->PSSetShader(ps.Get(),nullptr,0);
+        ID3D11ShaderResourceView* srv=views[n].Get(); context->PSSetShaderResources(0,1,&srv);
+        ID3D11Buffer* cb=tint.Get(); context->PSSetConstantBuffers(0,1,&cb);
+        context->DrawIndexed(lod?3:6,0,0);
+        context->CopyResource(staging.Get(),target.Get());
+        const double submitted=now(), submitMs=submitted-start;
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        check(context->Map(staging.Get(),0,D3D11_MAP_READ,0,&mapped),"Map readback");
+        const double mappedAt=now();
+        // Own the readback before Unmap; no file export is timed as rendering.
+        std::vector<uint8_t> image(width*height*4);
+        for(unsigned y=0;y<height;++y) memcpy(image.data()+y*width*4,static_cast<const uint8_t*>(mapped.pData)+y*mapped.RowPitch,width*4);
+        context->Unmap(staging.Get(),0);
+        const auto result=compare(image.data(),image.size(),width*4,n,dim);
+        const double verified=now();
+        reports.frames << reports.epoch << ',' << scenario << ',' << iteration << ',' << n << ',' << dim << ',' << lod << ','
+            << submitMs << ',' << mappedAt-submitted << ',' << verified-mappedAt << ',' << result.badPixels << ',' << result.maxError << ',' << objects-before << '\n';
+        if (result.badPixels) throw std::runtime_error(std::string("readback mismatch: ")+scenario);
+        if (objects!=before) throw std::runtime_error("resource creation during render");
+        if(save) {
+            auto filename=std::string("epoch")+std::to_string(reports.epoch)+"_"+scenario+".ppm";
+            std::ofstream file(reports.directory/filename,std::ios::binary);
+            file << "P6\n" << width << ' ' << height << "\n255\n";
+            for(size_t i=0;i<image.size();i+=4) file.write(reinterpret_cast<const char*>(image.data()+i),3);
+            if(!file) throw std::runtime_error("PPM export failed");
+        }
+    }
+};
+
+int wmain(int argc, wchar_t** argv) {
+    try {
+        fs::path output; bool warp=false; unsigned repeats=30;
+        for(int i=1;i<argc;++i) {
+            std::wstring arg=argv[i];
+            if(arg==L"--warp") warp=true;
+            else if(arg==L"--output" && i+1<argc) output=argv[++i];
+            else if(arg==L"--repeat" && i+1<argc) {
+                std::wstring value=argv[++i]; size_t used=0;
+                auto count=std::stoul(value,&used);
+                if(used!=value.size() || count<1 || count>1000) throw std::runtime_error("repeat must be 1..1000");
+                repeats=static_cast<unsigned>(count);
+            } else throw std::runtime_error("usage: d3d11_fixture --output NEW_DIRECTORY [--warp] [--repeat 1..1000]");
+        }
+        if(output.empty()) throw std::runtime_error("--output NEW_DIRECTORY is required");
+        Reports reports(output);
+        SYSTEMTIME utc{}; GetSystemTime(&utc);
+        reports.metadata << "fixture_schema=1 baseline_source=a7847eae82aaac32175c9a7d199673d5c9323bcd\n"
+            << "utc=" << utc.wYear << '-' << utc.wMonth << '-' << utc.wDay << 'T' << utc.wHour << ':' << utc.wMinute << ':' << utc.wSecond
+            << "Z pid=" << GetCurrentProcessId() << " repeats=" << repeats << " dimensions=64x64 format=RGBA8_UNORM\n"
+            << "synthetic_offscreen=true present=false injection=false source_file_io=false decoder=false gpu_timestamps=false\n"
+            << "timing=host_QPC_wall_ms readback_wait_includes_GPU_synchronization verification_includes_readback_copy\n";
+        for(unsigned epoch=1;epoch<=2;++epoch) {
+            reports.epoch=epoch;
+            Host host(reports,warp);
+            host.render(epoch==1?"first_use":"device_recreated",0,0,false,0,true);
+            for(unsigned i=0;i<repeats;++i) {
+                host.render("revisit",i,0,false,0,i==0);
+                host.render("outfit_1",i,1,false,0,i==0);
+                host.render("toggle_dim",i,1,true,0,i==0);
+                host.render("lod_low",i,1,true,1,i==0);
+                host.render("lod_high",i,1,true,0,i==0);
+                host.context->ClearState(); // Synthetic no-change rebind, not the importer's F10 path.
+                host.render("unchanged_rebind",i,0,false,0,i==0);
+            }
+            host.outfit(2); // Preparation is recorded separately from the following first draw.
+            host.render("new_generation",0,2,false,0,true);
+            host.render("new_generation_revisit",1,2,false,1,true);
+        }
+        reports.frames.flush(); reports.stages.flush(); reports.metadata.flush();
+        if(!reports.frames || !reports.stages || !reports.metadata) throw std::runtime_error("report write failed");
+        // The success marker is last. Its absence means the run is incomplete/failed.
+        std::ofstream success(output/"PASS.txt");
+        success << "All " << 2*(1+6*repeats+2) << " rendered readbacks matched the CPU oracle (max per-channel tolerance 1).\n"
+                << "Synthetic fixture only; no in-game acceptance or performance claim.\n";
+        success.close(); if(!success) throw std::runtime_error("success marker write failed");
+        std::cout << "PASS: all readbacks verified; see output reports\n";
+        return 0;
+    } catch(const std::exception& e) { std::cerr << "FAIL: " << e.what() << '\n'; return 1; }
+}
diff --git a/tests/d3d11_fixture/oracle.h b/tests/d3d11_fixture/oracle.h
new file mode 100644
index 0000000000000000000000000000000000000000..6fdcfa0c12efa7713f4c07c6a0ad510a80533277
--- /dev/null
+++ b/tests/d3d11_fixture/oracle.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+namespace fixture {
+constexpr unsigned width = 64, height = 64;
+using Pixel = std::array<uint8_t, 4>;
+// Exact UNORM-friendly values. Quadrants distinguish UV/axis/orientation errors.
+inline Pixel texel(unsigned outfit, unsigned x, unsigned y) {
+    if (outfit > 2 || x > 1 || y > 1) throw std::invalid_argument("texel range");
+    const unsigned q = y * 2 + x;
+    const Pixel palettes[3][4] = {
+        {{240,0,0,255},{0,240,0,255},{0,0,240,255},{240,240,240,255}},
+        {{240,240,0,255},{0,240,240,255},{240,0,240,255},{80,160,240,255}},
+        {{80,0,160,255},{160,80,0,255},{0,160,80,255},{160,160,160,255}}
+    };
+    return palettes[outfit][q];
+}
+inline Pixel expected(unsigned outfit, bool dim, unsigned x, unsigned y) {
+    if (x >= width || y >= height) throw std::invalid_argument("pixel range");
+    Pixel p = texel(outfit, x / 32, y / 32);
+    if (dim) for (unsigned c = 0; c < 3; ++c) p[c] /= 2;
+    return p;
+}
+struct Comparison { size_t badPixels = 0; unsigned maxError = 0; };
+inline Comparison compare(const uint8_t* bytes, size_t size, size_t pitch,
+                          unsigned outfit, bool dim) {
+    if (!bytes || pitch < width * 4 || pitch > SIZE_MAX / height || size < pitch * height)
+        throw std::invalid_argument("invalid readback layout");
+    Comparison result;
+    for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+        auto p = expected(outfit, dim, x, y);
+        bool bad = false;
+        for (unsigned c = 0; c < 4; ++c) {
+            int delta = int(bytes[y * pitch + x * 4 + c]) - int(p[c]);
+            unsigned error = unsigned(delta < 0 ? -delta : delta);
+            if (error > result.maxError) result.maxError = error;
+            bad |= error > 1; // D3D UNORM rounding tolerance; alpha included.
+        }
+        result.badPixels += bad;
+    }
+    return result;
+}
+}
diff --git a/tests/d3d11_fixture/oracle_test.cpp b/tests/d3d11_fixture/oracle_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..74d2d737b73b206da47b8c67f4b62d8ec157d869
--- /dev/null
+++ b/tests/d3d11_fixture/oracle_test.cpp
@@ -0,0 +1,34 @@
+#include "oracle.h"
+#include <iostream>
+#include <vector>
+
+int main() {
+    using namespace fixture;
+    auto require = [](bool ok) { if (!ok) throw std::runtime_error("oracle test failed"); };
+    try {
+        require(expected(0,false,0,0) == Pixel{240,0,0,255});
+        require(expected(0,false,63,0) == Pixel{0,240,0,255});
+        require(expected(0,false,0,63) == Pixel{0,0,240,255});
+        require(expected(1,true,63,63) == Pixel{40,80,120,255});
+        constexpr size_t pitch = width * 4 + 32;
+        std::vector<uint8_t> data(pitch * height, 123);
+        for (unsigned outfit = 0; outfit < 3; ++outfit) for (bool dim : {false,true}) {
+            for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+                auto p = expected(outfit,dim,x,y);
+                for (unsigned c = 0; c < 4; ++c) data[y*pitch+x*4+c] = p[c];
+            }
+            require(compare(data.data(),data.size(),pitch,outfit,dim).badPixels == 0);
+            data[0] ^= 127;
+            require(compare(data.data(),data.size(),pitch,outfit,dim).badPixels == 1);
+        }
+        bool rejected = false;
+        try { compare(data.data(),data.size()-1,pitch,0,false); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        require(rejected);
+        rejected = false;
+        try { compare(data.data(),data.size(),SIZE_MAX,0,false); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        require(rejected);
+        std::cout << "PASS: quadrant/color oracle, six variants, corruption, padded rows, bounds\n";
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
diff --git a/tests/mod_loading/README.md b/tests/mod_loading/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..2706950f15859dc524ff6f6406ccdea51fb24bca
--- /dev/null
+++ b/tests/mod_loading/README.md
@@ -0,0 +1,33 @@
+# Portable LoadTrace checks
+
+From the repository root:
+
+```sh
+mkdir -p work
+c++ -std=c++14 -O2 -Wall -Wextra -Werror -pthread DirectX11/ModLoading/LoadTrace.cpp tests/mod_loading/load_trace_test.cpp -o work/load_trace_test
+./work/load_trace_test
+```
+
+Checks disabled recording, command-list opt-in filtering, allocation-free
+producers, scoped bytes/results and frame attribution, stale session rejection,
+explicit first-correct-frame markers, bounded overflow, CSV output and failure,
+I/O outside the producer lock, and six concurrent producers with a consumer.
+The concurrent test reconciles every attempted record with accepted events or
+explicit full/contention losses and checks accepted records for coherent fields.
+
+The ring holds at most 8192 records. The Windows worker drains it every 100 ms
+to a bounded CSV, so a capture can contain more records than the ring capacity.
+Capture-specific accounting distinguishes a complete footer from lossless data;
+full-buffer drops, stale scopes, outstanding work and failed writes invalidate
+the lossless result. Lifetime counters remain separate. Command-list tracing
+defaults off to limit diagnostic overhead.
+
+`load_trace_streaming_test.cpp` also checks continuous export, graceful stop,
+session isolation, stream failures and size/time limits. Compile it with
+`LoadTrace.cpp` and `TraceControl.cpp` using the same portable flags above.
+
+The prepared-loading Windows workflow builds a separate trace fixture DLL and
+host from `load_trace_streaming_windows_fixture.cpp`. It checks file growth
+while recording, a lossless 100,000-event stream, in-flight stop scopes, closed
+output files and restart. These fixtures make no claim about a separate
+collector's ABI, rendered correctness, game performance or release qualification.
diff --git a/tests/mod_loading/load_trace_streaming_test.cpp b/tests/mod_loading/load_trace_streaming_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4456a73ad99bcb438dff43fa82f73ee7dff078ee
--- /dev/null
+++ b/tests/mod_loading/load_trace_streaming_test.cpp
@@ -0,0 +1,214 @@
+#include "../../DirectX11/ModLoading/LoadTrace.h"
+#include "../../DirectX11/ModLoading/TraceControl.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <iostream>
+#include <sstream>
+#include <thread>
+
+using namespace ModLoading;
+
+static void Empty()
+{
+    LoadTraceRecord batch[128];
+    while (LoadTrace::Get().Drain(batch, 128)) {}
+}
+static std::uint64_t Begin()
+{
+    auto& trace = LoadTrace::Get();
+    trace.SetEnabled(false);
+    Empty();
+    trace.SetEnabled(true);
+    assert(trace.IsEnabled());
+    return trace.CaptureSession();
+}
+static LoadTraceStreamLimits FastLimits()
+{
+    LoadTraceStreamLimits limits;
+    limits.intervalMilliseconds = 1;
+    limits.finalAttempts = 3;
+    return limits;
+}
+class PartialBuffer : public std::stringbuf {
+    std::streamsize remaining_ = 512;
+protected:
+    std::streamsize xsputn(const char* data, std::streamsize size) override
+    {
+        const auto count = (std::min)(remaining_, size);
+        remaining_ -= count;
+        return std::stringbuf::xsputn(data, count);
+    }
+};
+class FailedBuffer : public std::streambuf {
+protected:
+    std::streamsize xsputn(const char*, std::streamsize) override { return 0; }
+    int overflow(int) override { return traits_type::eof(); }
+};
+
+int main()
+{
+    auto& trace = LoadTrace::Get();
+    // Actual 100ms worker cadence, bounded rate below ring/tick capacity, and
+    // enough events to wrap the ring twelve times. No full or contention loss.
+    auto session = Begin();
+    std::ostringstream csv;
+    bool success = false;
+    std::thread worker([&] { success = StreamLoadTraceCapture(csv, session); });
+    for (std::uint64_t batch = 0; batch < 100; ++batch) {
+        for (std::uint64_t i = 0; i < 1000; ++i) trace.RecordInstant(LoadStage::Discovery, batch * 1000 + i);
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    }
+    trace.EndCapture(session);
+    worker.join();
+    assert(success);
+    const auto stats = trace.GetCaptureStats(session);
+    assert(stats.accepted == 100000 && stats.drained == 100000);
+    assert(!stats.droppedFull && !stats.droppedContention && !stats.outstanding);
+    assert(csv.str().find("structural_complete=1;lossless=1;accepted=100000;drained=100000;written=100000") != std::string::npos);
+
+    // Present -> ReloadConfig -> Configure(false) stops new admission while
+    // both already-open durations remain pinned to the old capture. Model the
+    // exact configuration stop request; only the worker waits for completion.
+    session = Begin();
+    std::ostringstream gracefulCsv;
+    bool gracefulSuccess = false;
+    auto gracefulLimits = FastLimits(); gracefulLimits.finalAttempts = 100;
+    std::thread gracefulWorker;
+    {
+        ScopedLoadTrace present(LoadStage::Present);
+        ScopedLoadTrace reload(LoadStage::ConfigReload);
+        gracefulWorker = std::thread([&] {
+            gracefulSuccess = StreamLoadTraceCapture(gracefulCsv, session, gracefulLimits);
+        });
+        assert(trace.RequestEndCapture(session));
+        assert(!trace.IsEnabled());
+        trace.RecordInstant(LoadStage::Discovery); // admission closed
+        { ScopedLoadTrace excluded(LoadStage::Decode); }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    gracefulWorker.join();
+    assert(gracefulSuccess);
+    assert(gracefulCsv.str().find("accepted=2;drained=2;written=2") != std::string::npos);
+    assert(gracefulCsv.str().find("lossless=1") != std::string::npos);
+    assert(gracefulCsv.str().find("config_reload,duration,") != std::string::npos);
+    assert(gracefulCsv.str().find("present_cpu,duration,") != std::string::npos);
+
+    // A stuck pinned scope expires the worker-only grace window. Closing the
+    // window prevents its eventual destruction from publishing late records.
+    session = Begin();
+    {
+        ScopedLoadTrace stuck(LoadStage::ConfigReload);
+        assert(trace.RequestEndCapture(session));
+        std::ostringstream stuckCsv;
+        assert(!StreamLoadTraceCapture(stuckCsv, session, FastLimits()));
+        assert(stuckCsv.str().find("lossless=0") != std::string::npos);
+        assert(stuckCsv.str().find("outstanding=1") != std::string::npos);
+    }
+    assert(trace.GetCaptureStats(session).accepted == 0);
+    assert(trace.GetCaptureStats(session).stale == 1);
+
+    // A structurally finished file with full loss must never claim lossless.
+    session = Begin();
+    for (std::size_t i = 0; i < LoadTrace::Capacity + 7; ++i) trace.RecordInstant(LoadStage::Decode);
+    trace.EndCapture(session);
+    std::ostringstream full;
+    assert(!StreamLoadTraceCapture(full, session, FastLimits()));
+    assert(full.str().find("structural_complete=1;lossless=0") != std::string::npos);
+    assert(full.str().find("dropped_full=7") != std::string::npos);
+
+    // An unclosed duration is explicit outstanding work. Its eventual stale
+    // submission belongs only to the old capture, even after restart.
+    session = Begin();
+    {
+        ScopedLoadTrace late(LoadStage::FileRead);
+        trace.EndCapture(session);
+        std::ostringstream lateCsv;
+        assert(!StreamLoadTraceCapture(lateCsv, session, FastLimits()));
+        assert(lateCsv.str().find("outstanding=1") != std::string::npos);
+        trace.SetEnabled(true);
+        const auto next = trace.CaptureSession();
+        trace.RecordInstant(LoadStage::Activation);
+        assert(!trace.EndCapture(session)); // stale worker cannot stop new capture
+        assert(trace.CaptureSession() == next);
+    }
+    const auto next = trace.CaptureSession();
+    trace.EndCapture(next);
+    std::ostringstream nextCsv;
+    assert(StreamLoadTraceCapture(nextCsv, next, FastLimits()));
+    assert(nextCsv.str().find("accepted=1;drained=1;written=1") != std::string::npos);
+
+    // Foreign queued rows are excluded; their counters cannot satisfy this file.
+    session = Begin();
+    trace.RecordInstant(LoadStage::Discovery);
+    trace.EndCapture(session);
+    trace.SetEnabled(true);
+    const auto restarted = trace.CaptureSession();
+    trace.RecordInstant(LoadStage::Activation);
+    trace.EndCapture(restarted);
+    std::ostringstream restartedCsv;
+    assert(StreamLoadTraceCapture(restartedCsv, restarted, FastLimits()));
+    assert(restartedCsv.str().find("foreign_discarded=1") != std::string::npos);
+    assert(restartedCsv.str().find("accepted=1;drained=1;written=1") != std::string::npos);
+
+    // A competing consumer makes per-file written accounting incomplete.
+    session = Begin();
+    trace.RecordInstant(LoadStage::Discovery);
+    LoadTraceRecord stolen;
+    assert(trace.Drain(&stolen, 1) == 1);
+    trace.EndCapture(session);
+    std::ostringstream stolenCsv;
+    assert(!StreamLoadTraceCapture(stolenCsv, session, FastLimits()));
+    assert(stolenCsv.str().find("accepted=1;drained=1;written=0") != std::string::npos);
+
+    // Two worker consumers remain safe; only the worker that wrote every row
+    // may qualify. A worker cannot complete using another worker's drained rows.
+    session = Begin();
+    for (int i = 0; i < 2000; ++i) trace.RecordInstant(LoadStage::Decode);
+    trace.EndCapture(session);
+    std::ostringstream first, second;
+    bool firstGood = false, secondGood = false;
+    std::thread firstWorker([&] { firstGood = StreamLoadTraceCapture(first, session, FastLimits()); });
+    std::thread secondWorker([&] { secondGood = StreamLoadTraceCapture(second, session, FastLimits()); });
+    firstWorker.join(); secondWorker.join();
+    assert(!(firstGood && secondGood));
+    assert(trace.GetCaptureStats(session).drained == 2000);
+
+    // File byte and time limits stop capture and emit loss-aware final metadata.
+    session = Begin();
+    for (int i = 0; i < 1000; ++i) trace.RecordInstant(LoadStage::Decode);
+    auto limits = FastLimits(); limits.maximumBytes = 4096;
+    std::ostringstream bounded;
+    assert(!StreamLoadTraceCapture(bounded, session, limits));
+    assert(!trace.IsEnabled() && bounded.str().size() <= limits.maximumBytes);
+    assert(bounded.str().find("lossless=0") != std::string::npos);
+    Empty();
+    session = Begin();
+    limits = FastLimits(); limits.maximumMilliseconds = 2;
+    std::ostringstream timed;
+    assert(!StreamLoadTraceCapture(timed, session, limits));
+    assert(!trace.IsEnabled() && timed.str().find("reason=time_limit") != std::string::npos);
+
+    // Row write failure after draining is accounted as unwritten, and cannot
+    // leave any lossless footer. This is distinct from failing to open/header.
+    session = Begin();
+    for (int i = 0; i < 100; ++i) trace.RecordInstant(LoadStage::Decode);
+    PartialBuffer partialBuffer;
+    std::ostream partial(&partialBuffer);
+    assert(!StreamLoadTraceCapture(partial, session, FastLimits()));
+    assert(!trace.IsEnabled());
+    assert(trace.GetCaptureStats(session).drained == 100);
+    assert(partialBuffer.str().find("lossless=1") == std::string::npos);
+
+    // A rejected write disables this capture without a success footer.
+    session = Begin();
+    trace.RecordInstant(LoadStage::Decode);
+    FailedBuffer failure;
+    std::ostream failed(&failure);
+    assert(!StreamLoadTraceCapture(failed, session, FastLimits()));
+    assert(!trace.IsEnabled());
+    Empty();
+    std::cout << "LoadTrace streaming portable tests passed\n";
+}
diff --git a/tests/mod_loading/load_trace_streaming_windows_fixture.cpp b/tests/mod_loading/load_trace_streaming_windows_fixture.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8cf301691d162a97d5622b22959be7ac35ad312c
--- /dev/null
+++ b/tests/mod_loading/load_trace_streaming_windows_fixture.cpp
@@ -0,0 +1,142 @@
+// Run from an x64 Visual Studio developer prompt, in the repository root:
+// cl /nologo /std:c++14 /EHsc /W4 /WX /LD /DLOAD_TRACE_FIXTURE_DLL DirectX11\ModLoading\LoadTrace.cpp DirectX11\ModLoading\TraceControl.cpp tests\mod_loading\load_trace_streaming_windows_fixture.cpp /link /OUT:work\load-trace-fixture.dll
+// cl /nologo /std:c++14 /EHsc /W4 /WX tests\mod_loading\load_trace_streaming_windows_fixture.cpp /Fe:work\load-trace-fixture.exe
+// work\load-trace-fixture.exe work\load-trace-fixture.dll
+// This fixture exercises our native worker; it makes no collector ABI claim.
+#include <Windows.h>
+
+#ifdef LOAD_TRACE_FIXTURE_DLL
+#include "../../DirectX11/ModLoading/LoadTrace.h"
+#include "../../DirectX11/ModLoading/TraceControl.h"
+extern "C" __declspec(dllexport) BOOL FixtureStart()
+{
+    return ModLoading::ConfigureLoadTrace(true) ? TRUE : FALSE;
+}
+extern "C" __declspec(dllexport) void FixtureEmit(unsigned count)
+{
+    for (unsigned i = 0; i < count; ++i)
+        ModLoading::LoadTrace::Get().RecordInstant(ModLoading::LoadStage::Discovery, i);
+}
+extern "C" __declspec(dllexport) BOOL FixtureStop()
+{
+    // Models Present -> reload -> LoadConfigFile -> Configure(false): both
+    // durations end after the stop request and must be captured losslessly.
+    ModLoading::ScopedLoadTrace present(ModLoading::LoadStage::Present);
+    ModLoading::ScopedLoadTrace reload(ModLoading::LoadStage::ConfigReload);
+    const bool stopped = ModLoading::ConfigureLoadTrace(false);
+    const bool restartRejected = !ModLoading::ConfigureLoadTrace(true);
+    return stopped && restartRejected ? TRUE : FALSE;
+}
+#else
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+static std::vector<std::wstring> Files(const std::wstring& directory)
+{
+    std::vector<std::wstring> files;
+    WIN32_FIND_DATAW data;
+    HANDLE search = FindFirstFileW((directory + L"\\mod-load-trace-*.csv").c_str(), &data);
+    if (search == INVALID_HANDLE_VALUE) return files;
+    do { files.push_back(directory + L"\\" + data.cFileName); } while (FindNextFileW(search, &data));
+    FindClose(search);
+    return files;
+}
+static std::string ReadClosed(const std::wstring& path)
+{
+    // Exclusive read verifies the writer has closed, rather than merely emitted
+    // its footer. This fixture keeps storage completion separate from counters.
+    HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, 0, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return {};
+    std::string contents;
+    char buffer[4096];
+    DWORD read = 0;
+    while (ReadFile(file, buffer, sizeof(buffer), &read, NULL) && read) contents.append(buffer, read);
+    CloseHandle(file);
+    return contents;
+}
+int wmain(int argc, wchar_t** argv)
+{
+    assert(argc == 2);
+    wchar_t temporary[MAX_PATH], unique[MAX_PATH];
+    assert(GetTempPathW(MAX_PATH, temporary));
+    assert(GetTempFileNameW(temporary, L"xlt", 0, unique));
+    assert(DeleteFileW(unique));
+    assert(CreateDirectoryW(unique, NULL));
+    const std::wstring directory(unique), dll = directory + L"\\trace-fixture.dll";
+    assert(CopyFileW(argv[1], dll.c_str(), TRUE));
+    HMODULE module = LoadLibraryW(dll.c_str());
+    assert(module);
+    BOOL (*start)() = nullptr;
+    void (*emit)(unsigned) = nullptr;
+    BOOL (*stop)() = nullptr;
+    FARPROC address = GetProcAddress(module, "FixtureStart");
+    static_assert(sizeof(start) == sizeof(address), "Windows function pointer ABI");
+    std::memcpy(&start, &address, sizeof(start));
+    address = GetProcAddress(module, "FixtureEmit");
+    std::memcpy(&emit, &address, sizeof(emit));
+    address = GetProcAddress(module, "FixtureStop");
+    std::memcpy(&stop, &address, sizeof(stop));
+    assert(start && emit && stop && start());
+    assert(start()); // repeated true configuration is idempotent
+    bool observedStreaming = false;
+    for (unsigned batch = 0; batch < 100; ++batch) {
+        emit(1000);
+        Sleep(20);
+        if (batch == 30) {
+            const auto files = Files(directory);
+            assert(files.size() == 1);
+            WIN32_FILE_ATTRIBUTE_DATA info;
+            assert(GetFileAttributesExW(files.front().c_str(), GetFileExInfoStandard, &info));
+            observedStreaming = info.nFileSizeLow > 4096 || info.nFileSizeHigh;
+        }
+    }
+    assert(observedStreaming && stop());
+    bool complete = false;
+    for (unsigned attempt = 0; attempt < 100 && !complete; ++attempt) {
+        const auto files = Files(directory);
+        assert(files.size() == 1);
+        const auto csv = ReadClosed(files.front());
+        complete = csv.find("structural_complete=1;lossless=1;accepted=100002;drained=100002;written=100002") != std::string::npos;
+        if (!complete) Sleep(20);
+    }
+    assert(complete);
+    bool restarted = false;
+    for (unsigned attempt = 0; attempt < 100 && !restarted; ++attempt) {
+        restarted = start() != FALSE;
+        if (!restarted) Sleep(20);
+    }
+    assert(restarted);
+    emit(1);
+    assert(stop());
+    complete = false;
+    for (unsigned attempt = 0; attempt < 100 && !complete; ++attempt) {
+        const auto files = Files(directory);
+        if (files.size() == 2) {
+            for (const auto& file : files) {
+                if (ReadClosed(file).find("structural_complete=1;lossless=1;accepted=3;drained=3;written=3;") != std::string::npos)
+                    complete = true;
+            }
+        }
+        if (!complete) Sleep(20);
+    }
+    assert(complete);
+    assert(FreeLibrary(module));
+    // Worker module pin may briefly outlive its closed file. Retry deletion;
+    // never unload or join the worker from DllMain.
+    bool deleted = false;
+    for (unsigned attempt = 0; attempt < 100 && !deleted; ++attempt) {
+        deleted = DeleteFileW(dll.c_str()) != FALSE;
+        if (!deleted) Sleep(20);
+    }
+    assert(deleted);
+    for (const auto& file : Files(directory)) assert(DeleteFileW(file.c_str()));
+    assert(RemoveDirectoryW(directory.c_str()));
+    std::cout << "LoadTrace native streaming fixture passed\n";
+}
+#endif
diff --git a/tests/mod_loading/load_trace_test.cpp b/tests/mod_loading/load_trace_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0826f07ab912acd23542c815d3302ba4844c30db
--- /dev/null
+++ b/tests/mod_loading/load_trace_test.cpp
@@ -0,0 +1,232 @@
+#include "../../DirectX11/ModLoading/LoadTrace.h"
+
+#include <cassert>
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <sstream>
+#include <thread>
+
+// Catch accidental producer heap allocation, including in first enabled use on
+// each producer thread. Consumer/export allocations are intentionally allowed.
+static thread_local bool denyAllocation = false;
+void* operator new(std::size_t size)
+{
+    assert(!denyAllocation);
+    if (void* p = std::malloc(size ? size : 1)) return p;
+    throw std::bad_alloc();
+}
+void* operator new[](std::size_t size) { return ::operator new(size); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+#if __cplusplus >= 201402L
+void operator delete(void* p, std::size_t) noexcept { std::free(p); }
+void operator delete[](void* p, std::size_t) noexcept { std::free(p); }
+#endif
+
+using namespace ModLoading;
+
+namespace ModLoading {
+struct LoadTraceTestAccess {
+    static void Lock(LoadTrace& trace)
+    {
+        const bool alreadyLocked = trace.lock_.test_and_set(std::memory_order_acquire);
+        assert(!alreadyLocked);
+    }
+    static void Unlock(LoadTrace& trace) { trace.lock_.clear(std::memory_order_release); }
+    static void Collision(LoadTrace& trace)
+    {
+        const auto tail = trace.tail_.load();
+        auto& slot = trace.records_[tail % LoadTrace::Capacity];
+        assert(slot.sequence.load() == tail);
+        slot.sequence.store(tail + LoadTrace::Capacity * 2);
+        trace.RecordInstant(LoadStage::Decode);
+        slot.sequence.store(tail);
+    }
+};
+}
+
+static void Empty(LoadTrace& trace)
+{
+    LoadTraceRecord batch[128];
+    while (trace.Drain(batch, 128)) {}
+}
+
+// Simulate worker-side I/O calling back into a producer. A successful callback
+// proves the buffer lock is not held while formatting/writing a drained row.
+class ReentrantBuffer : public std::stringbuf {
+public:
+    bool submitted = false;
+protected:
+    std::streamsize xsputn(const char* data, std::streamsize size) override
+    {
+        if (!submitted && std::string(data, static_cast<std::size_t>(size)) == "discovery") {
+            submitted = true;
+            LoadTrace::Get().RecordInstant(LoadStage::ViewCreation, 987);
+        }
+        return std::stringbuf::xsputn(data, size);
+    }
+};
+
+int main()
+{
+    LoadTrace& trace = LoadTrace::Get();
+    assert(!trace.IsEnabled());
+    denyAllocation = true;
+    trace.RecordInstant(LoadStage::Discovery);
+    { ScopedLoadTrace scope(LoadStage::FileRead); scope.SetBytes(42); }
+    denyAllocation = false;
+    assert(trace.GetStats().accepted == 0);
+
+    trace.SetEnabled(true);
+    const std::uint64_t firstFrame = trace.AdvanceFrame();
+    denyAllocation = true;
+    {
+        ScopedLoadTrace scope(LoadStage::FileRead, 123);
+        scope.SetBytes(456);
+        scope.SetResult(-7);
+        trace.AdvanceFrame();
+    }
+    // A timer alone cannot claim a known-correct rendering result.
+    { ScopedLoadTrace forbidden(LoadStage::FirstCorrectFrame); }
+    trace.RecordInstant(LoadStage::FirstCorrectFrame, 123);
+    denyAllocation = false;
+    LoadTraceRecord records[4];
+    assert(trace.Drain(records, 4) == 2);
+    assert(records[0].kind == LoadTraceKind::Duration);
+    assert(records[0].objectId == 123 && records[0].bytes == 456 && records[0].result == -7);
+    assert(records[0].startFrame == firstFrame && records[0].endFrame == firstFrame + 1);
+    assert(records[0].threadId != 0);
+    assert(records[1].stage == LoadStage::FirstCorrectFrame);
+    assert(records[1].kind == LoadTraceKind::Instant && records[1].result == LoadTrace::UnknownResult);
+    const std::uint64_t firstSession = records[0].captureSession;
+
+    // No command-list timing/markers unless explicitly enabled for diagnosis.
+    { ScopedLoadTrace filtered(LoadStage::CommandList); }
+    trace.RecordInstant(LoadStage::CommandList);
+    assert(trace.Drain(records, 4) == 0);
+    trace.SetCommandListTracing(true);
+    { ScopedLoadTrace enabled(LoadStage::CommandList); enabled.SetResult(9); }
+    assert(trace.Drain(records, 4) == 1);
+    assert(records[0].stage == LoadStage::CommandList && records[0].result == 9);
+    trace.SetCommandListTracing(false);
+
+    // A scope opened in an old session must not contaminate the new session.
+    {
+        ScopedLoadTrace stale(LoadStage::Decode);
+        trace.SetEnabled(false);
+        trace.SetEnabled(true);
+    }
+    assert(trace.Drain(records, 4) == 0);
+    trace.RecordInstant(LoadStage::Activation);
+    assert(trace.Drain(records, 4) == 1 && records[0].captureSession > firstSession);
+
+    const LoadTraceStats beforeFull = trace.GetStats();
+    denyAllocation = true;
+    for (std::size_t i = 0; i < LoadTrace::Capacity + 19; ++i)
+        trace.RecordInstant(LoadStage::Discovery, i);
+    denyAllocation = false;
+    const LoadTraceStats afterFull = trace.GetStats();
+    assert(afterFull.accepted - beforeFull.accepted == LoadTrace::Capacity);
+    assert(afterFull.droppedFull - beforeFull.droppedFull == 19);
+    assert(trace.Drain(nullptr, 100) == 0 && trace.Drain(records, 0) == 0);
+    std::ostringstream csv;
+    assert(trace.ExportCsv(csv) == LoadTrace::Capacity);
+    assert(csv.str().find("stage,kind,capture_session,") != std::string::npos);
+    assert(csv.str().find("dropped_full=19") != std::string::npos);
+    assert(trace.Drain(records, 4) == 0);
+
+    trace.RecordInstant(LoadStage::Discovery);
+    const LoadTraceStats beforeExport = trace.GetStats();
+    ReentrantBuffer reentrantBuffer;
+    std::ostream reentrantStream(&reentrantBuffer);
+    assert(trace.ExportCsv(reentrantStream) == 2);
+    assert(reentrantBuffer.submitted);
+    assert(trace.GetStats().accepted == beforeExport.accepted + 1);
+    assert(trace.GetStats().droppedContention == beforeExport.droppedContention);
+    trace.RecordInstant(LoadStage::FileRead);
+    std::ostringstream failedOutput;
+    failedOutput.setstate(std::ios::badbit);
+    assert(trace.ExportCsv(failedOutput) == 0);
+    assert(trace.Drain(records, 4) == 1);
+
+    // A consumer can remain blocked while producers fill every free slot.
+    const auto beforeBlocked = trace.GetStats();
+    LoadTraceTestAccess::Lock(trace);
+    denyAllocation = true;
+    for (std::size_t i = 0; i < LoadTrace::Capacity; ++i)
+        trace.RecordInstant(LoadStage::Discovery, i);
+    denyAllocation = false;
+    LoadTraceTestAccess::Unlock(trace);
+    assert(trace.GetStats().accepted - beforeBlocked.accepted == LoadTrace::Capacity);
+    assert(trace.GetStats().droppedContention == beforeBlocked.droppedContention);
+    Empty(trace);
+    // Deterministic unavailable-slot collision does not reserve a queue hole.
+    const auto beforeCollision = trace.GetStats();
+    LoadTraceTestAccess::Collision(trace);
+    assert(trace.GetStats().droppedContention == beforeCollision.droppedContention + 1);
+    trace.RecordInstant(LoadStage::Decode, 9876);
+    assert(trace.Drain(records, 4) == 1 && records[0].objectId == 9876);
+
+    // Deterministic contention: an exporter must report an incomplete capture,
+    // rather than treating the occupied producer flag as an empty queue.
+    trace.RecordInstant(LoadStage::Decode, 765);
+    LoadTraceTestAccess::Lock(trace);
+    std::ostringstream contendedOutput;
+    assert(trace.ExportCsv(contendedOutput) == 0);
+    LoadTraceTestAccess::Unlock(trace);
+    assert(contendedOutput.fail());
+    assert(contendedOutput.str().find("export_incomplete=contention_retry_limit") != std::string::npos);
+    assert(trace.Drain(records, 4) == 1 && records[0].objectId == 765);
+
+    // Concurrent producers and consumer: all attempts are either accepted or
+    // explicitly counted as losses, and all accepted records remain coherent.
+    const LoadTraceStats beforeConcurrent = trace.GetStats();
+    const std::size_t producerCount = 6;
+    const std::size_t perProducer = 20000;
+    std::atomic<bool> start(false), finished(false);
+    std::atomic<std::uint64_t> consumed(0);
+    std::thread consumer([&] {
+        LoadTraceRecord batch[113];
+        while (!start.load()) std::this_thread::yield();
+        while (!finished.load()) {
+            const std::size_t count = trace.Drain(batch, 113);
+            for (std::size_t i = 0; i < count; ++i) {
+                assert(batch[i].stage == LoadStage::GpuCreation);
+                assert(batch[i].bytes == batch[i].objectId * 2);
+                assert(batch[i].result == -static_cast<std::int64_t>(batch[i].objectId));
+            }
+            consumed.fetch_add(count);
+        }
+    });
+    std::thread producers[producerCount];
+    for (std::size_t p = 0; p < producerCount; ++p) producers[p] = std::thread([&, p] {
+        while (!start.load()) std::this_thread::yield();
+        denyAllocation = true;
+        for (std::size_t i = 0; i < perProducer; ++i) {
+            const std::uint64_t id = p * perProducer + i;
+            trace.RecordInstant(LoadStage::GpuCreation, id, id * 2, -static_cast<std::int64_t>(id));
+        }
+        denyAllocation = false;
+    });
+    start.store(true);
+    for (auto& producer : producers) producer.join();
+    finished.store(true);
+    consumer.join();
+    LoadTraceRecord finalBatch[128];
+    std::size_t count;
+    while ((count = trace.Drain(finalBatch, 128)) != 0) consumed.fetch_add(count);
+    const LoadTraceStats afterConcurrent = trace.GetStats();
+    assert(afterConcurrent.accepted - beforeConcurrent.accepted == consumed.load());
+    assert(afterConcurrent.accepted - beforeConcurrent.accepted +
+           afterConcurrent.droppedFull - beforeConcurrent.droppedFull +
+           afterConcurrent.droppedContention - beforeConcurrent.droppedContention == producerCount * perProducer);
+    assert(afterConcurrent.exported - beforeConcurrent.exported == consumed.load());
+
+    trace.SetEnabled(false);
+    trace.RecordInstant(LoadStage::Present);
+    Empty(trace);
+    assert(trace.GetStats().accepted == afterConcurrent.accepted);
+    std::cout << "LoadTrace portable tests passed\n";
+}
