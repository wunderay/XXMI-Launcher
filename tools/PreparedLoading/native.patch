+	BuildTextureOverrideDrawMaps();
+
+	LogInfo("[Present]\n");
+	ConfigState().present_command_list.clear();
+	ConfigState().post_present_command_list.clear();
+	ParseCommandList(L"Present", &ConfigState().present_command_list, &ConfigState().post_present_command_list, NULL);
