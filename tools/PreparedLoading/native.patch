+std::vector<std::wstring> CompactWatchRoots(const std::set<std::wstring>& roots)
+{
+	std::vector<std::wstring> ordered(roots.begin(), roots.end()), result;
+	std::sort(ordered.begin(), ordered.end(), [](const std::wstring& a, const std::wstring& b) {
+		return a.size() < b.size();
+	});
+	for (const auto& root : ordered) {
+		bool covered = false;
+		for (const auto& parent : result)
+			if (root.size() >= parent.size() && !_wcsnicmp(root.c_str(), parent.c_str(), parent.size()) &&
+				(root.size() == parent.size() || parent.back() == L'\\' || root[parent.size()] == L'\\')) {
+				covered = true;
+				break;
+			}
+		if (!covered)
+			result.push_back(root);
+	}
+	return result;
+}
+std::wstring ExistingWatchParent(const std::wstring& file)
+{
+	auto path = Parent(file);
+	while (!path.empty()) {
+		const DWORD attributes = GetFileAttributesW(path.c_str());
+		if (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY))
+			return path;
+		while (!path.empty() && (path.back() == L'\\' || path.back() == L'/'))
+			path.pop_back();
+		path = Parent(path);
+	}
+	return {};
+}
+bool GeneralExpression(const CommandListExpression &expression, size_t &nodes)
+{
+	std::vector<std::pair<const CommandListEvaluatable *, size_t>> pending{{expression.evaluatable.get(), 0}};
+	while (!pending.empty()) {
+		const auto current = pending.back();
+		pending.pop_back();
+		if (!current.first || ++nodes > 65536 || current.second > 256)
+			return false;
+		if (auto operation = dynamic_cast<const CommandListOperator *>(current.first)) {
+			if (operation->lhs)
+				pending.emplace_back(operation->lhs.get(), current.second + 1);
+			pending.emplace_back(operation->rhs.get(), current.second + 1);
+			continue;
+		}
+		auto operand = dynamic_cast<const CommandListOperand *>(current.first);
+		if (!operand)
+			return false;
+		if (operand->type == ParamOverrideType::SHADER) {
+			switch (operand->shader_target.evaluation_mode) {
+			case ShaderTargetEvaluationMode::SHADER:
+			case ShaderTargetEvaluationMode::DCL_CB_MASK:
+			case ShaderTargetEvaluationMode::DCL_CB_TYPE:
+			case ShaderTargetEvaluationMode::DCL_CB_SIZE:
+			case ShaderTargetEvaluationMode::DCL_SRV_MASK:
+			case ShaderTargetEvaluationMode::DCL_SRV_TYPE:
+			case ShaderTargetEvaluationMode::DCL_SRV_DIMENSION:
+			case ShaderTargetEvaluationMode::DCL_SRV_STRIDE:
+				break;
+			default:
+				return false;
+			}
+			for (const auto &argument : operand->shader_target.member_args)
+				if (argument.expression)
+					pending.emplace_back(argument.expression->evaluatable.get(), current.second + 1);
+		}
+		switch (operand->type) {
+		case ParamOverrideType::VALUE:
+		case ParamOverrideType::INI_PARAM:
+		case ParamOverrideType::VARIABLE:
+		case ParamOverrideType::RT_WIDTH:
+		case ParamOverrideType::RT_HEIGHT:
+		case ParamOverrideType::RES_WIDTH:
+		case ParamOverrideType::RES_HEIGHT:
+		case ParamOverrideType::WINDOW_WIDTH:
+		case ParamOverrideType::WINDOW_HEIGHT:
+		case ParamOverrideType::SHADER:
+		case ParamOverrideType::VERTEX_COUNT:
+		case ParamOverrideType::INDEX_COUNT:
+		case ParamOverrideType::INSTANCE_COUNT:
+		case ParamOverrideType::FIRST_VERTEX:
+		case ParamOverrideType::FIRST_INDEX:
+		case ParamOverrideType::FIRST_INSTANCE:
+		case ParamOverrideType::THREAD_GROUP_COUNT_X:
+		case ParamOverrideType::THREAD_GROUP_COUNT_Y:
+		case ParamOverrideType::THREAD_GROUP_COUNT_Z:
+		case ParamOverrideType::INDIRECT_OFFSET:
+		case ParamOverrideType::DRAW_TYPE:
+		case ParamOverrideType::CURSOR_VISIBLE:
+		case ParamOverrideType::CURSOR_SCREEN_X:
+		case ParamOverrideType::CURSOR_SCREEN_Y:
+		case ParamOverrideType::CURSOR_WINDOW_X:
+		case ParamOverrideType::CURSOR_WINDOW_Y:
+		case ParamOverrideType::CURSOR_X:
+		case ParamOverrideType::CURSOR_Y:
+		case ParamOverrideType::CURSOR_HOTSPOT_X:
+		case ParamOverrideType::CURSOR_HOTSPOT_Y:
+		case ParamOverrideType::TIME:
+		case ParamOverrideType::SCISSOR_LEFT:
+		case ParamOverrideType::SCISSOR_TOP:
+		case ParamOverrideType::SCISSOR_RIGHT:
+		case ParamOverrideType::SCISSOR_BOTTOM:
+		case ParamOverrideType::HUNTING:
+		case ParamOverrideType::FRAME_ANALYSIS:
+		case ParamOverrideType::EFFECTIVE_DPI:
+		case ParamOverrideType::SLI:
+		case ParamOverrideType::STEREO_ACTIVE:
+		case ParamOverrideType::STEREO_AVAILABLE:
+		case ParamOverrideType::FRAME_NUMBER:
+		case ParamOverrideType::DRAW_NUMBER:
+		case ParamOverrideType::DISPATCH_NUMBER:
+		case ParamOverrideType::FRAME_TIME:
+		case ParamOverrideType::FPS:
+			break;
+		default:
+			// TEXTURE includes resource properties, pool access, cursor
+			// textures and region hashes that can allocate/read back GPU data.
+			return false;
+		}
+	}
+	return true;
+}
+bool GeneralPipelineTarget(const ResourceCopyTarget &target)
+{
+	if (target.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+		target.slot_expression || target.range_start || target.range_end ||
+		target.custom_resource_pool || target.pool_dynamic_index_expression)
+			return false;
+	switch (target.type) {
+	case ResourceCopyTargetType::CONSTANT_BUFFER:
+	case ResourceCopyTargetType::SHADER_RESOURCE:
+	case ResourceCopyTargetType::VERTEX_BUFFER:
+	case ResourceCopyTargetType::INDEX_BUFFER:
+	case ResourceCopyTargetType::STREAM_OUTPUT:
+	case ResourceCopyTargetType::RENDER_TARGET:
+	case ResourceCopyTargetType::DEPTH_STENCIL_TARGET:
+	case ResourceCopyTargetType::UNORDERED_ACCESS_VIEW:
+		return true;
+	default:
+		return false;
+	}
+}
+bool GeneralDraw(const DrawCommand &draw, size_t &nodes)
+{
+	size_t arguments = 0;
+	switch (draw.type) {
+	case DrawCommandType::DRAW:
+		arguments = 2;
+		break;
+	case DrawCommandType::DRAW_INDEXED:
+	case DrawCommandType::DISPATCH:
+		arguments = 3;
+		break;
+	case DrawCommandType::DRAW_INSTANCED:
+		arguments = 4;
+		break;
+	case DrawCommandType::DRAW_INDEXED_INSTANCED:
+		arguments = 5;
+		break;
+	case DrawCommandType::DRAW_AUTO:
+	case DrawCommandType::FROM_CALLER:
+	case DrawCommandType::AUTO_VERTEX_COUNT:
+	case DrawCommandType::AUTO_INDEX_COUNT:
+	case DrawCommandType::AUTO_INDEX_INSTANCE_COUNT:
+		break;
+	case DrawCommandType::DRAW_INSTANCED_INDIRECT:
+	case DrawCommandType::DRAW_INDEXED_INSTANCED_INDIRECT:
+	case DrawCommandType::DISPATCH_INDIRECT:
+		if (!GeneralPipelineTarget(draw.indirect_buffer) ||
+			(draw.indirect_buffer.type != ResourceCopyTargetType::VERTEX_BUFFER &&
+			 draw.indirect_buffer.type != ResourceCopyTargetType::INDEX_BUFFER &&
+			 draw.indirect_buffer.type != ResourceCopyTargetType::CONSTANT_BUFFER &&
+			 draw.indirect_buffer.type != ResourceCopyTargetType::STREAM_OUTPUT))
+			return false;
+		arguments = 1;
+		break;
+	default:
+		return false;
+	}
+	for (size_t i = 0; i < arguments; ++i)
+		if (!GeneralExpression(draw.args[i], nodes))
+			return false;
+	return true;
+}
+bool GeneralCommandClosure(ConfigurationState& graph, std::string& reason, std::set<CustomShader*>& reachableShaders)
+{
+	if (!graph.pools.empty()) {
+		reason = "Dynamic resource pools require compatible reset/loading";
+		return false;
+	}
+	if (!graph.regexGroups.empty()) {
+		reason = "ShaderRegex process replacement invalidation requires compatible reload";
+		return false;
+	}
+	std::set<CommandList*> visited;
+	std::vector<CommandList*> pending{
+		&graph.present_command_list, &graph.post_present_command_list,
+		&graph.clear_rtv_command_list, &graph.post_clear_rtv_command_list,
+		&graph.clear_dsv_command_list, &graph.post_clear_dsv_command_list,
+		&graph.clear_uav_uint_command_list, &graph.post_clear_uav_uint_command_list,
+		&graph.clear_uav_float_command_list, &graph.post_clear_uav_float_command_list,
+		&graph.constants_command_list, &graph.post_constants_command_list};
+	for (auto& entry : graph.explicitLists) if (_wcsnicmp(entry.first.c_str(), L"builtin", 7)) {
+		pending.push_back(&entry.second.command_list);
+		pending.push_back(&entry.second.post_command_list);
+	}
+	for (auto& entry : graph.shaders) if (_wcsnicmp(entry.first.c_str(), L"builtin", 7)) {
+		pending.push_back(&entry.second.command_list);
+		pending.push_back(&entry.second.post_command_list);
+	}
+	for (auto& entry : graph.mShaderOverrideMap) {
+		pending.push_back(&entry.second.command_list);
+		pending.push_back(&entry.second.post_command_list);
+	}
+	for (auto& entry : graph.mTextureOverrideMap) for (auto& override : entry.second) {
+		pending.push_back(&override.command_list);
+		pending.push_back(&override.post_command_list);
+	}
+	for (auto* list : graph.registeredLists)
+		if (list && _wcsnicmp(list->ini_section.c_str(), L"builtin", 7)) pending.push_back(list);
+	size_t commands = 0, expressionNodes = 0;
+	while (!pending.empty()) {
+		auto* list = pending.back(); pending.pop_back();
+		if (!list || list->runtime_populated || visited.size() > 65536)
+			return false;
+		if (!visited.insert(list).second)
+			continue;
+		for (const auto& command : list->commands) {
+			if (!command || ++commands > 65536)
+				return false;
+			if (auto branch = dynamic_cast<IfCommand*>(command.get())) {
+				if (!GeneralExpression(branch->expression, expressionNodes)) {
+					reason = "Conditional expression requires unprepared resource access";
+					return false;
+				}
+				for (auto child : {branch->true_commands_pre, branch->true_commands_post,
+					branch->false_commands_pre, branch->false_commands_post})
+					if (child)
+						pending.push_back(child.get());
+			} else if (dynamic_cast<VariableAssignment *>(command.get()) || dynamic_cast<ParamOverride *>(command.get())) {
+				auto assignment = static_cast<AssignmentCommand *>(command.get());
+				if (!GeneralExpression(assignment->expression, expressionNodes)) {
+					reason = "Assignment expression requires unprepared resource access";
+					return false;
+				}
+			} else if (auto draw = dynamic_cast<DrawCommand *>(command.get())) {
+				if (!GeneralDraw(*draw, expressionNodes)) {
+					reason = "Draw arguments or indirect target cannot be fully prepared";
+					return false;
+				}
+			} else if (auto check = dynamic_cast<CheckTextureOverrideCommand *>(command.get())) {
+				// VB/IB matching can call GetRegionHash and create a staging
+				// buffer. Other static pipeline targets only read bound objects.
+				if (!GeneralPipelineTarget(check->target) ||
+					check->target.type == ResourceCopyTargetType::VERTEX_BUFFER ||
+					check->target.type == ResourceCopyTargetType::INDEX_BUFFER) {
+					reason = "Texture override check requires unprepared resource access or region hashing";
+					return false;
+				}
+			} else if (dynamic_cast<PresetCommand*>(command.get()) || dynamic_cast<ResetPerFrameLimitsCommand*>(command.get()) ||
+				dynamic_cast<CommandPlaceholder*>(command.get()) || dynamic_cast<CopyCommandListCommand*>(command.get())) {
+				// No GPU allocation by these commands; every possible linked
+				// command list is included in registeredLists and visited here.
+			} else if (auto run = dynamic_cast<RunCustomShaderCommand*>(command.get())) {
+				if (!run->custom_shader)
+					return false;
+				reachableShaders.insert(run->custom_shader);
+				pending.push_back(&run->custom_shader->command_list);
+				pending.push_back(&run->custom_shader->post_command_list);
+			} else if (auto run = dynamic_cast<RunExplicitCommandList*>(command.get())) {
+				if (!run->command_list_section)
+					return false;
+				pending.push_back(&run->command_list_section->command_list);
+				pending.push_back(&run->command_list_section->post_command_list);
+			} else if (auto run = dynamic_cast<RunLinkedCommandList*>(command.get())) {
+				pending.push_back(run->link);
+			} else if (auto copy = dynamic_cast<ResourceCopyOperation*>(command.get())) {
+				if (!KnownPreparationCopy(*copy)) {
+					reason = "Resource copy/mutation cannot be fully prepared";
+					return false;
+				}
+			} else if (!KnownPreparationCommand(*command)) {
+				reason = "Command graph contains an unqualified GPU mutation or side effect";
+				return false;
+			}
+		}
+	}
+	return true;
+}
+void ConfigureWorkingSet(RuntimeState& state) {
+	std::vector<WorkingSetNode> nodes;
+	for (const auto& entry : state.resourceIds) {
+		WorkingSetNode node{entry.second, {}, false};
+		auto shader = state.graph ? state.graph->shaders.find(entry.second) : CustomShaders::iterator();
+		if (state.graph && shader != state.graph->shaders.end()) {
+			std::set<CommandList*> visited;
+			std::set<std::wstring> dependencies;
+			std::vector<CommandList*> lists{&shader->second.command_list, &shader->second.post_command_list};
+			while (!lists.empty() && visited.size() <= 65536) {
+				auto* list = lists.back(); lists.pop_back();
+				if (!list || !visited.insert(list).second) continue;
+				for (const auto& command : list->commands) {
+					if (auto copy = dynamic_cast<ResourceCopyOperation*>(command.get())) {
+						auto* resource = copy->src.GetCustomResource(nullptr, true);
+						auto id = state.resourceIds.find(resource);
+						if (id != state.resourceIds.end()) dependencies.insert(id->second);
+					} else if (auto run = dynamic_cast<RunCustomShaderCommand*>(command.get())) {
+						auto id = state.resourceIds.find(run->custom_shader);
+						if (id != state.resourceIds.end() && id->second != node.id) dependencies.insert(id->second);
+					} else if (auto run = dynamic_cast<RunExplicitCommandList*>(command.get())) {
+						if (run->command_list_section) { lists.push_back(&run->command_list_section->command_list); lists.push_back(&run->command_list_section->post_command_list); }
+					} else if (auto run = dynamic_cast<RunLinkedCommandList*>(command.get())) lists.push_back(run->link);
+					else if (auto branch = dynamic_cast<IfCommand*>(command.get()))
+						for (auto child : {branch->true_commands_pre, branch->true_commands_post, branch->false_commands_pre, branch->false_commands_post})
+							if (child) lists.push_back(child.get());
+				}
+			}
+			node.dependencies.assign(dependencies.begin(), dependencies.end());
+		}
+		nodes.push_back(std::move(node));
+	}
+	state.workingSet.SetGraph(nodes);
+	state.workingSet.SetAdaptiveLearning(state.adaptiveLearning);
+	state.workingSet.SelectProfile(state.profileMembers);
+}
+std::shared_ptr<RuntimeState> NextRuntimeState(const std::shared_ptr<RuntimeState>& previous) {
+	auto next = Disposal().Make<RuntimeState>();
+	next->mode = previous->mode; next->legacyConfigEpoch = previous->legacyConfigEpoch;
+	next->generalEnabled = previous->generalEnabled; next->transactionalActivation = previous->transactionalActivation;
+	next->cpuEnabled = previous->cpuEnabled; next->gpuEnabled = previous->gpuEnabled;
+	next->adaptiveLearning = previous->adaptiveLearning; next->detectColorSpace = previous->detectColorSpace;
+	next->generalCpuBytes = previous->generalCpuBytes; next->generalGpuBytes = previous->generalGpuBytes;
+	next->cpuLimits = previous->cpuLimits; next->gpuLimits = previous->gpuLimits;
+	next->gpuBytes = previous->gpuBytes; next->shaderBytes = previous->shaderBytes;
+	next->loadingWindow = previous->loadingWindow; next->semanticBuilder = previous->semanticBuilder;
+	next->scheduler = previous->scheduler; next->profileMembers = previous->profileMembers;
+	next->profileName = previous->profileName; next->outputDirectory = previous->outputDirectory;
+	next->resourceSharingProven = true;
+	return next;
+}
+class GeneralBuildWorker {
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	std::shared_ptr<GeneralBuildTask> pending_;
+	std::thread worker_;
+	std::shared_ptr<const void> cacheAdmission_;
+	IncrementalConfigCache cache_{16 * 1024 * 1024, 512};
+	std::shared_ptr<GeneralBuildResult> Build(const std::shared_ptr<RuntimeState>& state, const GeneralBuildTask& task) {
+		auto result = Disposal().Make<GeneralBuildResult>();
+		result->id = task.id; result->expected = state->graph;
+		result->versions = {task.request.token, task.device, state->legacyConfigEpoch};
+		auto& budget = *Services().generalCpuBudget;
+		if (!cacheAdmission_) cacheAdmission_ = budget.TryReserve(16 * 1024 * 1024);
+		if (!cacheAdmission_) { result->reason = "Incremental compiler cache exceeds CPU admission"; return result; }
+		auto metadata = budget.TryReserve(128 * 1024);
+		if (!metadata) { result->reason = "General configuration CPU metadata budget exhausted"; return result; }
+		result->bookkeepingOwnership = std::move(metadata);
+		ConfigSourceManifest manifest;
+		if (!ReadVerifiedCurrentConfigManifest(state->config->manifest, manifest, result->closure,
+			result->reason, Services().generalCpuBudget)) return result;
+		ConfigCompiler compiler(cache_, state->semanticBuilder);
+		auto compiled = compiler.Build(manifest, state->config, result->versions, true, task.forceFull);
+		if (!compiled || compiled->disposition != ConfigDisposition::Complete || !compiled->semanticState) {
+			result->reason = compiled ? compiled->reason : "Detached semantic build failed"; return result;
+		}
+		auto next = NextRuntimeState(state);
+		next->generation = task.id; next->config = compiled; next->graph = compiled->semanticState;
+		next->preparedDeviceEpoch = task.device;
+		result->next = next;
+		ConfigBuildScope build(next->graph);
+		auto& graph = *next->graph;
+		std::set<CustomShader*> reachableShaders;
+		if (!GeneralCommandClosure(graph, result->reason, reachableShaders)) return result;
+		const size_t count = graph.resources.size() + graph.shaders.size();
+		if (count > 8192) { result->reason = "Configuration dependency count exceeds bounded preparation"; return result; }
+		auto assetMetadata = budget.TryReserve(uint64_t(count) * 4096 + 65536);
+		if (!assetMetadata) { result->reason = "Complete dependency metadata exceeds CPU admission"; return result; }
+		result->metadata.push_back(std::move(assetMetadata));
+		next->graph->shaderReservations.insert(next->graph->shaderReservations.end(), result->metadata.begin(), result->metadata.end());
+		next->graph->shaderReservations.push_back(result->bookkeepingOwnership);
+		result->assets.reserve(count);
+		std::set<std::wstring> files, roots;
+		for (const auto& source : manifest.sources) result->dependencies.push_back(source.snapshot);
+		for (const auto& source : graph.shaderDependencies) result->dependencies.push_back(source);
+		for (auto& entry : graph.resources) {
+			auto& resource = entry.second;
+			if (!resource.preparation_known_read && !resource.preparation_writable && !resource.preparation_unknown_uses) continue;
+			if (!resource.PreparationReadOnly() || resource.filename.empty() || resource.initial_data ||
+				(IsBuffer(resource) && resource.preparation_known_srv)) {
+				result->reason = "A referenced resource needs mutable, inline, pool, or unqualified buffer-view creation"; return result;
+			}
+			auto asset = std::make_shared<PreparedAsset>();
+			asset->generation = task.id;
+			if (!budget.ReadSnapshot(resource.filename, state->cpuLimits.maxAssetBytes, asset->snapshot, result->reason) ||
+				!asset->snapshot.watchable || !asset->snapshot.bytes || asset->snapshot.bytes->empty()) return result;
+			GeneralAsset prepared; prepared.id = entry.first; prepared.resource = &resource; prepared.source = asset;
+			if (!RequestFor(resource, *asset, nullptr, prepared.request, state->detectColorSpace)) {
+				result->reason = "Resource descriptor cannot be fully prepared"; return result;
+			}
+			prepared.request.sourceOwner = asset;
+			prepared.request.retainedBudget = Services().generalGpuBudget;
+			prepared.request.retainedBudgetLimit = state->generalGpuBytes;
+			prepared.request.reserveCpuScratch = [bank = Services().generalCpuBudget](uint64_t bytes) {
+				return bank->TryReserve(bytes);
+			};
+			result->dependencies.push_back(asset->snapshot);
+			files.insert(resource.filename); next->resources.push_back(&resource);
+			next->resourceIds.emplace(&resource, entry.first);
+			next->profile.emplace(&resource, ProfileEntry());
+			result->assets.push_back(std::move(prepared));
+		}
+		for (auto& entry : graph.shaders) {
+			auto& shader = entry.second;
+			if (!_wcsnicmp(entry.first.c_str(), L"builtin", 7) && !reachableShaders.count(&shader)) continue;
+			shader.preparation_bundle = CaptureShaderBundle(shader, state->cpuLimits.maxAssetBytes, state->shaderBytes);
+			if (!shader.preparation_bundle) {
+				const bool empty = !shader.vs_bytecode && !shader.hs_bytecode && !shader.ds_bytecode && !shader.gs_bytecode &&
+					!shader.ps_bytecode && !shader.cs_bytecode && !shader.blend_override && !shader.depth_stencil_override &&
+					!shader.rs_override && !shader.sampler_override && !shader.preparation_compile_failed;
+				if (empty) { shader.substantiated = true; next->resourceIds.emplace(&shader, entry.first); continue; }
+				result->reason = "Shader bundle or merged fixed state cannot be fully prepared"; return result;
+			}
+			GeneralAsset prepared; prepared.id = entry.first; prepared.shader = &shader;
+			if (!ShaderRequestFor(shader, prepared.request)) { result->reason = "Shader bundle descriptor is unsupported"; return result; }
+			prepared.request.retainedBudget = Services().generalGpuBudget;
+			prepared.request.retainedBudgetLimit = state->generalGpuBytes;
+			next->shaders.push_back(&shader); next->resourceIds.emplace(&shader, entry.first);
+			next->profile.emplace(&shader, ProfileEntry()); result->assets.push_back(std::move(prepared));
+		}
+		uint64_t completeGpuBytes = graph.iniParams.empty() ? 0 : graph.iniParams.size() * sizeof(DirectX::XMFLOAT4) + 128 * 1024;
+		for (const auto& asset : result->assets) {
+			if (asset.request.estimatedBytes > next->generalGpuBytes ||
+				completeGpuBytes > next->generalGpuBytes - asset.request.estimatedBytes) {
+				result->reason = "Complete configuration exceeds configured GPU admission"; return result;
+			}
+			completeGpuBytes += asset.request.estimatedBytes;
+		}
+		ConfigureWorkingSet(*next);
+		if (!next->workingSet.Selection().Complete()) { result->reason = "Profile contains unknown IDs or unsupported dependency closure"; return result; }
+		{ std::lock_guard<std::mutex> learningLock(state->generalMutex);
+		  std::stable_sort(result->assets.begin(), result->assets.end(), [&](const GeneralAsset& a, const GeneralAsset& b) {
+			const int aPriority = (std::max)(next->workingSet.Priority(a.id), state->workingSet.Priority(a.id));
+			const int bPriority = (std::max)(next->workingSet.Priority(b.id), state->workingSet.Priority(b.id));
+			return aPriority > bPriority;
+		  }); }
+
+		next->totalAssets = result->assets.size(); next->files.assign(files.begin(), files.end());
+		auto missing = result->closure.absentPaths;
+		missing.insert(missing.end(), graph.resourceLookupPaths.begin(), graph.resourceLookupPaths.end());
+		for (const auto& path : graph.shaderDependencyPaths) {
+			const auto found = std::find_if(result->dependencies.begin(), result->dependencies.end(),
+				[&](const SourceSnapshot& source) { return !_wcsicmp(source.path.c_str(), path.c_str()); });
+			if (found == result->dependencies.end()) missing.push_back(path);
+		}
+		for (const auto& path : missing) {
+			if (!IsWatchableMissingSource(path, result->reason)) return result;
+			const auto parent = ExistingWatchParent(path);
+			if (parent.empty()) { result->reason = "Missing dependency has no watchable ancestor"; return result; }
+			roots.insert(parent); files.insert(path);
+		}
+		for (const auto& source : result->dependencies) {
+			if (!source.watchable || source.path.empty()) { result->reason = "Unwatchable dependency uses compatible loading"; return result; }
+			roots.insert(Parent(source.path)); files.insert(source.path);
+		}
+		for (const auto& directory : result->closure.directories) roots.insert(directory.path);
+		ChangeOptions options; options.filterDependencies = true; options.maxRoots = 128;
+		options.maxDependencyFiles = 16384; options.dependencyFiles.assign(files.begin(), files.end());
+		next->monitor.reset(new ChangeMonitor(options));
+		if (!next->monitor->Start(CompactWatchRoots(roots), next->outputDirectory.empty() ? std::vector<std::wstring>() :
+			std::vector<std::wstring>{next->outputDirectory}, [owned = next.get()](const ReconcileRequest& request) { RecordMonitorChange(owned, request); })) {
+			result->reason = "Candidate dependency watches unavailable"; return result;
+		}
+		if (!next->monitor->WaitUntilWatching(5000)) { result->reason = "Candidate watches could not be armed"; return result; }
+		result->nextSourceToken = next->monitor->CurrentToken();
+		next->sourceToken.store(result->nextSourceToken);
+		// Watches are live BEFORE the final immutable source comparison.
+		for (const auto& source : result->dependencies) {
+			SourceSnapshot current;
+			if (!budget.ReadSnapshot(source.path, source.bytes->size(), current, result->reason) ||
+				!current.watchable || current.digest != source.digest || !(current.identity == source.identity)) {
+				result->reason = "Dependency changed during candidate preparation"; return result;
+			}
+		}
+		for (const auto& path : missing) if (!IsWatchableMissingSource(path, result->reason)) return result;
+		if (!VerifyResourceRefreshClosure(result->closure, result->reason) ||
+			!next->monitor->IsCurrent(result->nextSourceToken) || !state->monitor->IsCurrent(task.request.token)) {
+			result->reason = "Source closure changed during verification"; return result;
+		}
+		result->valid = true; result->reason.clear();
+		return result;
+	}
+	void Run() {
+		for (;;) {
+			std::shared_ptr<GeneralBuildTask> task;
+			{ std::unique_lock<std::mutex> lock(mutex_); wake_.wait(lock, [&] { return bool(pending_); }); task.swap(pending_); }
+			auto state = task->state.lock();
+			if (!state || !state->enabled.load() || !state->monitor->IsCurrent(task->request.token)) continue;
+			try {
+				auto result = Build(state, *task);
+				if (!state->enabled.load() || !state->monitor->IsCurrent(task->request.token)) continue;
+				std::lock_guard<std::mutex> lock(state->generalMutex);
+				state->generalResult = std::move(result);
+			} catch (...) {
+				std::lock_guard<std::mutex> lock(state->generalMutex);
+				state->generalFailure = "Complete configuration preparation exceeded bounded admission";
+			}
+		}
+	}
+public:
+	GeneralBuildWorker() : worker_([this] { Run(); }) {}
+	void Submit(std::shared_ptr<GeneralBuildTask> task) {
+		{ std::lock_guard<std::mutex> lock(mutex_); pending_ = std::move(task); }
+		wake_.notify_one();
+	}
+};
+void ScheduleGeneralBuild(const std::shared_ptr<RuntimeState>& state, const ReconcileRequest& request, DeviceEpoch epoch) {
+	auto& service = Services();
+	service.refreshActivation.SetReady(0); service.pendingGeneral.reset();
+	if (!state->generalEnabled || !service.generalWorker || !state->semanticBuilder || !state->config) return;
+	state->generalBuildDeviceEpoch = epoch;
+	auto task = std::make_shared<GeneralBuildTask>();
+	task->state = state; task->request = request; task->device = epoch;
+	task->id = ++service.nextGeneration; task->forceFull = request.fullReconcile || state->generalRescan.exchange(false);
+	service.generalWorker->Submit(std::move(task));
+	state->generalReason = "Building complete configuration and dependency closure";
+}
+bool AttachGeneralAsset(GeneralAsset& asset, ID3D11Device* device) {
+	if (!asset.gpu) return false;
+	if (asset.resource) {
+		auto& resource = *asset.resource;
+		if (!QualifiedResource(resource, asset.gpu)) return false;
+		asset.gpu->resource->AddRef(); resource.resource = asset.gpu->resource;
+		if (resource.preparation_known_srv) {
+			asset.gpu->shaderResourceView->AddRef(); resource.view = asset.gpu->shaderResourceView;
+		}
+		resource.device = device; resource.is_null = false; resource.substantiated = true;
+		resource.preparation_pin = asset.gpu;
+		if (IsBuffer(resource)) {
+			resource.buf_size = UINT(asset.source->snapshot.bytes->size());
+			resource.OverrideOutOfBandInfo(&resource.format, &resource.stride);
+		}
+	} else {
+		auto& shader = *asset.shader;
+		if (!asset.gpu->bundle) return false;
+		const auto& bundle = *asset.gpu->bundle;
+		const auto& input = *asset.request.shaderBundle;
+		const bool output[] = {bool(bundle.vertex), bool(bundle.hull), bool(bundle.domain),
+			bool(bundle.geometry), bool(bundle.pixel), bool(bundle.compute)};
+		for (size_t i = 0; i < 6; ++i) if (bool(input.stages[i]) != output[i]) return false;
+		if (input.createBlendState != bool(bundle.blend) || input.createDepthStencilState != bool(bundle.depthStencil) ||
+			input.createRasterizerState != bool(bundle.rasterizer) || input.createSamplerState != bool(bundle.sampler)) return false;
+#define ATTACH_SHADER(Member, Source) if (bundle.Source) bundle.Source->AddRef(); shader.Member = bundle.Source;
+		ATTACH_SHADER(vs, vertex) ATTACH_SHADER(hs, hull) ATTACH_SHADER(ds, domain)
+		ATTACH_SHADER(gs, geometry) ATTACH_SHADER(ps, pixel) ATTACH_SHADER(cs, compute)
+		ATTACH_SHADER(blend_state, blend) ATTACH_SHADER(depth_stencil_state, depthStencil)
+		ATTACH_SHADER(rs_state, rasterizer) ATTACH_SHADER(sampler_state, sampler)
+#undef ATTACH_SHADER
+		shader.substantiated = true; shader.preparation_pin = asset.gpu;
+	}
+	asset.attached = true;
+	return true;
+}
+bool PrepareGeneralIni(GeneralBuildResult& candidate, ID3D11Device* device) {
+	auto& graph = *candidate.next->graph;
+	if (candidate.iniPrepared) return true;
+	if (!candidate.next->loadingWindow) return false;
+	graph.iniDevice = device;
+	if (graph.iniParams.empty()) { graph.ownsIniResources = true; candidate.iniPrepared = true; return true; }
+	const uint64_t bytes = graph.iniParams.size() * sizeof(DirectX::XMFLOAT4) + 128 * 1024;
+	if (bytes > candidate.next->gpuLimits.bytes || graph.iniParams.size() > D3D11_REQ_TEXTURE1D_U_DIMENSION) {
+		candidate.reason = "Initialization parameter texture exceeds preparation limits"; candidate.valid = false; return false;
+	}
+	auto lease = Services().generalGpuBudget->TryTrack(bytes, candidate.next->generalGpuBytes);
+	if (!lease) return false;
+	D3D11_TEXTURE1D_DESC descriptor{};
+	descriptor.Width = UINT(graph.iniParams.size()); descriptor.MipLevels = descriptor.ArraySize = 1;
+	descriptor.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; descriptor.Usage = D3D11_USAGE_DYNAMIC;
+	descriptor.BindFlags = D3D11_BIND_SHADER_RESOURCE; descriptor.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+	D3D11_SUBRESOURCE_DATA data{}; data.pSysMem = graph.iniParams.data();
+	ID3D11Texture1D* texture = nullptr;
+	if (FAILED(device->CreateTexture1D(&descriptor, &data, &texture))) return false;
+	graph.ownedIniTexture = std::shared_ptr<ID3D11Texture1D>(texture, [](ID3D11Texture1D* p) { p->Release(); });
+	if (!AttachPreparedAllocation(texture, bytes, lease)) { graph.ownedIniTexture.reset(); return false; }
+	ID3D11ShaderResourceView* view = nullptr;
+	if (FAILED(device->CreateShaderResourceView(texture, nullptr, &view))) { graph.ownedIniTexture.reset(); return false; }
+	graph.ownedIniView = std::shared_ptr<ID3D11ShaderResourceView>(view, [](ID3D11ShaderResourceView* p) { p->Release(); });
+	graph.iniGpuOwnership = lease; graph.ownsIniResources = true; candidate.iniPrepared = true;
+	return true;
+}
+void GeneralStatus(const std::shared_ptr<RuntimeState>& state, const std::shared_ptr<GeneralBuildResult>& candidate,
+	PreparationStatusState statusState, const std::string& reason, uint64_t ticket) {
+	PreparationStatus status; status.mode = state->mode; status.state = statusState; status.reason = reason;
+	status.totalAssets = candidate ? candidate->assets.size() : state->totalAssets;
+	status.cpuReady = candidate && candidate->valid ? candidate->assets.size() : 0;
+	status.gpuReady = candidate ? candidate->readyAssets : 0;
+	if (statusState == PreparationStatusState::Compatibility) status.compatibilityAssets = status.totalAssets ? status.totalAssets : 1;
+	if (statusState == PreparationStatusState::Ready && !candidate) status.cpuReady = status.gpuReady = state->totalAssets;
+	UpdatePreparationStatus(status, ticket);
+}
+void PumpGeneralConfiguration(const std::shared_ptr<RuntimeState>& state, ID3D11Device* device,
+	DeviceEpoch epoch, ID3D11DeviceContext* suppliedContext) {
+	auto& service = Services();
+	const auto statusTicket = ReservePreparationStatusTicket();
+	std::shared_ptr<GeneralBuildResult> result;
+	{ std::unique_lock<std::mutex> lock(state->generalMutex, std::try_to_lock);
+	  if (lock.owns_lock()) {
+		  result.swap(state->generalResult);
+		  if (!state->generalFailure.empty()) { state->generalReason.swap(state->generalFailure); state->generalFailure.clear(); }
+	  } }
+	if (result) {
+		service.refreshActivation.SetReady(0);
+		service.pendingGeneral = std::move(result);
+	}
+	auto candidate = service.pendingGeneral;
+	if (state->generalAdmissionBlocked || !state->semanticBuilder) {
+		GeneralStatus(state, {}, PreparationStatusState::Compatibility, state->generalReason, statusTicket); return;
+	}
+	if (!candidate) {
+		if (state->config && state->config->semanticState == state->graph && state->preparedDeviceEpoch != epoch && state->generalBuildDeviceEpoch != epoch) {
+			ReconcileRequest request; request.token = state->monitor->CurrentToken(); request.fullReconcile = true;
+			ScheduleGeneralBuild(state, request, epoch);
+		}
+		const bool active = state->config && state->config->semanticState == state->graph && state->preparedDeviceEpoch == epoch &&
+			state->monitor->IsCurrent(state->sourceToken.load());
+		GeneralStatus(state, {}, active ? PreparationStatusState::Ready : PreparationStatusState::Preparing,
+			active ? "Complete configuration active; source and GPU ownership verified" : state->generalReason, statusTicket);
+		return;
+	}
+	if (!candidate->valid) {
+		service.refreshActivation.SetReady(0); service.refreshActivation.Consume();
+		GeneralStatus(state, candidate, PreparationStatusState::Compatibility, candidate->reason, statusTicket);
+		return;
+	}
+	if (candidate->versions.runtime != service.legacyConfigEpoch.load() || candidate->versions.device != epoch ||
+		candidate->expected != PinConfiguration() || !state->monitor->IsCurrent(candidate->versions.source) ||
+		!candidate->next->monitor->IsCurrent(candidate->nextSourceToken)) {
+		service.refreshActivation.SetReady(0); service.pendingGeneral.reset();
+		ReconcileRequest current; current.token = state->monitor->CurrentToken(); current.fullReconcile = true;
+		ScheduleGeneralBuild(state, current, epoch);
+		GeneralStatus(state, {}, PreparationStatusState::Preparing, "Source/device/runtime proof changed; rebuilding latest candidate", statusTicket);
+		return;
+	}
+	if (!state->gpuEnabled || !state->generalGpuBytes || (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED)) {
+		GeneralStatus(state, candidate, PreparationStatusState::Compatibility, "Complete GPU preparation disabled or device owner unsupported", statusTicket); return;
+	}
+	service.device = device; service.epoch = epoch; service.owner = std::this_thread::get_id();
+	if (!candidate->planner) {
+		candidate->planner.reset(new PreparationPlanner(state->generalGpuBytes, 32, state->shaderBytes));
+		if (!candidate->planner->BeginDevice(device, epoch)) { candidate->reason = "Rendering device cannot prepare this generation"; candidate->valid = false; return; }
+	}
+	// All descriptor construction/hashing/source reads happened on the worker.
+	// The owner only admits a bounded number of immutable requests each frame.
+	for (size_t work = 0; work < 8 && !candidate->assets.empty(); ++work) {
+		auto& asset = candidate->assets[candidate->cursor++ % candidate->assets.size()];
+		if (asset.attached) continue;
+		if (asset.request.estimatedBytes > state->gpuLimits.bytes) {
+			candidate->reason = "An activation dependency exceeds the configured per-pump upload budget"; candidate->valid = false; return;
+		}
+		const auto queued = candidate->planner->Enqueue(asset.request, &asset.key);
+		if (queued == GpuQueueResult::CompatibilityOnly || queued == GpuQueueResult::WrongDevice || queued == GpuQueueResult::WrongThread) {
+			candidate->reason = "A complete dependency could not be prepared on the rendering device"; candidate->valid = false; return;
+		}
+		asset.gpu = candidate->planner->TryAcquire(asset.key);
+		if (asset.gpu) {
+			if (!AttachGeneralAsset(asset, device)) { candidate->reason = "Prepared GPU object/view failed exact compatibility validation"; candidate->valid = false; return; }
+			++candidate->readyAssets;
+			const void* target = asset.resource ? static_cast<const void*>(asset.resource) : static_cast<const void*>(asset.shader);
+			auto& profile = candidate->next->profile.at(target);
+			profile.generation = candidate->next->generation; profile.epoch = epoch; profile.cpuReady = true;
+			profile.source = asset.source; profile.pinnedGpu = asset.gpu; profile.observedGpu = asset.gpu; profile.key = asset.key;
+		}
+	}
+	if (state->loadingWindow) {
+		EnsureCOM();
+		struct CreationGuard { CreationGuard() { LockResourceCreationMode(); } ~CreationGuard() { UnlockResourceCreationMode(); } } guard;
+		const auto pumped = candidate->planner->Pump(true, state->gpuLimits);
+		if (pumped.deviceRemoved) { candidate->valid = false; candidate->reason = "Device was removed during candidate preparation"; return; }
+		if (candidate->readyAssets == candidate->assets.size() && !candidate->iniPrepared) PrepareGeneralIni(*candidate, device);
+		// Query allocation occurs before Ready, never within the final source
+		// lock. Do it on a separate pump from ini texture creation.
+		else if (candidate->readyAssets == candidate->assets.size() && candidate->iniPrepared && candidate->retirementSlot < 0)
+			candidate->retirementSlot = ReserveGraphRetirement(device);
+	}
+	const bool ready = candidate->valid && candidate->readyAssets == candidate->assets.size() &&
+		candidate->iniPrepared && candidate->retirementSlot >= 0;
+	if (!ready) {
+		service.refreshActivation.SetReady(0); service.refreshActivation.Consume();
+		GeneralStatus(state, candidate, PreparationStatusState::Preparing, "Preparing the complete graph within CPU/GPU/loading-window budgets", statusTicket); return;
+	}
+	const bool readyProof = state->monitor->CommitIfCurrent(candidate->versions.source, [&] {
+		return candidate->next->monitor->CommitIfCurrent(candidate->nextSourceToken, [&] {
+			service.refreshActivation.SetReady(candidate->id);
+			GeneralStatus(state, candidate, PreparationStatusState::Ready,
+				"Complete candidate prepared; use the configured refresh shortcut to activate", statusTicket);
+			return true;
+		});
+	});
+	if (!readyProof) { service.refreshActivation.SetReady(0); return; }
+	const auto requested = service.refreshActivation.Consume();
+	if (requested == candidate->id && state->transactionalActivation) candidate->activationRequested = true;
+	if (!candidate->activationRequested) return;
+	// Activation duration measures one owner-side attempt, excluding preparation
+	// and readiness waits: 0 = published, 1 = retry, -1 = compatible reload needed.
+	ScopedLoadTrace activationTrace(LoadStage::Activation, candidate->id);
+	activationTrace.SetResult(1);
+	ID3D11DeviceContext* context = suppliedContext;
+	bool releaseContext = false;
+	if (!context) { device->GetImmediateContext(&context); releaseContext = true; }
+	if (!context) return;
+	uint64_t revision = 0;
+	const auto staged = StageConfigurationRuntime(candidate->next->graph, candidate->expected, 262144, revision);
+#ifdef XXMI_MODLOADING_TESTS
+	candidate->lastStage = int(staged);
+	candidate->lastPublication = -1;
+#endif
+	bool uploaded = staged == ConfigPublishResult::Published;
+	if (uploaded && candidate->next->graph->ownedIniTexture) {
+		D3D11_MAPPED_SUBRESOURCE mapped{};
+		uploaded = SUCCEEDED(context->Map(candidate->next->graph->ownedIniTexture.get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped));
+		if (uploaded) {
+			memcpy(mapped.pData, candidate->next->graph->iniParams.data(), candidate->next->graph->iniParams.size() * sizeof(DirectX::XMFLOAT4));
+			context->Unmap(candidate->next->graph->ownedIniTexture.get(), 0);
+		}
+	}
+	// Any CPU hook between runtime migration and publication increments the
+	// revision, including pending pre/post work. A rejected commit retries later.
+	bool published = false;
+	if (uploaded && SUCCEEDED(device->GetDeviceRemovedReason())) {
+		published = state->monitor->CommitIfCurrent(candidate->versions.source, [&] {
+			return candidate->next->monitor->CommitIfCurrent(candidate->nextSourceToken, [&] {
+				if (candidate->versions.runtime != service.legacyConfigEpoch.load()) return false;
+				const auto publication = PublishStagedConfiguration(candidate->next->graph, candidate->expected, revision);
+#ifdef XXMI_MODLOADING_TESTS
+				candidate->lastPublication = int(publication);
+#endif
+				if (publication != ConfigPublishResult::Published) return false;
+				candidate->next->enabled.store(true); state->enabled.store(false);
+				std::atomic_store(&service.state, candidate->next);
+				return true;
+			});
+		});
+	}
+#ifdef XXMI_MODLOADING_TESTS
+	candidate->lastUploaded = uploaded;
+	candidate->lastCommit = published;
+#endif
+	if (releaseContext) context->Release();
+	if (published) {
+		activationTrace.SetResult(0);
+		SubmitGraphRetirement(candidate->retirementSlot, candidate->expected); candidate->retirementSlot = -1;
+		service.refreshActivation.SetReady(0); service.pendingGeneral.reset();
+		GeneralStatus(candidate->next, {}, PreparationStatusState::Ready, "Complete prepared configuration activated", statusTicket);
+		LoadTrace::Get().RecordInstant(LoadStage::Activation, candidate->id, 0, 0);
+	} else if (staged == ConfigPublishResult::MigrationBudget || staged == ConfigPublishResult::Invalid) {
+		activationTrace.SetResult(-1);
+		candidate->valid = false; candidate->reason = "Bounded runtime migration/initializer validation requires compatible reload";
+		service.refreshActivation.SetReady(0);
+	}
+}
