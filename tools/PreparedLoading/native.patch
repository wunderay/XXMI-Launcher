+        auto request = queue->WaitAfter(before, "create"); queue->Quiet(); request = queue->Latest();
+        Require(monitor.IsCurrent(request.token), "created token current");
+        before = queue->Count(); Write(asset, "BBBB"); // Same-size actual byte rewrite.
+        request = queue->WaitAfter(before, "modify"); queue->Quiet(); request = queue->Latest();
+        Require(monitor.IsCurrent(request.token), "modified token current");
+        before = queue->Count();
+        const auto renamed = root + L"\\renamed.bin";
+        Require(MoveFileExW(asset.c_str(), renamed.c_str(), MOVEFILE_WRITE_THROUGH) != FALSE, "rename file");
+        queue->WaitAfter(before, "rename"); queue->Quiet();
+        before = queue->Count(); Require(DeleteFileW(renamed.c_str()) != FALSE, "delete file");
+        request = queue->WaitAfter(before, "delete"); queue->Quiet(); request = queue->Latest();
+        before = queue->Count(); Write(cache + L"\\own-cache.bin", "cache");
+        std::this_thread::sleep_for(std::chrono::milliseconds(700));
