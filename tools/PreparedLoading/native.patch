+    auto oldObject = std::make_shared<OwnedAllocation>(); oldObject->allocation = ledger.Track(80);
+    assert(oldObject->allocation && ledger.Bytes() == 80);
+    assert(oldCache.Insert(Key(epoch, 1), oldObject, 80));
+    auto activeLease = oldCache.Find(Key(epoch, 1)); oldObject.reset();
+    // A generation/device cache reset releases policy ownership while a live
+    // consumer still owns the actual allocation estimate.
+    oldCache.BeginEpoch(AllocateDeviceEpoch());
+    assert(oldCache.Bytes() == 0 && ledger.Bytes() == 80);
+    budget.Update({false, 0, ledger.Bytes()});
+    assert(!budget.Reserve({21, 0})); assert(budget.Reserve({20, 0}));
+    auto alias = activeLease; activeLease.reset(); assert(ledger.Bytes() == 80);
+    alias.reset(); assert(ledger.Bytes() == 0);
+    budget.Complete(20); budget.Update({false, 0, ledger.Bytes()});
+    assert(budget.Reserve({100, 0})); budget.Complete(100);
