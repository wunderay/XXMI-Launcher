+        Append(v, {uint32_t(d.AlphaToCoverageEnable), uint32_t(d.IndependentBlendEnable)});
+        for (const auto& target : d.RenderTarget)
+            Append(v, {uint32_t(target.BlendEnable), uint32_t(target.SrcBlend), uint32_t(target.DestBlend), uint32_t(target.BlendOp),
+                uint32_t(target.SrcBlendAlpha), uint32_t(target.DestBlendAlpha), uint32_t(target.BlendOpAlpha), target.RenderTargetWriteMask});
+    }
+    if (bundle.createDepthStencilState) {
+        const auto& d = bundle.depthStencil;
+        Append(v, {uint32_t(d.DepthEnable), uint32_t(d.DepthWriteMask), uint32_t(d.DepthFunc), uint32_t(d.StencilEnable), d.StencilReadMask, d.StencilWriteMask});
+        for (const auto* face : {&d.FrontFace, &d.BackFace})
+            Append(v, {uint32_t(face->StencilFailOp), uint32_t(face->StencilDepthFailOp), uint32_t(face->StencilPassOp), uint32_t(face->StencilFunc)});
+    }
+    if (bundle.createRasterizerState) {
+        const auto& d = bundle.rasterizer;
+        Append(v, {uint32_t(d.FillMode), uint32_t(d.CullMode), uint32_t(d.FrontCounterClockwise), uint32_t(d.DepthBias),
+            FloatBits(d.DepthBiasClamp), FloatBits(d.SlopeScaledDepthBias), uint32_t(d.DepthClipEnable), uint32_t(d.ScissorEnable),
+            uint32_t(d.MultisampleEnable), uint32_t(d.AntialiasedLineEnable)});
+    }
+    if (bundle.createSamplerState) {
+        const auto& d = bundle.sampler;
+        Append(v, {uint32_t(d.Filter), uint32_t(d.AddressU), uint32_t(d.AddressV), uint32_t(d.AddressW), FloatBits(d.MipLODBias),
+            d.MaxAnisotropy, uint32_t(d.ComparisonFunc), FloatBits(d.BorderColor[0]), FloatBits(d.BorderColor[1]),
+            FloatBits(d.BorderColor[2]), FloatBits(d.BorderColor[3]), FloatBits(d.MinLOD), FloatBits(d.MaxLOD)});
+    }
+    return true;
+}
+uint64_t RetainedShaderBytecodeBytes(const GpuPreparationRequest& request) {
+    if (request.kind == GpuPreparationKind::ShaderBundle) {
+        uint64_t total = 0;
+        if (request.shaderBundle)
+            for (const auto& stage : request.shaderBundle->stages) {
+                if (stage.Size() > (std::numeric_limits<uint64_t>::max)() - total) return (std::numeric_limits<uint64_t>::max)();
+                total += stage.Size();
+            }
+        return total;
+    }
+    if (request.kind >= GpuPreparationKind::VertexShader && request.kind <= GpuPreparationKind::ComputeShader)
+        return request.shaderBytecode ? request.shaderBytecode.Size() : request.snapshot.bytes ? request.snapshot.bytes->size() : 0;
+    return 0;
+}
+bool ReadOnly(UINT bind, UINT cpu, D3D11_USAGE usage, UINT misc) {
+    const UINT allowed = D3D11_BIND_VERTEX_BUFFER | D3D11_BIND_INDEX_BUFFER |
+        D3D11_BIND_CONSTANT_BUFFER | D3D11_BIND_SHADER_RESOURCE;
+    const UINT allowedMisc = D3D11_RESOURCE_MISC_BUFFER_STRUCTURED | D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS |
+        D3D11_RESOURCE_MISC_TEXTURECUBE;
+    return bind && !(bind & ~allowed) && !cpu && !(misc & ~allowedMisc) &&
+        (usage == D3D11_USAGE_DEFAULT || usage == D3D11_USAGE_IMMUTABLE);
+}
+// The explicit decoded path accepts only layouts whose byte extents are known.
+// Other formats remain compatibility-only, rather than trusting driver reads
+// beyond supplied snapshot ranges.
+bool Surface(DXGI_FORMAT format, UINT width, UINT height, uint64_t& row, uint64_t& rows) {
+    uint64_t bpp = 0, block = 0;
+    switch (format) {
+    case DXGI_FORMAT_R8_UNORM: case DXGI_FORMAT_A8_UNORM: bpp = 1; break;
+    case DXGI_FORMAT_R8G8_UNORM: case DXGI_FORMAT_R16_UNORM: case DXGI_FORMAT_R16_FLOAT: bpp = 2; break;
+    case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM: case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+    case DXGI_FORMAT_R16G16_FLOAT: case DXGI_FORMAT_R32_FLOAT: bpp = 4; break;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT: case DXGI_FORMAT_R32G32_FLOAT: bpp = 8; break;
+    case DXGI_FORMAT_R32G32B32A32_FLOAT: bpp = 16; break;
+    case DXGI_FORMAT_BC1_UNORM: case DXGI_FORMAT_BC1_UNORM_SRGB:
+    case DXGI_FORMAT_BC4_UNORM: case DXGI_FORMAT_BC4_SNORM: block = 8; break;
+    case DXGI_FORMAT_BC2_UNORM: case DXGI_FORMAT_BC2_UNORM_SRGB:
+    case DXGI_FORMAT_BC3_UNORM: case DXGI_FORMAT_BC3_UNORM_SRGB:
+    case DXGI_FORMAT_BC5_UNORM: case DXGI_FORMAT_BC5_SNORM:
+    case DXGI_FORMAT_BC6H_UF16: case DXGI_FORMAT_BC6H_SF16:
+    case DXGI_FORMAT_BC7_UNORM: case DXGI_FORMAT_BC7_UNORM_SRGB: block = 16; break;
+    default: return false;
+    }
+    row = block ? ((uint64_t(width) + 3) / 4) * block : uint64_t(width) * bpp;
+    rows = block ? (uint64_t(height) + 3) / 4 : height;
+    return true;
+}
+bool AppendView(std::vector<uint32_t>& v, const D3D11_SHADER_RESOURCE_VIEW_DESC& d) {
+    Append(v, {uint32_t(d.Format), uint32_t(d.ViewDimension)});
+    switch (d.ViewDimension) {
+    case D3D11_SRV_DIMENSION_BUFFER: Append(v, {d.Buffer.FirstElement, d.Buffer.NumElements}); break;
+    case D3D11_SRV_DIMENSION_BUFFEREX: Append(v, {d.BufferEx.FirstElement, d.BufferEx.NumElements, d.BufferEx.Flags}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE1D: Append(v, {d.Texture1D.MostDetailedMip, d.Texture1D.MipLevels}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE1DARRAY: Append(v, {d.Texture1DArray.MostDetailedMip, d.Texture1DArray.MipLevels, d.Texture1DArray.FirstArraySlice, d.Texture1DArray.ArraySize}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE2D: Append(v, {d.Texture2D.MostDetailedMip, d.Texture2D.MipLevels}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DARRAY: Append(v, {d.Texture2DArray.MostDetailedMip, d.Texture2DArray.MipLevels, d.Texture2DArray.FirstArraySlice, d.Texture2DArray.ArraySize}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DMS: break;
+    case D3D11_SRV_DIMENSION_TEXTURE2DMSARRAY: Append(v, {d.Texture2DMSArray.FirstArraySlice, d.Texture2DMSArray.ArraySize}); break;
+    case D3D11_SRV_DIMENSION_TEXTURE3D: Append(v, {d.Texture3D.MostDetailedMip, d.Texture3D.MipLevels}); break;
+    case D3D11_SRV_DIMENSION_TEXTURECUBE: Append(v, {d.TextureCube.MostDetailedMip, d.TextureCube.MipLevels}); break;
+    case D3D11_SRV_DIMENSION_TEXTURECUBEARRAY: Append(v, {d.TextureCubeArray.MostDetailedMip, d.TextureCubeArray.MipLevels, d.TextureCubeArray.First2DArrayFace, d.TextureCubeArray.NumCubes}); break;
+    default: return false;
+    }
+    return true;
