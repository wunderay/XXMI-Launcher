+constexpr size_t HeaderSize = 144;
+void Put(uint8_t *p, uint64_t n, size_t count) {
+	for (size_t i = 0; i < count; ++i)
+		p[i] = uint8_t(n >> (8 * i));
+}
+uint64_t Get(const uint8_t *p, size_t count) {
+	uint64_t n = 0;
+	for (size_t i = 0; i < count; ++i)
+		n |= uint64_t(p[i]) << (8 * i);
+	return n;
+}
+bool Layout(uint64_t width, uint64_t height, uint64_t pitch, uint64_t format, uint64_t size) {
+	return width && height && width <= 16384 && height <= 16384 && pitch == width * 4 &&
+		   size == pitch * height && (format == 28 || format == 87 || format == 88);
+}
+bool OwnedName(const std::wstring &name, bool &temporary) {
+	temporary = false;
+	if (name.size() != 69 && name.size() != 73)
+		return false;
+	for (size_t i = 0; i < 64; ++i)
+		if (!((name[i] >= L'0' && name[i] <= L'9') || (name[i] >= L'a' && name[i] <= L'f')))
+			return false;
+	if (name.substr(64, 5) != L".xxpc")
+		return false;
+	temporary = name.size() == 73;
+	return !temporary || name.substr(69) == L".tmp";
+}
+#ifdef _WIN32
+const wchar_t Separator = L'\\';
+struct File {
+	HANDLE handle = INVALID_HANDLE_VALUE;
+	~File() {
+		Close();
+	}
+	void Close() {
+		if (handle != INVALID_HANDLE_VALUE) {
+			CloseHandle(handle);
+			handle = INVALID_HANDLE_VALUE;
+		}
+	}
+	bool Open(const std::wstring &path, bool write) {
+		handle = CreateFileW(path.c_str(), write ? GENERIC_WRITE : GENERIC_READ,
+							 write ? 0 : FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr,
+							 write ? CREATE_NEW : OPEN_EXISTING,
+							 FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+		if (handle == INVALID_HANDLE_VALUE)
+			return false;
+		BY_HANDLE_FILE_INFORMATION s{};
+		if (!GetFileInformationByHandle(handle, &s) ||
+			(s.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) ||
+			s.nNumberOfLinks != 1) {
+			Close();
+			return false;
+		}
+		return true;
+	}
+	bool Size(uint64_t &size) {
+		LARGE_INTEGER n{};
+		if (!GetFileSizeEx(handle, &n) || n.QuadPart < 0)
+			return false;
+		size = uint64_t(n.QuadPart);
+		return true;
+	}
+	bool Transfer(uint8_t *p, size_t size, bool write) {
+		while (size) {
+			DWORD n = 0;
+			DWORD step = DWORD((std::min)(size, size_t(65536)));
+			BOOL ok = write ? WriteFile(handle, p, step, &n, nullptr)
+							: ReadFile(handle, p, step, &n, nullptr);
+			if (!ok || !n)
+				return false;
+			p += n;
+			size -= n;
+		}
+		return true;
+	}
+	bool Flush() {
+		return FlushFileBuffers(handle) != FALSE;
+	}
+};
+bool Remove(const std::wstring &path) {
+	return DeleteFileW(path.c_str()) != FALSE;
+}
+bool Rename(const std::wstring &from, const std::wstring &to) {
+	return MoveFileExW(from.c_str(), to.c_str(),
+					   MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != FALSE;
+}
+void Touch(const std::wstring &path) {
+	HANDLE h = CreateFileW(path.c_str(), FILE_WRITE_ATTRIBUTES,
+						   FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+						   OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+	if (h != INVALID_HANDLE_VALUE) {
+		FILETIME now{};
+		GetSystemTimeAsFileTime(&now);
+		SetFileTime(h, nullptr, nullptr, &now);
+		CloseHandle(h);
+	}
+}
+#else
+const wchar_t Separator = L'/';
+std::string Native(const std::wstring &path) {
+	return std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path);
+}
+struct File {
+	int handle = -1;
+	~File() {
+		Close();
+	}
+	void Close() {
+		if (handle >= 0) {
+			close(handle);
+			handle = -1;
+		}
+	}
+	bool Open(const std::wstring &path, bool write) {
+		handle = open(Native(path).c_str(),
+					  (write ? O_WRONLY | O_CREAT | O_EXCL : O_RDONLY) | O_NOFOLLOW, 0600);
+		if (handle < 0)
+			return false;
+		struct stat s{};
+		if (fstat(handle, &s) || !S_ISREG(s.st_mode) || s.st_nlink != 1) {
+			Close();
+			return false;
+		}
+		return true;
+	}
+	bool Size(uint64_t &size) {
+		struct stat s{};
+		if (fstat(handle, &s) || s.st_size < 0)
+			return false;
+		size = uint64_t(s.st_size);
+		return true;
+	}
+	bool Transfer(uint8_t *p, size_t size, bool write) {
+		while (size) {
+			ssize_t n = write ? ::write(handle, p, (std::min)(size, size_t(65536)))
+							  : ::read(handle, p, (std::min)(size, size_t(65536)));
+			if (n <= 0)
+				return false;
+			p += n;
+			size -= size_t(n);
+		}
+		return true;
+	}
+	bool Flush() {
+		return fsync(handle) == 0;
+	}
+};
+bool Remove(const std::wstring &path) {
+	return unlink(Native(path).c_str()) == 0;
+}
+bool Rename(const std::wstring &from, const std::wstring &to) {
+	return rename(Native(from).c_str(), Native(to).c_str()) == 0;
+}
+void Touch(const std::wstring &path) {
+	utimensat(AT_FDCWD, Native(path).c_str(), nullptr, AT_SYMLINK_NOFOLLOW);
+}
+#endif
+struct DirectoryLock {
+#ifdef _WIN32
+	HANDLE handle = INVALID_HANDLE_VALUE;
+	explicit DirectoryLock(const std::wstring &path) {
+		handle = CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_ALWAYS,
+							 FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+		if (handle != INVALID_HANDLE_VALUE) {
+			BY_HANDLE_FILE_INFORMATION s{};
+			if (!GetFileInformationByHandle(handle, &s) ||
+				(s.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) ||
+				s.nNumberOfLinks != 1) {
+				CloseHandle(handle);
+				handle = INVALID_HANDLE_VALUE;
+			}
+		}
+	}
+	~DirectoryLock() {
+		if (handle != INVALID_HANDLE_VALUE)
+			CloseHandle(handle);
+	}
+	bool Valid() const {
+		return handle != INVALID_HANDLE_VALUE;
+	}
+#else
+	int handle = -1;
+	explicit DirectoryLock(const std::wstring &path) {
+		handle = open(Native(path).c_str(), O_RDWR | O_CREAT | O_NOFOLLOW, 0600);
+		if (handle >= 0) {
+			struct stat s{};
+			if (fstat(handle, &s) || !S_ISREG(s.st_mode) || s.st_nlink != 1 ||
+				flock(handle, LOCK_EX | LOCK_NB)) {
+				close(handle);
+				handle = -1;
+			}
+		}
+	}
+	~DirectoryLock() {
+		if (handle >= 0)
+			close(handle);
+	}
+	bool Valid() const {
+		return handle >= 0;
+	}
+#endif
+};
+struct Entry {
+	std::wstring name;
+	uint64_t bytes = 0, touched = 0;
+	bool temporary = false;
+};
+} // namespace
+DiskAssetCache::DiskAssetCache(std::wstring directory, size_t budgetBytes, size_t maximumEntries)
+	: directory_(std::move(directory)), budget_(budgetBytes), maximum_(maximumEntries) {
+}
+std::wstring DiskAssetCache::EntryName(const SourceDigest &digest) {
+	std::array<uint8_t, 44> key{};
+	std::copy(digest.begin(), digest.end(), key.begin());
+	Put(key.data() + 32, 1, 4);
+	Put(key.data() + 36, 1, 4);
+	Put(key.data() + 40, 1, 4);
+	auto hash = HashBytes(key.data(), key.size());
+	std::wstring name;
+	const wchar_t *hex = L"0123456789abcdef";
+	for (uint8_t b : hash) {
+		name += hex[b >> 4];
+		name += hex[b & 15];
+	}
+	return name + L".xxpc";
+}
+bool DiskAssetCache::Directory() {
+	if (directory_.empty() || directory_.size() > 30000 || !budget_ || !maximum_ || maximum_ > 4096)
+		return false;
+#ifdef _WIN32
+	std::vector<wchar_t> buffer(32768);
+	DWORD n = GetFullPathNameW(directory_.c_str(), DWORD(buffer.size()), buffer.data(), nullptr);
+	if (!n || n >= buffer.size())
+		return false;
+	std::wstring full(buffer.data(), n);
+	if (full.size() < 3 || full[1] != L':' || full.find(L':', 2) != std::wstring::npos)
+		return false;
+	for (size_t i = 3; i <= full.size(); ++i) {
+		if (i != full.size() && full[i] != L'\\' && full[i] != L'/')
+			continue;
+		auto part = full.substr(0, i);
+		DWORD a = GetFileAttributesW(part.c_str());
+		if (a == INVALID_FILE_ATTRIBUTES) {
+			if (!CreateDirectoryW(part.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS)
+				return false;
+			a = GetFileAttributesW(part.c_str());
+		}
+		if (a == INVALID_FILE_ATTRIBUTES || !(a & FILE_ATTRIBUTE_DIRECTORY) ||
+			(a & FILE_ATTRIBUTE_REPARSE_POINT))
+			return false;
+	}
+	directory_ = std::move(full);
+#else
+	std::string full = Native(directory_);
+	if (full.empty())
+		return false;
+	if (full[0] != '/') {
+		char current[32768];
+		if (!getcwd(current, sizeof(current)))
+			return false;
+		full = std::string(current) + "/" + full;
+	}
+	for (size_t i = 1; i <= full.size(); ++i) {
+		if (i != full.size() && full[i] != '/')
+			continue;
+		auto part = full.substr(0, i);
+		struct stat s{};
+		if (lstat(part.c_str(), &s)) {
+			if (mkdir(part.c_str(), 0700) && errno != EEXIST)
+				return false;
+			if (lstat(part.c_str(), &s))
+				return false;
+		}
+		if (!S_ISDIR(s.st_mode) || S_ISLNK(s.st_mode))
+			return false;
+	}
+	directory_ = std::wstring_convert<std::codecvt_utf8<wchar_t>>().from_bytes(full);
+#endif
+	return true;
+}
+bool DiskAssetCache::MakeRoom(uint64_t bytes) {
+	if (bytes > budget_)
+		return false;
+	std::vector<Entry> entries;
+	uint64_t total = 0;
+	size_t visited = 0;
+#ifdef _WIN32
+	WIN32_FIND_DATAW data{};
+	HANDLE search = FindFirstFileW((directory_ + Separator + L"*").c_str(), &data);
+	if (search == INVALID_HANDLE_VALUE)
+		return false;
+	bool valid = true;
+	do {
+		if (++visited > maximum_ + 3) {
+			valid = false;
+			break;
+		}
+		std::wstring name = data.cFileName;
+		if (name == L"." || name == L".." || name == L".lock")
+			continue;
+		bool temporary = false;
+		if (!OwnedName(name, temporary) ||
+			(data.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) {
+			valid = false;
+			break;
+		}
+		uint64_t size = (uint64_t(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+		uint64_t touched = (uint64_t(data.ftLastWriteTime.dwHighDateTime) << 32) |
+						   data.ftLastWriteTime.dwLowDateTime;
+		entries.push_back(Entry{name, size, touched, temporary});
+	} while (FindNextFileW(search, &data));
+	FindClose(search);
+	if (!valid)
+		return false;
+#else
+	DIR *dir = opendir(Native(directory_).c_str());
+	if (!dir)
+		return false;
+	bool valid = true;
+	while (auto *item = readdir(dir)) {
+		if (++visited > maximum_ + 3) {
+			valid = false;
+			break;
+		}
+		std::string raw = item->d_name;
+		if (raw == "." || raw == ".." || raw == ".lock")
+			continue;
+		std::wstring name;
+		try {
+			name = std::wstring_convert<std::codecvt_utf8<wchar_t>>().from_bytes(raw);
+		} catch (...) {
+			valid = false;
+			break;
+		}
+		bool temporary = false;
+		struct stat s{};
+		if (!OwnedName(name, temporary) ||
+			lstat(Native(directory_ + Separator + name).c_str(), &s) || !S_ISREG(s.st_mode) ||
+			s.st_nlink != 1 || s.st_size < 0) {
+			valid = false;
+			break;
+		}
+		entries.push_back(Entry{
+			name, uint64_t(s.st_size),
+			uint64_t(s.st_mtim.tv_sec) * 1000000000 + uint64_t(s.st_mtim.tv_nsec), temporary});
+	}
+	closedir(dir);
+	if (!valid)
+		return false;
+#endif
+	for (const auto &e : entries) {
+		if (e.bytes > std::numeric_limits<uint64_t>::max() - total)
+			return false;
+		total += e.bytes;
+	}
+	std::sort(entries.begin(), entries.end(),
+			  [](const Entry &a, const Entry &b) { return a.touched < b.touched; });
+	size_t count = entries.size();
+	// The process-exclusive directory lock proves these temporary entries have
+	// no live writer. Reclaim interrupted publications before quota admission.
+	for (const auto &e : entries)
+		if (e.temporary) {
+			auto path = directory_ + Separator + e.name;
+			File orphan;
+			if (orphan.Open(path, false)) {
+				orphan.Close();
+				if (Remove(path)) {
+					total -= e.bytes;
+					--count;
+				}
+			}
+		}
+	for (const auto &e : entries) {
+		if (total <= budget_ - bytes && count + (bytes ? 1 : 0) <= maximum_)
+			return true;
+		if (!e.temporary && Remove(directory_ + Separator + e.name)) {
+			total -= e.bytes;
+			--count;
+		}
+	}
+	return total <= budget_ - bytes && count + (bytes ? 1 : 0) <= maximum_;
+}
+bool DiskAssetCache::Load(const SourceSnapshot &source, size_t maximum,
+						  std::shared_ptr<const DecodedImage> &result) {
+	if (!source.watchable || !source.bytes)
+		return false;
+	std::lock_guard<std::mutex> lock(mutex_);
+	try {
+		if (!Directory())
+			return false;
+		DirectoryLock diskLock(directory_ + Separator + L".lock");
+		if (!diskLock.Valid() || !MakeRoom(0))
+			return false;
+		auto path = directory_ + Separator + EntryName(source.digest);
+		File file;
+		if (!file.Open(path, false))
+			return false;
+		uint64_t size = 0;
+		std::array<uint8_t, HeaderSize> header{};
+		bool valid = file.Size(size) && size >= HeaderSize &&
+					 file.Transfer(header.data(), header.size(), false);
+		if (valid) {
+			auto checksum = HashBytes(header.data(), 112);
+			valid = std::memcmp(header.data(), "XXMIDC01", 8) == 0 &&
+					Get(header.data() + 8, 4) == 1 && Get(header.data() + 12, 4) == 1 &&
+					Get(header.data() + 68, 4) == 1 &&
+					std::equal(source.digest.begin(), source.digest.end(), header.begin() + 16) &&
+					std::equal(checksum.begin(), checksum.end(), header.begin() + 112);
+		}
+		uint64_t length = Get(header.data() + 72, 8);
+		if (valid)
+			valid = length <= maximum && length <= std::vector<uint8_t>().max_size() &&
+					length == size - HeaderSize && Get(header.data() + 64, 4) <= 1 &&
+					Layout(Get(header.data() + 48, 4), Get(header.data() + 52, 4),
+						   Get(header.data() + 56, 4), Get(header.data() + 60, 4), length);
+		if (!valid) {
+			file.Close();
+			Remove(path);
+			return false;
+		}
+		auto pixels = std::make_shared<std::vector<uint8_t>>(size_t(length));
+		if (!file.Transfer(pixels->data(), pixels->size(), false)) {
+			file.Close();
+			Remove(path);
+			return false;
+		}
+		auto digest = HashBytes(pixels->data(), pixels->size());
+		if (!std::equal(digest.begin(), digest.end(), header.begin() + 80)) {
+			file.Close();
+			Remove(path);
+			return false;
+		}
+		auto image = std::make_shared<DecodedImage>();
+		image->width = uint32_t(Get(header.data() + 48, 4));
+		image->height = uint32_t(Get(header.data() + 52, 4));
+		image->rowPitch = uint32_t(Get(header.data() + 56, 4));
+		image->format = uint32_t(Get(header.data() + 60, 4));
+		image->metadataSRGB = Get(header.data() + 64, 4) != 0;
+		image->pixels = pixels;
+		file.Close();
+		Touch(path);
+		result = std::move(image);
+		return true;
+	} catch (...) {
+		return false;
+	}
+}
+bool DiskAssetCache::Store(const SourceSnapshot &source, const DecodedImage &image) {
+	if (!source.watchable || !source.bytes || !image.pixels || image.decoderVersion != 1 ||
+		!Layout(image.width, image.height, image.rowPitch, image.format, image.pixels->size()))
+		return false;
+	std::lock_guard<std::mutex> lock(mutex_);
+	try {
+		if (!Directory())
+			return false;
+		DirectoryLock diskLock(directory_ + Separator + L".lock");
+		if (!diskLock.Valid() ||
+			image.pixels->size() > std::numeric_limits<uint64_t>::max() - HeaderSize ||
+			!MakeRoom(image.pixels->size() + HeaderSize))
+			return false;
+		std::array<uint8_t, HeaderSize> header{};
+		std::memcpy(header.data(), "XXMIDC01", 8);
+		Put(header.data() + 8, 1, 4);
+		Put(header.data() + 12, 1, 4);
+		std::copy(source.digest.begin(), source.digest.end(), header.begin() + 16);
+		Put(header.data() + 48, image.width, 4);
+		Put(header.data() + 52, image.height, 4);
+		Put(header.data() + 56, image.rowPitch, 4);
+		Put(header.data() + 60, image.format, 4);
+		Put(header.data() + 64, image.metadataSRGB ? 1 : 0, 4);
+		Put(header.data() + 68, 1, 4);
+		Put(header.data() + 72, image.pixels->size(), 8);
+		auto digest = HashBytes(image.pixels->data(), image.pixels->size());
+		std::copy(digest.begin(), digest.end(), header.begin() + 80);
+		digest = HashBytes(header.data(), 112);
+		std::copy(digest.begin(), digest.end(), header.begin() + 112);
+		auto path = directory_ + Separator + EntryName(source.digest), temporary = path + L".tmp";
+		File file;
+		if (!file.Open(temporary, true))
+			return false;
+		bool ok = file.Transfer(header.data(), header.size(), true) &&
+				  file.Transfer(const_cast<uint8_t *>(image.pixels->data()), image.pixels->size(),
+								true) &&
+				  file.Flush();
+		file.Close();
+		if (ok)
+			ok = Rename(temporary, path);
+		if (!ok)
+			Remove(temporary);
+		return ok;
+	} catch (...) {
+		return false;
+	}
+}
+} // namespace ModLoading
