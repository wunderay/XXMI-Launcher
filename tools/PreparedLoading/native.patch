+struct ConfigLegacyWriteScope::State {
+    std::unique_lock<std::mutex> lock;
+    ConfigGenerationPin previous, previousSelection, candidate;
+    bool previousDetached = false;
+    bool acquired = false;
+    State() {
+        if (!configurationBuilder && configurationReadDepth <= 1)
+            lock = ConfigurationRegistryInstance().TryBeginLegacy(configurationReadDepth ? 1 : 0);
+    }
+};
+ConfigLegacyWriteScope::ConfigLegacyWriteScope() : state_(new State)
+{
+    if (!state_->lock.owns_lock()) return;
+    auto& registry = ConfigurationRegistryInstance();
+    // Only the owning frame boundary may be inside a reader. A command,
+    // input callback or nested draw cannot replace its own linked pointers.
+    if (configurationBuilder || configurationReadDepth > 1) {
+        state_->lock.unlock();
+        return;
+    }
+    state_->previous = registry.ActiveUnderLock();
+    state_->previousSelection = configurationBuilder;
+    state_->previousDetached = configurationBuilderDetached;
+    configurationBuilder = registry.ActiveUnderLock();
+    configurationBuilderDetached = false;
+    state_->acquired = true;
+}
+ConfigLegacyWriteScope::~ConfigLegacyWriteScope()
+{
+    if (!state_->acquired) return;
+    configurationBuilder = std::move(state_->previousSelection);
+    configurationBuilderDetached = state_->previousDetached;
+    // Candidate/previous graph destruction happens AFTER unlocking; COM
+    // destruction may call hooked release paths and reacquire this registry.
+    state_->lock.unlock();
+}
+ConfigLegacyWriteScope::operator bool() const { return state_->acquired; }
+void ConfigLegacyWriteScope::BeginCandidate()
+{
+    state_->candidate = std::make_shared<ConfigurationState>();
+    // Preserve only the currently allocated GPU parameter texture's shape, so
+    // legacy resize detection also handles removing the last parameter. Values
+    // are reset by InitIniParams, exactly as in upstream reload semantics.
+    state_->candidate->iniParams.resize(state_->previous->iniParams.size());
+    configurationBuilder = state_->candidate;
+}
