+		bool AbsolutePath(const std::wstring& path, std::wstring& out) {
+			if(path.empty()||path.size()>32768)return false;
+#ifdef _WIN32
+			std::vector<wchar_t> b(32768);
+			DWORD n=GetFullPathNameW(path.c_str(),DWORD(b.size()),b.data(),nullptr);
+			if(!n||n>=b.size())return false;
