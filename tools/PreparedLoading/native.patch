+ConfigSource Source(const std::wstring& path, const std::string& text, const std::wstring& space = L"") {
+    ConfigSource result;
+    result.snapshot.path = path;
+    result.snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(text.begin(), text.end());
+    result.snapshot.digest = HashBytes(result.snapshot.bytes->data(), result.snapshot.bytes->size());
+    result.iniNamespace = space;
+    return result;
+}
+void EqualIR(const CompiledConfig& a, const CompiledConfig& b) {
+    assert(a.identity == b.identity && a.files.size() == b.files.size());
+    assert(a.disposition == b.disposition && a.dependencies == b.dependencies);
+    for (size_t i = 0; i < a.files.size(); ++i) {
+        const auto& x = *a.files[i]; const auto& y = *b.files[i];
+        assert(x.digest == y.digest && x.declaredIncludes == y.declaredIncludes);
+        assert(x.lines.size() == y.lines.size() && x.physicalLines.size() == y.physicalLines.size());
+        for (size_t j = 0; j < x.physicalLines.size(); ++j) {
+            const auto& p = x.physicalLines[j]; const auto& q = y.physicalLines[j];
+            assert(p.kind == q.kind && p.raw == q.raw && p.text == q.text && p.line == q.line);
+            assert(p.section == q.section && p.key == q.key && p.value == q.value && p.hasEquals == q.hasEquals);
+        }
+        for (size_t j = 0; j < x.lines.size(); ++j) {
+            const auto& p = x.lines[j]; const auto& q = y.lines[j];
+            assert(p.section == q.section && p.key == q.key && p.value == q.value && p.raw == q.raw && p.line == q.line);
+        }
+    }
+}
+void CompilerAdmissionTests() {
+    struct Ledger {
+        uint64_t used = 0, capacity = 16 * 1024 * 1024;
+    };
+    auto ledger = std::make_shared<Ledger>();
+    auto reserve = [ledger](uint64_t bytes) -> std::shared_ptr<const void> {
+        if (ledger->used > ledger->capacity || bytes > ledger->capacity - ledger->used) return {};
+        ledger->used += bytes;
+        return std::shared_ptr<const void>(new uint64_t(bytes), [ledger](const void* value) {
+            const auto count = static_cast<const uint64_t*>(value);
+            ledger->used -= *count;
+            delete count;
+        });
+    };
+    ConfigSourceManifest sources;
+    sources.verified = true;
+    sources.sources.push_back(Source(L"/root/a.ini", "[Constants]\nglobal $x = 1\n"));
+    sources.ownership = reserve(sources.MetadataBytes());
+    sources.reserve = reserve;
+    sources.budgetIdentity = ledger;
+    const auto initial = ledger->used;
+    {
+        IncrementalConfigCache cache;
+        ConfigCompiler compiler(cache);
+        ledger->capacity = initial;
+        auto refused = compiler.Build(sources, {}, {1, 1, 1}, true);
+        assert(refused->disposition == ConfigDisposition::CompatibilityOnly && cache.Entries() == 0);
+        assert(ledger->used == initial);
+        ledger->capacity = 16 * 1024 * 1024;
+        auto compiled = compiler.Build(sources, {}, {1, 1, 1}, true);
+        assert(compiled->files.size() == 1 && compiled->files[0]->ownership);
+        auto ir = compiled->files[0];
+        compiled.reset();
+        assert(ledger->used > initial);
+        cache.SetSchema({3, 3, 3});
+        assert(ledger->used > initial); // external IR pin owns its reservation
+        ir.reset();
+        assert(ledger->used == initial);
+        // An IR parsed without budget admission cannot become a free cache hit
+        // when a later, budgeted candidate requests the same source.
+        bool reused = false;
+        auto uncharged = cache.Parse(sources.sources[0].snapshot, false, reused);
+        assert(uncharged && !uncharged->ownership);
+        auto charged = cache.Parse(sources.sources[0].snapshot, false, reused, reserve, ledger);
+        assert(charged && charged->ownership && !reused);
+        auto warm = cache.Parse(sources.sources[0].snapshot, false, reused, reserve, ledger);
+        assert(warm == charged && reused);
+        auto otherLedger = std::make_shared<int>(0);
+        auto distinct = cache.Parse(sources.sources[0].snapshot, false, reused, reserve, otherLedger);
+        assert(distinct && distinct != charged && distinct->budgetIdentity == otherLedger && !reused);
+        auto anonymous = cache.Parse(sources.sources[0].snapshot, false, reused, reserve);
+        assert(anonymous && anonymous != distinct && !reused);
+    }
+    assert(ledger->used == initial);
+    {
+        IncrementalConfigCache cache;
+        bool reused = false;
+        std::string text = "\xef\xbb\xbf[" + std::string(4096, 's') + "]\n";
+        for (unsigned i = 0; i < 100; ++i) text += "a=1\n";
+        auto expanded = Source(L"/root/expanded.ini", text);
+        ledger->capacity = initial + 512 * 1024;
+        assert(!cache.Parse(expanded.snapshot, false, reused, reserve));
+        assert(cache.Entries() == 0 && ledger->used == initial);
+        ledger->capacity = 16 * 1024 * 1024;
+    }
+    sources = ConfigSourceManifest{};
+    assert(ledger->used == 0);
+}
