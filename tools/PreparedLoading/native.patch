+				auto part=full.substr(start,end-start);
+				if(part==L".."){
+					if(!parts.empty())parts.pop_back();
+				}
+				else if(!part.empty()&&part!=L".")parts.push_back(part);
+				start=end+1;
+			}
+			out=L"/";
+			for(size_t i=0;i<parts.size();++i){
+				if(i)out+=L"/";
+				out+=parts[i];
+			}
