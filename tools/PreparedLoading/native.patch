+namespace ModLoading {
+namespace {
+uint32_t Rotate(uint32_t v, unsigned n) {
+	return (v >> n) | (v << (32 - n));
+}
+const uint32_t K[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+struct Sha {
+	uint32_t h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+					 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+	uint8_t tail[64]{};
+	size_t used = 0;
+	uint64_t length = 0;
+	void Block(const uint8_t *b) {
+		uint32_t w[64];
+		for (size_t i = 0; i < 16; ++i)
+			w[i] = (uint32_t(b[4 * i]) << 24) | (uint32_t(b[4 * i + 1]) << 16) |
+				   (uint32_t(b[4 * i + 2]) << 8) | b[4 * i + 3];
+		for (size_t i = 16; i < 64; ++i) {
+			uint32_t x = w[i - 15], y = w[i - 2];
+			w[i] = w[i - 16] + (Rotate(x, 7) ^ Rotate(x, 18) ^ (x >> 3)) + w[i - 7] +
+				   (Rotate(y, 17) ^ Rotate(y, 19) ^ (y >> 10));
+		}
+		uint32_t a = h[0], b0 = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], z = h[7];
+		for (size_t i = 0; i < 64; ++i) {
+			uint32_t t = z + (Rotate(e, 6) ^ Rotate(e, 11) ^ Rotate(e, 25)) + ((e & f) ^ (~e & g)) +
+						 K[i] + w[i];
+			uint32_t u =
+				(Rotate(a, 2) ^ Rotate(a, 13) ^ Rotate(a, 22)) + ((a & b0) ^ (a & c) ^ (b0 & c));
+			z = g;
+			g = f;
+			f = e;
+			e = d + t;
+			d = c;
+			c = b0;
+			b0 = a;
+			a = t + u;
+		}
+		h[0] += a;
+		h[1] += b0;
+		h[2] += c;
+		h[3] += d;
+		h[4] += e;
+		h[5] += f;
+		h[6] += g;
+		h[7] += z;
+	}
+	void Add(const uint8_t *p, size_t n) {
+		length += n;
+		while (n) {
+			size_t c = std::min(n, 64 - used);
+			std::memcpy(tail + used, p, c);
+			used += c;
+			p += c;
+			n -= c;
+			if (used == 64) {
+				Block(tail);
+				used = 0;
+			}
+		}
+	}
+	SourceDigest End() {
+		uint64_t bits = length * 8;
+		uint8_t one = 128;
+		Add(&one, 1);
+		uint8_t zero = 0;
+		while (used != 56)
+			Add(&zero, 1);
+		uint8_t n[8];
+		for (size_t i = 0; i < 8; ++i)
+			n[7 - i] = uint8_t(bits >> (8 * i));
+		Add(n, 8);
+		SourceDigest r{};
+		for (size_t i = 0; i < 32; ++i)
+			r[i] = uint8_t(h[i / 4] >> (24 - 8 * (i % 4)));
+		return r;
+	}
+};
+#ifdef _WIN32
+struct Handle {
+	HANDLE value = INVALID_HANDLE_VALUE;
+	~Handle() {
+		if (value != INVALID_HANDLE_VALUE)
+			CloseHandle(value);
+	}
+	bool Open(const std::wstring &path) {
+		value = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+							nullptr, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+		return value != INVALID_HANDLE_VALUE;
+	}
+	bool Identity(FileIdentity &out) {
+		BY_HANDLE_FILE_INFORMATION s{};
+		if (!GetFileInformationByHandle(value, &s) ||
+			(s.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+			return false;
+		out.volume = s.dwVolumeSerialNumber;
+		out.file = (uint64_t(s.nFileIndexHigh) << 32) | s.nFileIndexLow;
+		out.size = (uint64_t(s.nFileSizeHigh) << 32) | s.nFileSizeLow;
+		out.modified =
+			(uint64_t(s.ftLastWriteTime.dwHighDateTime) << 32) | s.ftLastWriteTime.dwLowDateTime;
+		return true;
+	}
+	bool SingleLink() {
+		BY_HANDLE_FILE_INFORMATION s{};
+		return GetFileInformationByHandle(value, &s) && s.nNumberOfLinks == 1;
+	}
+	bool Read(uint8_t *p, size_t n, size_t &got) {
+		DWORD count = 0;
+		bool ok = ReadFile(value, p, DWORD(n), &count, nullptr) != FALSE;
+		got = count;
+		return ok;
+	}
+	bool Rewind() {
+		LARGE_INTEGER zero{};
+		return SetFilePointerEx(value, zero, nullptr, FILE_BEGIN) != FALSE;
+	}
+};
+#else
+struct Handle {
+	int value = -1;
+	~Handle() {
+		if (value >= 0)
+			close(value);
+	}
+	bool Open(const std::wstring &path) {
+		try {
+			value = open(std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path).c_str(),
+						 O_RDONLY);
+		} catch (...) {
+			return false;
+		}
+		return value >= 0;
+	}
+	bool Identity(FileIdentity &out) {
+		struct stat s{};
+		if (fstat(value, &s) || !S_ISREG(s.st_mode) || s.st_size < 0)
+			return false;
+		out.volume = uint64_t(s.st_dev);
+		out.file = uint64_t(s.st_ino);
+		out.size = uint64_t(s.st_size);
+		out.modified = uint64_t(s.st_mtim.tv_sec) * 1000000000 + uint64_t(s.st_mtim.tv_nsec);
+		return true;
+	}
+	bool SingleLink() {
+		struct stat s{};
+		return fstat(value, &s) == 0 && s.st_nlink == 1;
+	}
+	bool Read(uint8_t *p, size_t n, size_t &got) {
+		ssize_t r = read(value, p, n);
+		if (r < 0)
+			return false;
+		got = size_t(r);
+		return true;
+	}
+	bool Rewind() {
+		return lseek(value, 0, SEEK_SET) == 0;
+	}
+};
+#endif
+// Inspect every lexical component, including ancestors. Do not resolve symlinks:
+// their target may live outside the directory-notification closure.
+bool WatchablePath(const std::wstring &path, std::string *reason) {
+	if (reason)
+		reason->clear();
+#ifdef _WIN32
+	std::vector<wchar_t> buffer(32768);
+	DWORD count = GetFullPathNameW(path.c_str(), DWORD(buffer.size()), buffer.data(), nullptr);
+	if (!count || count >= buffer.size())
+		return false;
+	std::wstring full(buffer.data(), count);
+	// Directory notifications do not provide the stream-qualified identity used
+	// by a path-keyed cache. Only the drive separator may contain a colon.
+	if (full.find(L':', 2) != std::wstring::npos)
+		return false;
+	// Notifications use long names; reject 8.3 aliases until their notification
+	// identity is tracked explicitly. Case differences alone are equivalent.
+	DWORD longCount = GetLongPathNameW(full.c_str(), buffer.data(), DWORD(buffer.size()));
+	if (!longCount || longCount >= buffer.size() ||
+		CompareStringOrdinal(full.c_str(), int(full.size()), buffer.data(), int(longCount), TRUE) !=
+			CSTR_EQUAL)
+		return false;
+	// A long lexical name may itself have a distinct 8.3 notification identity.
+	// Until notifications are matched by file identity, neither spelling is ready.
+	DWORD shortCount = GetShortPathNameW(full.c_str(), buffer.data(), DWORD(buffer.size()));
+	if (!shortCount || shortCount >= buffer.size()) {
+		if (reason)
+			*reason = "source short-name notification identity could not be verified";
+		return false;
+	}
+	if (CompareStringOrdinal(full.c_str(), int(full.size()), buffer.data(), int(shortCount),
+							 TRUE) != CSTR_EQUAL) {
+		if (reason)
+			*reason = "source has an alternate short-name notification identity";
+		return false;
+	}
+	for (size_t i = 0; i <= full.size(); ++i) {
+		if (i != full.size() && full[i] != L'\\' && full[i] != L'/')
+			continue;
+		if (i == 0 || (i == 2 && full[1] == L':'))
+			continue;
+		// Extended and UNC namespace roots are conservatively unsupported.
+		if (i == 1)
+			return false;
+		DWORD attributes = GetFileAttributesW(full.substr(0, i).c_str());
+		if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_REPARSE_POINT))
+			return false;
+	}
+#else
+	std::string full;
+	try {
+		full = std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path);
+	} catch (...) {
+		return false;
+	}
+	if (full.empty())
+		return false;
+	if (full[0] != '/') {
+		char current[32768];
+		if (!getcwd(current, sizeof(current)))
+			return false;
+		full = std::string(current) + "/" + full;
+	}
+	for (size_t i = 1; i <= full.size(); ++i) {
+		if (i != full.size() && full[i] != '/')
+			continue;
+		struct stat s{};
+		if (lstat(full.substr(0, i).c_str(), &s) || S_ISLNK(s.st_mode))
+			return false;
+	}
+#endif
+	return true;
+}
+} // namespace
+SourceDigest HashBytes(const uint8_t *bytes, size_t size) {
+	Sha s;
+	s.Add(bytes, size);
+	return s.End();
+}
+bool ReadVerifiedSnapshot(const std::wstring &path, size_t maxBytes, SourceSnapshot &result,
+						  std::string &error) {
+	Handle h;
+	FileIdentity before, after;
+	if (!h.Open(path) || !h.Identity(before)) {
+		error = "source unavailable";
+		return false;
+	}
+	if (before.size > maxBytes || before.size > std::numeric_limits<size_t>::max() ||
+		before.size > std::vector<uint8_t>().max_size()) {
+		error = "source exceeds budget";
+		return false;
+	}
+	try {
+		std::string compatibilityReason;
+		const bool watchableBefore = h.SingleLink() && WatchablePath(path, &compatibilityReason);
+		auto bytes = std::make_shared<std::vector<uint8_t>>(size_t(before.size));
+		size_t offset = 0;
+		while (offset < bytes->size()) {
+			size_t count = 0;
+			if (!h.Read(bytes->data() + offset, std::min(size_t(65536), bytes->size() - offset),
+						count) ||
+				!count) {
+				error = "incomplete source";
+				return false;
+			}
+			offset += count;
+		}
+		if (!h.Identity(after) || !(before == after)) {
+			error = "source changed";
+			return false;
+		}
+		SourceDigest digest = HashBytes(bytes->data(), bytes->size());
+		// A second pass catches same-size writes with preserved timestamps, including on POSIX.
+		if (!h.Rewind()) {
+			error = "source seek failed";
+			return false;
+		}
+		Sha check;
+		uint8_t block[65536];
+		offset = 0;
+		while (offset < bytes->size()) {
+			size_t count = 0;
+			if (!h.Read(block, std::min(sizeof(block), bytes->size() - offset), count) || !count) {
+				error = "source changed";
+				return false;
+			}
+			check.Add(block, count);
+			offset += count;
+		}
+		if (check.End() != digest || !h.Identity(after) || !(before == after)) {
+			error = "source changed";
+			return false;
+		}
+		SourceSnapshot candidate;
+		candidate.watchable =
+			watchableBefore && h.SingleLink() && WatchablePath(path, &compatibilityReason);
+		if (!candidate.watchable)
+			candidate.compatibilityReason =
+				compatibilityReason.empty()
+					? "source alias dependencies are outside lexical watches"
+					: std::move(compatibilityReason);
+		candidate.path = path;
+		candidate.identity = before;
+		candidate.digest = digest;
+		candidate.bytes = bytes;
+		result = std::move(candidate);
+		error.clear();
+		return true;
+	} catch (const std::bad_alloc &) {
+		error = "source allocation failed";
+		return false;
+	}
+}
+} // namespace ModLoading
+#ifdef _WIN32
+#include <wincodec.h>
+#include <wrl/client.h>
+#include <propvarutil.h>
+namespace ModLoading {
+bool DecodeSnapshot(const SourceSnapshot &source, size_t maxDecodedBytes,
+					std::shared_ptr<const DecodedImage> &result, std::string &error) {
+	using Microsoft::WRL::ComPtr;
+	if (!source.bytes || source.bytes->empty() || source.bytes->size() > MAXDWORD) {
+		error = "unsupported encoded size";
+		return false;
+	}
+	// DDS payloads remain untouched; compressed formats, arrays and mipchains are handled by the DDS loader.
+	if (source.bytes->size() >= 4 && std::memcmp(source.bytes->data(), "DDS ", 4) == 0) {
+		error = "DDS preserved for layout-aware loader";
+		return false;
+	}
+	ComPtr<IWICImagingFactory> factory;
+	ComPtr<IWICStream> stream;
+	ComPtr<IWICBitmapDecoder> decoder;
+	ComPtr<IWICBitmapFrameDecode> frame;
+	HRESULT hr = CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER,
+								  IID_PPV_ARGS(factory.GetAddressOf()));
+	if (FAILED(hr) || FAILED(factory->CreateStream(stream.GetAddressOf())) ||
+		FAILED(stream->InitializeFromMemory(const_cast<BYTE *>(source.bytes->data()),
+											DWORD(source.bytes->size()))) ||
+		FAILED(factory->CreateDecoderFromStream(
+			stream.Get(), nullptr, WICDecodeMetadataCacheOnDemand, decoder.GetAddressOf())) ||
+		FAILED(decoder->GetFrame(0, frame.GetAddressOf()))) {
+		error = "WIC unavailable or unsupported";
+		return false;
+	}
+	UINT width = 0, height = 0;
+	WICPixelFormatGUID native{};
+	if (FAILED(frame->GetSize(&width, &height)) || FAILED(frame->GetPixelFormat(&native)) ||
+		!width || !height || width > 16384 || height > 16384) {
+		error = "unsupported WIC dimensions";
+		return false;
+	}
+	uint32_t format = 0;
+	GUID target = native;
+	if (IsEqualGUID(native, GUID_WICPixelFormat32bppRGBA))
+		format = 28;
+	else if (IsEqualGUID(native, GUID_WICPixelFormat32bppBGRA))
+		format = 87;
+	else if (IsEqualGUID(native, GUID_WICPixelFormat32bppBGR))
+		format = 88;
+	else if (IsEqualGUID(native, GUID_WICPixelFormat24bppRGB) ||
+			 IsEqualGUID(native, GUID_WICPixelFormat24bppBGR)) {
+		format = 28;
+		target = GUID_WICPixelFormat32bppRGBA;
+	} else {
+		error = "WIC layout requires compatibility decode";
+		return false;
+	}
+	const uint64_t pitch = uint64_t(width) * 4, total = pitch * height;
+	if (total > maxDecodedBytes || total > MAXDWORD) {
+		error = "decoded image exceeds reservation";
+		return false;
+	}
+	try {
+		auto image = std::make_shared<DecodedImage>();
+		image->width = width;
+		image->height = height;
+		image->rowPitch = uint32_t(pitch);
+		image->format = format;
+		ComPtr<IWICMetadataQueryReader> metadata;
+		if (SUCCEEDED(frame->GetMetadataQueryReader(metadata.GetAddressOf()))) {
+			GUID container{};
+			PROPVARIANT value;
+			PropVariantInit(&value);
+			if (SUCCEEDED(metadata->GetContainerFormat(&container)) &&
+				IsEqualGUID(container, GUID_ContainerFormatPng)) {
+				if (SUCCEEDED(metadata->GetMetadataByName(L"/sRGB/RenderingIntent", &value)) &&
+					value.vt == VT_UI1)
+					image->metadataSRGB = true;
+			} else if (SUCCEEDED(metadata->GetMetadataByName(L"System.Image.ColorSpace", &value)) &&
+					   value.vt == VT_UI2 && value.uiVal == 1)
+				image->metadataSRGB = true;
+			PropVariantClear(&value);
+		}
+		auto pixels = std::make_shared<std::vector<uint8_t>>(size_t(total));
+		if (IsEqualGUID(native, target))
+			hr = frame->CopyPixels(nullptr, UINT(pitch), UINT(total), pixels->data());
+		else {
+			ComPtr<IWICFormatConverter> converter;
+			hr = factory->CreateFormatConverter(converter.GetAddressOf());
+			if (SUCCEEDED(hr))
+				hr = converter->Initialize(frame.Get(), target, WICBitmapDitherTypeErrorDiffusion,
+										   nullptr, 0, WICBitmapPaletteTypeMedianCut);
+			if (SUCCEEDED(hr))
+				hr = converter->CopyPixels(nullptr, UINT(pitch), UINT(total), pixels->data());
+		}
+		if (FAILED(hr)) {
+			error = "WIC pixel decode failed";
+			return false;
+		}
+		image->pixels = pixels;
+		result = std::move(image);
+		error.clear();
+		return true;
+	} catch (const std::bad_alloc &) {
+		error = "decoded image allocation failed";
+		return false;
+	}
+}
+} // namespace ModLoading
+#else
+namespace ModLoading {
+bool DecodeSnapshot(const SourceSnapshot &, size_t, std::shared_ptr<const DecodedImage> &,
+					std::string &error) {
+	error = "WIC requires Windows";
+	return false;
+}
+} // namespace ModLoading
+#endif
