+#!/usr/bin/env python3
+"""Own fixture output until its process-life writer exits, then check protocol."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+executable = Path(sys.argv[1]).resolve()
+with tempfile.TemporaryDirectory(prefix="xxmi-publisher-fixture-") as temporary:
+    output = Path(temporary) / "status"
+    subprocess.run([str(executable), str(output)], check=True, timeout=35)
+    raw = (output / "status.json").read_bytes()
+    assert len(raw) <= 8192
+    status = json.loads(raw)
+    assert status["schema_version"] == 1
+    assert status["process_id"] > 0
+    assert status["dll_sha256"] == hashlib.sha256(executable.read_bytes()).hexdigest()
+    assert 0 <= time.time() * 1000 - status["updated_unix_ms"] < 5000
+    assert status["mode"] == "off" and status["state"] == "off"
+    assert status["total_assets"] == status["cpu_ready"] == status["gpu_ready"] == 3
+    assert status["compatibility_assets"] == 0 and status["reason"] == "fixture off"
+    assert sorted(path.name for path in output.iterdir()) == ["status.json"]
+print("preparation_status: actual SHA256, JSON counts/state, heartbeat and atomic output verified")
diff --git a/tests/preparation_status/status_publisher_windows_test.cpp b/tests/preparation_status/status_publisher_windows_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..81d8ce7c229e49bc512ba14b610ded9316fe275f
--- /dev/null
+++ b/tests/preparation_status/status_publisher_windows_test.cpp
@@ -0,0 +1,78 @@
+#ifndef _WIN32
+#error Windows SDK fixture only
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#include "PreparationStatus.h"
+#include <chrono>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+using namespace ModLoading;
+namespace {
+void Require(bool ok, const char* message) { if (!ok) throw std::runtime_error(message); }
+std::string Read(const std::wstring& path) {
+    HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return {};
+    LARGE_INTEGER size = {};
+    if (!GetFileSizeEx(file, &size) || size.QuadPart < 1 || size.QuadPart > 8192) {
+        CloseHandle(file); throw std::runtime_error("unbounded or empty published status");
+    }
+    std::string bytes(static_cast<size_t>(size.QuadPart), '\0'); DWORD count = 0;
+    const bool ok = ReadFile(file, &bytes[0], static_cast<DWORD>(bytes.size()), &count, nullptr) != FALSE && count == bytes.size();
+    CloseHandle(file); Require(ok, "status read failed");
+    Require(bytes.front() == '{' && bytes.size() > 2 && bytes.substr(bytes.size() - 2) == "}\n", "partial JSON observed");
+    Require(bytes.find("\"schema_version\":1,") != std::string::npos, "wrong protocol");
+    return bytes;
+}
+std::string Wait(const std::wstring& path, const char* state, const PreparationStatus* status) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(8);
+    do {
+        if (status) UpdatePreparationStatus(*status, ReservePreparationStatusTicket()); // try_lock may drop.
+        auto json = Read(path);
+        if (json.find(std::string("\"state\":\"") + state + "\"") != std::string::npos) return json;
+        Sleep(40);
+    } while (std::chrono::steady_clock::now() < deadline);
+    throw std::runtime_error(std::string("publisher timeout waiting for ") + state);
+}
+}
+// Python fixture runner owns the supplied temporary directory and removes it
+// after this process exits; the process-lifetime writer never needs a stop hook.
+int wmain(int argc, wchar_t** argv) {
+    try {
+        Require(argc == 2, "expected owned temporary output directory argument");
+        const std::wstring output = argv[1], path = output + L"\\status.json";
+        PreparationStatus status; status.mode = PreparationMode::Adaptive;
+        status.state = PreparationStatusState::Preparing; status.totalAssets = 3;
+        status.cpuReady = 2; status.gpuReady = 1; status.reason = "fixture preparing";
+        UpdatePreparationStatus(status, ReservePreparationStatusTicket());
+        Require(GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES, "Update before Initialize wrote a file");
+        Require(InitializePreparationStatusForTesting(reinterpret_cast<const void*>(&InitializePreparationStatus), output), "initialize publisher");
+        UpdatePreparationStatus(status, ReservePreparationStatusTicket());
+        const auto first = Wait(path, "preparing", &status);
+        Require(first.find("\"total_assets\":3,") != std::string::npos && first.find("\"cpu_ready\":2,") != std::string::npos &&
+            first.find("\"gpu_ready\":1,") != std::string::npos, "real supplied counts not published");
+        // A heartbeat must refresh even when no new Runtime snapshot arrives.
+        Sleep(1300); const auto heartbeat = Read(path);
+        Require(!heartbeat.empty() && heartbeat != first, "heartbeat did not advance");
+        status.state = PreparationStatusState::Ready; status.cpuReady = 3; status.gpuReady = 3;
+        status.reason = "fixture ready"; UpdatePreparationStatus(status, ReservePreparationStatusTicket()); Wait(path, "ready", &status);
+        const auto obsolete = ReservePreparationStatusTicket();
+        InvalidatePreparationStatus();
+        UpdatePreparationStatus(status, obsolete); // Delayed Ready must be rejected.
+        const auto invalidated = Wait(path, "preparing", nullptr); // No future authoritative updates.
+        Require(invalidated.find("preparation status invalidated") != std::string::npos &&
+            invalidated.find("\"gpu_ready\":0,") != std::string::npos &&
+            invalidated.find("\"cpu_ready\":0,") != std::string::npos, "invalidation left fresh cached Ready");
+        // Off is a supplied state, with counters deliberately retained. Writer
+        // must not infer Ready simply because all resource counts happen to match.
+        status.mode = PreparationMode::Off; status.state = PreparationStatusState::Off;
+        status.reason = "fixture off"; UpdatePreparationStatus(status, ReservePreparationStatusTicket()); Wait(path, "off", &status);
+        std::cout << "preparation_status: Windows publisher fixture passed\n"; return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "publisher fixture failed: " << error.what() << " Win32=" << GetLastError() << '\n'; return 1;
+    }
+}
diff --git a/tests/preparation_status/status_serialization_test.cpp b/tests/preparation_status/status_serialization_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b2aa5191656759b34300de8d086c9cf0cd64fd20
--- /dev/null
+++ b/tests/preparation_status/status_serialization_test.cpp
@@ -0,0 +1,58 @@
+#include "PreparationStatus.h"
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <future>
+#include <thread>
+#include <mutex>
+#include <atomic>
+#include <chrono>
+using namespace ModLoading;
+void Check(bool value) { if (!value) throw std::runtime_error("status serializer contract"); }
+int main() {
+    PreparationStatus status;
+    status.mode = PreparationMode::Adaptive; status.state = PreparationStatusState::Preparing;
+    status.totalAssets = 4; status.cpuReady = 4; status.gpuReady = 4; status.compatibilityAssets = 0;
+    status.reason = std::string("quote\" slash\\ newline\n tab\t nul", 30) + std::string(1, '\0') + "end";
+    const std::string hash(64, 'a');
+    auto json = SerializePreparationStatus(status, 123, hash, 1000);
+    Check(!json.empty() && json.size() < 8192);
+    std::cout << json;
+    status.reason.assign(100000, '\0'); status.totalAssets = std::numeric_limits<uint64_t>::max();
+    json = SerializePreparationStatus(status, 123, hash, 1001);
+    Check(!json.empty() && json.size() < 8192); std::cout << json;
+    Check(SerializePreparationStatus(status, 0, hash, 1).empty());
+    Check(SerializePreparationStatus(status, 1, "bad", 1).empty());
+    Check(SerializePreparationStatus(status, 1, std::string(64, 'G'), 1).empty());
+    Check(SerializePreparationStatus(status, 1, hash, 0).empty());
+    status.state = static_cast<PreparationStatusState>(100);
+    Check(SerializePreparationStatus(status, 1, hash, 1).empty());
+    status.state = PreparationStatusState::Failed; status.mode = static_cast<PreparationMode>(100);
+    Check(SerializePreparationStatus(status, 1, hash, 1).empty());
+    // Before opt-in initialization, updates cannot start a worker or write files.
+    UpdatePreparationStatus(status, ReservePreparationStatusTicket());
+    PreparationStatusFence fence;
+    const auto oldReady = fence.Reserve(); Check(fence.Accepts(oldReady));
+    fence.Invalidate(); Check(!fence.Accepts(oldReady));
+    // A dropped/contended Update does not erase the atomic invalidation floor;
+    // a delayed pre-invalidation Ready remains rejected without another update.
+    Check(!fence.Accepts(oldReady));
+    const auto fresh = fence.Reserve(); Check(fence.Accepts(fresh));
+    fence.Invalidate(); Check(!fence.Accepts(fresh) && !fence.Accepts(oldReady));
+    const auto afterReload = fence.Reserve(); Check(afterReload > fresh && fence.Accepts(afterReload));
+    Check(!fence.Accepts(0) && !fence.Accepts(afterReload + 1));
+    std::mutex simulatedSnapshotMutex;
+    std::unique_lock<std::mutex> occupied(simulatedSnapshotMutex);
+    std::promise<uint64_t> reserved; auto waiting = reserved.get_future();
+    std::atomic<bool> accepted{true};
+    std::thread delayed([&] {
+        const auto ticket = fence.Reserve(); reserved.set_value(ticket);
+        std::lock_guard<std::mutex> held(simulatedSnapshotMutex);
+        accepted.store(fence.Accepts(ticket));
+    });
+    Check(waiting.wait_for(std::chrono::seconds(2)) == std::future_status::ready);
+    const auto inFlightReady = waiting.get();
+    fence.Invalidate(); // Must work while the snapshot mutex is occupied.
+    Check(!fence.Accepts(inFlightReady));
+    occupied.unlock(); delayed.join(); Check(!accepted.load());
+}
