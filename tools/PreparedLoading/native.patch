+namespace {
+ConfigPublishResult MigrateConfiguration(const ConfigGenerationPin& candidate,
+    const ConfigGenerationPin& expected, size_t maxVariableCopies, bool reset) {
+    if (candidate->initializerCommandCount > maxVariableCopies ||
+        candidate->persistentVariables.size() > maxVariableCopies - candidate->initializerCommandCount)
+        return ConfigPublishResult::MigrationBudget;
+    if (!reset) {
+        // The compiler's initializer has already established defaults and reset
+        // nonpersistent variables, static locals, resources, pools and presets.
+        // Use latest persistent values, with the NEW declaration's flags.
+        for (auto* variable : candidate->persistentVariables) {
+            const auto found = expected->variables.find(variable->name);
+            if (found != expected->variables.end() &&
+                (found->second.flags & VariableFlags::PERSIST))
+                variable->fval = found->second.fval;
+        }
+    }
+    if (candidate->replayInitializers) {
+        ConfigBuildScope initialize(candidate);
+        if (!candidate->replayInitializers(*candidate)) return ConfigPublishResult::Invalid;
+    }
+    return ConfigPublishResult::Published;
+}
+}
+ConfigPublishResult TryPublishConfiguration(const ConfigGenerationPin& candidate,
+    const ConfigGenerationPin& expected, size_t maxVariableCopies, bool reset) {
+    if (!candidate || candidate == expected || candidate->compileFailed) return ConfigPublishResult::Invalid;
+    return ConfigurationRegistryInstance().TryPublish(candidate, expected, [&] {
+        return MigrateConfiguration(candidate, expected, maxVariableCopies, reset);
+    });
+}
+ConfigPublishResult StageConfigurationRuntime(const ConfigGenerationPin& candidate,
+    const ConfigGenerationPin& expected, size_t workBudget, uint64_t& revision) {
+    if (!candidate || candidate == expected || candidate->compileFailed) return ConfigPublishResult::Invalid;
+    return ConfigurationRegistryInstance().TryStage(expected, [&] {
+        return MigrateConfiguration(candidate, expected, workBudget, false);
+    }, revision);
+}
+ConfigPublishResult PublishStagedConfiguration(const ConfigGenerationPin& candidate,
+    const ConfigGenerationPin& expected, uint64_t revision) {
+    return ConfigurationRegistryInstance().TryPublishStaged(candidate, expected, revision);
+}
