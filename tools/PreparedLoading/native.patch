@@ -0,0 +1,309 @@
+// Standalone Windows regression host. WARP is this fixture's real rendering
+// device, never a device used to prepare resources for another game device.
+#include "PreparationPlanner.h"
+#include "SnapshotIO.h"
+#include <d3dcompiler.h>
+#include <objbase.h>
+#include <wrl/client.h>
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <thread>
+using namespace ModLoading;
+using Microsoft::WRL::ComPtr;
+namespace {
+struct Apartment {
+    Apartment() { assert(SUCCEEDED(CoInitializeEx(nullptr, COINIT_MULTITHREADED))); }
+    ~Apartment() { CoUninitialize(); }
+};
+SourceSnapshot Snapshot(const std::vector<uint8_t>& bytes) {
+    SourceSnapshot snapshot;
+    snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(bytes);
+    snapshot.digest = HashBytes(bytes.data(), bytes.size());
+    return snapshot;
+}
+ComPtr<ID3D11Device> Device(UINT flags, ComPtr<ID3D11DeviceContext>& context) {
+    ComPtr<ID3D11Device> device;
+    const HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, flags,
+        nullptr, 0, D3D11_SDK_VERSION, device.GetAddressOf(), nullptr, context.GetAddressOf());
+    assert(SUCCEEDED(hr)); return device;
+}
+SharedShaderBytecode CompileStage(const char* source, const char* profile) {
+    ComPtr<ID3DBlob> bytecode, errors;
+    const HRESULT hr = D3DCompile(source, std::strlen(source), nullptr, nullptr, nullptr,
+        "main", profile, 0, 0, bytecode.GetAddressOf(), errors.GetAddressOf());
+    if (FAILED(hr) && errors)
+        std::cerr << profile << ": " << static_cast<const char*>(errors->GetBufferPointer()) << std::endl;
+    assert(SUCCEEDED(hr));
+    const auto* bytes = static_cast<const uint8_t*>(bytecode->GetBufferPointer());
+    auto retained = SharedShaderBytecode::Retain(bytecode.Get(), HashBytes(bytes, bytecode->GetBufferSize()));
+    assert(retained); return retained;
+}
+void Created(PreparationPlanner& planner) {
