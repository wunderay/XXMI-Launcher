+ ComPtr<IWICImagingFactory> factory;ComPtr<IWICStream> stream;ComPtr<IWICBitmapDecoder> decoder;ComPtr<IWICBitmapFrameDecode> frame;
+ HRESULT hr=CoCreateInstance(CLSID_WICImagingFactory,nullptr,CLSCTX_INPROC_SERVER,IID_PPV_ARGS(factory.GetAddressOf()));
+ if(FAILED(hr)||FAILED(factory->CreateStream(stream.GetAddressOf()))||FAILED(stream->InitializeFromMemory(const_cast<BYTE*>(source.bytes->data()),DWORD(source.bytes->size())))||FAILED(factory->CreateDecoderFromStream(stream.Get(),nullptr,WICDecodeMetadataCacheOnDemand,decoder.GetAddressOf()))||FAILED(decoder->GetFrame(0,frame.GetAddressOf()))){error="WIC unavailable or unsupported";return false;}
+ UINT width=0,height=0;WICPixelFormatGUID native{};
+ if(FAILED(frame->GetSize(&width,&height))||FAILED(frame->GetPixelFormat(&native))||!width||!height||width>16384||height>16384){error="unsupported WIC dimensions";return false;}
+ uint32_t format=0;GUID target=native;
+ if(IsEqualGUID(native,GUID_WICPixelFormat32bppRGBA))format=28;
+ else if(IsEqualGUID(native,GUID_WICPixelFormat32bppBGRA))format=87;
+ else if(IsEqualGUID(native,GUID_WICPixelFormat32bppBGR))format=88;
+ else if(IsEqualGUID(native,GUID_WICPixelFormat24bppRGB)||IsEqualGUID(native,GUID_WICPixelFormat24bppBGR)){format=28;target=GUID_WICPixelFormat32bppRGBA;}
+ else {error="WIC layout requires compatibility decode";return false;}
+ const uint64_t pitch=uint64_t(width)*4,total=pitch*height;
+ if(total>maxDecodedBytes||total>MAXDWORD){error="decoded image exceeds reservation";return false;}
+ try {
+ auto image=std::make_shared<DecodedImage>();image->width=width;image->height=height;image->rowPitch=uint32_t(pitch);image->format=format;
+ ComPtr<IWICMetadataQueryReader> metadata;
+ if(SUCCEEDED(frame->GetMetadataQueryReader(metadata.GetAddressOf()))){GUID container{};PROPVARIANT value;PropVariantInit(&value);
+  if(SUCCEEDED(metadata->GetContainerFormat(&container))&&IsEqualGUID(container,GUID_ContainerFormatPng)){if(SUCCEEDED(metadata->GetMetadataByName(L"/sRGB/RenderingIntent",&value))&&value.vt==VT_UI1)image->metadataSRGB=true;}
+  else if(SUCCEEDED(metadata->GetMetadataByName(L"System.Image.ColorSpace",&value))&&value.vt==VT_UI2&&value.uiVal==1)image->metadataSRGB=true;
+  PropVariantClear(&value);
+ }
+ auto pixels=std::make_shared<std::vector<uint8_t>>(size_t(total));
+ if(IsEqualGUID(native,target))hr=frame->CopyPixels(nullptr,UINT(pitch),UINT(total),pixels->data());
+ else {ComPtr<IWICFormatConverter> converter;hr=factory->CreateFormatConverter(converter.GetAddressOf());if(SUCCEEDED(hr))hr=converter->Initialize(frame.Get(),target,WICBitmapDitherTypeErrorDiffusion,nullptr,0,WICBitmapPaletteTypeMedianCut);if(SUCCEEDED(hr))hr=converter->CopyPixels(nullptr,UINT(pitch),UINT(total),pixels->data());}
+ if(FAILED(hr)){error="WIC pixel decode failed";return false;}
+ image->pixels=pixels;result=std::move(image);error.clear();return true;
+ }catch(const std::bad_alloc&){error="decoded image allocation failed";return false;}
+}
+}
+#else
+namespace ModLoading {
+bool DecodeSnapshot(const SourceSnapshot&,size_t,std::shared_ptr<const DecodedImage>&,std::string& error){error="WIC requires Windows";return false;}
+}
+#endif
