+namespace {
+using ConfigurationRegistry = QuiescentGenerationRegistry<ConfigurationState>;
+ConfigurationRegistry& ConfigurationRegistryInstance()
+{
+    // Process lifetime avoids COM releases from a static destructor under the
+    // loader lock. Individual replaced generations are released by retirement.
+    static auto* registry = new ConfigurationRegistry(std::make_shared<ConfigurationState>());
+    return *registry;
+}
