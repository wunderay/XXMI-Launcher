+// retirement or physical residency.
+const GUID AllocationEstimateGuid = {0x62fba180, 0x25f4, 0x4cb1, {0x8c, 0xad, 0x35, 0x8e, 0x9d, 0x5c, 0xf0, 0x6a}};
+class AllocationEstimateAttachment final : public IUnknown {
+public:
+    explicit AllocationEstimateAttachment(std::shared_ptr<const LiveGpuAllocationLedger::Lease> lease)
+        : lease_(std::move(lease)) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** output) override {
+        if (!output) return E_POINTER;
