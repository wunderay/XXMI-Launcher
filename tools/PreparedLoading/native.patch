diff --git a/DirectX11/ModLoading/TraceControl.cpp b/DirectX11/ModLoading/TraceControl.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3374705ec1130214803daecc45fb189a467a1547
--- /dev/null
+++ b/DirectX11/ModLoading/TraceControl.cpp
@@ -0,0 +1,91 @@
+#include "TraceControl.h"
+#include "LoadTrace.h"
+#include <Windows.h>
+#include <cstdio>
+#include <memory>
+#include <sstream>
+#include <string>
+
+namespace ModLoading {
+namespace {
+std::atomic<bool> exporting(false);
+
+DWORD WINAPI ExportWorker(void* parameter)
+{
+    HMODULE module = static_cast<HMODULE>(parameter);
+    // Everything allocating or touching files runs here, outside renderer locks.
+    try {
+        wchar_t path[32768];
+        const DWORD length = GetModuleFileNameW(module, path, 32768);
+        if (length && length < 32768) {
+            std::wstring filename(path, length);
+            const auto slash = filename.find_last_of(L"\\/");
+            if (slash != std::wstring::npos) {
+                filename.resize(slash + 1);
+                filename += L"mod-load-trace-" + std::to_wstring(GetCurrentProcessId())
+                    + L"-" + std::to_wstring(GetTickCount64()) + L".csv";
+                std::unique_ptr<FILE, decltype(&fclose)> file(
+                    _wfopen(filename.c_str(), L"wb"), &fclose);
+                if (file) {
+                    std::ostringstream csv;
+                    LoadTrace::Get().ExportCsv(csv);
+                    const std::string contents = csv.str();
+                    // Preserve partial CSV diagnostics even when the recorder
+                    // explicitly marks an export incomplete through failbit.
+                    const bool written = fwrite(contents.data(), 1, contents.size(), file.get()) == contents.size();
+                    const bool complete = csv.good() && written;
+                    const bool closed = fclose(file.release()) == 0;
+                    if (!complete || !closed)
+                        OutputDebugStringW(L"XXMI mod-load trace export failed; consumed records cannot be retried.\n");
+                } else {
+                    OutputDebugStringW(L"XXMI mod-load trace output cannot be opened; records retained.\n");
+                }
+            } else {
+                OutputDebugStringW(L"XXMI mod-load trace DLL directory cannot be resolved; records retained.\n");
+            }
+        } else {
+            OutputDebugStringW(L"XXMI mod-load trace DLL path cannot be resolved; records retained.\n");
+        }
+    } catch (...) {
+        OutputDebugStringW(L"XXMI mod-load trace export failed.\n");
+    }
+    exporting.store(false, std::memory_order_release);
+    // Release the worker's module reference and exit atomically. No background
+    // thread destructor or join is run under the loader lock at process detach.
+    FreeLibraryAndExitThread(module, 0);
+    return 0;
+}
+}
+
+bool ConfigureLoadTrace(bool enabled) noexcept
+{
+    auto& trace = LoadTrace::Get();
+    if (enabled) {
+        if (exporting.load(std::memory_order_acquire))
+            return false;
+        trace.SetEnabled(true);
+        return true;
+    }
+    const bool wasEnabled = trace.IsEnabled();
+    trace.SetEnabled(false);
+    if (!wasEnabled)
+        return true;
+    bool expected = false;
+    if (!exporting.compare_exchange_strong(expected, true))
+        return false;
+    HMODULE module = NULL;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+            reinterpret_cast<LPCWSTR>(&ExportWorker), &module)) {
+        exporting.store(false, std::memory_order_release);
+        return false;
+    }
+    HANDLE worker = CreateThread(NULL, 0, ExportWorker, module, 0, NULL);
+    if (!worker) {
+        FreeLibrary(module);
+        exporting.store(false, std::memory_order_release);
+        return false;
+    }
+    CloseHandle(worker);
+    return true;
+}
+}
