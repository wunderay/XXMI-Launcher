+	uint64_t id = 0, legacyConfigEpoch = 0;
+};
+// One active task and one latest queued task, process-lifetime module pinned.
+// Tasks own immutable bytes/metadata only; they never dereference resource maps.
+class RefreshBuildWorker {
+public:
+	RefreshBuildWorker() : worker_([this] { Run(); }) {}
+	void Submit(std::shared_ptr<RefreshBuildTask> task) {
+		{ std::lock_guard<std::mutex> lock(mutex_); pending_ = std::move(task); }
+		wake_.notify_one();
+	}
+private:
+	void Run() {
+		for (;;) {
+			std::shared_ptr<RefreshBuildTask> task;
+			{ std::unique_lock<std::mutex> lock(mutex_);
+			  wake_.wait(lock, [this] { return bool(pending_); }); task.swap(pending_); }
+			try {
+			auto state = task->state.lock();
+			if (!state || !state->enabled.load() || !state->monitor->IsCurrent(task->versions.source)) continue;
+			auto result = std::make_shared<RefreshBuildResult>();
+			result->id = task->id; result->legacyConfigEpoch = task->legacyConfigEpoch;
+			result->schedulerGeneration = task->schedulerGeneration;
+			try {
+				result->patch = ReadResourceFilenamePatch(task->baseline, task->bindings,
+					task->versions, task->closure, task->budget, task->metadataOwnership);
+				result->patch.versions = task->versions;
+				if (result->patch.valid && (!state->monitor->IsCurrent(task->versions.source) ||
+					!state->monitor->TrackDependencyFile(result->patch.replacementPath))) {
+					result->patch.valid = false; result->patch.reason = "replacement source watch could not be verified";
+				}
+				if (result->patch.valid)
+					state->scheduler->Enqueue(result->patch.replacementPath, task->schedulerGeneration, 10);
+			} catch (...) { result->patch.valid = false; result->patch.reason = "bounded refresh preparation failed"; }
+			if (!state->enabled.load() || !state->monitor->IsCurrent(task->versions.source)) continue;
+			std::shared_ptr<RefreshBuildResult> previous;
+			{ std::lock_guard<std::mutex> lock(state->refreshMutex);
+			  previous.swap(state->refreshResult); state->refreshResult = std::move(result); }
+			previous.reset();
+			} catch (...) { /* Bounded admission failure leaves the active generation unchanged. */ }
+		}
+	}
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	std::shared_ptr<RefreshBuildTask> pending_;
+	std::thread worker_;
+};
+struct PendingRefresh {
+	std::shared_ptr<RefreshBuildResult> build;
