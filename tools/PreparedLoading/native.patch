--- /dev/null
+++ b/DirectX11/ModLoading/PreparationStatus.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <string>
+#include <atomic>
+
+namespace ModLoading {
+enum class PreparationStatusState { Off, Preparing, Ready, Compatibility, Failed };
+struct PreparationStatus {
+    PreparationMode mode = PreparationMode::Off;
+    PreparationStatusState state = PreparationStatusState::Off;
+    uint64_t totalAssets = 0, cpuReady = 0, gpuReady = 0, compatibilityAssets = 0;
+    std::string reason;
+};
+// Opt-in loading boundary only, never DllMain. Pins the containing module and
+// starts one process-lifetime writer. Hashing and file I/O run on that worker.
+bool InitializePreparationStatus(const void* moduleAddress) noexcept;
+// Pure lock-free version fence, also used by portable ordering tests. Tickets
+// must be reserved before any source/currentness/count/readiness computation.
+class PreparationStatusFence {
+public:
+    uint64_t Reserve() noexcept { return sequence_.fetch_add(1, std::memory_order_acq_rel) + 1; }
+    void Invalidate() noexcept {
+        const uint64_t next = Reserve();
+        uint64_t floor = floor_.load(std::memory_order_relaxed);
+        while (floor < next && !floor_.compare_exchange_weak(floor, next,
+            std::memory_order_release, std::memory_order_relaxed)) {}
+    }
+    bool Accepts(uint64_t ticket) const noexcept {
+        return ticket && ticket >= floor_.load(std::memory_order_acquire) &&
+            ticket <= sequence_.load(std::memory_order_acquire);
+    }
+private:
+    std::atomic<uint64_t> sequence_{0}, floor_{0};
+};
+// Global process-lifetime fence, never reset across configuration reloads.
+uint64_t ReservePreparationStatusTicket() noexcept;
+void InvalidatePreparationStatus() noexcept;
+// Latest immutable snapshot only: bounded copy, nonblocking try_lock, no I/O.
+// A contended update may be dropped; Runtime must provide authoritative state.
+void UpdatePreparationStatus(const PreparationStatus& status, uint64_t ticket) noexcept;
+// Portable protocol serializer. Invalid enum/hash input returns empty; reason
+// is bounded to 256 bytes and non-ASCII bytes are replaced with '?'. No paths.
+std::string SerializePreparationStatus(const PreparationStatus& status, uint32_t processId,
+    const std::string& dllSha256, uint64_t updatedUnixMs) noexcept;
+// Actual Windows fixture injection: directory must be an owned temporary path.
+// Same singleton/hash/pinning/writer behavior as production; never call in game.
+bool InitializePreparationStatusForTesting(const void* moduleAddress,
+    const std::wstring& outputDirectory) noexcept;
+}
