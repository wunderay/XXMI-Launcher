@@ -0,0 +1,14 @@
+#include "AssetCatalog.h"
+#include <set>
+namespace ModLoading {
+uint64_t AssetCatalog::Register(const std::wstring& path,Generation generation,const std::vector<uint64_t>& dependencies){
+ if(path.empty()||path.size()>32767||dependencies.size()>64)return 0;
+ std::lock_guard<std::mutex> lock(mutex_);
+ std::set<uint64_t> known;for(const auto& r:records_)known.insert(r.second.id);
+ for(uint64_t d:dependencies)if(!known.count(d))return 0;
+ auto it=records_.find(path);if(it==records_.end()){if(records_.size()>=maximum_)return 0;AssetRecord r;r.id=++next_;r.path=path;r.generation=generation;r.dependencies=dependencies;return records_.emplace(path,std::move(r)).first->second.id;}
+ it->second.generation=generation;it->second.dependencies=dependencies;return it->second.id;
+}
+std::vector<AssetRecord> AssetCatalog::Records()const{std::lock_guard<std::mutex> lock(mutex_);std::vector<AssetRecord> r;r.reserve(records_.size());for(const auto& p:records_)r.push_back(p.second);return r;}
+void AssetCatalog::Clear(){std::lock_guard<std::mutex> lock(mutex_);records_.clear();}
+}
