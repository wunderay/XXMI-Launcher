+#include "ChangeReconciler.h"
+#include "ChangeMonitor.h"
+#include <cassert>
+#include <atomic>
+#include <chrono>
+#include <thread>
+using namespace ModLoading;
+int main() {
+    ChangeOptions options; options.debounceMs = 10; options.maximumDelayMs = 30;
+    options.periodicReconcileMs = 100; options.maxRoots = 2; options.maxQueuedEvents = 3;
+    assert(!options.automaticActivation);
+    ChangeReconciler state(options); ReconcileRequest request;
+    assert(state.SetRoots({L"C:/Mods", L"C:/Shared"}, {L"C:/Mods/cache", L"C:/Mods/logs"}, 0));
+    assert(!state.TakeReady(9, request)); assert(state.TakeReady(10, request));
+    assert(request.fullReconcile && state.IsCurrent(request.token));
+    const auto first = request.token;
+    state.Notify(ChangeKind::Modified, L"C:/Mods/cache/foo.dds", 11);
+    state.Notify(ChangeKind::Modified, L"C:/Mods/logs/session.log", 11);
+    state.Notify(ChangeKind::Modified, L"C:/ModsOther/foo.dds", 11);
+    assert(state.IsCurrent(first));
+    state.Notify(ChangeKind::Modified, L"C:/Shared/foo.dds", 12);
+    assert(!state.IsCurrent(first)); assert(!state.RecordVerifiedDigest(first, "old", true));
+    state.Notify(ChangeKind::Created, L"C:/Mods/copy.dds", 16);
+    state.Notify(ChangeKind::RenamedOld, L"C:/Mods/copy.dds", 18);
+    state.Notify(ChangeKind::RenamedNew, L"C:/Mods/live.dds", 20);
+    state.Notify(ChangeKind::Deleted, L"C:/Mods/old.dds", 21);
+    assert(!state.TakeReady(30, request)); assert(state.TakeReady(31, request));
+    assert(request.fullReconcile); assert(!state.RecordVerifiedDigest(request.token, "partial", false));
+    assert(state.RecordVerifiedDigest(request.token, "bytes-A", true));
+    // A content digest can change without any metadata change; periodic scan
+    // schedules a fresh verified-byte read even if OS notification was lost.
+    assert(!state.TakeReady(131, request)); assert(state.TakeReady(141, request));
+    assert(request.fullReconcile && request.iniChanged);
+    assert(state.RecordVerifiedDigest(request.token, "bytes-B-same-size-and-time", true));
+    state.Notify(ChangeKind::Modified, L"C:/Mods/config.INI", 142);
+    assert(state.TakeReady(152, request) && request.iniChanged);
+    state.Notify(ChangeKind::Modified, L"C:/Mods/asset.dds", 153);
+    assert(state.TakeReady(163, request) && request.iniChanged); // Cancelled INI intent persists.
+    const auto beforeRoot = request.token;
+    state.Notify(ChangeKind::RootReplaced, L"C:/Mods", 164);
+    assert(!state.IsCurrent(beforeRoot)); assert(state.TakeReady(174, request) && request.fullReconcile);
+    state.Notify(ChangeKind::Overflow, L"", 175);
+    assert(state.TakeReady(185, request) && request.fullReconcile && request.iniChanged);
+    state.Notify(ChangeKind::Unsupported, L"", 186);
+    assert(state.TakeReady(196, request));
+    state.Cancel(); assert(!state.IsCurrent(request.token)); assert(!state.TakeReady(300, request));
+    assert(!state.SetRoots({L"a", L"b", L"c"}, {}, 300));
+    assert(state.SetRoots({L"C:/New"}, {}, 300));
+    for (uint64_t now = 301; now <= 335; ++now) {
+        state.Notify(ChangeKind::Modified, L"C:/New/rapid.dds", now);
+        if (now == 330) assert(state.TakeReady(now, request));
+    }
+    state.Cancel();
+    ChangeOptions filteredOptions;
+    filteredOptions.debounceMs = 0; filteredOptions.filterDependencies = true;
+    filteredOptions.dependencyFiles = {L"C:/Mods/Textures/live.DDS"};
+    filteredOptions.excludedSourceFiles = {L"C:/Mods/runtime-output.ini"};
+    ChangeReconciler filtered(filteredOptions);
+    assert(filtered.SetRoots({L"C:/Mods"}, {L"C:/Mods/cache"}, 0));
+    assert(filtered.TakeReady(0, request) && !request.iniChanged);
+    auto filteredToken = request.token;
+    filtered.Notify(ChangeKind::Modified, L"C:/Mods/d3d11_log.txt", 1);
+    filtered.Notify(ChangeKind::Created, L"C:/Mods/untracked.dds", 1);
+    filtered.Notify(ChangeKind::Modified, L"C:/Mods/runtime-output.ini", 1);
+    filtered.Notify(ChangeKind::Modified, L"C:/Mods/cache/artifact.ini", 1);
+    filtered.Notify(ChangeKind::RenamedOld, L"C:/Mods/Textures/live.tmp", 1);
+    assert(filtered.IsCurrent(filteredToken) && !filtered.TakeReady(1, request));
+    filtered.Notify(ChangeKind::Modified, L"c:\\mods\\textures\\LIVE.dds", 2);
+    assert(!filtered.IsCurrent(filteredToken));
+    assert(filtered.TakeReady(2, request) && !request.iniChanged);
+    filteredToken = request.token;
+    filtered.Notify(ChangeKind::RenamedNew, L"C:/Mods/Textures/live.dds", 3);
+    assert(!filtered.IsCurrent(filteredToken)); assert(filtered.TakeReady(3, request));
+    filteredToken = request.token;
+    filtered.Notify(ChangeKind::RenamedOld, L"C:/Mods/Textures", 4);
+    assert(!filtered.IsCurrent(filteredToken)); assert(filtered.TakeReady(4, request));
+    filtered.Notify(ChangeKind::Created, L"C:/Mods/new-config.ini", 5);
+    assert(filtered.TakeReady(5, request) && request.iniChanged);
+    assert(filtered.SetRoots({L"C:/Mods"}, {}, 6)); assert(filtered.TakeReady(6, request) && !request.iniChanged);
+    filtered.Notify(ChangeKind::Overflow, L"", 7);
+    assert(filtered.TakeReady(7, request) && request.iniChanged && request.fullReconcile);
+    assert(filtered.SetRoots({L"C:/Mods"}, {}, 8)); assert(filtered.TakeReady(8, request));
+    filtered.Notify(ChangeKind::RootReplaced, L"C:/Mods", 9);
+    assert(filtered.TakeReady(9, request) && request.iniChanged && request.fullReconcile);
+    ChangeMonitor monitor(options); std::atomic<unsigned> callbacks{0};
+    assert(monitor.Start({L"C:/Mods"}, {}, [&](const ReconcileRequest&) { ++callbacks; }));
+    std::this_thread::sleep_for(std::chrono::milliseconds(60));
+    monitor.Stop(); const auto stopped = callbacks.load();
+    assert(stopped > 0); monitor.Inject(ChangeKind::Modified, L"C:/Mods/foo.dds");
+    assert(callbacks.load() == stopped);
+}
