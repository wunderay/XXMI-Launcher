+				full=std::wstring_convert<std::codecvt_utf8<wchar_t>>().from_bytes(cwd)+L"/"+path;
+			}
+			std::vector<std::wstring> parts;
+			size_t start=0;
+			while(start<full.size()){
+				size_t end=full.find(L'/',start);
