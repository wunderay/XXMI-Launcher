+ConfigurationState::~ConfigurationState() = default;
+
+ConfigGenerationPin PinConfiguration()
+{
+    if (configurationBuilder) return configurationBuilder;
+    if (configurationReader) return configurationReader;
+    auto& registry = ConfigurationRegistryInstance();
+    return registry.Snapshot();
+}
+ConfigurationState& ConfigState()
+{
+    if (configurationBuilder) return *configurationBuilder;
+    if (configurationReader) return *configurationReader;
+    configurationStartupPin = PinConfiguration();
