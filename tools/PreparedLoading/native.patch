+struct RefreshBuildTask {
+	std::weak_ptr<RuntimeState> state;
+	ConfigSourceManifest baseline;
+	std::vector<ResourceFilenameBinding> bindings;
+	ResourceRefreshClosure closure;
+	std::shared_ptr<ResourceRefreshCpuBudget> budget;
+	std::shared_ptr<const void> metadataOwnership;
