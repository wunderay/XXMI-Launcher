+	std::wstring ShaderDiskCache::EntryName(const SourceDigest& digest){
+		std::wstring name;
+		const wchar_t* hex=L"0123456789abcdef";
+		for(uint8_t b:digest){
+			name+=hex[b>>4];
+			name+=hex[b&15];
+		}
+		return name+L".xxsc";
+	}
+	bool ShaderDiskCache::Directory(){
+		if(directory_.empty()||directory_.size()>30000||!budget_||!maximum_||maximum_>4096)return false;
+#ifdef _WIN32
+		std::vector<wchar_t> buffer(32768);
+		DWORD n=GetFullPathNameW(directory_.c_str(),DWORD(buffer.size()),buffer.data(),nullptr);
+		if(!n||n>=buffer.size())return false;
+		std::wstring full(buffer.data(),n);
+		if(full.size()<3||full[1]!=L':'||full.find(L':',2)!=std::wstring::npos)return false;
+		for(size_t i=3;i<=full.size();++i){
+			if(i!=full.size()&&full[i]!=L'\\'&&full[i]!=L'/')continue;
+			auto part=full.substr(0,i);
+			DWORD a=GetFileAttributesW(part.c_str());
+			if(a==INVALID_FILE_ATTRIBUTES){
+				if(!CreateDirectoryW(part.c_str(),nullptr)&&GetLastError()!=ERROR_ALREADY_EXISTS)return false;
+				a=GetFileAttributesW(part.c_str());
+			}
+			if(a==INVALID_FILE_ATTRIBUTES||!(a&FILE_ATTRIBUTE_DIRECTORY)||(a&FILE_ATTRIBUTE_REPARSE_POINT))return false;
+		}
+		directory_=std::move(full);
+#else
+		std::string full=Native(directory_);
+		if(full.empty())return false;
+		if(full[0]!='/'){
+			char current[32768];
+			if(!getcwd(current,sizeof(current)))return false;
+			full=std::string(current)+"/"+full;
+		}
+		for(size_t i=1;i<=full.size();++i){
+			if(i!=full.size()&&full[i]!='/')continue;
+			auto part=full.substr(0,i);
+			struct stat s{};
+			if(lstat(part.c_str(),&s)){
+				if(mkdir(part.c_str(),0700)&&errno!=EEXIST)return false;
+				if(lstat(part.c_str(),&s))return false;
+			}
+			if(!S_ISDIR(s.st_mode)||S_ISLNK(s.st_mode))return false;
+		}
+		directory_=std::wstring_convert<std::codecvt_utf8<wchar_t>>().from_bytes(full);
+#endif
+		return true;
+	}
+	bool ShaderDiskCache::MakeRoom(uint64_t bytes){
+		if(bytes>budget_)return false;
+		std::vector<Entry> entries;
+		uint64_t total=0;
+		size_t visited=0;
+#ifdef _WIN32
+		WIN32_FIND_DATAW data{};
+		HANDLE search=FindFirstFileW((directory_+Separator+L"*").c_str(),&data);
+		if(search==INVALID_HANDLE_VALUE)return false;
+		bool valid=true;
+		do {
+			if(++visited>maximum_+3){
+				valid=false;
+				break;
+			}
+			std::wstring name=data.cFileName;
+			if(name==L"."||name==L".."||name==L".lock")continue;
+			bool temporary=false;
+			if(!OwnedName(name,temporary)||(data.dwFileAttributes&(FILE_ATTRIBUTE_DIRECTORY|FILE_ATTRIBUTE_REPARSE_POINT))){
+				valid=false;
+				break;
+			}
+			uint64_t size=(uint64_t(data.nFileSizeHigh)<<32)|data.nFileSizeLow;
+			uint64_t touched=(uint64_t(data.ftLastWriteTime.dwHighDateTime)<<32)|data.ftLastWriteTime.dwLowDateTime;
+			entries.push_back(Entry{
+				name,size,touched,temporary
+			}
+			);
+		}
+		while(FindNextFileW(search,&data));
+		FindClose(search);
+		if(!valid)return false;
+#else
+		DIR* dir=opendir(Native(directory_).c_str());
+		if(!dir)return false;
+		bool valid=true;
+		while(auto* item=readdir(dir)){
+			if(++visited>maximum_+3){
+				valid=false;
+				break;
+			}
+			std::string raw=item->d_name;
+			if(raw=="."||raw==".."||raw==".lock")continue;
+			std::wstring name;
+			try{
+				name=std::wstring_convert<std::codecvt_utf8<wchar_t>>().from_bytes(raw);
+			}
+			catch(...){
+				valid=false;
+				break;
+			}
+			bool temporary=false;
+			struct stat s{};
+			if(!OwnedName(name,temporary)||lstat(Native(directory_+Separator+name).c_str(),&s)||!S_ISREG(s.st_mode)||s.st_nlink!=1||s.st_size<0){
+				valid=false;
+				break;
+			}
+			entries.push_back(Entry{
+				name,uint64_t(s.st_size),uint64_t(s.st_mtim.tv_sec)*1000000000+uint64_t(s.st_mtim.tv_nsec),temporary
+			}
+			);
+		}
+		closedir(dir);
+		if(!valid)return false;
+#endif
+		for(const auto& e:entries){
+			if(e.bytes>std::numeric_limits<uint64_t>::max()-total)return false;
+			total+=e.bytes;
+		}
+		std::sort(entries.begin(),entries.end(),[](const Entry&a,const Entry&b){
+			return a.touched<b.touched;
+		}
+		);
+		size_t count=entries.size();
+		// The process-exclusive directory lock proves these temporary entries have
+		// no live writer. Reclaim interrupted publications before quota admission.
+		for(const auto& e:entries)if(e.temporary){
+			auto path=directory_+Separator+e.name;
+			File orphan;
+			if(orphan.Open(path,false)){
+				orphan.Close();
+				if(Remove(path)){
+					total-=e.bytes;
+					--count;
+				}
+			}
+		}
+		for(const auto& e:entries){
+			if(total<=budget_-bytes&&count+(bytes?1:0)<=maximum_)return true;
+			if(!e.temporary&&Remove(directory_+Separator+e.name)){
+				total-=e.bytes;
+				--count;
+			}
+		}
+		return total<=budget_-bytes&&count+(bytes?1:0)<=maximum_;
+	}
+	bool ShaderDiskCache::Load(const SourceDigest& key,size_t maximum,std::vector<uint8_t>& result){
+		std::lock_guard<std::mutex> lock(mutex_);
+		try {
+			if(!Directory())return false;
+			DirectoryLock diskLock(directory_+Separator+L".lock");
+			if(!diskLock.Valid()||!MakeRoom(0))return false;
+			auto path=directory_+Separator+EntryName(key);
+			File file;
+			if(!file.Open(path,false))return false;
+			uint64_t size=0;
+			std::array<uint8_t,HeaderSize> h{};
+			bool valid=file.Size(size)&&size>=HeaderSize&&file.Transfer(h.data(),h.size(),false);
+			auto checksum=HashBytes(h.data(),80);
+			uint64_t length=Get(h.data()+40,8);
+			valid=valid&&std::memcmp(h.data(),"XXMISC01",8)==0&&std::equal(key.begin(),key.end(),h.begin()+8)&&std::equal(checksum.begin(),checksum.end(),h.begin()+80)&&length&&length<=maximum&&length==size-HeaderSize;
+			if(!valid){
+				file.Close();
+				Remove(path);
+				return false;
+			}
+			std::vector<uint8_t> bytes(static_cast<size_t>(length));
+			if(!file.Transfer(bytes.data(),bytes.size(),false)){
+				file.Close();
+				Remove(path);
+				return false;
+			}
+			auto digest=HashBytes(bytes.data(),bytes.size());
+			if(!std::equal(digest.begin(),digest.end(),h.begin()+48)){
+				file.Close();
+				Remove(path);
+				return false;
+			}
+			file.Close();
+			Touch(path);
+			result=std::move(bytes);
+			return true;
+		}
+		catch(...){
+			return false;
+		}
+	}
+	bool ShaderDiskCache::Store(const SourceDigest& key,const std::vector<uint8_t>& bytes){
+		if(bytes.empty())return false;
+		std::lock_guard<std::mutex> lock(mutex_);
+		try {
+			if(!Directory())return false;
+			DirectoryLock diskLock(directory_+Separator+L".lock");
+			if(!diskLock.Valid()||bytes.size()>std::numeric_limits<uint64_t>::max()-HeaderSize||!MakeRoom(bytes.size()+HeaderSize))return false;
+			std::array<uint8_t,HeaderSize> h{};
+			std::memcpy(h.data(),"XXMISC01",8);
+			std::copy(key.begin(),key.end(),h.begin()+8);
+			Put(h.data()+40,bytes.size(),8);
+			auto digest=HashBytes(bytes.data(),bytes.size());
+			std::copy(digest.begin(),digest.end(),h.begin()+48);
+			digest=HashBytes(h.data(),80);
+			std::copy(digest.begin(),digest.end(),h.begin()+80);
+			auto path=directory_+Separator+EntryName(key),temporary=path+L".tmp";
+			File file;
+			if(!file.Open(temporary,true))return false;
+			bool ok=file.Transfer(h.data(),h.size(),true)&&file.Transfer(const_cast<uint8_t*>(bytes.data()),bytes.size(),true)&&file.Flush();
+			file.Close();
+			if(ok)ok=Rename(temporary,path);
+			if(!ok)Remove(temporary);
+			return ok;
+		}
+		catch(...){
+			return false;
+		}
+	}
