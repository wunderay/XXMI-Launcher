+#!/usr/bin/env python3
+"""Compile and exercise the production portable working-set policy."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+ROOT = Path(__file__).resolve().parents[2]
+with tempfile.TemporaryDirectory(prefix="xxmi-working-set-") as build:
+    executable = Path(build) / "working-set-test"
+    subprocess.run([os.environ.get("CXX", "c++"), "-std=c++14", "-Wall", "-Wextra", "-Werror",
+                    "-I" + str(ROOT / "DirectX11/ModLoading"),
+                    str(ROOT / "DirectX11/ModLoading/WorkingSetPolicy.cpp"),
+                    str(Path(__file__).with_name("working_set_test.cpp")), "-o", str(executable)], check=True)
+    subprocess.run([str(executable)], check=True)
diff --git a/tests/preparation_working_set/working_set_test.cpp b/tests/preparation_working_set/working_set_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..223d119798e089e3ba0e6977004be249faa157fe
--- /dev/null
+++ b/tests/preparation_working_set/working_set_test.cpp
@@ -0,0 +1,74 @@
+#include "WorkingSetPolicy.h"
+#include <cassert>
+#include <iostream>
+using namespace ModLoading;
+int main() {
+    WorkingSetPolicy policy;
+    policy.SetGraph({{L"ResourceA", {L"ResourceShared"}, false},
+                     {L"CustomShaderB", {L"ResourceShared"}, false},
+                     {L"ResourceShared", {}, false}, {L"ResourceC", {}, false}});
+    const auto& selected = policy.SelectProfile({L"ResourceA", L"CustomShaderB"});
+    assert(selected.Complete() && selected.selected.size() == 3);
+    assert(policy.Priority(L"ResourceShared") == 200);
+    assert(policy.Priority(L"ResourceC") == 100);
+    const auto generation = selected.generation;
+    policy.Observe(L"ResourceA", 1, 1); policy.Observe(L"CustomShaderB", 1, 1);
+    policy.Observe(L"ResourceA", 2, 2); policy.Observe(L"CustomShaderB", 2, 2);
+    policy.Observe(L"ResourceA", 3, 3);
+    assert(policy.Priority(L"CustomShaderB") == 400);
+    assert(policy.Explain(L"CustomShaderB") == "repeated observed co-use");
+    policy.Observe(L"CustomShaderB", 3, 3);
+    assert(policy.Counters().predictionHits == 1);
+    assert(policy.Counters().observations == policy.Counters().predictionHits + policy.Counters().uncoveredObservations);
+    policy.Observe(L"ResourceA", 4, 4);
+    const auto issued = policy.Counters().predictionsIssued;
+    policy.SelectProfile({L"ResourceC"});
+    assert(policy.Generation() > generation && policy.Counters().predictions == 0);
+    assert(policy.Counters().predictionCancelled > 0);
+    assert(policy.Priority(L"CustomShaderB") == 100);
+    assert(policy.Counters().pairs == 0);
+    policy.SetAdaptiveLearning(false);
+    for (uint64_t i = 5; i < 10; ++i) {
+        policy.Observe(L"ResourceA", i, i); policy.Observe(L"CustomShaderB", i, i);
+    }
+    assert(policy.Counters().predictionsIssued == issued && policy.Counters().pairs == 0);
+    assert(policy.Counters().observations == policy.Counters().predictionHits +
+           policy.Counters().uncoveredObservations + policy.Counters().learningBypassedObservations);
+    policy.SetGraph({{L"a", {L"b"}, false}, {L"b", {L"a"}, false},
+                     {L"parent", {L"a"}, false}, {L"missing", {L"absent"}, false},
+                     {L"unsafe", {}, true}, {L"child", {L"unsafe"}, false}});
+    assert(!policy.Selection().Complete() && policy.Selection().compatibility.size() == 6);
+    assert(!policy.SelectProfile({L"ABSENT"}).Complete());
+    assert(policy.Selection().unknownSeeds.size() == 1);
+    assert(policy.SelectProfile({L"child"}).compatibility.size() == 2);
+
+    WorkingSetLimits limits;
+    limits.assets = 6; limits.dependenciesPerAsset = 2; limits.idCharacters = 20;
+    limits.recentAssets = 2; limits.assetsPerDraw = 3; limits.pairs = 2;
+    limits.predictions = 1; limits.predictionLifetime = 1; limits.recentLifetime = 2;
+    WorkingSetPolicy bounded(limits);
+    bounded.SetGraph({{L"a", {}, false}, {L"b", {}, false}, {L"c", {}, false},
+                      {L"d", {}, false}, {L"e", {}, false}, {L"f", {}, false}});
+    for (uint64_t draw = 1; draw <= 2; ++draw) {
+        bounded.Observe(L"a", draw, draw); bounded.Observe(L"b", draw, draw);
+    }
+    bounded.Observe(L"a", 3, 3);
+    assert(bounded.Counters().predictions == 1);
+    bounded.Observe(L"c", 4, 5);
+    assert(bounded.Counters().predictionMisses == 1);
+    bounded.Observe(L"d", 4, 5); bounded.Observe(L"e", 4, 5); bounded.Observe(L"f", 4, 5);
+    const auto count = bounded.Counters();
+    assert(count.drawAssets <= 3 && count.recentAssets <= 2 && count.pairs <= 2 && count.predictions <= 1);
+    assert(count.evictedPairs > 0 && count.droppedObservations == 1);
+    bounded.Observe(L"a", 3, 2); assert(bounded.Counters().droppedObservations == 2);
+    for (uint64_t draw = 6; draw < 10006; ++draw) {
+        bounded.Observe(L"a", draw, draw); bounded.Observe(L"b", draw, draw);
+        bounded.Observe(L"c", draw, draw);
+    }
+    assert(bounded.Counters().recentAssets <= 2 && bounded.Counters().pairs <= 2);
+    bounded.SetGraph({{L"a", {L"b", L"c", L"d"}, false}, {L"b", {}, false}, {L"c", {}, false}});
+    assert(!bounded.SelectProfile({L"a"}).Complete());
+    bounded.SetGraph({{L"a", {}, false}, {L"a", {}, false}});
+    assert(!bounded.Selection().Complete());
+    std::cout << "working_set: dependency closure, cancellation, actual co-use and bounded learning passed\n";
+}
diff --git a/tests/shader_regex_cache/README.md b/tests/shader_regex_cache/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..e1500b3eac6d242ddadf065134959dde918e4037
--- /dev/null
+++ b/tests/shader_regex_cache/README.md
@@ -0,0 +1,3 @@
+Run `bash tests/shader_regex_cache/run.sh` on a C++14 host. The test includes the production persisted header and metadata validator used by `load_shader_regex_cache`, with the configuration hash macro active as it is in `ShaderRegex.cpp`.
+
+It verifies the original 16-byte version 1 layout, valid NO_MATCH/matched/patched metadata, hash changes for all three cases, the malformed candidate format that omitted the hash (including current hashes 0/1), and invalid version/payload lengths including match-count overflow. The validator retains the original writer's invariants: `patched` stores a bool, and a patched cache has at least one match. The production loader applies this validator before returning NO_MATCH, linking groups, or loading cached patched bytecode. This portable test does not execute Windows file I/O, command lists, or D3D11.
diff --git a/tests/shader_regex_cache/main.cpp b/tests/shader_regex_cache/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..47b27e523ff5ed9cf0ac5699f0fafcceb392662d
--- /dev/null
+++ b/tests/shader_regex_cache/main.cpp
@@ -0,0 +1,94 @@
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+// ShaderRegex.h defines this before ShaderRegex.cpp includes the cache header.
+// A persisted field must not be rewritten into the configuration accessor.
+#define shader_regex_hash ConfigRegexHash()
+#include "ShaderRegexCache.h"
+
+static void require(bool condition, const char *message)
+{
+	if (!condition) {
+		std::fprintf(stderr, "%s\n", message);
+		std::exit(1);
+	}
+}
+
+template <size_t N>
+static bool valid_fixture(const uint32_t (&words)[N], uint32_t current_hash)
+{
+	ShaderRegexCacheHeader header = {};
+	std::memcpy(&header, words, sizeof(words) < sizeof(header) ? sizeof(words) : sizeof(header));
+	return valid_shader_regex_cache_header(header, sizeof(words), current_hash);
+}
+
+int main()
+{
+	const uint32_t original_hash = 0x12345678;
+	const uint32_t changed_hash = 0x87654321;
+
+	// Original version 1 disk format: version, regex hash, patched, count, ids.
+	const uint32_t no_match[] = { 1, original_hash, 0, 0 };
+	const uint32_t match[] = { 1, original_hash, 0, 1, 7 };
+	const uint32_t patch[] = { 1, original_hash, 1, 2, 7, 9 };
+	require(valid_fixture(no_match, original_hash), "Original NO_MATCH cache rejected");
+	require(valid_fixture(match, original_hash), "Original matched cache rejected");
+	require(valid_fixture(patch, original_hash), "Original patched cache rejected");
+	require(!valid_fixture(no_match, changed_hash), "Changed regex reused NO_MATCH cache");
+	require(!valid_fixture(match, changed_hash), "Changed regex reused group metadata");
+	require(!valid_fixture(patch, changed_hash), "Changed regex reused patched bytecode metadata");
+
+	// The broken candidate omitted the persisted hash without changing version.
+	const uint32_t broken_no_match[] = { 1, 0, 0 };
+	const uint32_t broken_match[] = { 1, 0, 1, 7 };
+	const uint32_t broken_patch[] = { 1, 1, 2, 7, 9 };
+	require(!valid_fixture(broken_no_match, original_hash), "12-byte candidate header accepted");
+	require(!valid_fixture(broken_match, original_hash), "Candidate matched metadata accepted");
+	require(!valid_fixture(broken_patch, original_hash), "Candidate patched metadata accepted");
+
+	// A candidate's bool can alias the restored hash when the current hash is
+	// 0 or 1. The original writer's flag/count invariants disambiguate it.
+	for (uint32_t small_hash = 0; small_hash <= 1; small_hash++) {
+		const uint32_t valid_no_match[] = { 1, small_hash, 0, 0 };
+		const uint32_t valid_match[] = { 1, small_hash, 0, 1, 0 };
+		const uint32_t valid_patch[] = { 1, small_hash, 1, 1, 0 };
+		const uint32_t aliased_one_match[] = { 1, small_hash, 1, 0 };
+		const uint32_t aliased_two_matches[] = { 1, small_hash, 2, 1, 0 };
+		require(valid_fixture(valid_no_match, small_hash), "Original small-hash NO_MATCH cache rejected");
+		require(valid_fixture(valid_match, small_hash), "Original small-hash matched cache rejected");
+		require(valid_fixture(valid_patch, small_hash), "Original small-hash patched cache rejected");
+		require(!valid_fixture(aliased_one_match, small_hash), "Candidate matched cache aliases empty patched cache");
+		require(!valid_fixture(aliased_two_matches, small_hash), "Candidate match count aliases patched flag");
+	}
+
+	const uint32_t truncated[] = { 1, original_hash, 0, 1 };
+	const uint32_t trailing[] = { 1, original_hash, 0, 0, 7 };
+	const uint32_t wrong_version[] = { 2, original_hash, 0, 0 };
+	const uint32_t overflow_count[] = { 1, original_hash, 1, 0x40000000 };
+	require(!valid_fixture(truncated, original_hash), "Truncated match list accepted");
+	require(!valid_fixture(trailing, original_hash), "Trailing match data accepted");
+	require(!valid_fixture(wrong_version, original_hash), "Unknown cache version accepted");
+	require(!valid_fixture(overflow_count, original_hash), "Overflowed match count accepted");
+
+	ShaderRegexCacheHeader header = { 1, original_hash, 0, 0 };
+	require(offsetof(ShaderRegexCacheHeader, regex_hash) == 4, "Persisted hash moved");
+	require(offsetof(ShaderRegexCacheHeader, patched) == 8, "Patched flag moved");
+	require(offsetof(ShaderRegexCacheHeader, num_matches) == 12, "Match count moved");
+	require(!valid_shader_regex_cache_header(header, sizeof(header) + 1, original_hash),
+		"Partial match id accepted");
+	header.regex_hash = changed_hash;
+	require(!valid_shader_regex_cache_header(header, sizeof(header), original_hash),
+		"Persisted hash was replaced by current configuration hash");
+	require(valid_shader_regex_cache_header(header, sizeof(header), changed_hash),
+		"Current generation's cache rejected");
+	header.num_matches = std::numeric_limits<uint32_t>::max();
+	require(!valid_shader_regex_cache_header(header, sizeof(header), changed_hash),
+		"Maximum match count wrapped to an empty payload");
+
+	std::puts("ShaderRegex cache format/hash regression tests passed");
+	return 0;
+}
