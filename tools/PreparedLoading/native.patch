+++ b/tests/preparation_refresh/test_refresh_device.cpp
@@ -0,0 +1,213 @@
+// Real WARP regression for the production refresh manager/overlay primitives.
+// This qualifies owner resolution, binding and COM lifetime, not the complete
+// legacy parser, Runtime integration, or a game's rendered output.
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include "ResourceRefreshOverlay.h"
+#include "SnapshotIO.h"
+#include <d3d11.h>
+#include <wrl/client.h>
+#include <objbase.h>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <thread>
+using namespace ModLoading;
+using Microsoft::WRL::ComPtr;
+namespace {
+using Words = std::array<uint32_t, 4>;
+struct Apartment {
+    Apartment() { assert(SUCCEEDED(CoInitializeEx(nullptr, COINIT_MULTITHREADED))); }
+    ~Apartment() { CoUninitialize(); }
+};
+struct BufferOwner {
+    ComPtr<ID3D11Buffer> buffer;
+    Words words;
+};
+struct Lifetime { std::atomic<bool> destroyed{false}; };
+class LifetimeProbe final : public IUnknown {
+public:
+    explicit LifetimeProbe(std::shared_ptr<Lifetime> lifetime) : lifetime_(std::move(lifetime)) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** output) override {
+        if (!output) return E_POINTER;
+        *output = nullptr;
+        if (!IsEqualGUID(id, __uuidof(IUnknown))) return E_NOINTERFACE;
+        *output = static_cast<IUnknown*>(this); AddRef(); return S_OK;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return refs_.fetch_add(1) + 1; }
+    ULONG STDMETHODCALLTYPE Release() override {
+        const auto remaining = refs_.fetch_sub(1) - 1;
+        if (!remaining) delete this;
+        return remaining;
+    }
+private:
+    ~LifetimeProbe() { lifetime_->destroyed.store(true, std::memory_order_release); }
+    std::atomic<ULONG> refs_{1};
+    std::shared_ptr<Lifetime> lifetime_;
+};
+const GUID LifetimeGuid = {0x093c1346, 0xf988, 0x4f01, {0x9b, 0x41, 0x5b, 0xe4, 0xdb, 0xba, 0x4a, 0x28}};
+ComPtr<ID3D11Device> Device(ComPtr<ID3D11DeviceContext>& context) {
+    ComPtr<ID3D11Device> result;
+    const auto hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, 0,
+        nullptr, 0, D3D11_SDK_VERSION, result.GetAddressOf(), nullptr, context.GetAddressOf());
+    assert(SUCCEEDED(hr)); return result;
+}
+std::shared_ptr<BufferOwner> Buffer(ID3D11Device* device, const Words& words) {
+    auto result = std::make_shared<BufferOwner>(); result->words = words;
+    D3D11_BUFFER_DESC desc{}; desc.ByteWidth = sizeof(Words); desc.Usage = D3D11_USAGE_IMMUTABLE;
+    desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    D3D11_SUBRESOURCE_DATA data{}; data.pSysMem = words.data();
+    assert(SUCCEEDED(device->CreateBuffer(&desc, &data, result->buffer.GetAddressOf()))); return result;
+}
+ConfigSourceManifest Manifest(const char* text) {
+    ConfigSource source; source.snapshot.path = L"C:\\fixture\\mods\\mod.ini";
+    source.snapshot.bytes = std::make_shared<const std::vector<uint8_t>>(text, text + std::strlen(text));
+    source.snapshot.digest = HashBytes(source.snapshot.bytes->data(), source.snapshot.bytes->size());
+    source.snapshot.watchable = true; source.iniNamespace = L"mods/mod.ini";
+    ConfigSourceManifest result; result.verified = true; result.sources.push_back(std::move(source)); return result;
+}
+ResourceRefreshPin MakeRefreshGeneration(uint64_t id, BuildVersions versions, uint64_t configEpoch,
+    const void* device, const BufferOwner* original, std::shared_ptr<BufferOwner> replacement,
+    const ConfigSourceManifest& manifest) {
+    auto overlay = std::make_shared<ResourceRefreshOverlay>();
+    overlay->deviceIdentity = device; overlay->deviceEpoch = versions.device; overlay->legacyConfigEpoch = configEpoch;
+    overlay->replacements[original] = std::move(replacement);
+    auto generation = std::make_shared<ResourceRefreshGeneration>();
+    generation->id = id; generation->versions = versions; generation->legacyConfigEpoch = configEpoch;
+    generation->manifest = manifest; generation->payload = overlay; return generation;
+}
+BufferOwner* Resolve(const ResourceRefreshDrawPin& draw, const BufferOwner* original,
+    const void* device, DeviceEpoch epoch, uint64_t configEpoch) {
+    return static_cast<BufferOwner*>(ResolveResourceRefreshOverlay(draw, original, device, epoch, configEpoch));
+}
+void ReadBound(ID3D11Device* device, ID3D11DeviceContext* context, ID3D11Buffer* expectedBuffer, const Words& expected) {
+    ComPtr<ID3D11Buffer> bound; UINT stride = 0, offset = 0;
+    context->IAGetVertexBuffers(0, 1, bound.GetAddressOf(), &stride, &offset);
+    assert(bound.Get() == expectedBuffer && stride == sizeof(uint32_t) && offset == 0);
+    D3D11_BUFFER_DESC desc{}; desc.ByteWidth = sizeof(Words); desc.Usage = D3D11_USAGE_STAGING; desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Buffer> staging; assert(SUCCEEDED(device->CreateBuffer(&desc, nullptr, staging.GetAddressOf())));
+    context->CopyResource(staging.Get(), bound.Get());
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    assert(SUCCEEDED(context->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)));
+    assert(std::memcmp(mapped.pData, expected.data(), sizeof(Words)) == 0); context->Unmap(staging.Get(), 0);
+}
+void BindAndRead(ID3D11Device* device, ID3D11DeviceContext* context, BufferOwner* owner) {
+    assert(owner && owner->buffer);
+    auto* buffer = owner->buffer.Get(); const UINT stride = sizeof(uint32_t), offset = 0;
+    context->IASetVertexBuffers(0, 1, &buffer, &stride, &offset); ReadBound(device, context, buffer, owner->words);
+}
+void CompleteSubmittedWork(ID3D11Device* device, ID3D11DeviceContext* context) {
+    D3D11_QUERY_DESC desc{}; desc.Query = D3D11_QUERY_EVENT;
+    ComPtr<ID3D11Query> complete; assert(SUCCEEDED(device->CreateQuery(&desc, complete.GetAddressOf())));
+    context->End(complete.Get()); context->Flush();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    BOOL done = FALSE; HRESULT hr = S_FALSE;
+    while ((hr = context->GetData(complete.Get(), &done, sizeof(done), 0)) == S_FALSE &&
+        std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
+    assert(hr == S_OK && done);
+}
+}
+int main() {
+    Apartment apartment;
+    ComPtr<ID3D11DeviceContext> context, otherContext;
+    auto device = Device(context); auto otherDevice = Device(otherContext);
+    const DeviceEpoch epoch = 42; const uint64_t configEpoch = 7;
+    const BuildVersions versionA{1, epoch, 1}, versionB{2, epoch, 1}, versionC{3, epoch, 1};
+    const Words bytesA{{1, 2, 3, 4}}, bytesB{{91, 92, 93, 94}};
+    auto ownerA = Buffer(device.Get(), bytesA), ownerB = Buffer(device.Get(), bytesB);
+    auto original = std::make_shared<BufferOwner>(); original->buffer = ownerA->buffer; original->words = bytesA;
+    const auto manifestA = Manifest("[ResourceVB]\nfilename = a.buf\nstride = 4\n");
+    const auto manifestB = Manifest("[ResourceVB]\nfilename = b.buf\nstride = 4\n");
+    ResourceRefreshManager manager(1); ResourceRefreshActivationEdge activation;
+    ResourceRefreshDrawPin capturedNull;
+    CaptureResourceRefreshDrawPin(capturedNull, manager.Pin()); assert(capturedNull.captured && !capturedNull.generation);
+    auto generationA = MakeRefreshGeneration(1, versionA, configEpoch, device.Get(), original.get(), ownerA, manifestA);
+    using Result = ResourceRefreshPublishResult;
+    assert(manager.Publish(generationA, versionA, configEpoch, true) == Result::Activated);
+    ResourceRefreshDrawPin oldDraw; CaptureResourceRefreshDrawPin(oldDraw, manager.Pin());
+    assert(Resolve(oldDraw, original.get(), device.Get(), epoch, configEpoch) == ownerA.get());
+    BindAndRead(device.Get(), context.Get(), Resolve(oldDraw, original.get(), device.Get(), epoch, configEpoch));
+    // Policy rejection and invalid manager publication preserve the active A.
+    ResourceFilenameBinding binding; binding.sourceIndex = 0; binding.line = 2;
+    binding.sourcePath = manifestA.sources[0].snapshot.path; binding.resourceId = L"resource\\mods\\vb";
+    binding.originalValue = L"a.buf"; binding.resolvedFilename = L"C:\\fixture\\mods\\a.buf";
+    binding.preferredDirectory = L"C:\\fixture\\mods\\";
+    assert(BuildResourceFilenamePatch(manifestA, manifestB, {binding}, versionB, true).valid);
+    const auto unsupported = Manifest("[ResourceVB]\nfilename = b.buf\nstride = 16\n");
+    assert(!BuildResourceFilenamePatch(manifestA, unsupported, {binding}, versionB, true).valid);
+    assert(manager.Pin() == generationA);
+    auto invalidManifest = manifestB; invalidManifest.verified = false;
+    assert(manager.Publish(MakeRefreshGeneration(2, versionB, configEpoch, device.Get(), original.get(), ownerB, invalidManifest),
+        versionB, configEpoch, true) == Result::InvalidCandidate && manager.Pin() == generationA);
+    // A real deferred command list records the old A binding before B publishes.
+    auto lifetime = std::make_shared<Lifetime>(); auto* probe = new LifetimeProbe(lifetime);
+    assert(SUCCEEDED(ownerA->buffer->SetPrivateDataInterface(LifetimeGuid, probe))); probe->Release();
+    ID3D11Buffer* recordedA = ownerA->buffer.Get();
+    ComPtr<ID3D11DeviceContext> deferred; assert(SUCCEEDED(device->CreateDeferredContext(0, deferred.GetAddressOf())));
+    const UINT stride = sizeof(uint32_t), offset = 0;
+    deferred->IASetVertexBuffers(0, 1, &recordedA, &stride, &offset);
+    D3D11_BUFFER_DESC deferredReadDesc{}; deferredReadDesc.ByteWidth = sizeof(Words);
+    deferredReadDesc.Usage = D3D11_USAGE_STAGING; deferredReadDesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Buffer> deferredReadback;
+    assert(SUCCEEDED(device->CreateBuffer(&deferredReadDesc, nullptr, deferredReadback.GetAddressOf())));
+    // An actual recorded copy keeps A live even if the driver removes unused
+    // IA state changes from a command list that contains no draw.
+    deferred->CopyResource(deferredReadback.Get(), recordedA);
+    ComPtr<ID3D11CommandList> commands;
+    assert(SUCCEEDED(deferred->FinishCommandList(FALSE, commands.GetAddressOf()))); deferred.Reset();
+    auto generationB = MakeRefreshGeneration(2, versionB, configEpoch, device.Get(), original.get(), ownerB, manifestB);
+    activation.Request(); activation.SetReady(generationB->id);
+    assert(activation.Consume() == 0 && manager.Pin() == generationA); // no future ready edge may satisfy the earlier request
+    assert(manager.Publish(generationB, versionB, configEpoch, false) == Result::DependenciesPending && manager.Pin() == generationA);
+    assert(manager.Publish(generationB, versionC, configEpoch, true) == Result::Stale && manager.Pin() == generationA);
+    assert(manager.Publish(generationB, versionB, configEpoch + 1, true) == Result::Stale && manager.Pin() == generationA);
+    activation.Request(); assert(activation.Consume() == generationB->id);
+    assert(manager.Publish(generationB, versionB, configEpoch, true) == Result::Activated);
+    ResourceRefreshDrawPin newDraw; CaptureResourceRefreshDrawPin(newDraw, manager.Pin());
+    CaptureResourceRefreshDrawPin(oldDraw, manager.Pin()); CaptureResourceRefreshDrawPin(capturedNull, manager.Pin());
+    assert(oldDraw.generation->id == 1 && !capturedNull.generation);
+    assert(Resolve(oldDraw, original.get(), device.Get(), epoch, configEpoch) == ownerA.get());
+    assert(Resolve(capturedNull, original.get(), device.Get(), epoch, configEpoch) == original.get());
+    BindAndRead(device.Get(), context.Get(), Resolve(newDraw, original.get(), device.Get(), epoch, configEpoch));
+    assert(Resolve(newDraw, original.get(), device.Get(), epoch, configEpoch) == ownerB.get());
+    assert(Resolve(newDraw, original.get(), otherDevice.Get(), epoch, configEpoch) == original.get());
+    assert(Resolve(newDraw, original.get(), device.Get(), epoch + 1, configEpoch) == original.get());
+    assert(Resolve(newDraw, original.get(), device.Get(), epoch, configEpoch + 1) == original.get());
+    BufferOwner absent; assert(Resolve(newDraw, &absent, device.Get(), epoch, configEpoch) == &absent);
+    ResourceRefreshDrawPin uncaptured; assert(Resolve(uncaptured, original.get(), device.Get(), epoch, configEpoch) == original.get());
+    auto generationC = MakeRefreshGeneration(3, versionC, configEpoch, device.Get(), original.get(), ownerA, manifestA);
+    assert(manager.Publish(generationC, versionC, configEpoch, false) == Result::DependenciesPending && manager.Pin() == generationB);
+    assert(manager.Publish(generationC, versionC, configEpoch, true) == Result::RetirementPending && manager.Pin() == generationB);
+    generationC.reset();
+    activation.SetReady(0); activation.Request(); activation.SetReady(3);
+    assert(activation.Consume() == 0 && manager.Pin() == generationB);
+    activation.SetReady(2); activation.Request(); activation.SetReady(3);
+    assert(activation.Consume() == 2 && manager.Pin() == generationB);
+    generationA.reset();
+    assert(manager.Retire([](uint64_t) { return true; }) == 0); // the draw pin alone retains the old generation
+    CompleteSubmittedWork(device.Get(), context.Get());
+    std::weak_ptr<BufferOwner> oldOwner = ownerA;
+    ownerA.reset(); original->buffer.Reset(); generationA.reset(); oldDraw = {};
+    assert(manager.Retire([](uint64_t) { return false; }) == 0);
+    assert(manager.Retire([](uint64_t id) { return id == 1; }) == 1);
+    assert(oldOwner.expired() && !lifetime->destroyed.load(std::memory_order_acquire));
+    // All old overlay/resource owners are gone. The recorded command list
+    // alone still carries a valid A COM child and can copy its original bytes.
+    // ExecuteCommandList(FALSE) resets immediate state, so inspect the recorded
+    // readback destination rather than expecting its IA binding to survive.
+    context->ExecuteCommandList(commands.Get(), FALSE);
+    D3D11_MAPPED_SUBRESOURCE recorded{};
+    assert(SUCCEEDED(context->Map(deferredReadback.Get(), 0, D3D11_MAP_READ, 0, &recorded)));
+    assert(std::memcmp(recorded.pData, bytesA.data(), sizeof(Words)) == 0);
+    context->Unmap(deferredReadback.Get(), 0); deferredReadback.Reset();
+    commands.Reset(); context->ClearState(); context->Flush(); CompleteSubmittedWork(device.Get(), context.Get());
+    manager.Clear(); newDraw = {}; generationB.reset(); ownerB.reset(); original.reset();
+    otherContext->ClearState(); otherContext->Flush();
+    context.Reset(); otherContext.Reset(); device.Reset(); otherDevice.Reset();
+    assert(lifetime->destroyed.load(std::memory_order_acquire));
+    std::cout << "refresh device: WARP A/B binding/readback, rejected candidates, draw pins, epochs, activation edges, deferred lifetime passed\n";
+}
