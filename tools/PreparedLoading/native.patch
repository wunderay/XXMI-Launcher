+static void Probe(const std::string& label,const std::string& source,const std::string& sourceName){ID3DBlob *output=nullptr,*errors=nullptr;HRESULT hr=D3DPreprocess(source.data(),source.size(),sourceName.c_str(),nullptr,D3D_COMPILE_STANDARD_FILE_INCLUDE,&output,&errors);std::cout<<label<<" hr="<<std::hex<<hr<<std::dec<<" ";if(output){std::string text(static_cast<char*>(output->GetBufferPointer()),output->GetBufferSize());for(const char* marker:{"ROOT_MARKER","PARENT_MARKER","CWD_MARKER"})if(text.find(marker)!=std::string::npos)std::cout<<marker<<" ";std::cout<<"output=["<<text<<"] ";output->Release();}if(errors){std::cout<<"diagnostics="<<static_cast<char*>(errors->GetBufferPointer());errors->Release();}std::cout<<'\n';}
