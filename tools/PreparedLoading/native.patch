+    assert(cache.Insert(key, std::make_shared<int>(9), 10)); cache.BeginEpoch(previous);
+    assert(cache.Bytes() == 0 && cache.Size() == 0 && !cache.Find(key));
+    cache.BeginEpoch(0); assert(!cache.Insert(Key(0, 1), std::make_shared<int>(1), 1));
+}
+void TestInactiveLRU() {
+    DeviceResourceCache cache(30); const auto e = AllocateDeviceEpoch(); cache.BeginEpoch(e);
+    const auto a = Key(e, 1), b = Key(e, 2), c = Key(e, 3), d = Key(e, 4);
+    assert(cache.Insert(a, std::make_shared<int>(1), 10));
+    assert(cache.Insert(b, std::make_shared<int>(2), 10));
+    assert(cache.Insert(c, std::make_shared<int>(3), 10));
+    assert(cache.Find(a)); assert(cache.Protect(c));
+    assert(cache.Insert(d, std::make_shared<int>(4), 10));
+    assert(!cache.Find(b) && cache.Find(a) && cache.Find(c) && cache.Find(d));
+    assert(!cache.Insert(Key(e, 5), std::make_shared<int>(5), 31));
+    assert(cache.EvictInactive(30) == 20); assert(cache.Size() == 1 && cache.Bytes() == 10);
+    cache.Unprotect(c); assert(cache.EvictInactive(30) == 10);
+}
+}
+int main() { TestBudget(); TestLiveAllocationLedger(); TestOwnershipAndIdentity(); TestInactiveLRU(); std::cout << "gpu policy: 4 groups passed\n"; }
