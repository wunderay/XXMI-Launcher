+	ConfigState().clear_uav_uint_command_list.clear();
+	ConfigState().post_clear_uav_uint_command_list.clear();
+	ParseCommandList(L"ClearUnorderedAccessViewUint", &ConfigState().clear_uav_uint_command_list, &ConfigState().post_clear_uav_uint_command_list, NULL);
+
+	LogInfo("[ClearUnorderedAccessViewFloat]\n");
+	ConfigState().clear_uav_float_command_list.clear();
+	ConfigState().post_clear_uav_float_command_list.clear();
+	ParseCommandList(L"ClearUnorderedAccessViewFloat", &ConfigState().clear_uav_float_command_list, &ConfigState().post_clear_uav_float_command_list, NULL);
+
+	// Every command list is parsed now, so bind flags can be resolved
+	// through chains of custom resource references:
+	PropagateDeferredBindFlags();
+
+}
