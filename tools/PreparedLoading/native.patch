diff --git a/DirectX11/ShaderRegexCache.h b/DirectX11/ShaderRegexCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..0c6506f8ef2e628293a7a4a4443a96f8d131cf43
--- /dev/null
+++ b/DirectX11/ShaderRegexCache.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#define SHADER_REGEX_CACHE_VERSION 1
+
+struct ShaderRegexCacheHeader {
+	uint32_t version;
+	// Keep the persisted hash distinct from the current configuration accessor.
+	uint32_t regex_hash;
+	uint32_t patched;
+	uint32_t num_matches;
+};
+
+static_assert(sizeof(ShaderRegexCacheHeader) == 16, "ShaderRegex cache version 1 header must remain 16 bytes");
+
+inline bool valid_shader_regex_cache_header(const ShaderRegexCacheHeader &header, size_t size, uint32_t current_regex_hash)
+{
+	if (header.version != SHADER_REGEX_CACHE_VERSION
+	 || header.regex_hash != current_regex_hash
+	 || size < sizeof(ShaderRegexCacheHeader))
+		return false;
+
+	// The writer stores a bool and can only patch a shader after a match.
+	// These also reject hashless candidate caches when the current hash is 0/1.
+	if (header.patched > 1 || (header.patched && !header.num_matches))
+		return false;
+
+	const size_t matches_size = size - sizeof(ShaderRegexCacheHeader);
+	return matches_size % sizeof(uint32_t) == 0
+		&& matches_size / sizeof(uint32_t) == header.num_matches;
+}
