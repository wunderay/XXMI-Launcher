diff --git a/tests/preparation_native_integration/run_windows_fixture.py b/tests/preparation_native_integration/run_windows_fixture.py
new file mode 100644
index 0000000000000000000000000000000000000000..69f7305df924d2993948643496870cd502930d39
--- /dev/null
+++ b/tests/preparation_native_integration/run_windows_fixture.py
@@ -0,0 +1,36 @@
+"""Load the test-only DLL inside an owned fixture directory; never find a game."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+host, dll = (Path(value).resolve() for value in sys.argv[1:])
+with tempfile.TemporaryDirectory(prefix='native-', dir=host.parent) as temporary:
+    root = Path(temporary)
+    target = root / 'd3d11.dll'
+    shutil.copyfile(dll, target)
+    (root / 'd3dx.ini').write_text('[Loader]\ntarget = ' + host.name + '\n', encoding='utf-8')
+    try:
+        subprocess.run([str(host), str(target), str(root)], check=True, timeout=120)
+    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
+        # TemporaryDirectory removes native logs on exit. Preserve a bounded
+        # tail in CI output before cleanup, including when the host times out.
+        remaining = 64 * 1024
+        for log in sorted(root.iterdir()):
+            if remaining <= 0:
+                break
+            if not log.is_file() or log.suffix.lower() not in {'.log', '.txt'}:
+                continue
+            try:
+                with log.open('rb') as stream:
+                    stream.seek(0, 2)
+                    length = min(stream.tell(), 16 * 1024, remaining)
+                    stream.seek(-length, 2)
+                    tail = stream.read(length)
+                remaining -= len(tail)
+                print(f'--- Native diagnostic tail: {log.name} ---', file=sys.stderr)
+                print(tail.decode('utf-8', errors='replace'), file=sys.stderr, flush=True)
+            except OSError as error:
+                print(f'Cannot read native diagnostic {log.name}: {error}', file=sys.stderr)
+        raise
