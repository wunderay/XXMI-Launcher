+++ b/DirectX11/ModLoading/ChangeMonitor.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "ChangeReconciler.h"
+#include <functional>
+#include <memory>
+
+namespace ModLoading {
+// Owns notification handles and one worker. Callback runs on that worker and
+// must only enqueue bounded work; it must not parse, wait for GPU, or activate.
+// Stop must be called by owner, never from the callback. No live-object captures.
+class ChangeMonitor {
+public:
+    using Callback = std::function<void(const ReconcileRequest&)>;
+    explicit ChangeMonitor(ChangeOptions options = ChangeOptions());
+    ~ChangeMonitor();
+    ChangeMonitor(const ChangeMonitor&) = delete;
+    ChangeMonitor& operator=(const ChangeMonitor&) = delete;
+    bool Start(const std::vector<std::wstring>& resolvedRoots,
+               const std::vector<std::wstring>& excludedRoots, Callback enqueue);
+    void Stop();
+    bool IsCurrent(uint64_t token) const;
+    void RequestFullReconcile();
+    // Portable injection supports deterministic state tests; production uses OS events.
+    void Inject(ChangeKind kind, const std::wstring& path);
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+}
diff --git a/DirectX11/ModLoading/ChangeReconciler.cpp b/DirectX11/ModLoading/ChangeReconciler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2b1014d303cddb61aa19fffad48d5661e0b767a1
--- /dev/null
+++ b/DirectX11/ModLoading/ChangeReconciler.cpp
@@ -0,0 +1,96 @@
+#include "ChangeReconciler.h"
+#include <algorithm>
+#include <cwctype>
+
+namespace ModLoading {
+namespace {
+std::wstring Normal(std::wstring value) {
+    std::replace(value.begin(), value.end(), L'/', L'\\');
+    std::transform(value.begin(), value.end(), value.begin(), [](wchar_t c) { return std::towlower(c); });
+    while (value.size() > 3 && value.back() == L'\\') value.pop_back();
+    return value;
+}
+bool Within(const std::wstring& path, const std::wstring& root) {
+    return path == root || (path.size() > root.size() && path.compare(0, root.size(), root) == 0 &&
+        (root.back() == L'\\' || path[root.size()] == L'\\'));
+}
+}
+ChangeReconciler::ChangeReconciler(ChangeOptions options) : options_(options) {
+    options_.maxRoots = std::max(size_t(1), options_.maxRoots);
+    options_.maxQueuedEvents = std::max(size_t(1), options_.maxQueuedEvents);
+    for (auto& path : options_.dependencyFiles) path = Normal(path);
+    for (auto& path : options_.excludedSourceFiles) path = Normal(path);
+    std::sort(options_.dependencyFiles.begin(), options_.dependencyFiles.end());
+    std::sort(options_.excludedSourceFiles.begin(), options_.excludedSourceFiles.end());
+}
+void ChangeReconciler::Dirty(uint64_t now, bool full) {
+    ++token_;
+    if (!dirty_) first_ = now;
+    dirty_ = true; last_ = now; full_ = full_ || full;
+    events_ = std::min(events_ + 1, options_.maxQueuedEvents);
+    if (events_ == options_.maxQueuedEvents) full_ = true;
+}
+bool ChangeReconciler::SetRoots(const std::vector<std::wstring>& roots,
+    const std::vector<std::wstring>& excluded, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (roots.size() > options_.maxRoots || excluded.size() > options_.maxRoots) return false;
+    std::vector<std::wstring> normalized;
+    for (const auto& root : roots) { if (root.empty()) return false; normalized.push_back(Normal(root)); }
+    roots_ = std::move(normalized); excluded_.clear();
+    for (const auto& root : excluded) if (!root.empty()) excluded_.push_back(Normal(root));
+    cancelled_ = false; ini_ = false; events_ = 0; lastScan_ = now;
+    Dirty(now, true); return true;
+}
+void ChangeReconciler::Notify(ChangeKind kind, const std::wstring& path, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (cancelled_) return;
+    const bool force = kind == ChangeKind::Overflow || kind == ChangeKind::Unsupported || kind == ChangeKind::RootReplaced;
+    const auto normal = Normal(path);
+    const bool ini = normal.size() >= 4 && normal.substr(normal.size() - 4) == L".ini";
+    if (!force) {
+        if (normal.empty()) return;
+        for (const auto& root : excluded_) if (Within(normal, root)) return;
+        bool relevant = false;
+        for (const auto& root : roots_) if (Within(normal, root)) relevant = true;
+        if (!relevant) return;
+        if (std::binary_search(options_.excludedSourceFiles.begin(), options_.excludedSourceFiles.end(), normal)) return;
+        if (options_.filterDependencies && !ini) {
+            bool dependency = std::binary_search(options_.dependencyFiles.begin(), options_.dependencyFiles.end(), normal);
+            // Directory rename/removal notifications do not enumerate descendants.
+            // Keep ancestor changes so a moved dependency cannot stay reusable.
+            if (!dependency && kind != ChangeKind::Modified) {
+                for (const auto& file : options_.dependencyFiles) {
+                    if (!file.empty() && Within(file, normal)) { dependency = true; break; }
+                }
+            }
+            if (!dependency) return;
+        }
+    }
+    if (ini) ini_ = true;
+    // Unknown lost notifications may contain INI changes, so retain reload intent.
+    if (force) ini_ = true;
+    Dirty(now, force);
+}
+void ChangeReconciler::RequestFullReconcile(uint64_t now) { Notify(ChangeKind::Overflow, L"", now); }
+bool ChangeReconciler::TakeReady(uint64_t now, ReconcileRequest& request) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (cancelled_) return false;
+    if (options_.periodicReconcileMs && now - lastScan_ >= options_.periodicReconcileMs && !dirty_) {
+        Dirty(now, true); ini_ = true;
+    }
+    if (!dirty_ || (now - last_ < options_.debounceMs && now - first_ < options_.maximumDelayMs)) return false;
+    request.token = token_; request.roots = roots_; request.fullReconcile = full_; request.iniChanged = ini_;
+    dirty_ = false; full_ = false; events_ = 0; lastScan_ = now;
+    return true;
+}
+bool ChangeReconciler::IsCurrent(uint64_t token) const {
+    std::lock_guard<std::mutex> lock(mutex_); return !cancelled_ && token != 0 && token == token_;
+}
+void ChangeReconciler::Cancel() { std::lock_guard<std::mutex> lock(mutex_); ++token_; cancelled_ = true; dirty_ = false; }
+std::vector<std::wstring> ChangeReconciler::Roots() const { std::lock_guard<std::mutex> lock(mutex_); return roots_; }
+bool ChangeReconciler::RecordVerifiedDigest(uint64_t token, const std::string& digest, bool verified) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!verified || digest.empty() || cancelled_ || token != token_) return false;
+    verifiedDigest_ = digest; return true;
+}
+}
diff --git a/DirectX11/ModLoading/ChangeReconciler.h b/DirectX11/ModLoading/ChangeReconciler.h
new file mode 100644
index 0000000000000000000000000000000000000000..cb802fd2db22fe70a5b41c5e3ab46a47e53dbd3a
--- /dev/null
+++ b/DirectX11/ModLoading/ChangeReconciler.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ModLoading {
+enum class ChangeKind { Created, Modified, Deleted, RenamedOld, RenamedNew, Overflow, Unsupported, RootReplaced };
+struct ChangeOptions {
+    size_t maxRoots = 128;
+    size_t maxQueuedEvents = 1024;
+    uint64_t debounceMs = 150;
+    uint64_t maximumDelayMs = 1500;
+    uint64_t periodicReconcileMs = 0; // Opt in only with a complete config-closure verifier.
+    bool filterDependencies = false;
+    std::vector<std::wstring> dependencyFiles; // Resolved canonical asset files.
+    std::vector<std::wstring> excludedSourceFiles; // Exact runtime-owned output files.
+    bool automaticActivation = false; // Separate opt-in policy; monitor never activates.
+};
+struct ReconcileRequest {
+    uint64_t token = 0;
+    std::vector<std::wstring> roots;
+    bool fullReconcile = false;
+    bool iniChanged = false; // Sticky until SetRoots after legacy reload; never lose cancelled INI intent.
+};
+// Thread-safe notification state. Tick values are monotonic milliseconds.
+// Debounce only reduces work. The consumer must verify the entire dependency
+// closure from stable content snapshots, and recheck IsCurrent before publishing.
+class ChangeReconciler {
+public:
+    explicit ChangeReconciler(ChangeOptions options = ChangeOptions());
+    bool SetRoots(const std::vector<std::wstring>& resolvedRoots,
+                  const std::vector<std::wstring>& excludedRoots, uint64_t now);
+    void Notify(ChangeKind kind, const std::wstring& path, uint64_t now);
+    void RequestFullReconcile(uint64_t now);
+    bool TakeReady(uint64_t now, ReconcileRequest& request);
+    bool IsCurrent(uint64_t token) const;
+    void Cancel();
+    std::vector<std::wstring> Roots() const;
+    // Snapshot digests are computed from verified bytes by the CPU preparation
+    // layer, never timestamps/size. Stale and unverified snapshots are rejected.
+    bool RecordVerifiedDigest(uint64_t token, const std::string& digest, bool closureVerified);
+private:
+    void Dirty(uint64_t now, bool full);
+    ChangeOptions options_;
+    mutable std::mutex mutex_;
+    std::vector<std::wstring> roots_, excluded_;
+    uint64_t token_ = 0, first_ = 0, last_ = 0, lastScan_ = 0;
+    size_t events_ = 0;
+    bool dirty_ = false, full_ = false, ini_ = false, cancelled_ = false;
+    std::string verifiedDigest_;
+};
+}
diff --git a/DirectX11/ModLoading/ConfigCompiler.cpp b/DirectX11/ModLoading/ConfigCompiler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..43f05a039ee72e4031ebc4dc05f0eb2cbe2ec77e
--- /dev/null
+++ b/DirectX11/ModLoading/ConfigCompiler.cpp
@@ -0,0 +1,85 @@
+#include "ConfigCompiler.h"
+#include "IncrementalConfigCache.h"
+#include "SnapshotIO.h"
+
+namespace ModLoading {
+namespace {
+void AppendSize(std::vector<uint8_t>& out, uint64_t value) {
+    for (unsigned i = 0; i != 8; ++i) out.push_back(static_cast<uint8_t>(value >> (8 * i)));
+}
+void AppendText(std::vector<uint8_t>& out, const std::wstring& value) {
+    AppendSize(out, value.size());
+    for (auto c : value) {
+        const auto code = static_cast<uint32_t>(c);
+        for (unsigned i = 0; i != 4; ++i) out.push_back(static_cast<uint8_t>(code >> (8 * i)));
+    }
+}
+bool SameSource(const ConfigSource& a, const ConfigSource& b) {
+    return a.snapshot.path == b.snapshot.path && a.iniNamespace == b.iniNamespace &&
+        a.snapshot.digest == b.snapshot.digest && a.snapshot.bytes && b.snapshot.bytes &&
+        *a.snapshot.bytes == *b.snapshot.bytes;
+}
+}
+std::shared_ptr<const CompiledConfig> ConfigCompiler::Build(const ConfigSourceManifest& sources,
+    const std::shared_ptr<const CompiledConfig>& baseline, BuildVersions versions,
+    bool dependencyClosureVerified, bool forceFull) {
+    auto result = std::make_shared<CompiledConfig>();
+    result->manifest = sources;
+    result->versions = versions;
+    std::vector<uint8_t> identity;
+    const auto schema = cache_.Schema();
+    result->parserVersion = schema.parser;
+    result->schemaVersion = schema.schema;
+    result->abiVersion = schema.abi;
+    AppendSize(identity, schema.parser);
+    AppendSize(identity, schema.schema);
+    AppendSize(identity, schema.abi);
+    AppendSize(identity, sources.sources.size());
+    bool valid = sources.verified && !sources.sources.empty();
+    bool same = baseline && baseline->manifest.verified &&
+        baseline->manifest.sources.size() == sources.sources.size();
+    bool ambiguous = false;
+    for (size_t i = 0; i < sources.sources.size(); ++i) {
+        const auto& source = sources.sources[i];
+        const auto& snapshot = source.snapshot;
+        if (!snapshot.bytes || HashBytes(snapshot.bytes->data(), snapshot.bytes->size()) != snapshot.digest) {
+            valid = false;
+            same = false;
+            break;
+        }
+        AppendText(identity, snapshot.path);
+        AppendText(identity, source.iniNamespace);
+        AppendSize(identity, snapshot.bytes->size());
+        identity.insert(identity.end(), snapshot.digest.begin(), snapshot.digest.end());
+        bool reused = false;
+        auto ir = cache_.Parse(snapshot, forceFull, reused);
+        if (!ir) { valid = false; break; }
+        ambiguous = ambiguous || ir->ambiguousDependencies;
+        if (reused) ++result->reusedFiles; else ++result->parsedFiles;
+        result->files.push_back(std::move(ir));
+        if (same && !SameSource(source, baseline->manifest.sources[i])) same = false;
+    }
+    result->fullRebuild = forceFull || ambiguous || !baseline;
+    // Global/conditional include dependencies require a complete candidate IR.
+    // We never infer transitive reachability from an incomplete lexical graph.
+    if (ambiguous && !forceFull && valid) {
+        result->files.clear(); result->parsedFiles = 0; result->reusedFiles = 0;
+        for (const auto& source : sources.sources) {
+            bool reused = false;
+            result->files.push_back(cache_.Parse(source.snapshot, true, reused));
+            ++result->parsedFiles;
+        }
+    }
+    result->identity = HashBytes(identity.data(), identity.size());
+    if (!(cache_.Schema() == schema)) valid = false;
+    if (!valid) result->reason = "Unverified, missing, or inconsistent config source snapshot";
+    else if (!dependencyClosureVerified) result->reason = "Dependency closure not verified";
+    else if (!baseline) result->reason = "Legacy config baseline; full semantic linker required for config changes";
+    else if (!same) result->reason = "Config changes require legacy reload: globals, initialization, variables, pools and command links are not detached";
+    else {
+        result->disposition = ConfigDisposition::AssetOnly;
+        result->reason = "Exact config identity retained; asset preparation may proceed without config mutation";
+    }
+    return result;
+}
+}
diff --git a/DirectX11/ModLoading/ConfigCompiler.h b/DirectX11/ModLoading/ConfigCompiler.h
new file mode 100644
index 0000000000000000000000000000000000000000..ed3cdf4a4b64b43f37386e89485c44cf44074c18
--- /dev/null
+++ b/DirectX11/ModLoading/ConfigCompiler.h
@@ -0,0 +1,57 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <string>
+#include <vector>
+
+namespace ModLoading {
+struct ConfigSource {
+    SourceSnapshot snapshot;
+    std::wstring iniNamespace;
+};
+// Ordered actual parser inputs, including persistent settings. This is not a
+// directory scan: callers must separately prove the dependency closure current.
+struct ConfigSourceManifest {
+    std::vector<ConfigSource> sources;
+    bool verified = false;
+};
+struct BuildVersions {
+    uint64_t source = 0, device = 0, runtime = 0;
+    bool operator==(const BuildVersions& o) const {
+        return source == o.source && device == o.device && runtime == o.runtime;
+    }
+};
+struct ConfigLineIR {
+    std::string section, key, value, raw;
+    size_t line = 0;
+};
+// Ordered, locale-independent diagnostic lexical IR, NOT a replacement for the legacy
+// expression/command linker. Duplicate lines retain original order.
+struct ConfigFileIR {
+    SourceDigest digest{};
+    std::vector<ConfigLineIR> lines;
+    std::vector<std::string> declaredIncludes;
+    bool ambiguousDependencies = false;
+};
+enum class ConfigDisposition { AssetOnly, CompatibilityOnly };
+struct CompiledConfig {
+    ConfigSourceManifest manifest;
+    BuildVersions versions;
+    SourceDigest identity{};
+    uint32_t parserVersion = 1, schemaVersion = 1, abiVersion = 1;
+    std::vector<std::shared_ptr<const ConfigFileIR>> files;
+    ConfigDisposition disposition = ConfigDisposition::CompatibilityOnly;
+    std::string reason;
+    size_t parsedFiles = 0, reusedFiles = 0;
+    bool fullRebuild = true;
+};
+class IncrementalConfigCache;
+class ConfigCompiler {
+public:
+    explicit ConfigCompiler(IncrementalConfigCache& cache) : cache_(cache) {}
+    std::shared_ptr<const CompiledConfig> Build(const ConfigSourceManifest& sources,
+        const std::shared_ptr<const CompiledConfig>& baseline,
+        BuildVersions versions, bool dependencyClosureVerified, bool forceFull = false);
+private:
+    IncrementalConfigCache& cache_;
+};
+}
diff --git a/DirectX11/ModLoading/CpuAssetCache.cpp b/DirectX11/ModLoading/CpuAssetCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..38aa421a5a4c9c14428fd690868d2e51b5aab4a2
--- /dev/null
+++ b/DirectX11/ModLoading/CpuAssetCache.cpp
@@ -0,0 +1,38 @@
+#include "CpuAssetCache.h"
+#include <limits>
+namespace ModLoading {
+namespace {
+bool Unpinned(const std::shared_ptr<const PreparedAsset>& asset) {
+ return asset.use_count()==1 && asset->snapshot.bytes.use_count()==1 && (!asset->decoded || (asset->decoded.use_count()==1 && (!asset->decoded->pixels || asset->decoded->pixels.use_count()==1)));
+}
+}
+
+CpuAssetCache::CpuAssetCache(size_t capacity):capacity_(capacity){}
+bool CpuAssetCache::MakeRoom(size_t bytes) {
+ if(bytes>capacity_)return false;
+ while(resident_+reserved_>capacity_-bytes){
+  auto oldest=entries_.end();
+  for(auto it=entries_.begin();it!=entries_.end();++it)if(Unpinned(it->second.asset)&&(oldest==entries_.end()||it->second.touched<oldest->second.touched))oldest=it;
+  if(oldest==entries_.end())return false;
+  resident_-=oldest->second.asset->ByteSize();entries_.erase(oldest);
+ }
+ return true;
+}
+void CpuAssetCache::SetCapacity(size_t capacity){std::lock_guard<std::mutex> lock(mutex_);capacity_=capacity;MakeRoom(0);}
+bool CpuAssetCache::Reserve(size_t bytes){std::lock_guard<std::mutex> lock(mutex_);if(!MakeRoom(bytes))return false;reserved_+=bytes;return true;}
+void CpuAssetCache::ReleaseReservation(size_t bytes){std::lock_guard<std::mutex> lock(mutex_);if(bytes<=reserved_)reserved_-=bytes;}
+bool CpuAssetCache::Publish(std::shared_ptr<const PreparedAsset> asset,size_t reservation){
+ std::lock_guard<std::mutex> lock(mutex_);
+ if(reservation>reserved_)return false;
+ reserved_-=reservation;
+ if(!asset||!asset->snapshot.watchable||!asset->snapshot.bytes||asset->ByteSize()>reservation)return false;
+ auto key=std::make_pair(asset->snapshot.path,asset->generation);
+ if(entries_.count(key))return true;
+ size_t n=asset->ByteSize();if(!MakeRoom(n))return false;
+ try {entries_.emplace(std::move(key),Entry{std::move(asset),++clock_});}catch(const std::bad_alloc&){return false;}
+ resident_+=n;return true;
+}
+std::shared_ptr<const PreparedAsset> CpuAssetCache::Find(const std::wstring& path,Generation generation){std::lock_guard<std::mutex> lock(mutex_);auto it=entries_.find({path,generation});if(it==entries_.end())return {};it->second.touched=++clock_;return it->second.asset;}
+size_t CpuAssetCache::ResidentBytes()const{std::lock_guard<std::mutex> lock(mutex_);return resident_;}
+size_t CpuAssetCache::ReservedBytes()const{std::lock_guard<std::mutex> lock(mutex_);return reserved_;}
+}
diff --git a/DirectX11/ModLoading/CpuAssetCache.h b/DirectX11/ModLoading/CpuAssetCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..ee1fa2d712a246ae35de77ccb007635b699696a7
--- /dev/null
+++ b/DirectX11/ModLoading/CpuAssetCache.h
@@ -0,0 +1,23 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <map>
+#include <mutex>
+namespace ModLoading {
+class CpuAssetCache {
+public:
+ explicit CpuAssetCache(size_t capacity);
+ void SetCapacity(size_t capacity);
+ bool Reserve(size_t bytes);
+ void ReleaseReservation(size_t bytes);
+ bool Publish(std::shared_ptr<const PreparedAsset> asset, size_t reservation);
+ std::shared_ptr<const PreparedAsset> Find(const std::wstring& path, Generation generation);
+ size_t ResidentBytes() const;
+ size_t ReservedBytes() const;
+private:
+ struct Entry { std::shared_ptr<const PreparedAsset> asset; uint64_t touched; };
+ bool MakeRoom(size_t bytes);
+ mutable std::mutex mutex_;
+ std::map<std::pair<std::wstring,Generation>,Entry> entries_;
+ size_t capacity_, resident_=0, reserved_=0; uint64_t clock_=0;
+};
+}
diff --git a/DirectX11/ModLoading/DeviceResourceCache.cpp b/DirectX11/ModLoading/DeviceResourceCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b3f941be89b0310eca8df03654a34d6b3a59fe32
--- /dev/null
+++ b/DirectX11/ModLoading/DeviceResourceCache.cpp
@@ -0,0 +1,65 @@
+#include "DeviceResourceCache.h"
+#include <atomic>
+#include <limits>
+#include <stdexcept>
+namespace ModLoading {
+bool DeviceResourceKey::operator<(const DeviceResourceKey& other) const {
+    if (epoch != other.epoch) return epoch < other.epoch;
+    if (digest != other.digest) return digest < other.digest;
+    return effectiveOptions < other.effectiveOptions;
+}
+DeviceEpoch AllocateDeviceEpoch() {
+    static std::atomic<DeviceEpoch> next{1};
+    auto value = next.load();
+    for (;;) {
+        if (value == (std::numeric_limits<DeviceEpoch>::max)())
+            throw std::overflow_error("device epoch exhausted");
+        if (next.compare_exchange_weak(value, value + 1)) return value;
+    }
+}
+DeviceResourceCache::DeviceResourceCache(uint64_t maximumBytes) : maximum_(maximumBytes) {}
+void DeviceResourceCache::BeginEpoch(DeviceEpoch epoch) {
+    entries_.clear(); bytes_ = 0; clock_ = 0; epoch_ = epoch;
+}
+bool DeviceResourceCache::Insert(const DeviceResourceKey& key, std::shared_ptr<void> object, uint64_t bytes) {
+    if (!epoch_ || key.epoch != epoch_ || !object || bytes > maximum_) return false;
+    if (entries_.find(key) != entries_.end()) return true;
+    if (!MakeRoom(bytes)) return false;
+    entries_.emplace(key, Entry{std::move(object), bytes, ++clock_, 0}); bytes_ += bytes;
+    return true;
+}
+bool DeviceResourceCache::MakeRoom(uint64_t bytes) {
+    if (bytes > maximum_) return false;
+    if (bytes > maximum_ - bytes_) EvictInactive(bytes - (maximum_ - bytes_));
+    return bytes <= maximum_ - bytes_;
+}
+std::shared_ptr<void> DeviceResourceCache::Find(const DeviceResourceKey& key) {
+    if (!epoch_ || key.epoch != epoch_) return {};
+    auto it = entries_.find(key);
+    if (it == entries_.end()) return {};
+    it->second.use = ++clock_; return it->second.object;
+}
+bool DeviceResourceCache::Protect(const DeviceResourceKey& key) {
+    auto it = entries_.find(key);
+    if (key.epoch != epoch_ || it == entries_.end()) return false;
+    ++it->second.active; return true;
+}
+void DeviceResourceCache::Unprotect(const DeviceResourceKey& key) {
+    auto it = entries_.find(key);
+    if (it != entries_.end() && it->second.active) --it->second.active;
+}
+uint64_t DeviceResourceCache::EvictInactive(uint64_t requestedBytes) {
+    uint64_t released = 0;
+    while (released < requestedBytes) {
+        auto oldest = entries_.end();
+        for (auto it = entries_.begin(); it != entries_.end(); ++it)
+            // A lease outside the cache also protects the object. This is cache
+            // ownership protection, never an assertion of OS residency.
+            if (!it->second.active && it->second.object.use_count() == 1 &&
+                (oldest == entries_.end() || it->second.use < oldest->second.use)) oldest = it;
+        if (oldest == entries_.end()) break;
+        released += oldest->second.bytes; bytes_ -= oldest->second.bytes; entries_.erase(oldest);
+    }
+    return released;
+}
+}
