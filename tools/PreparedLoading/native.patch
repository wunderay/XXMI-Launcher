+namespace ModLoading {
+struct AssetRecord {uint64_t id=0;std::wstring path;Generation generation=0;std::vector<uint64_t> dependencies;};
+class AssetCatalog {
+public:
+ explicit AssetCatalog(size_t maximum=65536):maximum_(maximum){}
+ // IDs are stable within a catalog; all dependencies must already be registered.
+ uint64_t Register(const std::wstring& path,Generation generation,const std::vector<uint64_t>& dependencies={});
+ std::vector<AssetRecord> Records()const;
+ void Clear();
+private:
+ mutable std::mutex mutex_;size_t maximum_;uint64_t next_=0;std::map<std::wstring,AssetRecord> records_;
+};
+}
