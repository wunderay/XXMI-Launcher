+#include <Windows.h>
+#include <algorithm>
+#include <cwctype>
+#endif
+
+namespace ModLoading {
+namespace {
+uint64_t Now() {
+	return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+#ifdef _WIN32
+std::atomic<size_t> watchCount{0};
+struct Watch {
+	HANDLE file = INVALID_HANDLE_VALUE;
+	OVERLAPPED operation = {};
+	alignas(DWORD) unsigned char buffer[32768];
+	std::wstring directory;
+	std::wstring target;
+	bool parent = false;
+	bool pending = false;
+	~Watch()
+	{
+		if (file != INVALID_HANDLE_VALUE)
+			CloseHandle(file);
+		if (operation.hEvent)
+			CloseHandle(operation.hEvent);
+		--watchCount;
+	}
+};
+// Cancellation usually completes immediately. A broken filesystem driver must
+// not cause Stop to block forever or write into freed OVERLAPPED memory. Retain
+// at most 256 closed-handle operations process-wide; refuse new watches while
+// that bounded reserve is exhausted. No completion routines point into the DLL.
+struct Retired {
+	std::mutex mutex;
+	std::vector<std::unique_ptr<Watch>> watches;
+};
+
+Retired& RetiredIO()
+{
+	static auto* state = new Retired;
+	return *state;
+}
+
+void Reap()
+{
+	auto& state = RetiredIO();
+	std::lock_guard<std::mutex> guard(state.mutex);
+	state.watches.erase(std::remove_if(state.watches.begin(), state.watches.end(),
+		[](const std::unique_ptr<Watch>& watch) { return WaitForSingleObject(watch->operation.hEvent, 0) == WAIT_OBJECT_0; }), state.watches.end());
+}
+void CloseWatch(std::unique_ptr<Watch>& watch) {
+	if (!watch) return;
+	if (watch->pending) {
+		CancelIoEx(watch->file, &watch->operation);
+		CloseHandle(watch->file);
+		watch->file = INVALID_HANDLE_VALUE;
+		if (WaitForSingleObject(watch->operation.hEvent, 0) != WAIT_OBJECT_0) {
+			auto& state = RetiredIO();
+			std::lock_guard<std::mutex> guard(state.mutex);
+			state.watches.push_back(std::move(watch));
+			return;
+		}
+	}
+	watch.reset();
+}
+bool Arm(Watch& watch)
+{
+	ResetEvent(watch.operation.hEvent);
+	watch.pending = ReadDirectoryChangesW(watch.file, watch.buffer, sizeof(watch.buffer), !watch.parent,
+		FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME | FILE_NOTIFY_CHANGE_SIZE |
+		FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_CREATION, nullptr, &watch.operation, nullptr) != FALSE;
+	return watch.pending;
+}
+std::unique_ptr<Watch> Open(const std::wstring& directory, const std::wstring& target, bool parent)
+{
+	Reap();
+	{
+		auto& retired = RetiredIO();
+		std::lock_guard<std::mutex> guard(retired.mutex);
+		if (retired.watches.size() >= 256)
+			return nullptr;
+	}
+	if (watchCount.fetch_add(1) >= 256) {
+		--watchCount;
+		return nullptr;
+	}
+	std::unique_ptr<Watch> watch(new Watch);
+	watch->directory = directory;
+	watch->target = target;
+	watch->parent = parent;
+	watch->operation.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	watch->file = CreateFileW(directory.c_str(), FILE_LIST_DIRECTORY,
+		FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+		FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED, nullptr);
+	if (!watch->operation.hEvent || watch->file == INVALID_HANDLE_VALUE || !Arm(*watch))
+		return nullptr;
+	return watch;
+}
+bool Same(const std::wstring& left, const std::wstring& right)
+{
+	return _wcsicmp(left.c_str(), right.c_str()) == 0;
+}
+struct RootWatch {
+	std::wstring root;
+	std::wstring parent;
+	std::unique_ptr<Watch> tree;
+	std::unique_ptr<Watch> ancestor;
+	bool attemptedTree = false;
+};
+#endif
+}
+struct ChangeMonitor::Impl {
+	explicit Impl(ChangeOptions options) : state(options) {}
+	ChangeReconciler state;
+	std::atomic<bool> stopping{false}, watching{false};
+	std::mutex watchMutex;
+#ifdef _WIN32
+	std::vector<HANDLE> watchEvents;
+#endif
+	std::thread worker;
+	Callback callback;
+	void Run()
+	{
+#ifdef _WIN32
+		std::vector<RootWatch> roots;
+		for (auto root : state.Roots()) {
+			const auto slash = root.find_last_of(L"\\/");
+			RootWatch item;
+			item.root = root;
+			if (slash != std::wstring::npos)
+				item.parent = root.substr(0, slash + (slash == 2 ? 1 : 0));
+			roots.push_back(std::move(item));
+		}
+		uint64_t retryAt = 0;
+#endif
+		while (!stopping.load()) {
+#ifdef _WIN32
+			std::unique_lock<std::mutex> watchLock(watchMutex);
+			const auto now = Now();
+			if (now >= retryAt) {
+				retryAt = now + 1000;
+				for (auto& root : roots) {
+					if (!root.tree) {
+						root.tree = Open(root.root, root.root, false);
+						// SetRoots already scheduled the initial verified scan.
+						// Initial successful attachment is not an INI edit.
+						// A failed attempt is uncertain; subsequent attachment
+						// is genuine recovery and retains conservative intent.
+						if (!root.tree)
+							state.Notify(ChangeKind::Unsupported, root.root, now);
+						else if (root.attemptedTree)
+							state.Notify(ChangeKind::RootReplaced, root.root, now);
+						root.attemptedTree = true;
+					}
+					if (!root.ancestor && !root.parent.empty())
+						root.ancestor = Open(root.parent, root.root, true);
+				}
+			}
+			for (auto& root : roots) {
+				for (int parent = 1; parent >= 0; --parent) {
+					auto& ptr = parent ? root.ancestor : root.tree;
+					if (!ptr || WaitForSingleObject(ptr->operation.hEvent, 0) != WAIT_OBJECT_0)
+						continue;
+					DWORD bytes = 0;
+					const BOOL result = GetOverlappedResult(ptr->file, &ptr->operation, &bytes, FALSE);
+					ptr->pending = false;
+					if (!result || !bytes) {
+						state.Notify(ChangeKind::Overflow, root.root, Now());
+						CloseWatch(ptr);
+						continue;
+					}
+					bool replaced = false;
+					if (bytes < offsetof(FILE_NOTIFY_INFORMATION, FileName))
+						state.Notify(ChangeKind::Overflow, root.root, Now());
+					size_t offset = 0;
+					while (offset + offsetof(FILE_NOTIFY_INFORMATION, FileName) <= bytes) {
+						const auto* event = reinterpret_cast<const FILE_NOTIFY_INFORMATION*>(ptr->buffer + offset);
+						const size_t header = offsetof(FILE_NOTIFY_INFORMATION, FileName);
+						if (event->FileNameLength % sizeof(wchar_t) || header + event->FileNameLength > bytes - offset) {
+							state.Notify(ChangeKind::Overflow, root.root, Now());
+							break;
+						}
+						const std::wstring path = ptr->directory + (ptr->directory.back() == L'\\' ? L"" : L"\\") + std::wstring(event->FileName, event->FileNameLength / sizeof(wchar_t));
+						if (parent) {
+							if (event->Action != FILE_ACTION_MODIFIED && Same(path, root.root)) {
+								replaced = true;
+								state.Notify(ChangeKind::RootReplaced, root.root, Now());
+							}
+						} else {
+							ChangeKind kind = ChangeKind::Modified;
+							switch (event->Action) {
+							case FILE_ACTION_ADDED: kind = ChangeKind::Created; break;
+							case FILE_ACTION_REMOVED: kind = ChangeKind::Deleted; break;
+							case FILE_ACTION_RENAMED_OLD_NAME: kind = ChangeKind::RenamedOld; break;
+							case FILE_ACTION_RENAMED_NEW_NAME: kind = ChangeKind::RenamedNew; break;
+							case FILE_ACTION_MODIFIED: break;
+							default: kind = ChangeKind::Overflow; break;
+							}
+							state.Notify(kind, path, Now());
+						}
+						if (!event->NextEntryOffset)
+							break;
+						if (event->NextEntryOffset < header || event->NextEntryOffset % alignof(DWORD) || event->NextEntryOffset >= bytes - offset) {
+							state.Notify(ChangeKind::Overflow, root.root, Now());
+							break;
+						}
+						offset += event->NextEntryOffset;
+					}
+					if (replaced)
+						CloseWatch(root.tree);
+					if (!Arm(*ptr)) {
+						state.Notify(ChangeKind::Unsupported, root.root, Now());
+						CloseWatch(ptr);
+					}
+				}
+			}
+			watchEvents.clear();
+			bool complete = !roots.empty();
+			for (const auto& root : roots) {
+				complete = complete && root.tree && (root.parent.empty() || root.ancestor);
+				if (root.tree)
+					watchEvents.push_back(root.tree->operation.hEvent);
+				if (root.ancestor)
+					watchEvents.push_back(root.ancestor->operation.hEvent);
+			}
+			watching.store(complete);
+			watchLock.unlock();
+#else
+			watching.store(true);
+#endif
+			ReconcileRequest request;
+			if (state.TakeReady(Now(), request)) {
+				try {
+					callback(request);
+				} catch (...) {
+					state.RequestFullReconcile(Now());
+				}
+			}
+			std::this_thread::sleep_for(std::chrono::milliseconds(25));
+		}
+		watching.store(false);
+#ifdef _WIN32
+		std::lock_guard<std::mutex> watchLock(watchMutex);
+		watchEvents.clear();
+		for (auto& root : roots) {
+			CloseWatch(root.tree);
+			CloseWatch(root.ancestor);
+		}
+		Reap();
+#endif
+	}
+};
+ChangeMonitor::ChangeMonitor(ChangeOptions options) : impl_(new Impl(options)) {}
+ChangeMonitor::~ChangeMonitor() { Stop(); }
+bool ChangeMonitor::Start(const std::vector<std::wstring>& roots, const std::vector<std::wstring>& excluded, Callback callback)
+{
+	Stop();
+	if (!callback || !impl_->state.SetRoots(roots, excluded, Now()))
+		return false;
+	impl_->callback = std::move(callback);
+	impl_->stopping.store(false);
+	impl_->watching.store(false);
+	try { impl_->worker = std::thread([this] { impl_->Run(); }); }
+	catch (...) {
+		impl_->state.Cancel();
+		return false;
+	}
+	return true;
+}
+void ChangeMonitor::Stop()
+{
+	impl_->state.Cancel();
+	impl_->stopping.store(true);
+	if (impl_->worker.joinable()) impl_->worker.join();
+	impl_->callback = Callback();
+}
+bool ChangeMonitor::IsCurrent(uint64_t token) const
+{
+	return impl_->state.IsCurrent(token);
+}
+bool ChangeMonitor::CommitIfCurrent(uint64_t token, const std::function<bool()>& publish) noexcept
+{
+#ifdef _WIN32
+	// ReadDirectoryChanges completion can precede the worker's token update.
+	// Refuse publication while any queued native event remains undrained.
+	std::unique_lock<std::mutex> lock(impl_->watchMutex, std::try_to_lock);
+	if (!lock.owns_lock() || !impl_->watching.load())
+		return false;
+	for (const auto event : impl_->watchEvents)
+		if (WaitForSingleObject(event, 0) != WAIT_TIMEOUT)
+			return false;
+#endif
+	return impl_->state.CommitIfCurrent(token, publish);
+}
+bool ChangeMonitor::WaitUntilWatching(uint32_t timeoutMilliseconds)
+{
+	const auto end = Now() + timeoutMilliseconds;
+	while (!impl_->stopping.load() && Now() < end) {
+		if (impl_->watching.load())
+			return true;
+		std::this_thread::sleep_for(std::chrono::milliseconds(5));
+	}
+	return impl_->watching.load();
+}
+bool ChangeMonitor::TrackDependencyFile(const std::wstring& path)
+{
+	return impl_->state.TrackDependencyFile(path);
+}
+void ChangeMonitor::RequestFullReconcile()
+{
+	impl_->state.RequestFullReconcile(Now());
+}
+void ChangeMonitor::Inject(ChangeKind kind, const std::wstring& path)
+{
+	impl_->state.Notify(kind, path, Now());
+}
+}
+
+uint64_t ModLoading::ChangeMonitor::CurrentToken() const
+{
+	return impl_->state.CurrentToken();
+}
diff --git a/DirectX11/ModLoading/ChangeMonitor.h b/DirectX11/ModLoading/ChangeMonitor.h
new file mode 100644
index 0000000000000000000000000000000000000000..eb29f56ab8c19ff2ba1470934a485768ae8b364e
--- /dev/null
+++ b/DirectX11/ModLoading/ChangeMonitor.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "ChangeReconciler.h"
+#include <functional>
+#include <memory>
+
+namespace ModLoading {
+// Owns notification handles and one worker. Callback runs on that worker and
+// must only enqueue bounded work; it must not parse, wait for GPU, or activate.
+// Stop must be called by owner, never from the callback. No live-object captures.
+class ChangeMonitor {
+public:
+	using Callback = std::function<void(const ReconcileRequest&)>;
+	explicit ChangeMonitor(ChangeOptions options = ChangeOptions());
+	~ChangeMonitor();
+	ChangeMonitor(const ChangeMonitor&) = delete;
+	ChangeMonitor& operator=(const ChangeMonitor&) = delete;
+	bool Start(const std::vector<std::wstring>& resolvedRoots,
+			   const std::vector<std::wstring>& excludedRoots, Callback enqueue);
+	void Stop();
+	bool IsCurrent(uint64_t token) const;
+	// Worker/loading-boundary only: waits for native watches to be armed.
+	bool WaitUntilWatching(uint32_t timeoutMilliseconds);
+	uint64_t CurrentToken() const;
+	// Final bounded pointer swap only; obey ChangeReconciler's lock/callback
+	// contract. In particular, defer D3D resource retirement until after return.
+	bool CommitIfCurrent(uint64_t token, const std::function<bool()>& publish) noexcept;
+	void RequestFullReconcile();
+	bool TrackDependencyFile(const std::wstring& resolvedCanonicalFile);
+	// Portable injection supports deterministic state tests; production uses OS events.
+	void Inject(ChangeKind kind, const std::wstring& path);
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl_;
+};
+}
diff --git a/DirectX11/ModLoading/ChangeReconciler.cpp b/DirectX11/ModLoading/ChangeReconciler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..51d6ac75350236699937a01cc2394c49612b4ea1
--- /dev/null
+++ b/DirectX11/ModLoading/ChangeReconciler.cpp
@@ -0,0 +1,231 @@
+#include "ChangeReconciler.h"
+#include <algorithm>
+#include <cwctype>
+
+namespace ModLoading {
+namespace {
+std::wstring Normal(std::wstring value)
+{
+	std::replace(value.begin(), value.end(), L'/', L'\\');
+	std::transform(value.begin(), value.end(), value.begin(), [](wchar_t c) { return std::towlower(c); });
+	while (value.size() > 3 && value.back() == L'\\')
+		value.pop_back();
+	return value;
+}
+bool Within(const std::wstring& path, const std::wstring& root)
+{
+	return path == root || (path.size() > root.size() && path.compare(0, root.size(), root) == 0 &&
+		(root.back() == L'\\' || path[root.size()] == L'\\'));
+}
+}
+ChangeReconciler::ChangeReconciler(ChangeOptions options) : options_(options)
+{
+	options_.maxDependencyFiles = std::min(size_t(65536), std::max(size_t(1), options_.maxDependencyFiles));
+	options_.maxRoots = std::max(size_t(1), options_.maxRoots);
+	options_.maxQueuedEvents = std::max(size_t(1), options_.maxQueuedEvents);
+	for (auto& path : options_.dependencyFiles)
+		path = Normal(path);
+	for (auto& path : options_.excludedSourceFiles)
+		path = Normal(path);
+	std::sort(options_.dependencyFiles.begin(), options_.dependencyFiles.end());
+	std::sort(options_.excludedSourceFiles.begin(), options_.excludedSourceFiles.end());
+}
+void ChangeReconciler::Dirty(uint64_t now, bool full)
+{
+	++token_;
+	if (!dirty_) first_ = now;
+	dirty_ = true;
+	last_ = now;
+	full_ = full_ || full;
+	events_ = std::min(events_ + 1, options_.maxQueuedEvents);
+	if (events_ == options_.maxQueuedEvents)
+		full_ = true;
+}
+bool ChangeReconciler::SetRoots(const std::vector<std::wstring>& roots,
+	const std::vector<std::wstring>& excluded, uint64_t now)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (roots.size() > options_.maxRoots || excluded.size() > options_.maxRoots)
+		return false;
+	std::vector<std::wstring> normalized;
+	for (const auto& root : roots) {
+		if (root.empty())
+			return false;
+		normalized.push_back(Normal(root));
+	}
+	roots_ = std::move(normalized);
+	excluded_.clear();
+	for (const auto& root : excluded)
+		if (!root.empty())
+			excluded_.push_back(Normal(root));
+	cancelled_ = false;
+	ini_ = false;
+	events_ = 0;
+	lastScan_ = now;
+	Dirty(now, true);
+	return true;
+}
+void ChangeReconciler::Notify(ChangeKind kind, const std::wstring& path, uint64_t now)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (cancelled_)
+		return;
+	const bool force = kind == ChangeKind::Overflow || kind == ChangeKind::Unsupported || kind == ChangeKind::RootReplaced;
+	const auto normal = Normal(path);
+	const bool ini = normal.size() >= 4 && normal.substr(normal.size() - 4) == L".ini";
+	if (!force) {
+		if (normal.empty())
+			return;
+		for (const auto& root : excluded_)
+			if (Within(normal, root))
+				return;
+		bool relevant = false;
+		for (const auto& root : roots_)
+			if (Within(normal, root))
+				relevant = true;
+		if (!relevant)
+			return;
+		if (std::binary_search(options_.excludedSourceFiles.begin(), options_.excludedSourceFiles.end(), normal))
+			return;
+		if (options_.filterDependencies && !ini) {
+			bool dependency = std::binary_search(options_.dependencyFiles.begin(), options_.dependencyFiles.end(), normal);
+			// Directory rename/removal notifications do not enumerate descendants.
+			// Keep ancestor changes so a moved dependency cannot stay reusable.
+			if (!dependency && kind != ChangeKind::Modified) {
+				for (const auto& file : options_.dependencyFiles) {
+					if (!file.empty() && Within(file, normal)) { dependency = true; break; }
+				}
+			}
+			if (!dependency)
+				return;
+		}
+	}
+	if (ini)
+		ini_ = true;
+	// Unknown lost notifications may contain INI changes, so retain reload intent.
+	if (force)
+		ini_ = true;
+	Dirty(now, force);
+}
+bool ChangeReconciler::TrackDependencyFile(const std::wstring& path)
+{
+	// Caller must already resolve the source path; reject noncanonical traversal
+	// lexically so an apparent in-root prefix cannot bypass watch coverage.
+	if (path.empty() || path.size() > 32767 || path.back() == L'/' || path.back() == L'\\')
+		return false;
+	try {
+		const auto normal = Normal(path);
+		const bool absolute = (normal.size() >= 3 && normal[1] == L':' && normal[2] == L'\\') ||
+			(normal.size() > 2 && normal[0] == L'\\' && normal[1] == L'\\');
+		if (!absolute || normal.back() == L'\\' || normal.find(L'\0') != std::wstring::npos)
+			return false;
+		// Plain Windows file paths only: no alternate streams, device namespace,
+		// duplicate separators, or trailing-dot/space aliases to different names.
+		const size_t body = normal[1] == L':' ? 2 : 0;
+		if (normal.find(L':', body) != std::wstring::npos || normal.find_first_of(L"*?<>\"|") != std::wstring::npos)
+			return false;
+		size_t start = 0;
+		while (start < normal.size()) {
+			const auto end = normal.find(L'\\', start);
+			const auto part = normal.substr(start, end == std::wstring::npos ? normal.size() - start : end - start);
+			if (part == L"." || part == L".." || (!part.empty() && (part.back() == L'.' || part.back() == L' ')))
+				return false;
+			if (part.empty() && start > 1)
+				return false;
+			if (end == std::wstring::npos)
+				break;
+			start = end + 1;
+		}
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (cancelled_)
+			return false;
+		bool watched = false;
+		for (const auto& root : roots_)
+			if (Within(normal, root) && normal != root)
+				watched = true;
+		if (!watched)
+			return false;
+		for (const auto& root : excluded_)
+			if (Within(normal, root))
+				return false;
+		if (std::binary_search(options_.excludedSourceFiles.begin(), options_.excludedSourceFiles.end(), normal))
+			return false;
+		auto position = std::lower_bound(options_.dependencyFiles.begin(), options_.dependencyFiles.end(), normal);
+		if (position != options_.dependencyFiles.end() && *position == normal)
+			return true;
+		if (options_.dependencyFiles.size() >= options_.maxDependencyFiles)
+			return false;
+		options_.dependencyFiles.insert(position, normal);
+		return true;
+	} catch (...) {
+		return false;
+	}
+}
+void ChangeReconciler::RequestFullReconcile(uint64_t now)
+{
+	Notify(ChangeKind::Overflow, L"", now);
+}
+bool ChangeReconciler::TakeReady(uint64_t now, ReconcileRequest& request)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (cancelled_)
+		return false;
+	if (options_.periodicReconcileMs && now - lastScan_ >= options_.periodicReconcileMs && !dirty_) {
+		Dirty(now, true);
+		ini_ = true;
+	}
+	if (!dirty_ || (now - last_ < options_.debounceMs && now - first_ < options_.maximumDelayMs))
+		return false;
+	request.token = token_;
+	request.roots = roots_;
+	request.fullReconcile = full_;
+	request.iniChanged = ini_;
+	dirty_ = false;
+	full_ = false;
+	events_ = 0;
+	lastScan_ = now;
+	return true;
+}
+bool ChangeReconciler::IsCurrent(uint64_t token) const
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	return !cancelled_ && token != 0 && token == token_;
+}
+bool ChangeReconciler::CommitIfCurrent(uint64_t token, const std::function<bool()>& publish) noexcept
+{
+	try {
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (cancelled_ || !token || token != token_ || !publish)
+			return false;
+		return publish();
+	} catch (...) {
+		return false;
+	}
+}
+void ChangeReconciler::Cancel()
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	++token_;
+	cancelled_ = true;
+	dirty_ = false;
+}
+std::vector<std::wstring> ChangeReconciler::Roots() const
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	return roots_;
+}
+bool ChangeReconciler::RecordVerifiedDigest(uint64_t token, const std::string& digest, bool verified)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!verified || digest.empty() || cancelled_ || token != token_)
+		return false;
+	verifiedDigest_ = digest;
+	return true;
+}
+}
+
+uint64_t ModLoading::ChangeReconciler::CurrentToken() const
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	return token_;
+}
diff --git a/DirectX11/ModLoading/ChangeReconciler.h b/DirectX11/ModLoading/ChangeReconciler.h
new file mode 100644
index 0000000000000000000000000000000000000000..7d11991c95beb742d308962fb96f502578d75b7d
--- /dev/null
+++ b/DirectX11/ModLoading/ChangeReconciler.h
@@ -0,0 +1,66 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ModLoading {
+enum class ChangeKind { Created, Modified, Deleted, RenamedOld, RenamedNew, Overflow, Unsupported, RootReplaced };
+struct ChangeOptions {
+	size_t maxRoots = 128;
+	size_t maxQueuedEvents = 1024;
+	size_t maxDependencyFiles = 4096; // Dynamic tracking capacity, hard ceiling 65536.
+	uint64_t debounceMs = 150;
+	uint64_t maximumDelayMs = 1500;
+	uint64_t periodicReconcileMs = 0; // Opt in only with a complete config-closure verifier.
+	bool filterDependencies = false;
+	std::vector<std::wstring> dependencyFiles; // Resolved canonical asset files.
+	std::vector<std::wstring> excludedSourceFiles; // Exact runtime-owned output files.
+	bool automaticActivation = false; // Separate opt-in policy; monitor never activates.
+};
+struct ReconcileRequest {
+	uint64_t token = 0;
+	std::vector<std::wstring> roots;
+	bool fullReconcile = false;
+	bool iniChanged = false; // Sticky until SetRoots after legacy reload; never lose cancelled INI intent.
+};
+// Thread-safe notification state. Tick values are monotonic milliseconds.
+// Debounce only reduces work. The consumer must verify the entire dependency
+// closure from stable content snapshots, and use CommitIfCurrent for publication.
+class ChangeReconciler {
+public:
+	explicit ChangeReconciler(ChangeOptions options = ChangeOptions());
+	bool SetRoots(const std::vector<std::wstring>& resolvedRoots,
+				const std::vector<std::wstring>& excludedRoots, uint64_t now);
+	void Notify(ChangeKind kind, const std::wstring& path, uint64_t now);
+	void RequestFullReconcile(uint64_t now);
+	// Worker-only learning of a verified INI dependency inside existing roots.
+	// No IO/restart/token change; false means candidate must fail closed.
+	bool TrackDependencyFile(const std::wstring& resolvedCanonicalFile);
+	bool TakeReady(uint64_t now, ReconcileRequest& request);
+	bool IsCurrent(uint64_t token) const;
+	uint64_t CurrentToken() const;
+	// Serializes only the final pointer publication against Notify/Cancel.
+	// Lock order: caller pending/planner -> reconciler -> publication manager.
+	// Callback must be bounded and must not perform D3D/IO/hash, wait, destroy
+	// resources, call this monitor recursively, or acquire a caller-side lock.
+	// Retire displaced resources after this returns. Failure/exception must
+	// leave the manager unchanged; exceptions return false with the lock freed.
+	bool CommitIfCurrent(uint64_t token, const std::function<bool()>& publish) noexcept;
+	void Cancel();
+	std::vector<std::wstring> Roots() const;
+	// Snapshot digests are computed from verified bytes by the CPU preparation
+	// layer, never timestamps/size. Stale and unverified snapshots are rejected.
+	bool RecordVerifiedDigest(uint64_t token, const std::string& digest, bool closureVerified);
+private:
+	void Dirty(uint64_t now, bool full);
+	ChangeOptions options_;
+	mutable std::mutex mutex_;
+	std::vector<std::wstring> roots_, excluded_;
+	uint64_t token_ = 0, first_ = 0, last_ = 0, lastScan_ = 0;
+	size_t events_ = 0;
+	bool dirty_ = false, full_ = false, ini_ = false, cancelled_ = false;
+	std::string verifiedDigest_;
+};
+}
diff --git a/DirectX11/ModLoading/ConfigCompiler.cpp b/DirectX11/ModLoading/ConfigCompiler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..72b5bd685f893b3e76df2b610de6f5d54f9e99fa
--- /dev/null
+++ b/DirectX11/ModLoading/ConfigCompiler.cpp
@@ -0,0 +1,120 @@
+#include "ConfigCompiler.h"
+#include "IncrementalConfigCache.h"
+#include "SnapshotIO.h"
+#include <exception>
+
+namespace ModLoading {
+namespace {
+void AppendSize(std::vector<uint8_t>& out, uint64_t value) {
+	for (unsigned i = 0; i != 8; ++i) out.push_back(static_cast<uint8_t>(value >> (8 * i)));
+}
+void AppendText(std::vector<uint8_t>& out, const std::wstring& value) {
+	AppendSize(out, value.size());
+	for (auto c : value) {
+		const auto code = static_cast<uint32_t>(c);
+		for (unsigned i = 0; i != 4; ++i) out.push_back(static_cast<uint8_t>(code >> (8 * i)));
+	}
+}
+bool SameSource(const ConfigSource& a, const ConfigSource& b) {
+	return a.snapshot.path == b.snapshot.path && a.iniNamespace == b.iniNamespace &&
+		a.snapshot.digest == b.snapshot.digest && a.snapshot.bytes && b.snapshot.bytes &&
+		*a.snapshot.bytes == *b.snapshot.bytes;
+}
+}
+std::shared_ptr<const CompiledConfig> ConfigCompiler::Build(const ConfigSourceManifest& sources,
+	const std::shared_ptr<const CompiledConfig>& baseline, BuildVersions versions,
+	bool dependencyClosureVerified, bool forceFull) try {
+	auto result = std::make_shared<CompiledConfig>();
+	result->versions = versions;
+	if (sources.reserve) {
+		// Admit identity encoding and dependency graph/workspace allocations
+		// before the cache planner allocates them. Lexical IR owns its separate
+		// reservation; shared immutable snapshot bytes retain their own charge.
+		uint64_t bytes = 65536 + uint64_t(sources.sources.size()) * 4096;
+		for (const auto& source : sources.sources) {
+			if (!source.snapshot.bytes || source.snapshot.bytes->size() > 16 * 1024 * 1024) {
+				result->reason = "Configuration source exceeds compiler bounds";
+				return result;
+			}
+			uint64_t lines = 1;
+			for (auto c : *source.snapshot.bytes) if (c == '\n') ++lines;
+			bytes += uint64_t(source.snapshot.bytes->size()) * 16 + lines * 256 +
+				uint64_t(source.snapshot.path.size() + source.iniNamespace.size()) * sizeof(wchar_t) * 8;
+		}
+		for (const auto& root : sources.recursiveIncludes)
+			bytes += uint64_t(root.size() + 1) * sizeof(wchar_t) * 8;
+		bytes += uint64_t(sources.userConfig.size() + 1) * sizeof(wchar_t) * 8;
+		result->ownership = sources.reserve(bytes);
+		if (!result->ownership) {
+			result->reason = "Configuration compiler CPU admission exhausted";
+			return result;
+		}
+	}
+	result->manifest = sources;
+	std::vector<uint8_t> identity;
+	const auto schema = cache_.Schema();
+	result->parserVersion = schema.parser;
+	result->schemaVersion = schema.schema;
+	result->abiVersion = schema.abi;
+	AppendSize(identity, schema.parser);
+	AppendSize(identity, schema.schema);
+	AppendSize(identity, schema.abi);
+	AppendSize(identity, sources.sources.size());
+	AppendSize(identity, sources.recursiveIncludes.size());
+	for (const auto& root : sources.recursiveIncludes) AppendText(identity, root);
+	AppendText(identity, sources.userConfig);
+	const auto plan = cache_.Plan(sources, baseline, forceFull);
+	result->files = plan.files;
+	result->dependencies = plan.dependencies;
+	result->rebuiltFiles = plan.invalidated;
+	result->parsedFiles = plan.parsedFiles;
+	result->reusedFiles = plan.reusedFiles;
+	result->fullRebuild = plan.fullRebuild;
+	bool valid = plan.valid;
+	bool same = baseline && baseline->manifest.verified &&
+		baseline->manifest.sources.size() == sources.sources.size() &&
+		baseline->manifest.recursiveIncludes == sources.recursiveIncludes &&
+		baseline->manifest.userConfig == sources.userConfig &&
+		baseline->parserVersion == schema.parser && baseline->schemaVersion == schema.schema &&
+		baseline->abiVersion == schema.abi;
+	for (size_t i = 0; i < sources.sources.size(); ++i) {
+		const auto& source = sources.sources[i];
+		const auto& snapshot = source.snapshot;
+		AppendText(identity, snapshot.path);
+		AppendText(identity, source.iniNamespace);
+		AppendSize(identity, snapshot.bytes ? snapshot.bytes->size() : 0);
+		identity.insert(identity.end(), snapshot.digest.begin(), snapshot.digest.end());
+		if (same && !SameSource(source, baseline->manifest.sources[i])) same = false;
+	}
+	result->identity = HashBytes(identity.data(), identity.size());
+	if (!(cache_.Schema() == schema)) valid = false;
+	if (!valid) result->reason = plan.reason.empty() ? "Config schema changed during compilation" : plan.reason;
+	else if (!dependencyClosureVerified) result->reason = "Dependency closure not verified";
+	else if (semanticBuild_) {
+		try {
+			auto semantic = semanticBuild_(*result, baseline);
+			if (semantic.complete && semantic.state && cache_.Schema() == schema) {
+				result->semanticState = std::move(semantic.state);
+				result->disposition = ConfigDisposition::Complete;
+				result->reason = "Detached semantic configuration compiled";
+			} else result->reason = semantic.reason.empty() ? "Detached semantic compilation incomplete" : semantic.reason;
+		} catch (const std::exception& error) {
+			result->reason = std::string("Detached semantic compilation failed: ") + error.what();
+		} catch (...) {
+			result->reason = "Detached semantic compilation failed";
+		}
+	}
+	else if (!baseline) result->reason = "Legacy config baseline; full semantic linker required for config changes";
+	else if (!same) result->reason = "Config changes require legacy reload: globals, initialization, variables, pools and command links are not detached";
+	else {
+		result->disposition = ConfigDisposition::AssetOnly;
+		result->reason = "Exact config identity retained; asset preparation may proceed without config mutation";
+	}
+	return result;
+} catch (const std::bad_alloc&) {
+	auto result = std::make_shared<CompiledConfig>();
+	result->versions = versions;
+	result->reason = "Configuration CPU admission exhausted";
+	return result;
+}
+}
diff --git a/DirectX11/ModLoading/ConfigCompiler.h b/DirectX11/ModLoading/ConfigCompiler.h
new file mode 100644
index 0000000000000000000000000000000000000000..f3b947eaa3bccee250c6ae88e659db30865ee262
--- /dev/null
+++ b/DirectX11/ModLoading/ConfigCompiler.h
@@ -0,0 +1,146 @@
+#pragma once
+#include "PreparedTypes.h"
+#include <string>
+#include <vector>
+#include <functional>
+#include <new>
+#include <utility>
+
+struct ConfigurationState;
+
+namespace ModLoading {
+struct ConfigSource {
+	SourceSnapshot snapshot;
+	std::wstring iniNamespace;
+};
+// Ordered actual parser inputs, including persistent settings. This is not a
+// directory scan: callers must separately prove the dependency closure current.
+struct ConfigSourceManifest {
+	// Reservations precede storage so metadata is destroyed before admission
+	// is returned. Copies allocate metadata independently; snapshot bytes share
+	// their existing charged owner.
+	std::shared_ptr<const void> sharedOwnership, ownership, budgetIdentity;
+	std::function<std::shared_ptr<const void>(uint64_t)> reserve;
+	std::vector<ConfigSource> sources;
+	bool verified = false;
+	// Include roots classify mod key bindings without consulting live globals.
+	std::vector<std::wstring> recursiveIncludes;
+	std::wstring userConfig;
+
+	ConfigSourceManifest() = default;
+	ConfigSourceManifest(const ConfigSourceManifest& other)
+		: sharedOwnership(other.sharedOwnership ? other.sharedOwnership : other.ownership),
+		  ownership(other.ReserveCopy()), budgetIdentity(other.budgetIdentity), reserve(other.reserve),
+		  sources(other.sources), verified(other.verified),
+		  recursiveIncludes(other.recursiveIncludes), userConfig(other.userConfig) {}
+	ConfigSourceManifest(ConfigSourceManifest&&) noexcept = default;
+	ConfigSourceManifest& operator=(ConfigSourceManifest other) noexcept {
+		Swap(other);
+		return *this;
+	}
+	void Swap(ConfigSourceManifest& other) noexcept {
+		sharedOwnership.swap(other.sharedOwnership);
+		ownership.swap(other.ownership);
+		budgetIdentity.swap(other.budgetIdentity);
+		reserve.swap(other.reserve);
+		sources.swap(other.sources);
+		std::swap(verified, other.verified);
+		recursiveIncludes.swap(other.recursiveIncludes);
+		userConfig.swap(other.userConfig);
+	}
+	uint64_t MetadataBytes() const {
+		uint64_t bytes = 65536;
+		if (sources.size() > 4096 || recursiveIncludes.size() > 4096 || userConfig.size() > 32768) return 0;
+		bytes += 16 * (userConfig.size() + 1) * sizeof(wchar_t);
+		for (const auto& root : recursiveIncludes) {
+			if (root.size() > 32768) return 0;
+			bytes += 16 * (sizeof(std::wstring) + (root.size() + 1) * sizeof(wchar_t));
+		}
+		for (const auto& source : sources) {
+			if (source.snapshot.path.size() > 32768 || source.iniNamespace.size() > 32768 ||
+				source.snapshot.compatibilityReason.size() > 65536) return 0;
+			bytes += 16 * (sizeof(ConfigSource) + source.snapshot.compatibilityReason.size() +
+				(source.snapshot.path.size() + source.iniNamespace.size() + 2) * sizeof(wchar_t));
+		}
+		return bytes;
+	}
+private:
+	std::shared_ptr<const void> ReserveCopy() const {
+		if (!reserve) return ownership;
+		const auto bytes = MetadataBytes();
+		auto lease = bytes ? reserve(bytes) : std::shared_ptr<const void>{};
+		if (!lease) throw std::bad_alloc();
+		return lease;
+	}
+};
+struct BuildVersions {
+	uint64_t source = 0, device = 0, runtime = 0;
+	bool operator==(const BuildVersions& o) const {
+		return source == o.source && device == o.device && runtime == o.runtime;
+	}
+};
+struct ConfigPhysicalLineIR {
+	enum class Kind { Empty, Comment, Section, Statement };
+	Kind kind = Kind::Empty;
+	std::string raw, text, section, key, value;
+	bool hasEquals = false;
+	size_t line = 0;
+};
+struct ConfigLineIR {
+	std::string section, key, value, raw;
+	size_t line = 0;
+};
+// Ordered, locale-independent diagnostic lexical IR, NOT a replacement for the legacy
+// expression/command linker. Duplicate lines retain original order.
+struct ConfigFileIR {
+	ConfigFileIR() = default;
+	ConfigFileIR(const ConfigFileIR&) = delete;
+	ConfigFileIR& operator=(const ConfigFileIR&) = delete;
+	std::shared_ptr<const void> ownership, budgetIdentity;
+	SourceDigest digest{};
+	std::vector<ConfigLineIR> lines;
+	std::vector<ConfigPhysicalLineIR> physicalLines;
+	std::vector<std::string> declaredIncludes;
+	bool ambiguousDependencies = false;
+};
+enum class ConfigDisposition { AssetOnly, Complete, CompatibilityOnly };
+struct SemanticCompileResult {
+	// A complete generation owns all raw command/resource/variable references.
+	std::shared_ptr<ConfigurationState> state;
+	std::string reason;
+	bool complete = false;
+};
+struct CompiledConfig;
+using SemanticBuild = std::function<SemanticCompileResult(const CompiledConfig&,
+	const std::shared_ptr<const CompiledConfig>&)>;
+struct CompiledConfig {
+	CompiledConfig() = default;
+	CompiledConfig(const CompiledConfig&) = delete;
+	CompiledConfig& operator=(const CompiledConfig&) = delete;
+	std::shared_ptr<const void> ownership;
+	ConfigSourceManifest manifest;
+	BuildVersions versions;
+	SourceDigest identity{};
+	uint32_t parserVersion = 2, schemaVersion = 2, abiVersion = 2;
+	std::vector<std::shared_ptr<const ConfigFileIR>> files;
+	std::vector<std::vector<size_t>> dependencies;
+	std::vector<size_t> rebuiltFiles;
+	std::shared_ptr<ConfigurationState> semanticState;
+	ConfigDisposition disposition = ConfigDisposition::CompatibilityOnly;
+	std::string reason;
+	size_t parsedFiles = 0, reusedFiles = 0;
+	bool fullRebuild = true;
+};
+class IncrementalConfigCache;
+class ConfigCompiler {
+public:
+	explicit ConfigCompiler(IncrementalConfigCache& cache, SemanticBuild semanticBuild = {})
+		: cache_(cache), semanticBuild_(std::move(semanticBuild)) {}
+	std::shared_ptr<const CompiledConfig> Build(const ConfigSourceManifest& sources,
+		const std::shared_ptr<const CompiledConfig>& baseline,
+		BuildVersions versions, bool dependencyClosureVerified, bool forceFull = false);
+private:
+	IncrementalConfigCache& cache_;
+	SemanticBuild semanticBuild_;
+};
+}
diff --git a/DirectX11/ModLoading/ConfigurationOwnership.h b/DirectX11/ModLoading/ConfigurationOwnership.h
