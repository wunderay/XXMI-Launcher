+                    while (offset + offsetof(FILE_NOTIFY_INFORMATION, FileName) <= bytes) {
+                        const auto* event = reinterpret_cast<const FILE_NOTIFY_INFORMATION*>(ptr->buffer + offset);
+                        const size_t header = offsetof(FILE_NOTIFY_INFORMATION, FileName);
+                        if (event->FileNameLength % sizeof(wchar_t) || header + event->FileNameLength > bytes - offset) {
+                            state.Notify(ChangeKind::Overflow, root.root, Now()); break;
+                        }
+                        const std::wstring path = ptr->directory + (ptr->directory.back() == L'\\' ? L"" : L"\\") + std::wstring(event->FileName, event->FileNameLength / sizeof(wchar_t));
+                        if (parent) {
+                            if (event->Action != FILE_ACTION_MODIFIED && Same(path, root.root)) { replaced = true; state.Notify(ChangeKind::RootReplaced, root.root, Now()); }
+                        } else {
+                            ChangeKind kind = ChangeKind::Modified;
+                            switch (event->Action) {
+                            case FILE_ACTION_ADDED: kind = ChangeKind::Created; break;
+                            case FILE_ACTION_REMOVED: kind = ChangeKind::Deleted; break;
+                            case FILE_ACTION_RENAMED_OLD_NAME: kind = ChangeKind::RenamedOld; break;
+                            case FILE_ACTION_RENAMED_NEW_NAME: kind = ChangeKind::RenamedNew; break;
+                            case FILE_ACTION_MODIFIED: break;
+                            default: kind = ChangeKind::Overflow; break;
+                            }
+                            state.Notify(kind, path, Now());
+                        }
+                        if (!event->NextEntryOffset) break;
+                        if (event->NextEntryOffset < header || event->NextEntryOffset % alignof(DWORD) || event->NextEntryOffset >= bytes - offset) {
+                            state.Notify(ChangeKind::Overflow, root.root, Now()); break;
+                        }
+                        offset += event->NextEntryOffset;
+                    }
+                    if (replaced) CloseWatch(root.tree);
+                    if (!Arm(*ptr)) { state.Notify(ChangeKind::Unsupported, root.root, Now()); CloseWatch(ptr); }
+                }
+            }
+#endif
+            ReconcileRequest request;
+            if (state.TakeReady(Now(), request)) {
+                try { callback(request); } catch (...) { state.RequestFullReconcile(Now()); }
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(25));
+        }
+#ifdef _WIN32
+        for (auto& root : roots) { CloseWatch(root.tree); CloseWatch(root.ancestor); }
+        Reap();
+#endif
+    }
+};
+ChangeMonitor::ChangeMonitor(ChangeOptions options) : impl_(new Impl(options)) {}
+ChangeMonitor::~ChangeMonitor() { Stop(); }
+bool ChangeMonitor::Start(const std::vector<std::wstring>& roots, const std::vector<std::wstring>& excluded, Callback callback) {
+    Stop();
+    if (!callback || !impl_->state.SetRoots(roots, excluded, Now())) return false;
+    impl_->callback = std::move(callback); impl_->stopping.store(false);
+    try { impl_->worker = std::thread([this] { impl_->Run(); }); }
+    catch (...) { impl_->state.Cancel(); return false; }
+    return true;
+}
+void ChangeMonitor::Stop() {
+    impl_->state.Cancel(); impl_->stopping.store(true);
+    if (impl_->worker.joinable()) impl_->worker.join();
+    impl_->callback = Callback();
+}
+bool ChangeMonitor::IsCurrent(uint64_t token) const { return impl_->state.IsCurrent(token); }
+void ChangeMonitor::RequestFullReconcile() { impl_->state.RequestFullReconcile(Now()); }
+void ChangeMonitor::Inject(ChangeKind kind, const std::wstring& path) { impl_->state.Notify(kind, path, Now()); }
+}
diff --git a/DirectX11/ModLoading/ChangeMonitor.h b/DirectX11/ModLoading/ChangeMonitor.h
new file mode 100644
index 0000000000000000000000000000000000000000..88d63c6cd50e39162a15899ab7d49bc24f21e6a9
