+}
+uint64_t EstimateEncodedTextureBytes(const SourceSnapshot& source, GpuPreparationKind kind) {
+    if (!source.bytes) return 0;
+    const auto& b = *source.bytes;
+    const auto le = [&](size_t p) -> uint32_t {
+        if (p > b.size() || b.size() - p < 4) return 0;
+        return uint32_t(b[p]) | uint32_t(b[p + 1]) << 8 | uint32_t(b[p + 2]) << 16 | uint32_t(b[p + 3]) << 24;
+    };
+    const auto be = [&](size_t p) -> uint32_t {
+        if (p > b.size() || b.size() - p < 4) return 0;
+        return uint32_t(b[p]) << 24 | uint32_t(b[p + 1]) << 16 | uint32_t(b[p + 2]) << 8 | uint32_t(b[p + 3]);
+    };
+    uint64_t width = 0, height = 0, depth = 1, arrays = 1, bytesPerPixel = 4, mipCount = 1;
+    DXGI_FORMAT ddsFormat = DXGI_FORMAT_UNKNOWN;
+    if (kind == GpuPreparationKind::EncodedDDS) {
+        if (b.size() < 128 || le(0) != 0x20534444 || le(4) != 124 || le(76) != 32) return 0;
+        width = le(16); height = le(12); depth = (std::max)(1u, le(24));
+        bytesPerPixel = 16; mipCount = (std::max)(1u, le(28));
+        if (mipCount > 15) return 0;
+        if (le(84) == 0x30315844) {
+            if (b.size() < 148) return 0;
+            arrays = le(140); ddsFormat = static_cast<DXGI_FORMAT>(le(128));
+            if (le(136) & 4) arrays *= 6;
+            if (le(132) == 2) height = 1;
+        } else {
+            if (le(112) & 0x200) arrays = 6;
+            switch (le(84)) {
+            case 0x31545844: ddsFormat = DXGI_FORMAT_BC1_UNORM; break; // DXT1
+            case 0x32545844: case 0x33545844: ddsFormat = DXGI_FORMAT_BC2_UNORM; break;
+            case 0x34545844: case 0x35545844: ddsFormat = DXGI_FORMAT_BC3_UNORM; break;
+            case 0x31495441: case 0x55344342: case 0x53344342: ddsFormat = DXGI_FORMAT_BC4_UNORM; break;
+            case 0x32495441: case 0x55354342: case 0x53354342: ddsFormat = DXGI_FORMAT_BC5_UNORM; break;
+            default:
+                if (!(le(80) & 4) && le(88) && le(88) <= 32) bytesPerPixel = (le(88) + 7) / 8;
+                break;
+            }
+        }
+    } else if (kind == GpuPreparationKind::EncodedWIC) {
+        const uint8_t png[] = {137, 80, 78, 71, 13, 10, 26, 10};
+        if (b.size() >= 33 && std::equal(png, png + 8, b.begin()) && be(8) == 13 && be(12) == 0x49484452) {
+            width = be(16); height = be(20); bytesPerPixel = b[24] > 8 ? 8 : 4;
+        } else if (b.size() >= 54 && b[0] == 'B' && b[1] == 'M' && le(14) >= 40) {
+            width = le(18); const uint32_t rawHeight = le(22);
+            height = rawHeight & 0x80000000u ? uint64_t((~rawHeight) + 1u) : rawHeight;
+        } else return 0;
+    } else return 0;
+    if (!width || !height || !depth || !arrays || width > 16384 || height > 16384 || depth > 2048 || arrays > 12288) return 0;
+    uint64_t total = 0;
+    for (uint64_t mip = 0; mip < mipCount; ++mip) {
+        uint64_t row = 0, rows = 0;
+        const uint64_t w = (std::max)(uint64_t(1), width >> mip);
+        const uint64_t h = (std::max)(uint64_t(1), height >> mip);
+        if (!Surface(ddsFormat, UINT(w), UINT(h), row, rows)) { row = w * bytesPerPixel; rows = h; }
+        uint64_t estimate = row;
+        for (const auto factor : {rows, (std::max)(uint64_t(1), depth >> mip), arrays, uint64_t(2)}) {
+            if (factor > (std::numeric_limits<uint64_t>::max)() / estimate) return 0;
+            estimate *= factor;
+        }
+        if (estimate > (std::numeric_limits<uint64_t>::max)() - total) return 0;
+        total += estimate;
+    }
+    // Driver allocations/metadata are estimates, not exact physical residency.
+    return total <= (std::numeric_limits<uint64_t>::max)() - 65536 ? total + 65536 : 0;
+}
+DeviceResourceKey PreparationPlanner::CanonicalKey(const DeviceResourceKey& requestKey, const PreparedGpuObject& object) const {
+    DeviceResourceKey key = requestKey;
+    if (key.effectiveOptions.size() > 3 && !key.effectiveOptions[3] &&
+        key.effectiveOptions[1] != uint32_t(GpuPreparationKind::EncodedDDS) &&
+        key.effectiveOptions[1] != uint32_t(GpuPreparationKind::EncodedWIC)) return key;
+    auto& v = key.effectiveOptions; Append(v, {0x44455343});
+    if (!object.resource) return key;
+    D3D11_RESOURCE_DIMENSION dimension; object.resource->GetType(&dimension); Append(v, {uint32_t(dimension)});
+    // GetType proves the concrete resource interface; these casts preserve COM ownership.
+    switch (dimension) {
+    case D3D11_RESOURCE_DIMENSION_BUFFER: {
+        D3D11_BUFFER_DESC d{}; static_cast<ID3D11Buffer*>(object.resource)->GetDesc(&d);
+        Append(v, {d.ByteWidth, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags, d.StructureByteStride}); break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE1D: {
+        D3D11_TEXTURE1D_DESC d{}; static_cast<ID3D11Texture1D*>(object.resource)->GetDesc(&d);
+        Append(v, {d.Width, d.MipLevels, d.ArraySize, uint32_t(d.Format), uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE2D: {
+        D3D11_TEXTURE2D_DESC d{}; static_cast<ID3D11Texture2D*>(object.resource)->GetDesc(&d);
+        Append(v, {d.Width, d.Height, d.MipLevels, d.ArraySize, uint32_t(d.Format), d.SampleDesc.Count,
+            d.SampleDesc.Quality, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+    }
+    case D3D11_RESOURCE_DIMENSION_TEXTURE3D: {
+        D3D11_TEXTURE3D_DESC d{}; static_cast<ID3D11Texture3D*>(object.resource)->GetDesc(&d);
+        Append(v, {d.Width, d.Height, d.Depth, d.MipLevels, uint32_t(d.Format), uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags}); break;
+    }
+    default: break;
+    }
+    if (object.shaderResourceView) { D3D11_SHADER_RESOURCE_VIEW_DESC d{}; object.shaderResourceView->GetDesc(&d); AppendView(v, d); }
+    return key;
+}
+uint64_t SharedShaderBytecode::LiveRetainedBytes() { return BytecodeRegistry().liveBytes.load(std::memory_order_relaxed); }
+SharedShaderBytecode SharedShaderBytecode::Retain(ID3DBlob* blob, const SourceDigest& digest, uint64_t maximumRetainedBytes) {
+    SharedShaderBytecode result;
+    if (!maximumRetainedBytes || !blob || !blob->GetBufferPointer() || !blob->GetBufferSize()) return result;
+    auto& registry = BytecodeRegistry();
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    // Weak entries retain neither the blob nor its charge. Clean them before
+    // admission so repeated F10 generations cannot grow the index unboundedly.
+    for (auto it = registry.owners.begin(); it != registry.owners.end();)
+        if (it->second.owner.expired()) it = registry.owners.erase(it); else ++it;
+    const size_t bytes = blob->GetBufferSize();
+    auto existing = registry.owners.find(blob);
+    if (existing != registry.owners.end()) {
+        if (existing->second.bytes != bytes || existing->second.digest != digest) return result;
+        result.owner_ = existing->second.owner.lock();
+        if (!result.owner_) return result;
+    } else {
+        if (registry.owners.size() >= 4096 || bytes > maximumRetainedBytes) return result;
+        auto live = registry.liveBytes.load(std::memory_order_relaxed);
+        do {
+            if (live > maximumRetainedBytes - bytes) return result;
+        } while (!registry.liveBytes.compare_exchange_weak(live, live + bytes, std::memory_order_relaxed));
+        blob->AddRef();
+        // No registry mutex in the deleter: control-block/map allocation may
+        // fail while admission holds that mutex. Final release decrements only
+        // after the compiled blob's own Release returns.
+        auto* accounting = &registry;
+        result.owner_ = std::shared_ptr<ID3DBlob>(blob, [accounting, bytes](ID3DBlob* retained) {
+            retained->Release(); accounting->liveBytes.fetch_sub(bytes, std::memory_order_relaxed);
+        });
+        registry.owners.emplace(blob, ShaderBytecodeRegistry::Entry{result.owner_, digest, bytes});
+    }
+    result.data_ = static_cast<const uint8_t*>(blob->GetBufferPointer()); result.size_ = bytes; result.digest_ = digest;
+    return result;
+}
+PreparedShaderBundle::~PreparedShaderBundle() {
+    for (auto* child : {static_cast<ID3D11DeviceChild*>(vertex), static_cast<ID3D11DeviceChild*>(hull),
+        static_cast<ID3D11DeviceChild*>(domain), static_cast<ID3D11DeviceChild*>(geometry),
+        static_cast<ID3D11DeviceChild*>(pixel), static_cast<ID3D11DeviceChild*>(compute),
+        static_cast<ID3D11DeviceChild*>(blend), static_cast<ID3D11DeviceChild*>(depthStencil),
+        static_cast<ID3D11DeviceChild*>(rasterizer), static_cast<ID3D11DeviceChild*>(sampler)})
+        if (child) child->Release();
+}
+PreparedGpuObject::~PreparedGpuObject() {
+    if (shaderResourceView) shaderResourceView->Release();
+    if (shader) shader->Release();
+    if (resource) resource->Release();
+}
+PreparationPlanner::PreparationPlanner(uint64_t cacheBytes, size_t maxQueued, uint64_t maxRetainedShaderBytecodeBytes)
+    : cache_(cacheBytes), maxQueued_((std::min)(size_t(4096), maxQueued)), maxShaderBytecodeBytes_(maxRetainedShaderBytecodeBytes), enabled_(cacheBytes != 0) {}
+PreparationPlanner::~PreparationPlanner() { RetireDevice(); }
+bool PreparationPlanner::OnOwner() const { return owner_ == std::this_thread::get_id(); }
+bool PreparationPlanner::BeginDevice(ID3D11Device* device, DeviceEpoch epoch) {
+    if (!device || !epoch || (device_ && !OnOwner())) return false;
+    if (device_ == device && cache_.Epoch() == epoch) return true;
+    RetireDevice(); owner_ = std::this_thread::get_id(); device_ = device; cache_.BeginEpoch(epoch);
+    singleThreaded_ = (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED) != 0;
+    D3D11_FEATURE_DATA_THREADING threading{};
+    concurrentCreates_ = SUCCEEDED(device->CheckFeatureSupport(D3D11_FEATURE_THREADING, &threading, sizeof(threading))) && threading.DriverConcurrentCreates;
+    return true;
+}
+void PreparationPlanner::RetireDevice() {
+    queue_.clear(); resolvedKeys_.clear(); failedKeys_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0; budget_ = MemoryBudgetController(128ull * 1024 * 1024, safetyHeadroom_);
+    cache_.BeginEpoch(0); device_ = nullptr; singleThreaded_ = false; concurrentCreates_ = false;
+}
+void PreparationPlanner::SetSafetyHeadroom(uint64_t bytes) {
+    if (device_ && !OnOwner()) return;
+    // Existing queue reservations are preserved by re-reserving their estimates.
+    safetyHeadroom_ = bytes; budget_ = MemoryBudgetController(128ull * 1024 * 1024, bytes);
+    budget_.Update(QueryBudget());
+    for (const auto& entry : queue_)
+        if (!budget_.Reserve({entry.request.estimatedBytes, entry.request.pendingGenerationOverlap})) {
+            queue_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0; budget_ = MemoryBudgetController(128ull * 1024 * 1024, bytes); break;
+        }
+}
+bool PreparationPlanner::MakeKey(const GpuPreparationRequest& r, DeviceResourceKey& key) const {
+    if (!r.dependencyReadOnly || !r.estimatedBytes || (r.createShaderResourceView && r.createDefaultShaderResourceView)) return false;
+    const bool bundle = r.kind == GpuPreparationKind::ShaderBundle;
+    const bool shader = r.kind >= GpuPreparationKind::VertexShader && r.kind <= GpuPreparationKind::ComputeShader;
+    if (bundle) {
+        if (!r.shaderBundle || r.shaderBytecode || r.createShaderResourceView || r.createDefaultShaderResourceView || !r.subresources.empty()) return false;
+    } else if (shader && r.shaderBytecode) {
+        if (r.snapshot.bytes || r.shaderBundle) return false;
+    } else if (!r.snapshot.bytes || r.snapshot.bytes->empty() || r.shaderBundle || r.shaderBytecode) return false;
+    key.digest = bundle ? SourceDigest{} : r.shaderBytecode ? r.shaderBytecode.Digest() : r.snapshot.digest;
+    key.epoch = cache_.Epoch();
+    auto& v = key.effectiveOptions;
+    Append(v, {2, uint32_t(r.kind), uint32_t(r.createShaderResourceView), uint32_t(r.createDefaultShaderResourceView), uint32_t(r.creationOptions.size())});
+    v.insert(v.end(), r.creationOptions.begin(), r.creationOptions.end());
+    if (bundle) return AppendBundle(v, *r.shaderBundle, r.estimatedBytes);
+    if (r.kind == GpuPreparationKind::Buffer) {
+        const auto& d = r.buffer;
+        if (!d.ByteWidth || !ReadOnly(d.BindFlags, d.CPUAccessFlags, d.Usage, d.MiscFlags) ||
+            (d.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE) || r.estimatedBytes < d.ByteWidth) return false;
+        Append(v, {d.ByteWidth, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags, d.StructureByteStride});
+    } else if (r.kind == GpuPreparationKind::Texture2D) {
+        const auto& d = r.texture;
+        if (!d.Width || !d.Height || !d.ArraySize || !d.MipLevels || d.MipLevels > 15 ||
+            d.Width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION || d.Height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            d.ArraySize > D3D11_REQ_TEXTURE2D_ARRAY_AXIS_DIMENSION ||
+            d.SampleDesc.Count != 1 || d.SampleDesc.Quality ||
+            d.BindFlags != D3D11_BIND_SHADER_RESOURCE || !ReadOnly(d.BindFlags, d.CPUAccessFlags, d.Usage, d.MiscFlags) ||
+            (d.MiscFlags & ~UINT(D3D11_RESOURCE_MISC_TEXTURECUBE)) ||
+            r.subresources.size() != uint64_t(d.MipLevels) * d.ArraySize) return false;
+        uint64_t total = 0;
+        for (size_t i = 0; i < r.subresources.size(); ++i) {
+            const auto& s = r.subresources[i]; uint64_t row = 0, rows = 0;
+            const UINT mip = UINT(i % d.MipLevels);
+            if (!Surface(d.Format, (std::max)(1u, d.Width >> mip), (std::max)(1u, d.Height >> mip), row, rows) ||
+                s.rowPitch < row || s.bytes < uint64_t(s.rowPitch) * (rows - 1) + row ||
+                s.offset > r.snapshot.bytes->size() || s.bytes > r.snapshot.bytes->size() - s.offset) return false;
+            if (s.bytes > (std::numeric_limits<uint64_t>::max)() - total) return false;
+            total += s.bytes;
+            Append(v, {uint32_t(s.offset), uint32_t(s.offset >> 32), uint32_t(s.bytes), uint32_t(s.bytes >> 32), s.rowPitch, s.slicePitch});
+        }
+        if (r.estimatedBytes < total) return false;
+        Append(v, {d.Width, d.Height, d.MipLevels, d.ArraySize, uint32_t(d.Format), d.SampleDesc.Count,
+            d.SampleDesc.Quality, uint32_t(d.Usage), d.BindFlags, d.CPUAccessFlags, d.MiscFlags});
+    } else if (r.kind == GpuPreparationKind::EncodedDDS || r.kind == GpuPreparationKind::EncodedWIC) {
+        const uint64_t required = EstimateEncodedTextureBytes(r.snapshot, r.kind);
+        if (!required || r.estimatedBytes < required ||
+            !ReadOnly(r.loaderBindFlags, 0, D3D11_USAGE_DEFAULT, r.loaderMiscFlags) ||
+            r.loaderBindFlags != D3D11_BIND_SHADER_RESOURCE || (r.wicLoaderFlags & ~3u) ||
+            (r.loaderMiscFlags & ~UINT(D3D11_RESOURCE_MISC_TEXTURECUBE)) || !r.subresources.empty()) return false;
+        Append(v, {r.loaderBindFlags, r.loaderMiscFlags, r.wicLoaderFlags, uint32_t(r.forceSRGB),
+            uint32_t(r.maxTextureSize), uint32_t(uint64_t(r.maxTextureSize) >> 32)});
+    } else {
+        const auto codeBytes = r.shaderBytecode ? r.shaderBytecode.Size() : r.snapshot.bytes->size();
+        if (!shader || r.estimatedBytes < codeBytes || r.createShaderResourceView || r.createDefaultShaderResourceView || !r.subresources.empty()) return false;
+    }
+    return !r.createShaderResourceView || AppendView(v, r.shaderResourceView);
+}
+VideoMemorySample PreparationPlanner::QueryBudget() const {
+    VideoMemorySample sample; sample.currentUsage = ProcessGpuAllocationLedger().Bytes();
+    if (!device_) return sample;
+    IDXGIDevice* dxgiDevice = nullptr; IDXGIAdapter* adapter = nullptr; IDXGIAdapter3* adapter3 = nullptr;
+    if (SUCCEEDED(device_->QueryInterface(__uuidof(IDXGIDevice), reinterpret_cast<void**>(&dxgiDevice)))) {
+        if (SUCCEEDED(dxgiDevice->GetAdapter(&adapter)) &&
+            SUCCEEDED(adapter->QueryInterface(__uuidof(IDXGIAdapter3), reinterpret_cast<void**>(&adapter3)))) {
+            DXGI_QUERY_VIDEO_MEMORY_INFO local{}, nonlocal{};
+            if (SUCCEEDED(adapter3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local))) {
+                sample.available = true; sample.budget = local.Budget; sample.currentUsage = local.CurrentUsage;
+                // Never count nonlocal allowance as extra local VRAM. If paging
+                // already exceeds the process' nonlocal budget, stop speculation.
+                if (SUCCEEDED(adapter3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal)) &&
+                    nonlocal.CurrentUsage > nonlocal.Budget) sample.budget = 0;
+            }
+        }
+    }
+    if (adapter3) adapter3->Release(); if (adapter) adapter->Release(); if (dxgiDevice) dxgiDevice->Release();
+    return sample;
+}
+bool PreparationPlanner::ComputeKey(const GpuPreparationRequest& request, DeviceResourceKey& key) const {
+    if (!enabled_ || !device_ || !OnOwner() || !cache_.Epoch() || request.estimatedBytes > cache_.CapacityBytes()) return false;
+    DeviceResourceKey candidate;
+    if (!MakeKey(request, candidate)) return false;
+    key = std::move(candidate); return true;
+}
+GpuQueueResult PreparationPlanner::Enqueue(const GpuPreparationRequest& request, DeviceResourceKey* key) {
+    if (!enabled_) return GpuQueueResult::CompatibilityOnly;
+    if (!device_ || !cache_.Epoch()) return GpuQueueResult::WrongDevice;
+    if (!OnOwner()) return GpuQueueResult::WrongThread;
+    DeviceResourceKey candidate;
+    if (request.estimatedBytes > cache_.CapacityBytes() || !MakeKey(request, candidate)) return GpuQueueResult::CompatibilityOnly;
+    if (key) *key = candidate;
+    if (TryAcquire(candidate)) return GpuQueueResult::AlreadyReady;
+    if (failedKeys_.find(candidate) != failedKeys_.end()) return GpuQueueResult::CompatibilityOnly;
+    for (const auto& pending : queue_)
+        if (!(candidate < pending.key) && !(pending.key < candidate)) return GpuQueueResult::Queued;
+    // Saturation disables new speculative keys for this epoch rather than
+    // evicting failure knowledge and retrying unsupported creations forever.
+    if (failedKeys_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) return GpuQueueResult::CompatibilityOnly;
+    if (queue_.size() >= maxQueued_) return GpuQueueResult::Full;
+    const auto retainedShaderBytes = RetainedShaderBytecodeBytes(request);
+    if (retainedShaderBytes > maxShaderBytecodeBytes_ - queuedShaderBytecodeBytes_) return GpuQueueResult::BudgetBlocked;
+    if ((request.kind == GpuPreparationKind::EncodedDDS || request.kind == GpuPreparationKind::EncodedWIC || request.createDefaultShaderResourceView) &&
+        resolvedKeys_.size() + queue_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) {
+        for (auto alias = resolvedKeys_.begin(); alias != resolvedKeys_.end();) {
+            if (!cache_.Find(alias->second)) alias = resolvedKeys_.erase(alias); else ++alias;
+        }
+        if (resolvedKeys_.size() + queue_.size() >= (std::max)(size_t(1), maxQueued_ * 4)) return GpuQueueResult::Full;
+    }
+    budget_.Update(QueryBudget());
+    if (!budget_.Reserve({request.estimatedBytes, request.pendingGenerationOverlap})) {
+        cache_.EvictInactive(request.estimatedBytes); budget_.Update(QueryBudget());
+        if (!budget_.Reserve({request.estimatedBytes, request.pendingGenerationOverlap})) return GpuQueueResult::BudgetBlocked;
+    }
+    try { queue_.push_back({request, std::move(candidate)}); }
+    catch (...) { budget_.Complete(request.estimatedBytes + request.pendingGenerationOverlap); throw; }
+    queuedBytes_ += request.estimatedBytes; queuedShaderBytecodeBytes_ += retainedShaderBytes;
+    return GpuQueueResult::Queued;
+}
+std::shared_ptr<PreparedGpuObject> PreparationPlanner::Create(const GpuPreparationRequest& r, HRESULT& hr) {
+    auto result = std::make_shared<PreparedGpuObject>(); hr = E_INVALIDARG;
+    const auto* bytes = r.shaderBytecode ? r.shaderBytecode.Data() : r.snapshot.bytes ? r.snapshot.bytes->data() : nullptr;
+    const size_t byteCount = r.shaderBytecode ? r.shaderBytecode.Size() : r.snapshot.bytes ? r.snapshot.bytes->size() : 0;
+    ScopedLoadTrace trace(LoadStage::GpuCreation); trace.SetBytes(r.estimatedBytes);
+    switch (r.kind) {
+    case GpuPreparationKind::Buffer: {
+        std::vector<uint8_t> padded(r.buffer.ByteWidth, 0);
+        std::memcpy(padded.data(), bytes, (std::min)(padded.size(), byteCount));
+        D3D11_SUBRESOURCE_DATA initial{}; initial.pSysMem = padded.data(); ID3D11Buffer* buffer = nullptr;
+        hr = device_->CreateBuffer(&r.buffer, &initial, &buffer); result->resource = buffer; break;
+    }
+    case GpuPreparationKind::EncodedDDS:
+        hr = DirectX::CreateDDSTextureFromMemoryEx(device_, bytes, byteCount, r.maxTextureSize,
+            D3D11_USAGE_DEFAULT, r.loaderBindFlags, 0, r.loaderMiscFlags, r.forceSRGB, &result->resource, nullptr);
+        break;
+    case GpuPreparationKind::EncodedWIC:
+        hr = DirectX::CreateWICTextureFromMemoryEx(device_, bytes, byteCount, r.maxTextureSize,
+            D3D11_USAGE_DEFAULT, r.loaderBindFlags, 0, r.loaderMiscFlags, r.wicLoaderFlags, &result->resource, nullptr);
+        break;
+    case GpuPreparationKind::Texture2D: {
+        std::vector<D3D11_SUBRESOURCE_DATA> initial(r.subresources.size());
+        for (size_t i = 0; i < initial.size(); ++i) {
+            initial[i].pSysMem = bytes + r.subresources[i].offset;
+            initial[i].SysMemPitch = r.subresources[i].rowPitch; initial[i].SysMemSlicePitch = r.subresources[i].slicePitch;
+        }
+        ID3D11Texture2D* texture = nullptr;
+        hr = device_->CreateTexture2D(&r.texture, initial.data(), &texture); result->resource = texture; break;
+    }
+    case GpuPreparationKind::ShaderBundle: {
+        result->bundle = std::make_shared<PreparedShaderBundle>();
+        const auto& input = *r.shaderBundle; auto& output = *result->bundle; hr = S_OK;
+#define PREPARE_BUNDLE_STAGE(Index, Member, Method) if (SUCCEEDED(hr) && input.stages[Index]) hr = device_->Method(input.stages[Index].Data(), input.stages[Index].Size(), nullptr, &output.Member);
+        PREPARE_BUNDLE_STAGE(0, vertex, CreateVertexShader)
+        PREPARE_BUNDLE_STAGE(1, hull, CreateHullShader)
+        PREPARE_BUNDLE_STAGE(2, domain, CreateDomainShader)
+        PREPARE_BUNDLE_STAGE(3, geometry, CreateGeometryShader)
+        PREPARE_BUNDLE_STAGE(4, pixel, CreatePixelShader)
+        PREPARE_BUNDLE_STAGE(5, compute, CreateComputeShader)
+#undef PREPARE_BUNDLE_STAGE
+        if (SUCCEEDED(hr) && input.createBlendState) hr = device_->CreateBlendState(&input.blend, &output.blend);
+        if (SUCCEEDED(hr) && input.createDepthStencilState) hr = device_->CreateDepthStencilState(&input.depthStencil, &output.depthStencil);
+        if (SUCCEEDED(hr) && input.createRasterizerState) hr = device_->CreateRasterizerState(&input.rasterizer, &output.rasterizer);
+        if (SUCCEEDED(hr) && input.createSamplerState) hr = device_->CreateSamplerState(&input.sampler, &output.sampler);
+        break;
+    }
+#define PREPARE_SHADER(Kind, Type, Method) case GpuPreparationKind::Kind: { Type* shader = nullptr; hr = device_->Method(bytes, byteCount, nullptr, &shader); result->shader = shader; break; }
+    PREPARE_SHADER(VertexShader, ID3D11VertexShader, CreateVertexShader)
+    PREPARE_SHADER(PixelShader, ID3D11PixelShader, CreatePixelShader)
+    PREPARE_SHADER(GeometryShader, ID3D11GeometryShader, CreateGeometryShader)
+    PREPARE_SHADER(HullShader, ID3D11HullShader, CreateHullShader)
+    PREPARE_SHADER(DomainShader, ID3D11DomainShader, CreateDomainShader)
+    PREPARE_SHADER(ComputeShader, ID3D11ComputeShader, CreateComputeShader)
+#undef PREPARE_SHADER
+    }
+    trace.SetResult(hr);
+    if (SUCCEEDED(hr) && (r.createShaderResourceView || r.createDefaultShaderResourceView)) {
+        ScopedLoadTrace viewTrace(LoadStage::ViewCreation);
+        hr = device_->CreateShaderResourceView(result->resource, r.createDefaultShaderResourceView ? nullptr : &r.shaderResourceView, &result->shaderResourceView);
+        viewTrace.SetResult(hr);
+    }
+    if (SUCCEEDED(hr)) {
+        std::array<ID3D11DeviceChild*, 12> children{};
+        children[0] = result->resource; children[1] = result->shader;
+        if (result->bundle) {
+            const auto& b = *result->bundle;
+            children[2] = b.vertex; children[3] = b.hull; children[4] = b.domain; children[5] = b.geometry;
+            children[6] = b.pixel; children[7] = b.compute; children[8] = b.blend;
+            children[9] = b.depthStencil; children[10] = b.rasterizer; children[11] = b.sampler;
+        }
+        // An intentional null-only stage bundle has no GPU allocation to track.
+        const bool hasAllocation = std::any_of(children.begin(), children.end(), [](ID3D11DeviceChild* child) { return child != nullptr; });
+        if (hasAllocation) {
+            result->allocationEstimate = ProcessGpuAllocationLedger().Track(r.estimatedBytes);
+            if (!result->allocationEstimate) hr = E_OUTOFMEMORY;
+            else {
+                auto* attachment = new AllocationEstimateAttachment(result->allocationEstimate);
+                for (auto* child : children) {
+                    if (child && SUCCEEDED(hr)) hr = child->SetPrivateDataInterface(AllocationEstimateGuid, attachment);
+                }
+                attachment->Release();
+            }
+        }
+    }
+    return SUCCEEDED(hr) ? result : nullptr;
+}
+GpuPumpResult PreparationPlanner::Pump(bool knownLoadingWindow, GpuPumpLimits limits) {
+    GpuPumpResult result;
+    if (!enabled_ || !device_ || !OnOwner() || !knownLoadingWindow || !limits.operations || !limits.bytes || !(limits.milliseconds > 0)) return result;
+    const auto start = std::chrono::steady_clock::now(); uint64_t processedBytes = 0;
+    while (!queue_.empty() && result.created + result.failed + result.compatibilitySkipped < limits.operations) {
+        const auto& next = queue_.front();
+        if (next.request.estimatedBytes > limits.bytes) {
+            budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+            queuedBytes_ -= next.request.estimatedBytes;
+            queuedShaderBytecodeBytes_ -= RetainedShaderBytecodeBytes(next.request);
+            queue_.pop_front(); ++result.compatibilitySkipped;
+            continue;
+        }
+        if (next.request.estimatedBytes > limits.bytes - processedBytes ||
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count() >= limits.milliseconds) break;
+        // Recheck process budget at execution, excluding this request's own
+        // reservation. Queue estimates are not a promise of driver residency.
+        budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+        budget_.Update(QueryBudget());
+        if (!budget_.Reserve({next.request.estimatedBytes, next.request.pendingGenerationOverlap})) {
+            // Pressure invalidates speculative reservations; retain CPU sources
+            // in the CPU cache and let the runtime count a preparation miss.
+            queue_.clear(); queuedBytes_ = 0; queuedShaderBytecodeBytes_ = 0;
+            budget_ = MemoryBudgetController(128ull * 1024 * 1024, safetyHeadroom_); break;
+        }
+        // Make space before driver allocation, preserving active leases. A
+        // configured cache cap includes the pending allocation's peak estimate.
+        if (!cache_.MakeRoom(next.request.estimatedBytes)) {
+            budget_.Complete(next.request.estimatedBytes + next.request.pendingGenerationOverlap);
+            queuedBytes_ -= next.request.estimatedBytes;
+            queuedShaderBytecodeBytes_ -= RetainedShaderBytecodeBytes(next.request);
+            queue_.pop_front(); ++result.compatibilitySkipped;
+            continue;
+        }
+        auto work = std::move(queue_.front()); queue_.pop_front();
+        processedBytes += work.request.estimatedBytes; queuedBytes_ -= work.request.estimatedBytes;
+        struct ReservationCompletion {
+            MemoryBudgetController& budget;
+            uint64_t bytes;
+            uint64_t& retainedShaderBytes;
+            uint64_t requestShaderBytes;
+            ~ReservationCompletion() {
+                budget.Complete(bytes);
+                retainedShaderBytes = retainedShaderBytes >= requestShaderBytes ? retainedShaderBytes - requestShaderBytes : 0;
+            }
+        } completion{budget_, work.request.estimatedBytes + work.request.pendingGenerationOverlap,
+            queuedShaderBytecodeBytes_, RetainedShaderBytecodeBytes(work.request)};
+        HRESULT hr = E_FAIL; auto object = Create(work.request, hr);
+        if (object) {
+            const auto canonical = CanonicalKey(work.key, *object);
+            if (cache_.Insert(canonical, std::move(object), work.request.estimatedBytes)) {
+                // Never discard an active alias: it is also the handle needed
+                // to release a policy pin. Admission bounds the alias index.
+                if (canonical < work.key || work.key < canonical) resolvedKeys_[work.key] = canonical;
+                ++result.created;
+            } else ++result.failed;
+        } else {
+            ++result.failed;
+            if (FAILED(hr) && hr != E_OUTOFMEMORY && hr != E_PENDING &&
+                hr != DXGI_ERROR_DEVICE_REMOVED && hr != DXGI_ERROR_DEVICE_RESET && hr != DXGI_ERROR_DEVICE_HUNG &&
+                hr != DXGI_ERROR_WAS_STILL_DRAWING && failedKeys_.size() < (std::max)(size_t(1), maxQueued_ * 4))
+                failedKeys_.insert(work.key);
+        }
+        if (hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET || FAILED(device_->GetDeviceRemovedReason())) {
+            result.deviceRemoved = true; RetireDevice(); break;
+        }
+    }
+    return result;
+}
+bool PreparationPlanner::Protect(const DeviceResourceKey& key) {
+    if (!device_ || !OnOwner()) return false;
+    const auto resolved = resolvedKeys_.find(key);
+    return cache_.Protect(resolved == resolvedKeys_.end() ? key : resolved->second);
+}
+void PreparationPlanner::Unprotect(const DeviceResourceKey& key) {
+    if (!device_ || !OnOwner()) return;
+    const auto resolved = resolvedKeys_.find(key);
+    cache_.Unprotect(resolved == resolvedKeys_.end() ? key : resolved->second);
+}
+std::shared_ptr<PreparedGpuObject> PreparationPlanner::TryAcquire(const DeviceResourceKey& key) {
+    if (!device_ || !OnOwner()) return {};
+    auto resolved = resolvedKeys_.find(key);
+    auto object = cache_.Find(resolved == resolvedKeys_.end() ? key : resolved->second);
+    if (!object && resolved != resolvedKeys_.end()) resolvedKeys_.erase(resolved);
+    return std::static_pointer_cast<PreparedGpuObject>(object);
+}
+}
