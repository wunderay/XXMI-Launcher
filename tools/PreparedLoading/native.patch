+	ResourceRefreshPin generation;
+	DeviceResourceKey key;
+	ID3D11Query* retirementQuery = nullptr;
+	~PendingRefresh() { if (retirementQuery) retirementQuery->Release(); }
+};
+// The DLL's process-lifetime services deliberately have no static destructors
+// that join Windows workers while DllMain holds the loader lock.
+struct RuntimeServices {
+	std::shared_ptr<RuntimeState> state;
+	std::atomic<Generation> nextGeneration{0};
+	std::atomic<uint64_t> legacyConfigEpoch{0};
+	ResourceRefreshManager refreshManager;
+	std::shared_ptr<LiveGpuAllocationLedger> refreshGpuBudget = std::make_shared<LiveGpuAllocationLedger>();
+	std::shared_ptr<ResourceRefreshCpuBudget> generalCpuBudget = std::make_shared<ResourceRefreshCpuBudget>(0);
+	std::shared_ptr<LiveGpuAllocationLedger> generalGpuBudget = std::make_shared<LiveGpuAllocationLedger>();
+	GeneralBuildWorker* generalWorker = nullptr;
+	std::shared_ptr<GeneralBuildResult> pendingGeneral;
+	std::shared_ptr<ResourceRefreshCpuBudget> refreshCpuBudget = std::make_shared<ResourceRefreshCpuBudget>(0);
+	ResourceRefreshActivationEdge refreshActivation;
+	RefreshBuildWorker* refreshWorker = nullptr;
+	std::shared_ptr<PendingRefresh> pendingRefresh;
+	std::unique_ptr<PreparationPlanner> refreshPlanner;
+	std::map<uint64_t, std::shared_ptr<ID3D11Query>> refreshRetirement;
+	struct GraphRetirement {
+		std::shared_ptr<ConfigGenerationPin> graph;
+		std::shared_ptr<ID3D11Query> query;
+		ID3D11Device* device = nullptr;
+		std::thread::id owner;
+		bool reserved = false, submitted = false, singleThreaded = false;
+	};
+	std::mutex graphRetirementMutex;
+	std::array<GraphRetirement, 8> graphRetirement;
+	std::shared_ptr<PreparationScheduler> scheduler;
+	bool modulePinned = false;
+	std::unique_ptr<PreparationPlanner> planner;
+	ID3D11Device* device = nullptr;
+	DeviceEpoch epoch = 0;
+	std::thread::id owner;
+	Generation plannerGeneration = 0;
+	IncrementalConfigCache configCache;
+	std::recursive_mutex plannerMutex;
+	std::atomic<bool> retirementRequested{false};
+	std::map<ID3D11Resource*, std::weak_ptr<PreparedGpuObject>> activeResources;
+	// Strong speculative profile leases share the planner's retirement lock.
+	// Config/profile entries hold weak references, so device teardown drops all
+	// unconsumed GPU owners without touching the raw configuration graph.
+	std::map<const void*, std::shared_ptr<PreparedGpuObject>> profileGpuPins;
+};
+RuntimeServices& Services() { static auto* s = new RuntimeServices; return *s; }
+std::shared_ptr<RuntimeState> Current() { return std::atomic_load(&Services().state); }
+thread_local bool runtimeBusy = false;
+thread_local bool retiringDevice = false;
+struct TryGlobalConfigGuard {
+	bool acquired;
+	explicit TryGlobalConfigGuard(bool enter = true) : acquired(enter && TryEnterCriticalSection(&G->mCriticalSection) != FALSE) {}
+	~TryGlobalConfigGuard() { if (acquired) LeaveCriticalSection(&G->mCriticalSection); }
+};
+struct RuntimeOwnerScope {
+	std::unique_lock<std::recursive_mutex>& lock;
+	explicit RuntimeOwnerScope(std::unique_lock<std::recursive_mutex>& held) : lock(held) { runtimeBusy = true; }
+	~RuntimeOwnerScope() {
+		runtimeBusy = false;
+		auto& service = Services();
+		if (service.retirementRequested.exchange(false)) {
+			InvalidatePreparationStatus();
+			// Resource destructors may call wrapped device Release recursively.
+			retiringDevice = true;
+			service.activeResources.clear();
+			service.profileGpuPins.clear();
+			service.refreshActivation.SetReady(0);
+			service.pendingRefresh.reset();
+			service.refreshPlanner.reset();
+			service.pendingGeneral.reset();
+			auto retired = std::move(service.planner);
+			service.device = nullptr;
+			service.epoch = 0;
+			service.plannerGeneration = 0;
+			retired.reset();
+			retiringDevice = false;
+		}
+		// A foreign Release may request retirement after the final exchange
+		// but before mutex unlock. Requests are stored before try_lock, so
+		// checking again after unlock closes that handoff window.
+		ID3D11Device* const device = service.device;
+		lock.unlock();
+		if (service.retirementRequested.load()) RetireRuntimeDevice(device);
+	}
+};
+int Setting(const wchar_t* key, int fallback, int low, int high) {
+	return (std::max)(low, (std::min)(high, GetIniInt(L"ModLoading", key, fallback, nullptr)));
+}
+std::wstring Canonical(const std::wstring& path) {
+	if (path.empty()) return {};
+	const DWORD length = GetFullPathNameW(path.c_str(), 0, nullptr, nullptr);
+	if (!length || length > 32767) return {};
+	std::vector<wchar_t> full(length);
+	const DWORD written = GetFullPathNameW(path.c_str(), length, full.data(), nullptr);
+	if (!written || written >= length) return {};
+	return std::wstring(full.data(), written);
+}
+std::wstring Parent(const std::wstring& path) {
+	const auto slash = path.find_last_of(L"\\/");
+	return slash == std::wstring::npos ? std::wstring() : path.substr(0, slash + 1);
+}
+std::wstring OwnOutputDirectory() {
+	static int moduleAnchor;
+	HMODULE module = nullptr;
+	if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		reinterpret_cast<LPCWSTR>(&moduleAnchor), &module)) return {};
+	std::vector<wchar_t> path(32768);
+	const DWORD count = GetModuleFileNameW(module, path.data(), DWORD(path.size()));
+	if (!count || count >= path.size()) return {};
+	return Parent(std::wstring(path.data(), count)) + L".xxmi-preparation\\";
+}
+bool IsBuffer(const CustomResource& resource) {
+	return resource.override_type == CustomResourceType::BUFFER ||
+		resource.override_type == CustomResourceType::STRUCTURED_BUFFER ||
+		resource.override_type == CustomResourceType::RAW_BUFFER;
+}
+bool IsDDS(const std::wstring& path) {
+	const auto dot = path.find_last_of(L'.');
+	return dot != std::wstring::npos && !_wcsicmp(path.c_str() + dot, L".dds");
+}
+DXGI_FORMAT SRGB(DXGI_FORMAT format) {
+	switch (format) {
+	case DXGI_FORMAT_R8G8B8A8_UNORM: return DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+	case DXGI_FORMAT_B8G8R8A8_UNORM: return DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+	case DXGI_FORMAT_B8G8R8X8_UNORM: return DXGI_FORMAT_B8G8R8X8_UNORM_SRGB;
+	default: return format;
+	}
+}
+// This strict subset matches DirectXTK's no-context, no-resize WIC path.
+// Feature-level scaling, format conversion and uncommon decoder output use
+// the exact encoded-memory loader instead.
+bool UseDecoded(const PreparedAsset& asset, ID3D11Device* device,
+	const CustomResource& target, GpuPreparationRequest& request, bool detectColorSpace) {
+	if (!asset.decoded || !asset.decoded->pixels || !device) return false;
+	const auto& image = *asset.decoded;
+	if (!image.width || !image.height || image.decoderVersion != 1) return false;
+	UINT maximum = device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_11_0 ? 16384 :
+		device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_10_0 ? 8192 :
+		device->GetFeatureLevel() >= D3D_FEATURE_LEVEL_9_3 ? 4096 : 2048;
+	if (image.width > maximum || image.height > maximum) return false;
+	DXGI_FORMAT format = static_cast<DXGI_FORMAT>(image.format);
+	const auto flags = PreparedWICFlags(*asset.snapshot.bytes,
+		target.override_color_space, detectColorSpace);
+	if ((flags & DirectX::WIC_LOADER_FORCE_SRGB) ||
+		(!(flags & DirectX::WIC_LOADER_IGNORE_SRGB) && image.metadataSRGB))
+		format = SRGB(format);
+	UINT support = 0;
+	if (FAILED(device->CheckFormatSupport(format, &support)) ||
+		!(support & D3D11_FORMAT_SUPPORT_TEXTURE2D)) return false;
+	if (request.loaderMiscFlags || request.loaderBindFlags != D3D11_BIND_SHADER_RESOURCE)
+		return false;
+	request.kind = GpuPreparationKind::Texture2D;
+	request.snapshot.bytes = image.pixels;
+	request.texture.Width = image.width;
+	request.texture.Height = image.height;
+	request.texture.MipLevels = request.texture.ArraySize = 1;
+	request.texture.Format = format;
+	request.texture.SampleDesc.Count = 1;
+	request.texture.Usage = D3D11_USAGE_DEFAULT;
+	request.texture.BindFlags = request.loaderBindFlags;
+	request.subresources.push_back({0, image.pixels->size(), image.rowPitch,
+		static_cast<UINT>(image.pixels->size())});
+	request.estimatedBytes = image.pixels->size() + 64 * 1024;
+	request.creationOptions.insert(request.creationOptions.end(), {image.decoderVersion,
+		image.width, image.height, image.rowPitch, image.format, flags});
+	return true;
+}
+bool RequestFor(CustomResource& resource, const PreparedAsset& asset,
+	ID3D11Device* device, GpuPreparationRequest& request, bool detectColorSpace) {
+	if (!resource.PreparationReadOnly() || resource.filename.empty() ||
+		!asset.snapshot.bytes || asset.snapshot.bytes->empty()) return false;
+	request.snapshot = asset.snapshot;
+	request.reserveCpuScratch = [bank = Services().refreshCpuBudget](uint64_t bytes) {
+		return bank->TryReserve(bytes);
+	};
+	request.dependencyReadOnly = true;
+	// No custom NVAPI stereo mode is applied by CustomResource::Substantiate.
+	// Preparation uses exactly that default creation policy under its lock.
+	request.creationOptions = {RuntimeFeatureVersion, 0};
+	if (IsBuffer(resource)) {
+		if (asset.snapshot.bytes->size() > UINT_MAX) return false;
+		auto& desc = request.buffer;
+		desc.Usage = D3D11_USAGE_DEFAULT;
+		desc.BindFlags = resource.bind_flags;
+		desc.MiscFlags = resource.misc_flags;
+		desc.ByteWidth = static_cast<UINT>(asset.snapshot.bytes->size());
+		if (resource.override_type == CustomResourceType::STRUCTURED_BUFFER)
+			desc.StructureByteStride = desc.ByteWidth;
+		resource.OverrideBufferDesc(&desc);
+		request.estimatedBytes = uint64_t(desc.ByteWidth) + 64 * 1024;
+		return desc.ByteWidth != 0;
+	}
+	request.loaderBindFlags = resource.override_bind_flags == CustomResourceBindFlags::INVALID ?
+		resource.bind_flags : static_cast<UINT>(resource.override_bind_flags);
+	request.loaderMiscFlags = resource.override_misc_flags == ResourceMiscFlags::INVALID ?
+		resource.misc_flags : static_cast<UINT>(resource.override_misc_flags);
+	request.createDefaultShaderResourceView = resource.preparation_known_srv &&
+		request.loaderBindFlags == D3D11_BIND_SHADER_RESOURCE && !request.loaderMiscFlags;
+	request.forceSRGB = resource.override_color_space == CustomColorSpace::SRGB;
+	request.wicLoaderFlags = PreparedWICFlags(*asset.snapshot.bytes,
+		resource.override_color_space, detectColorSpace);
+	const bool dds = IsDDS(resource.filename);
+	if (!dds && UseDecoded(asset, device, resource, request, detectColorSpace)) {
+		if (request.createDefaultShaderResourceView) request.estimatedBytes += 64 * 1024;
+		return true;
+	}
+	request.kind = dds ? GpuPreparationKind::EncodedDDS : GpuPreparationKind::EncodedWIC;
+	request.estimatedBytes = EstimateEncodedTextureBytes(asset.snapshot, request.kind);
+	if (!request.estimatedBytes) return false;
+	if (request.createDefaultShaderResourceView) request.estimatedBytes += 64 * 1024;
+	return true;
+}
+std::shared_ptr<const ShaderBundleInput> CaptureShaderBundle(CustomShader& shader, size_t maxBytes, uint64_t shaderBudget) {
+	if (shader.substantiated || shader.preparation_compile_failed ||
+		shader.blend_override < 0 || shader.blend_override > 1 ||
+		shader.depth_stencil_override < 0 || shader.depth_stencil_override > 1 ||
+		shader.rs_override < 0 || shader.rs_override > 1 ||
+		shader.sampler_override < 0 || shader.sampler_override > 1) return {};
+	auto input = std::make_shared<ShaderBundleInput>();
+	const bool overrideStage[] = {shader.vs_override, shader.hs_override, shader.ds_override,
+		shader.gs_override, shader.ps_override, shader.cs_override};
+	ID3DBlob* bytecode[] = {shader.vs_bytecode, shader.hs_bytecode, shader.ds_bytecode,
+		shader.gs_bytecode, shader.ps_bytecode, shader.cs_bytecode};
+	size_t bytes = 0;
+	bool createsObject = false;
+	for (size_t stage = 0; stage < 6; ++stage) {
+		if (overrideStage[stage]) input->stageOverrideMask |= 1u << stage;
+		if (!bytecode[stage]) continue; // A configured null stage is intentional.
+		if (!overrideStage[stage] || bytecode[stage]->GetBufferSize() > maxBytes - bytes) return {};
+		bytes += bytecode[stage]->GetBufferSize();
+		const auto retained = SharedShaderBytecode::LiveRetainedBytes();
+		if (retained > shaderBudget || bytecode[stage]->GetBufferSize() > shaderBudget - retained) return {};
+		const auto digest = HashBytes(static_cast<const uint8_t*>(bytecode[stage]->GetBufferPointer()),
+			bytecode[stage]->GetBufferSize());
+		input->stages[stage] = SharedShaderBytecode::Retain(bytecode[stage], digest, shaderBudget);
+		if (!input->stages[stage]) return {};
+		createsObject = true;
+	}
+	input->createBlendState = shader.blend_override == 1;
+	input->createDepthStencilState = shader.depth_stencil_override == 1;
+	input->createRasterizerState = shader.rs_override == 1;
+	input->createSamplerState = shader.sampler_override == 1;
+	if (input->createBlendState) input->blend = shader.blend_desc;
+	if (input->createDepthStencilState) input->depthStencil = shader.depth_stencil_desc;
+	if (input->createRasterizerState) input->rasterizer = shader.rs_desc;
+	if (input->createSamplerState) input->sampler = shader.sampler_desc;
+	return createsObject || input->createBlendState || input->createDepthStencilState ||
+		input->createRasterizerState || input->createSamplerState ? input : nullptr;
+}
+bool ShaderRequestFor(CustomShader& shader, GpuPreparationRequest& request) {
+	if (!shader.preparation_bundle || shader.substantiated || shader.preparation_compile_failed)
+		return false;
+	request.kind = GpuPreparationKind::ShaderBundle;
+	request.shaderBundle = shader.preparation_bundle;
+	request.dependencyReadOnly = true; // Compiled shaders and fixed states are immutable.
+	request.creationOptions = {RuntimeFeatureVersion, 1, uint32_t(shader.compile_flags)};
+	uint64_t bytes = 0, objects = 0;
+	for (const auto& stage : shader.preparation_bundle->stages) {
+		bytes += stage.Size();
+		if (stage) ++objects;
+	}
+	const auto& input = *shader.preparation_bundle;
+	objects += input.createBlendState + input.createDepthStencilState +
+		input.createRasterizerState + input.createSamplerState;
+	request.estimatedBytes = bytes * 2 + objects * 64 * 1024;
+	return request.estimatedBytes != 0;
+}
+bool KnownPreparationCopy(const ResourceCopyOperation& operation) {
+	const auto& destination = operation.dst;
+	const bool inputSlot = destination.type == ResourceCopyTargetType::SHADER_RESOURCE ||
+		destination.type == ResourceCopyTargetType::VERTEX_BUFFER ||
+		destination.type == ResourceCopyTargetType::INDEX_BUFFER ||
+		destination.type == ResourceCopyTargetType::CONSTANT_BUFFER;
+	if (!inputSlot || destination.slot_expression || destination.range_start || destination.range_end ||
+		destination.custom_resource_pool || destination.pool_dynamic_index_expression ||
+		destination.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+		operation.src.slot_expression || operation.src.range_start || operation.src.range_end ||
+		operation.src.custom_resource_pool || operation.src.pool_dynamic_index_expression ||
+		operation.src.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE) return false;
+	const uint32_t allowedOptions = uint32_t(ResourceCopyOptions::REFERENCE) |
+		uint32_t(ResourceCopyOptions::UNLESS_NULL) | uint32_t(ResourceCopyOptions::SET_VIEWPORT);
+	if (uint32_t(operation.options) & ~allowedOptions) return false;
+	if (operation.src.type == ResourceCopyTargetType::EMPTY) return true;
+	if (operation.src.type != ResourceCopyTargetType::CUSTOM_RESOURCE ||
+		!(operation.options & ResourceCopyOptions::REFERENCE) ||
+		(uint32_t(operation.options) & ~allowedOptions) ||
+		operation.src.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+		destination.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE) return false;
+	// GetCustomResource has a legacy non-const API; this is a static target
+	// lookup only, and pool/dynamic sources are explicitly rejected.
+	auto& source = const_cast<ResourceCopyTarget&>(operation.src);
+	if (source.custom_resource_pool) return false;
+	auto* resource = source.GetCustomResource(nullptr, true);
+	return resource && resource->PreparationReadOnly() && !resource->filename.empty();
+}
+bool KnownPreparationCommand(const CommandListCommand& command) {
+	if (const auto* operation = dynamic_cast<const ResourceCopyOperation*>(&command))
+		return KnownPreparationCopy(*operation);
+	if (const auto* batch = dynamic_cast<const ShaderResourceBindBatch*>(&command)) {
+		for (const auto& operation : batch->operations)
+			if (!operation || !KnownPreparationCopy(*operation)) return false;
+		return true;
+	}
+	if (const auto* shader = dynamic_cast<const RunCustomShaderCommand*>(&command)) return shader->custom_shader != nullptr;
+	if (const auto* draw = dynamic_cast<const DrawCommand*>(&command)) {
+		size_t arguments = 0;
+		switch (draw->type) {
+		case DrawCommandType::DRAW: arguments = 2; break;
+		case DrawCommandType::DRAW_INDEXED: case DrawCommandType::DISPATCH: arguments = 3; break;
+		case DrawCommandType::DRAW_INSTANCED: arguments = 4; break;
+		case DrawCommandType::DRAW_INDEXED_INSTANCED: arguments = 5; break;
+		default: return false;
+		}
+		// Resource/hash expressions can create staging resources while being
+		// evaluated. Only the parser's side-effect-free constant evaluation is
+		// admitted by this initial whole-profile command proof.
+		for (size_t argument = 0; argument < arguments; ++argument) {
+			float value = 0;
+			if (!const_cast<CommandListExpression&>(draw->args[argument]).static_evaluate(&value)) return false;
+		}
+		return true;
+	}
+	return dynamic_cast<const RunExplicitCommandList*>(&command) ||
+		dynamic_cast<const RunLinkedCommandList*>(&command) ||
+		dynamic_cast<const SkipCommand*>(&command) || dynamic_cast<const AbortCommand*>(&command);
+}
+bool KnownPreparationCommandClosure() {
+	if (registered_command_lists.size() > 65536) return false;
+	std::vector<CommandList*> pending(registered_command_lists.begin(), registered_command_lists.end());
+	std::set<CommandList*> visited;
+	size_t commands = 0;
+	while (!pending.empty()) {
+		auto* list = pending.back(); pending.pop_back();
+		if (!list || list->runtime_populated) return false;
+		if (!visited.insert(list).second) continue;
+		if (visited.size() > 65536) return false;
+		for (const auto& command : list->commands) {
+			if (++commands > 65536 || !command || !KnownPreparationCommand(*command)) return false;
+			if (const auto* shader = dynamic_cast<const RunCustomShaderCommand*>(command.get())) {
+				pending.push_back(&shader->custom_shader->command_list);
+				pending.push_back(&shader->custom_shader->post_command_list);
+			} else if (const auto* explicitList = dynamic_cast<const RunExplicitCommandList*>(command.get())) {
+				if (!explicitList->command_list_section) return false;
+				pending.push_back(&explicitList->command_list_section->command_list);
+				pending.push_back(&explicitList->command_list_section->post_command_list);
+			} else if (const auto* linked = dynamic_cast<const RunLinkedCommandList*>(command.get())) {
+				pending.push_back(linked->link);
+			}
+		}
+	}
+	return true;
+}
+
+bool CaptureRefreshUseRecipe(CustomResource* original, RefreshUseRecipe& recipe) {
+	if (!original || !original->PreparationReadOnly() || original->override_type != CustomResourceType::BUFFER ||
+		original->pool || original->initial_data || original->initial_data_size || original->offset ||
+		original->misc_flags || original->max_copies_per_frame || original->filename.empty()) return false;
+	std::set<const CommandListCommand*> visited;
+	ResourceCopyOperation* use = nullptr;
+	CommandList* owner = nullptr;
+	for (auto* list : registered_command_lists) {
+		if (!list || list->runtime_populated) return false;
+		for (const auto& command : list->commands) {
+			if (!command || !visited.insert(command.get()).second) continue;
+			auto* operation = dynamic_cast<ResourceCopyOperation*>(command.get());
+			if (!operation || operation->src.type != ResourceCopyTargetType::CUSTOM_RESOURCE ||
+				operation->src.custom_resource_pool || operation->src.GetCustomResource(nullptr, true) != original) continue;
+			if (use) return false;
+			use = operation; owner = list;
+		}
+	}
+	if (!use || !owner || uint32_t(use->options) != uint32_t(ResourceCopyOptions::REFERENCE) ||
+		use->src.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+		use->dst.evaluation_mode != ResourceCopyTargetEvaluationMode::RESOURCE ||
+		use->dst.slot_expression || use->dst.range_start || use->dst.range_end ||
+		use->dst.custom_resource_pool || use->src.forbid_view_cache) return false;
+	bool drawEntrypoint = false;
+	for (auto& overrideEntry : ConfigState().mShaderOverrideMap)
+		if (owner == &overrideEntry.second.command_list) drawEntrypoint = true;
+	if (!drawEntrypoint) return false; // No init/Present/input/post/indirect call sites.
+	for (auto* list : registered_command_lists)
+		for (const auto& command : list->commands) {
+			if (auto* linked = dynamic_cast<RunLinkedCommandList*>(command.get()))
+				if (linked->link == owner) return false;
+			if (auto* explicitList = dynamic_cast<RunExplicitCommandList*>(command.get()))
+				if (explicitList->command_list_section &&
+					(owner == &explicitList->command_list_section->command_list ||
+					 owner == &explicitList->command_list_section->post_command_list)) return false;
+		}
+	UINT bind = 0;
+	if (use->dst.type == ResourceCopyTargetType::VERTEX_BUFFER && original->override_stride > 0) bind = D3D11_BIND_VERTEX_BUFFER;
+	if (use->dst.type == ResourceCopyTargetType::INDEX_BUFFER &&
+		(original->override_format == DXGI_FORMAT_R16_UINT || original->override_format == DXGI_FORMAT_R32_UINT)) bind = D3D11_BIND_INDEX_BUFFER;
+	if (!bind || original->bind_flags != bind ||
+		(original->override_bind_flags != CustomResourceBindFlags::INVALID && uint32_t(original->override_bind_flags) != bind)) return false;
+	recipe.original = original; recipe.bind = bind;
+	recipe.stride = original->override_stride > 0 ? UINT(original->override_stride) : 0;
+	recipe.format = original->override_format;
+	return true;
+}
+bool AdmitRefreshRecipe(const std::shared_ptr<RuntimeState>& state,
+	const ResourceFilenamePatch& patch, ID3D11Device* device, CustomResource*& original,
+	D3D11_BUFFER_DESC& descriptor) {
+	if (!state->resourceSharingProven) return false;
+	const auto captured = state->refreshRecipes.find(patch.binding.resourceId);
+	const auto found = customResources.find(patch.binding.resourceId);
+	if (captured == state->refreshRecipes.end() || found == customResources.end() ||
+		captured->second.original != &found->second) return false;
+	original = &found->second;
+	const auto& recipe = captured->second;
+	if (!original->PreparationReadOnly() || original->override_type != CustomResourceType::BUFFER ||
+		original->pool || original->initial_data || original->initial_data_size || original->offset ||
+		original->view || original->misc_flags || original->max_copies_per_frame ||
+		!original->substantiated || !original->resource || original->is_null || original->device != device ||
+		!original->buf_size || original->bind_flags != recipe.bind ||
+		(recipe.bind == D3D11_BIND_VERTEX_BUFFER && original->stride != recipe.stride) ||
+		(recipe.bind == D3D11_BIND_INDEX_BUFFER && original->format != recipe.format) ||
+		_wcsicmp(Canonical(patch.binding.resolvedFilename).c_str(), original->filename.c_str())) return false;
+	D3D11_RESOURCE_DIMENSION dimension;
+	original->resource->GetType(&dimension);
+	if (dimension != D3D11_RESOURCE_DIMENSION_BUFFER) return false;
+	static_cast<ID3D11Buffer*>(original->resource)->GetDesc(&descriptor);
+	return descriptor.BindFlags == recipe.bind && descriptor.Usage == D3D11_USAGE_DEFAULT &&
+		!descriptor.CPUAccessFlags && !descriptor.MiscFlags;
+	// Non-structured VB/IB descriptors may preserve the legacy stride field;
+	// reusing that exact descriptor does not require the ignored field be zero.
+}
+
+void ScheduleRefreshBuild(const std::shared_ptr<RuntimeState>& state,
+	const ReconcileRequest& request, DeviceEpoch epoch) {
+	auto& service = Services();
+	service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+	service.pendingGeneral.reset();
+	if (!state->refreshEnabled) return;
+	if (request.fullReconcile || !state->refreshClosure.verified || !state->config ||
+		!state->config->manifest.verified || !state->resourceSharingProven || !service.refreshWorker) {
+		state->refreshReason = "filename refresh unsupported for this dependency closure; use F10"; return;
+	}
+	if (!state->refreshBaselineCharged) {
+		state->refreshReason = "filename refresh baseline memory admission unavailable; use F10"; return;
+	}
+	const auto active = service.refreshManager.Pin();
+	const auto& baseline = active ? active->manifest : state->refreshBaseline;
+	auto metadata = ReserveResourceRefreshMetadata(*service.refreshCpuBudget, baseline,
+		state->refreshBindings, state->refreshClosure);
+	if (!metadata) {
+		state->refreshReason = "filename refresh waiting for aggregate CPU memory admission; use F10"; return;
+	}
+	auto task = std::make_shared<RefreshBuildTask>();
+	task->budget = service.refreshCpuBudget; task->metadataOwnership = std::move(metadata);
+	task->state = state; task->id = ++service.nextGeneration;
+	task->legacyConfigEpoch = state->legacyConfigEpoch;
+	task->schedulerGeneration = state->generation;
+	task->versions = {request.token, epoch, state->legacyConfigEpoch};
+	try {
+		task->baseline = baseline;
+	} catch (const std::bad_alloc &) {
+		state->refreshReason = "filename refresh manifest copy exceeds CPU memory admission; last-good generation remains active";
+		return;
+	}
+	uint64_t bytes = 0;
+	const auto ownOutput = OwnOutputDirectory();
+	for (const auto& source : task->baseline.sources) {
+		const auto sourcePath = Canonical(source.snapshot.path);
+		const bool ignoredOutput = !ownOutput.empty() && sourcePath.size() >= ownOutput.size() &&
+			!_wcsnicmp(sourcePath.c_str(), ownOutput.c_str(), ownOutput.size());
+		if (ignoredOutput || !source.snapshot.watchable || !source.snapshot.bytes ||
+			source.snapshot.bytes->size() > state->refreshBytes / 2 - bytes) {
+			state->refreshReason = "filename refresh manifest exceeds admission bounds or watch coverage; use F10"; return;
+		}
+		bytes += source.snapshot.bytes->size();
+	}
+	task->bindings = state->refreshBindings; task->closure = state->refreshClosure;
+	state->refreshReason = "filename refresh: preparing a verified immutable candidate";
+	service.refreshWorker->Submit(std::move(task));
+}
+void PollRefreshRetirement(ID3D11Device* device) {
+	auto& service = Services();
+	if (service.refreshRetirement.empty()) return;
+	ID3D11DeviceContext* context = nullptr; device->GetImmediateContext(&context);
+	if (!context) return;
+	std::vector<uint64_t> completeIds;
+	service.refreshManager.Retire([&](uint64_t id) {
+		const auto query = service.refreshRetirement.find(id); BOOL complete = FALSE;
+		const bool done = query != service.refreshRetirement.end() &&
+			context->GetData(query->second.get(), &complete, sizeof(complete), D3D11_ASYNC_GETDATA_DONOTFLUSH) == S_OK && complete;
+		if (done) completeIds.push_back(id);
+		return done;
+	});
+	context->Release();
+	for (const auto id : completeIds) service.refreshRetirement.erase(id);
+}
+void PumpPreparedRefresh(const std::shared_ptr<RuntimeState>& state, ID3D11Device* device, DeviceEpoch epoch) {
+	auto& service = Services();
+	if (!state->refreshEnabled || !service.refreshWorker || !state->enabled.load()) return;
+	if (FAILED(device->GetDeviceRemovedReason())) {
+		service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+		service.pendingGeneral.reset();
+		state->refreshReason = "filename refresh unavailable after device removal; use F10";
+		service.refreshActivation.Consume(); return;
+	}
+	const auto activeDevice = service.refreshManager.Pin();
+	if (activeDevice && activeDevice->versions.device != epoch) {
+		state->refreshReason = "filename refresh invalidated by device recreation; use F10";
+		service.refreshManager.Clear(); service.refreshRetirement.clear();
+		service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+		service.pendingGeneral.reset();
+	}
+	PollRefreshRetirement(device);
+	std::shared_ptr<RefreshBuildResult> result;
+	{ std::unique_lock<std::mutex> lock(state->refreshMutex, std::try_to_lock);
+	  if (lock.owns_lock()) result.swap(state->refreshResult); }
+	if (result) {
+		service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+		service.pendingGeneral.reset();
+		if (result->legacyConfigEpoch != service.legacyConfigEpoch.load() ||
+			result->patch.versions.device != epoch || !state->monitor->IsCurrent(result->patch.versions.source)) return;
+		CustomResource* original = nullptr; D3D11_BUFFER_DESC descriptor{};
+		if (!result->patch.valid || !AdmitRefreshRecipe(state, result->patch, device, original, descriptor)) {
+			state->refreshReason = "filename refresh rejected (only one uniquely used static VB/IB is supported); use F10"; return;
+		}
+		const auto active = service.refreshManager.Pin();
+		if (active) {
+			const auto payload = std::static_pointer_cast<const ResourceRefreshOverlay>(active->payload);
+			if (!payload || payload->replacements.size() != 1 || !payload->replacements.count(original)) {
+				state->refreshReason = "filename refresh can repeat only the same audited resource; use F10"; return;
+			}
+		}
+		service.pendingRefresh = std::make_shared<PendingRefresh>();
+		service.pendingRefresh->build = std::move(result); service.pendingRefresh->original = original;
+		service.pendingRefresh->descriptor = descriptor;
+	}
+	auto pending = service.pendingRefresh;
+	if (!pending) { service.refreshActivation.Consume(); return; }
+	auto& build = *pending->build;
+	if (build.legacyConfigEpoch != service.legacyConfigEpoch.load() || build.patch.versions.device != epoch ||
+		!state->monitor->IsCurrent(build.patch.versions.source)) {
+		service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+		service.pendingGeneral.reset();
+		state->refreshReason = "filename refresh source changed; last-good generation remains active";
+		service.refreshActivation.Consume(); return;
+	}
+	if (!pending->source) pending->source = state->scheduler->TryGet(build.patch.replacementPath, build.schedulerGeneration);
+	if (!pending->source) {
+		state->scheduler->Enqueue(build.patch.replacementPath, build.schedulerGeneration, 10);
+		const auto reason = state->scheduler->CompatibilityReason(build.patch.replacementPath, build.schedulerGeneration);
+		state->refreshReason = reason.empty() ? "filename refresh: awaiting verified bytes and memory admission" :
+			"filename refresh source is outside supported watch coverage; use F10";
+		service.refreshActivation.Consume(); return;
+	}
+	if (!pending->source->snapshot.watchable || !pending->source->snapshot.bytes ||
+		pending->source->snapshot.bytes->size() != pending->original->buf_size) {
+		state->refreshReason = "filename refresh requires the same source byte count and watchable input; use F10";
+		service.refreshActivation.SetReady(0); service.refreshActivation.Consume(); return;
+	}
+	if (!pending->generation) {
+		const uint64_t budget = state->refreshGpuBytes;
+		if (!budget || (device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED)) {
+			state->refreshReason = "filename refresh GPU preparation unsupported or disabled; use F10";
+			service.refreshActivation.Consume(); return;
+		}
+		if (!service.refreshPlanner) {
+			service.device = device; service.epoch = epoch; service.owner = std::this_thread::get_id();
+			service.refreshPlanner.reset(new PreparationPlanner(budget, 1, 0));
+			if (!service.refreshPlanner->BeginDevice(device, epoch)) return;
+		}
+		GpuPreparationRequest request;
+		request.snapshot = pending->source->snapshot; request.sourceOwner = pending->source;
+		request.buffer = pending->descriptor; request.dependencyReadOnly = true;
+		request.estimatedBytes = uint64_t(request.buffer.ByteWidth) * 2 + 128 * 1024;
+		request.pendingGenerationOverlap = uint64_t(request.buffer.ByteWidth) * 2;
+		request.creationOptions = {RuntimeFeatureVersion, 3};
+		request.retainedBudget = service.refreshGpuBudget;
+		request.retainedBudgetLimit = state->refreshGpuBytes;
+		request.reserveCpuScratch = [bank = service.refreshCpuBudget](uint64_t bytes) {
+			return bank->TryReserve(bytes);
+		};
+		const auto admitted = service.refreshPlanner->Enqueue(request, &pending->key);
+		if (admitted == GpuQueueResult::CompatibilityOnly) {
+			state->refreshReason = "filename refresh descriptor or GPU admission limit unsupported; use F10";
+			service.refreshActivation.Consume(); return;
+		}
+		if (state->loadingWindow) {
+			struct CreationGuard { CreationGuard() { LockResourceCreationMode(); } ~CreationGuard() { UnlockResourceCreationMode(); } } guard;
+			const auto pumped = service.refreshPlanner->Pump(true, state->gpuLimits);
+			if (pumped.deviceRemoved) { RetireRuntimeDevice(device); return; }
+		}
+		pending->gpu = service.refreshPlanner->TryAcquire(pending->key);
+		if (!pending->gpu || !pending->gpu->resource) {
+			state->refreshReason = "filename refresh: awaiting GPU memory admission and configured loading window";
+			service.refreshActivation.Consume(); return;
+		}
+		auto replacement = std::make_shared<CustomResource>();
+		replacement->CopyMetadataFrom(*pending->original);
+		replacement->name = pending->original->name; replacement->filename = build.patch.replacementPath;
+		replacement->format = pending->original->format; replacement->stride = pending->original->stride;
+		replacement->buf_size = pending->original->buf_size; replacement->source_stride = pending->original->source_stride;
+		replacement->resource = pending->gpu->resource; replacement->resource->AddRef();
+		replacement->device = device; replacement->is_null = false; replacement->substantiated = true;
+		replacement->preparation_pin = pending->gpu;
+		auto payload = std::make_shared<ResourceRefreshOverlay>();
+		payload->deviceIdentity = device; payload->deviceEpoch = epoch;
+		payload->legacyConfigEpoch = build.legacyConfigEpoch;
+		payload->replacements.emplace(pending->original, replacement);
+		auto generation = std::make_shared<ResourceRefreshGeneration>();
+		generation->id = build.id; generation->legacyConfigEpoch = build.legacyConfigEpoch;
+		generation->versions = build.patch.versions;
+		try {
+			generation->manifest = build.patch.manifest;
+		} catch (const std::bad_alloc &) {
+			state->refreshReason = "filename refresh publication metadata exceeds CPU memory admission; last-good generation remains active";
+			service.refreshActivation.SetReady(0);
+			service.refreshActivation.Consume();
+			return;
+		}
+		generation->payload = payload; pending->generation = generation;
+	}
+	const auto active = service.refreshManager.Pin();
+	if (active && !pending->retirementQuery) {
+		if (!state->loadingWindow) { service.refreshActivation.Consume(); return; }
+		D3D11_QUERY_DESC descriptor{D3D11_QUERY_EVENT, 0};
+		HRESULT queryResult;
+		{ struct QueryCreationGuard { QueryCreationGuard() { LockResourceCreationMode(); } ~QueryCreationGuard() { UnlockResourceCreationMode(); } } guard;
+		  queryResult = device->CreateQuery(&descriptor, &pending->retirementQuery); }
+		if (FAILED(queryResult)) {
+			state->refreshReason = "filename refresh retirement fence unavailable; use F10";
+			service.refreshActivation.Consume(); return;
+		}
+	}
+	if (!state->monitor->IsCurrent(build.patch.versions.source) ||
+		build.legacyConfigEpoch != service.legacyConfigEpoch.load() || FAILED(device->GetDeviceRemovedReason())) {
+		service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+		service.pendingGeneral.reset();
+		service.refreshActivation.Consume();
+		state->refreshReason = "filename refresh proof became stale; last-good generation remains active"; return;
+	}
+	service.refreshActivation.SetReady(build.id);
+	state->refreshReason = "filename refresh prepared; press the configured refresh shortcut to apply";
+	const uint64_t requested = service.refreshActivation.Consume();
+	if (requested && requested == build.id && state->monitor->IsCurrent(build.patch.versions.source)) {
+		// Match complete-graph activation durations: 0 = published, 1 = retry.
+		// This interval excludes asynchronous preparation and readiness waits.
+		ScopedLoadTrace activationTrace(LoadStage::Activation, build.id);
+		activationTrace.SetResult(1);
+		const BuildVersions current{build.patch.versions.source, epoch, state->legacyConfigEpoch};
+		if (active && pending->retirementQuery) {
+			pending->retirementQuery->AddRef();
+			service.refreshRetirement[active->id] = std::shared_ptr<ID3D11Query>(pending->retirementQuery,
+				[](ID3D11Query* query) { query->Release(); });
+		}
+		ResourceRefreshPublishResult published = ResourceRefreshPublishResult::Stale;
+		const bool committed = state->monitor->CommitIfCurrent(build.patch.versions.source, [&] {
+			// Source Notify and this manager-only swap share the final fence.
+			// No D3D calls, destruction, I/O, or recursive monitor access here.
+			published = service.refreshManager.Publish(pending->generation, current,
+				service.legacyConfigEpoch.load(), true);
+			return published == ResourceRefreshPublishResult::Activated;
+		});
+		if (committed) {
+			activationTrace.SetResult(0);
+			if (active && pending->retirementQuery) {
+				ID3D11DeviceContext* context = nullptr; device->GetImmediateContext(&context);
+				if (context) { context->End(pending->retirementQuery); context->Release(); }
+			}
+			service.refreshActivation.SetReady(0); service.pendingRefresh.reset(); service.refreshPlanner.reset();
+			service.pendingGeneral.reset();
+			state->refreshReason = "filename refresh applied; general configuration changes still use F10";
+		} else {
+			if (active) service.refreshRetirement.erase(active->id);
+			state->refreshReason = "filename refresh waiting for retirement or stale proof; press again when prepared";
+		}
+	}
+
+}
+void PublishProgress(const std::shared_ptr<RuntimeState>& state, DeviceEpoch epoch,
+	const char* forcedReason = nullptr) {
+	PreparationStatus status;
+	const auto statusTicket = ReservePreparationStatusTicket();
+	status.mode = state ? state->mode : PreparationMode::Off;
+	if (!state || state->mode == PreparationMode::Off) {
+		status.state = PreparationStatusState::Off;
+		UpdatePreparationStatus(status, statusTicket); return;
+	}
+	status.totalAssets = state->totalAssets;
+	status.compatibilityAssets = state->baseCompatibility;
+	for (const auto& item : state->profile) {
+		const auto& entry = item.second;
+		if (entry.compatibility) ++status.compatibilityAssets;
+		if (entry.generation != state->generation) continue;
+		if (entry.cpuReady) ++status.cpuReady;
+		auto gpu = entry.pinnedGpu.lock();
+		if (!gpu) gpu = entry.observedGpu.lock();
+		if (entry.cpuReady && gpu && entry.epoch == epoch) ++status.gpuReady;
+	}
+	// Serialize the final source fence and publication with the monitor's
+	// invalidation callback. A snapshot gathered before that callback cannot
+	// clear its newer atomic writer invalidation with a stale Ready update.
+	std::unique_lock<std::mutex> publishLock(state->pendingMutex, std::try_to_lock);
+	if (!publishLock.owns_lock()) return;
+	const bool current = state->enabled.load() && state->monitor &&
+		state->monitor->IsCurrent(state->sourceToken.load());
+	if (forcedReason || Services().retirementRequested.load() || !current || !state->gpuBytes || !state->cpuLimits.cpuBytes) {
+		status.state = PreparationStatusState::Compatibility;
+		status.compatibilityAssets = status.totalAssets;
+		status.gpuReady = 0;
+		if (!current) status.cpuReady = 0;
+		status.reason = forcedReason ? forcedReason : "preparation disabled or source/configuration needs compatible reload";
+	} else if (status.compatibilityAssets) {
+		status.state = PreparationStatusState::Compatibility;
+		status.reason = "profile includes unsupported, mutable, unknown-view, or legacy shader entries";
+		for (const auto& item : state->profile)
+			if (item.second.compatibility && !item.second.reason.empty()) {
+				status.reason = item.second.reason; break;
+			}
+	} else if (state->mode == PreparationMode::PreparedProfile && status.totalAssets &&
+		status.cpuReady == status.totalAssets && status.gpuReady == status.totalAssets) {
+		status.state = PreparationStatusState::Ready;
+		status.reason = "complete current profile pinned; preparation readiness is not activation or visual validation";
+	} else {
+		status.state = PreparationStatusState::Preparing;
+		status.reason = "waiting for verified sources, complete GPU objects, loading window, or available budget";
+	}
+	if (!state->refreshReason.empty()) status.reason = state->refreshReason;
+	UpdatePreparationStatus(status, statusTicket);
+}
+void ResetProfileEntry(ProfileEntry& entry, Generation generation, DeviceEpoch epoch) {
+	if (entry.generation == generation && entry.epoch == epoch) return;
+	entry.source.reset(); entry.pinnedGpu.reset(); entry.observedGpu.reset();
+	entry.cpuReady = false; entry.compatibility = entry.staticCompatibility; entry.reason.clear();
+	entry.generation = generation; entry.epoch = epoch; entry.key = DeviceResourceKey();
+}
+bool SameKey(const DeviceResourceKey& a, const DeviceResourceKey& b) {
+	return !(a < b) && !(b < a);
+}
+bool QualifiedResource(CustomResource& resource, const std::shared_ptr<PreparedGpuObject>& prepared) {
+	if (!prepared || !prepared->resource) return false;
+	if (!resource.preparation_known_srv) return true;
+	if (!prepared->shaderResourceView || IsBuffer(resource)) return false;
+	D3D11_RESOURCE_DIMENSION dimension;
+	prepared->resource->GetType(&dimension);
+	if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) return false;
+	D3D11_TEXTURE2D_DESC texture{};
+	static_cast<ID3D11Texture2D*>(prepared->resource)->GetDesc(&texture);
+	D3D11_SHADER_RESOURCE_VIEW_DESC view{};
+	prepared->shaderResourceView->GetDesc(&view);
+	return texture.ArraySize == 1 && texture.SampleDesc.Count == 1 && !texture.SampleDesc.Quality &&
+		!(texture.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE) &&
+		view.ViewDimension == D3D11_SRV_DIMENSION_TEXTURE2D &&
+		FullTexture2DViewMatches(uint32_t(texture.Format), texture.MipLevels,
+			0, 0, UINT32_MAX, uint32_t(view.Format), view.Texture2D.MostDetailedMip, view.Texture2D.MipLevels);
+}
+bool SourcesCurrent(const std::shared_ptr<RuntimeState>& state) {
+	return state && state->enabled.load() && state->scheduler && state->monitor &&
+		state->monitor->IsCurrent(state->sourceToken.load());
+}
