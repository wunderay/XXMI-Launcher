+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+namespace ModLoading {
+using Generation = uint64_t;
+using DeviceEpoch = uint64_t;
+using SourceDigest = std::array<uint8_t, 32>;
+enum class PreparationMode { Off, Adaptive, PreparedProfile };
+enum class PreparationState { Discovered, SnapshotVerified, SourceBytesReady, DecodedReady, CPUReady, DeviceReady, ValidatedForActivation, Active, Retiring, Released, Failed, Canceled, CompatibilityOnly };
+struct FileIdentity {
+    uint64_t volume = 0, file = 0, size = 0, modified = 0;
+    bool operator==(const FileIdentity& o) const { return volume == o.volume && file == o.file && size == o.size && modified == o.modified; }
+};
+struct SourceSnapshot {
+    std::wstring path;
+    SourceDigest digest{};
+    FileIdentity identity;
+    // Lexical parent watches cannot observe writes through these aliases.
+    bool watchable = true;
+    std::string compatibilityReason;
+    std::shared_ptr<const std::vector<uint8_t>> bytes;
+};
+// Source format is retained verbatim. This key is NOT a decoded-image identity.
+// Decoded/GPU consumers must additionally key all decoder and descriptor options.
+struct DecodedImage {
+    uint32_t width=0, height=0, rowPitch=0, format=0; // DXGI numeric format, no D3D dependency
+    bool metadataSRGB=false;
+    uint32_t decoderVersion=1;
+    std::shared_ptr<const std::vector<uint8_t>> pixels;
+};
+struct PreparedAsset {
+    SourceSnapshot snapshot;
+    Generation generation = 0;
+    PreparationState state = PreparationState::SourceBytesReady;
+    std::shared_ptr<const DecodedImage> decoded;
+    size_t ByteSize() const { return (snapshot.bytes ? snapshot.bytes->size() : 0) + (decoded && decoded->pixels ? decoded->pixels->size() : 0); }
+};
+struct PreparationLimits {
+    size_t cpuBytes = size_t(512) * 1024 * 1024;
+    size_t maxAssetBytes = size_t(64) * 1024 * 1024;
+    size_t workers = 2;
+    size_t maxQueued = 64;
+    bool Valid() const { return maxAssetBytes && (!cpuBytes || maxAssetBytes <= cpuBytes) && workers >= 1 && workers <= 16 && maxQueued >= 1 && maxQueued <= 4096; }
+};
+}
