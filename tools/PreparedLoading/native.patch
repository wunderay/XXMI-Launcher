+ConfigReadScope::ConfigReadScope() : ConfigReadScope(ConfigGenerationPin()) {}
+ConfigReadScope::ConfigReadScope(ConfigGenerationPin generation)
+{
+    if (configurationBuilder) { pin_ = configurationBuilder; return; }
+    if (!configurationReadDepth) {
+        auto& registry = ConfigurationRegistryInstance();
+        configurationReader = registry.Acquire(std::move(generation));
+        outer_ = true;
+    }
+    ++configurationReadDepth;
+    counted_ = true;
+    pin_ = configurationReader;
+    configurationStartupPin.reset();
+}
+ConfigReadScope::~ConfigReadScope()
+{
+    if (!counted_) return;
+    --configurationReadDepth;
+    if (outer_) {
+        auto& registry = ConfigurationRegistryInstance();
+        configurationReader.reset();
+        registry.Release();
+    }
