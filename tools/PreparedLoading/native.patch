+
+struct ID3D11Device;
+struct ID3D11DeviceContext;
+class CustomResource;
+class CustomShader;
+struct DrawCallInfo;
+struct ID3D11Resource;
+struct ID3D11ShaderResourceView;
+struct D3D11_SHADER_RESOURCE_VIEW_DESC;
+enum class CustomColorSpace;
+
+namespace ModLoading {
+// Experimental native protocol version; settings remain off unless explicitly
+// selected. No readiness/activation claim is inferred from this version.
+constexpr unsigned RuntimeFeatureVersion = 2;
+void ConfigureRuntime();
+void CancelRuntimeGeneration();
+void RequestPreparedRefresh();
+void RequestFullPreparationRescan();
+bool AdmitConfigurationRetirement(ID3D11Device* device);
+void CancelConfigurationRetirement();
+void RetainRetiredConfiguration(ConfigGenerationPin generation);
+void ObservePreparedResource(CustomResource* original, DrawCallInfo* draw);
+void CapturePreparedRefreshDraw(DrawCallInfo& draw);
+CustomResource* ResolvePreparedRefreshResource(CustomResource* original, DrawCallInfo* draw,
+	ID3D11Device* realDevice, DeviceEpoch lifetimeEpoch);
+// Call only on the real rendering device's Present owner, never DXGI_PRESENT_TEST.
+void PumpRuntime(ID3D11Device* realDevice, DeviceEpoch lifetimeEpoch, ID3D11DeviceContext* realContext = nullptr);
+void RetireRuntimeDevice(ID3D11Device* realDevice);
+// Internal COM calls must not be mistaken for application device retirement.
+bool InRuntimePreparation();
+std::shared_ptr<const PreparedAsset> TryGetPreparedAsset(const std::wstring& path);
+// Acquires an actual prepared GPU resource only after descriptor/proof matching.
+// False always preserves the legacy creation path.
+bool TryUsePreparedResource(CustomResource& target, ID3D11Device* realDevice);
+bool TryUsePreparedShaderBundle(CustomShader& target, ID3D11Device* realDevice);
+// Returns an AddRef-owned exact compatible SRV, or nullptr for the legacy path.
+ID3D11ShaderResourceView* TryGetPreparedShaderResourceView(ID3D11Resource* resource,
+	ID3D11Device* realDevice, const D3D11_SHADER_RESOURCE_VIEW_DESC* requested);
+unsigned PreparedWICFlags(const std::vector<uint8_t>& bytes,
+	CustomColorSpace colorSpace, bool detectPngSRGB);
+}
diff --git a/DirectX11/ModLoading/RuntimePolicy.h b/DirectX11/ModLoading/RuntimePolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..d76bfb9b9a285685a716c961d517d764c8d89791
--- /dev/null
+++ b/DirectX11/ModLoading/RuntimePolicy.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <vector>
+namespace ModLoading {
+// Same explicit PNG sRGB intent used by the legacy file probe, evaluated from
+// immutable source bytes. Every chunk length is bounded before pointer access.
+inline bool HasPngSRGBChunk(const std::vector<uint8_t>& bytes)
+{
+	static const uint8_t signature[] = {137,80,78,71,13,10,26,10};
+	if (bytes.size() < sizeof(signature) ||
+		std::memcmp(bytes.data(), signature, sizeof(signature)))
+		return false;
+	for (size_t at = 8; bytes.size() - at >= 12;) {
+		const uint64_t count = (uint64_t(bytes[at]) << 24) |
+			(uint64_t(bytes[at + 1]) << 16) | (uint64_t(bytes[at + 2]) << 8) | bytes[at + 3];
+		if (count > bytes.size() - at - 12)
+			return false;
+		if (!std::memcmp(bytes.data() + at + 4, "sRGB", 4))
+			return true;
+		if (!std::memcmp(bytes.data() + at + 4, "IEND", 4))
+			return false;
+		at += static_cast<size_t>(count) + 12;
+	}
+	return false;
+}
+// Conservative target-view reuse: only a full, typed, non-array Texture2D
+// view is admitted. Zero format inherits the typed resource format; UINT_MAX
+// mip count means every available mip, as in the legacy descriptor builder.
+inline bool FullTexture2DViewMatches(uint32_t resourceFormat, uint32_t resourceMips,
+	uint32_t requestedFormat, uint32_t requestedFirst, uint32_t requestedMips,
+	uint32_t preparedFormat, uint32_t preparedFirst, uint32_t preparedMips)
+{
+	if (!resourceFormat || !resourceMips || requestedFirst || preparedFirst)
+		return false;
+	if (!requestedFormat)
+		requestedFormat = resourceFormat;
+	if (!preparedFormat)
+		preparedFormat = resourceFormat;
+	if (requestedMips == UINT32_MAX)
+		requestedMips = resourceMips;
+	if (preparedMips == UINT32_MAX)
+		preparedMips = resourceMips;
+	return requestedFormat == preparedFormat && requestedMips == resourceMips &&
+		preparedMips == resourceMips;
+}
+
+}
diff --git a/DirectX11/ModLoading/ShaderSourceCache.cpp b/DirectX11/ModLoading/ShaderSourceCache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..36ee8fdc7ff150d82882a25e167f3d399874fb5c
--- /dev/null
+++ b/DirectX11/ModLoading/ShaderSourceCache.cpp
@@ -0,0 +1,931 @@
+#include "ShaderSourceCache.h"
+#include "SnapshotIO.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <cerrno>
+#include <climits>
+#include <limits>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#else
+#include <codecvt>
+#include <locale>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
+namespace ModLoading {
+	namespace {
+		constexpr size_t HeaderSize=112;
+		void Put(uint8_t* p,uint64_t n,size_t count){
+			for(size_t i=0;i<count;++i)p[i]=uint8_t(n>>(8*i));
+		}
+		uint64_t Get(const uint8_t* p,size_t count){
+			uint64_t n=0;
+			for(size_t i=0;i<count;++i)n|=uint64_t(p[i])<<(8*i);
+			return n;
+		}
+		bool OwnedName(const std::wstring& name,bool& temporary){
+			temporary=false;
+			if(name.size()!=69&&name.size()!=73)return false;
+			for(size_t i=0;i<64;++i)if(!((name[i]>=L'0'&&name[i]<=L'9')||(name[i]>=L'a'&&name[i]<=L'f')))return false;
+			if(name.substr(64,5)!=L".xxsc")return false;
+			temporary=name.size()==73;
+			return !temporary||name.substr(69)==L".tmp";
+		}
+#ifdef _WIN32
+		const wchar_t Separator=L'\\';
+		struct File {
+			HANDLE handle=INVALID_HANDLE_VALUE;
+			~File(){
+				Close();
+			}
+			void Close(){
+				if(handle!=INVALID_HANDLE_VALUE){
+					CloseHandle(handle);
+					handle=INVALID_HANDLE_VALUE;
+				}
+			}
+			bool Open(const std::wstring& path,bool write){
+				handle=CreateFileW(path.c_str(),write?GENERIC_WRITE:GENERIC_READ,write?0:FILE_SHARE_READ|FILE_SHARE_DELETE,nullptr,write?CREATE_NEW:OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_OPEN_REPARSE_POINT,nullptr);
+				if(handle==INVALID_HANDLE_VALUE)return false;
+				BY_HANDLE_FILE_INFORMATION s{};
+				if(!GetFileInformationByHandle(handle,&s)||(s.dwFileAttributes&(FILE_ATTRIBUTE_REPARSE_POINT|FILE_ATTRIBUTE_DIRECTORY))||s.nNumberOfLinks!=1){
+					Close();
+					return false;
+				}
+				return true;
+			}
+			bool Size(uint64_t& size){
+				LARGE_INTEGER n{};
+				if(!GetFileSizeEx(handle,&n)||n.QuadPart<0)return false;
+				size=uint64_t(n.QuadPart);
+				return true;
+			}
+			bool Transfer(uint8_t* p,size_t size,bool write){
+				while(size){
+					DWORD n=0;
+					DWORD step=DWORD((std::min)(size,size_t(65536)));
+					BOOL ok=write?WriteFile(handle,p,step,&n,nullptr):ReadFile(handle,p,step,&n,nullptr);
+					if(!ok||!n)return false;
+					p+=n;
+					size-=n;
+				}
+				return true;
+			}
+			bool Flush(){
+				return FlushFileBuffers(handle)!=FALSE;
+			}
+		};
+		bool Remove(const std::wstring& path){
+			return DeleteFileW(path.c_str())!=FALSE;
+		}
+		bool Rename(const std::wstring& from,const std::wstring& to){
+			return MoveFileExW(from.c_str(),to.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=FALSE;
+		}
+		void Touch(const std::wstring& path){
+			HANDLE h=CreateFileW(path.c_str(),FILE_WRITE_ATTRIBUTES,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,nullptr,OPEN_EXISTING,FILE_FLAG_OPEN_REPARSE_POINT,nullptr);
+			if(h!=INVALID_HANDLE_VALUE){
+				FILETIME now{};
+				GetSystemTimeAsFileTime(&now);
+				SetFileTime(h,nullptr,nullptr,&now);
+				CloseHandle(h);
+			}
+		}
+#else
+		const wchar_t Separator=L'/';
+		std::string Native(const std::wstring& path){
+			return std::wstring_convert<std::codecvt_utf8<wchar_t>>().to_bytes(path);
+		}
+		struct File {
+			int handle=-1;
+			~File(){
+				Close();
+			}
+			void Close(){
+				if(handle>=0){
+					close(handle);
+					handle=-1;
+				}
+			}
+			bool Open(const std::wstring& path,bool write){
+				handle=open(Native(path).c_str(),(write?O_WRONLY|O_CREAT|O_EXCL:O_RDONLY)|O_NOFOLLOW,0600);
+				if(handle<0)return false;
+				struct stat s{};
+				if(fstat(handle,&s)||!S_ISREG(s.st_mode)||s.st_nlink!=1){
+					Close();
+					return false;
+				}
+				return true;
+			}
+			bool Size(uint64_t& size){
+				struct stat s{};
+				if(fstat(handle,&s)||s.st_size<0)return false;
+				size=uint64_t(s.st_size);
+				return true;
+			}
+			bool Transfer(uint8_t* p,size_t size,bool write){
+				while(size){
+					ssize_t n=write?::write(handle,p,(std::min)(size,size_t(65536))) : ::read(handle,p,(std::min)(size,size_t(65536)));
+					if(n<=0)return false;
+					p+=n;
+					size-=size_t(n);
+				}
+				return true;
+			}
+			bool Flush(){
+				return fsync(handle)==0;
+			}
+		};
+		bool Remove(const std::wstring& path){
+			return unlink(Native(path).c_str())==0;
+		}
