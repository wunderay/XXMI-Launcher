+    assert(!budget.Reserve({31, 0})); assert(budget.Reserve({30, 0}));
+    budget.Complete(80); assert(budget.Available() == 80);
+    budget.Update({true, 200, 195}); assert(budget.Available() == 0);
+    assert(!budget.Reserve({1, 0})); budget.Complete(999); assert(budget.QueuedBytes() == 0);
+    budget.Update({false, 0, 40}); assert(budget.Available() == 60);
+    assert(budget.Reserve({40, 20})); assert(budget.Available() == 0);
+    budget.Update({true, 0, (std::numeric_limits<uint64_t>::max)()}); assert(budget.Available() == 0);
+    MemoryBudgetController overflow((std::numeric_limits<uint64_t>::max)(), 0);
+    assert(!overflow.Reserve({(std::numeric_limits<uint64_t>::max)(), 1}));
+    assert(overflow.Reserve({(std::numeric_limits<uint64_t>::max)(), 0}));
+    assert(!overflow.Reserve({1, 0}));
