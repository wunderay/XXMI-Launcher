+#include "ShaderSourceCache.h"
+#include "SnapshotIO.h"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <Windows.h>
+using namespace ModLoading;
+static void Milestone(const char* stage)
+{
+	std::fprintf(stderr, "shader fixture: %s\n", stage);
+	std::fflush(stderr);
+}
+static LONG WINAPI ReportFixtureException(EXCEPTION_POINTERS* exception)
+{
+	const auto address = exception->ExceptionRecord->ExceptionAddress;
+	HMODULE module = nullptr;
+	char modulePath[32768] = "<unresolved>";
+	uintptr_t offset = 0;
+	if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+		GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		reinterpret_cast<LPCWSTR>(address), &module)) {
+		GetModuleFileNameA(module, modulePath, DWORD(sizeof(modulePath)));
+		offset = reinterpret_cast<uintptr_t>(address) - reinterpret_cast<uintptr_t>(module);
+	}
+	std::fprintf(stderr, "shader fixture exception: code=0x%08lx address=%p module=%s offset=0x%llx\n",
+		static_cast<unsigned long>(exception->ExceptionRecord->ExceptionCode), address,
+		modulePath, static_cast<unsigned long long>(offset));
+	std::fflush(stderr);
